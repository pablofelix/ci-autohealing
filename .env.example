# CI Auto-Healing System Configuration
# Copy to .env and fill in values: cp .env.example .env

# ============================================================================
# CORE — Required
# ============================================================================
NAMESPACE=your-namespace
APPLICATION_NAME=your-app-name
KNOWN_APPLICATIONS=your-app-name

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=konflux_monitoring

# ============================================================================
# INFRASTRUCTURE URLS
# ============================================================================
KUBEARCHIVE_URL=https://your-kubearchive-instance.example.com
KONFLUX_UI_BASE=https://your-konflux-ui.example.com

# ============================================================================
# JIRA (optional — for ticket creation via ic fix)
# ============================================================================
JIRA_URL=https://your-jira.example.com
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT=YOUR_PROJECT
JIRA_COMPONENT=DevOps

# ============================================================================
# GITLAB (optional — for exception policy lookups)
# ============================================================================
GITLAB_API_BASE=https://your-gitlab.example.com/api/v4
GITLAB_TOKEN=your-gitlab-token
GITLAB_EC_POLICY_URL=https://your-gitlab.example.com/path/to/policy
GITLAB_RELEASE_PROJECT=your-org/your-release-data-repo
GITLAB_RPA_BASE=config/your-cluster/product/ReleasePlanAdmission/your-product
GITLAB_EC_PATHS=config/your-cluster/product/EnterpriseContractPolicy,config/common/product/EnterpriseContractPolicy
GITLAB_POLICY_PATH=config/your-cluster/product/EnterpriseContractPolicy
GITLAB_POLICY_FILENAMES=registry-yourproduct-prod.yaml,fbc-yourproduct-prod.yaml,registry-yourproduct-stage.yaml,fbc-yourproduct-stage.yaml

# ============================================================================
# GITHUB (for commit context and PR creation)
# ============================================================================
GITHUB_TOKEN=ghp_your_token_here
GITHUB_BUILD_CONFIG_OWNER=your-org
GITHUB_BUILD_CONFIG_REPO=your-build-config-repo
KONFLUX_CENTRAL_REPO=https://github.com/your-org/your-central-repo

# ============================================================================
# COMPONENT DATA SOURCE
# ============================================================================
COMPONENT_DATA_URL=https://your-source.example.com/path/to/component-data.yaml

# ============================================================================
# QUAY (container image registry)
# ============================================================================
QUAY_ORG=your-quay-org

# ============================================================================
# KUBEARCHIVE
# ============================================================================
KUBEARCHIVE_NAMESPACE=product-kubearchive

# ============================================================================
# NEO4J (knowledge graph — system map + AI context enrichment)
# ============================================================================
SLK_NEO4J_URI=bolt://localhost:7687
SLK_NEO4J_USER=neo4j
SLK_NEO4J_PASSWORD=your-neo4j-password-here

# ============================================================================
# SYSTEM MAP (standalone interactive infrastructure map)
# ============================================================================
MAP_PORT=8081
# IC_API_URL=http://localhost:8000  # optional — for live component data

# ============================================================================
# PYTHON (override if your system uses a specific version)
# ============================================================================
# PYTHON=python3.11

# ============================================================================
# PYXIS (optional — for release verification)
# ============================================================================
PYXIS_PROD_URL=https://your-pyxis.example.com/v1
PYXIS_STAGE_URL=https://your-pyxis-stage.example.com/v1
RELENG_NAMESPACE=your-releng-namespace

# ============================================================================
# LLM PROVIDER (optional — for AI analysis)
# ============================================================================
# Provider: 'anthropic' or 'vertex_ai'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vertex AI alternative:
# LLM_PROVIDER=vertex_ai
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_REGION=us-east5

AI_MAX_PER_RUN=5
AI_MIN_CONFIDENCE=0.8

# ============================================================================
# LANGFUSE (optional — LLM observability)
# ============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=http://localhost:3000

# ============================================================================
# WATCH DAEMON (event-driven monitoring, replaces cron steps 1-5 and 9)
# ============================================================================
# Space-separated list of applications to watch. Falls back to APPLICATION_NAME.
# WATCH_APPLICATIONS=your-app-v3-5-ea-1 your-app-v3-5-ea-2
WATCH_AUTO_ANALYZE=true
WATCH_RECONCILE_INTERVAL=1800
WATCH_JIRA_POLL_INTERVAL=600
WATCH_MAX_RETRIES=5
# Space-separated list of watchers to disable: builds tests conforma jira components
# WATCH_DISABLE=conforma jira

# ============================================================================
# BLOB STORAGE (optional — offload large data from PostgreSQL)
# ============================================================================
# Backend: 'local' (filesystem, default) or 'minio' (S3-compatible)
BLOB_STORE=local
# Threshold in bytes — data larger than this is stored externally (default 50KB)
# BLOB_THRESHOLD=51200

# MinIO settings (only needed when BLOB_STORE=minio)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ic-data
# MINIO_SECURE=false

# ============================================================================
# WORKER (pipeline loop intervals)
# ============================================================================
# WORKER_COLLECT_INTERVAL=1200
# WORKER_ANALYZE_INTERVAL=1200
# WORKER_JIRA_INTERVAL=600
# WORKER_HEALTH_PORT=8001

# ============================================================================
# CLI MODE (cluster vs local)
# ============================================================================
# IC_MODE=local                    # 'local' (default) or 'cluster'
# IC_API_URL=                      # API URL for cluster mode (set via ic config use-cluster)
# IC_API_KEY=                      # API bearer token (set via ic config use-cluster --api-key)

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
