# CI Auto-Healing System Configuration

# ============================================================================
# DATABASE (PostgreSQL - same as Langfuse)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=konflux_monitoring

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================================================
# OPENSHIFT / KUBERNETES
# ============================================================================
NAMESPACE=NAMESPACE_PLACEHOLDER
KUBECONFIG=KUBECONFIG_PATH

# ============================================================================
# LLM PROVIDER (for AI analysis)
# ============================================================================
# Provider: 'anthropic' (direct API, recommended) or 'vertex_ai' (Claude on GCP)
# 'anthropic' gives access to latest models (Sonnet 4.5, Opus 4.6)
# 'vertex_ai' uses GCP auth but may have limited model availability
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929

# Anthropic API settings (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vertex AI settings (when LLM_PROVIDER=vertex_ai)
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_REGION=us-east5

# AI analysis controls
AI_MAX_PER_RUN=5
AI_MIN_CONFIDENCE=0.8

# ============================================================================
# LANGFUSE (Observability)
# ============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=http://localhost:3000

# ============================================================================
# GITHUB (for commit context collection and future PR creation)
# ============================================================================
# Token needs read access to repos (contents, pull requests, commits)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_BOT_NAME=ci-autohealing-bot
GITHUB_BOT_EMAIL=ci-bot@example.com

# ============================================================================
# SCANNER CONFIGURATION
# ============================================================================
# Daemon mode: how often to scan (seconds)
SCANNER_INTERVAL=300  # 5 minutes

# How far back to look for builds
SCANNER_LOOKBACK_HOURS=48

# Components file (or set to empty to scan all in namespace)
COMPONENTS_FILE=HOME_DIR/components-ui-failed.txt

# Limit PRs to analyze per scan (to avoid rate limits)
SCANNER_MAX_PRS_PER_RUN=50

# ============================================================================
# AI REMEDIATION
# ============================================================================
# Auto-fix enabled (if false, only analyze, don't create PRs)
AI_AUTO_FIX_ENABLED=false

# Require minimum confidence before auto-fixing
AI_MIN_CONFIDENCE=0.8

# Max fix attempts per failure
AI_MAX_FIX_ATTEMPTS=3

# Categories that can be auto-fixed (comma-separated)
AI_AUTO_FIX_CATEGORIES=dependency_issue,syntax_error,config_error

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=PROJECT_DIR/logs/autohealing.log
LOG_FORMAT=json  # json or text

# ============================================================================
# ALERTS & NOTIFICATIONS (future)
# ============================================================================
SLACK_WEBHOOK_URL=
ENABLE_SLACK_ALERTS=false
