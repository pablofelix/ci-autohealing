cmd_dashboard() {
    _check_db || return 1

    section_header "CI Auto-Healing Dashboard"
    printf "  Application: ${CYAN}%s${NC}\n" "$APPLICATION_NAME"
    printf "  Date: %s\n\n" "$(date '+%Y-%m-%d %H:%M')"

    # --- Analysis Queue ---
    echo -e "${BOLD}Analysis Queue${NC}"
    local queue
    queue=$(sql "
        SELECT
            (SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME' AND ai_analyzed = FALSE AND is_resolved = FALSE AND ai_skip_reason IS NULL) as build_pending,
            (SELECT COUNT(*) FROM conforma_results WHERE application = '$APPLICATION_NAME' AND ai_analyzed = FALSE AND ai_skip_reason IS NULL) as conforma_pending,
            (SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME' AND ai_analyzed = TRUE) as build_done,
            (SELECT COUNT(*) FROM conforma_results WHERE application = '$APPLICATION_NAME' AND ai_analyzed = TRUE) as conforma_done;
    ")
    local bp cp bd cd
    IFS='|' read -r bp cp bd cd <<< "$queue"
    printf "  Build:    ${GREEN}%s analyzed${NC}  ${YELLOW}%s pending${NC}\n" "${bd:-0}" "${bp:-0}"
    printf "  Conforma: ${GREEN}%s analyzed${NC}  ${YELLOW}%s pending${NC}\n" "${cd:-0}" "${cp:-0}"
    echo ""

    # --- Enrichment Coverage ---
    echo -e "${BOLD}Enrichment Coverage${NC}"
    local enrich
    enrich=$(sql "
        SELECT
            COUNT(*) FILTER (WHERE commit_sha IS NOT NULL AND is_resolved = FALSE) as total,
            COUNT(*) FILTER (WHERE enriched_context IS NOT NULL) as enriched,
            COUNT(*) FILTER (WHERE enrichment_error IS NOT NULL) as failed
        FROM build_failures WHERE application = '$APPLICATION_NAME' AND commit_sha IS NOT NULL;
    ")
    local et ee ef
    IFS='|' read -r et ee ef <<< "$enrich"
    local epct=0
    if [ "${et:-0}" -gt 0 ]; then
        epct=$(( (${ee:-0} * 100) / ${et:-1} ))
    fi
    printf "  Enriched: ${GREEN}%s/%s${NC} (%s%%)  Failed: ${RED}%s${NC}\n" "${ee:-0}" "${et:-0}" "$epct" "${ef:-0}"
    echo ""

    # --- Pattern Library ---
    echo -e "${BOLD}Pattern Library${NC}"
    local patterns
    patterns=$(sql "
        SELECT
            COUNT(*) as total,
            COUNT(*) FILTER (WHERE avg_confidence IS NOT NULL) as with_conf,
            COALESCE(ROUND(AVG(avg_confidence)::numeric * 100), 0) as avg_pct,
            COALESCE(SUM(occurrence_count), 0) as total_occ
        FROM error_patterns;
    ")
    local pt pw pa po
    IFS='|' read -r pt pw pa po <<< "$patterns"
    printf "  Patterns: %s total (%s with confidence data)\n" "${pt:-0}" "${pw:-0}"
    printf "  Avg confidence: ${CYAN}%s%%${NC}  Total occurrences: %s\n" "${pa:-0}" "${po:-0}"
    local shared_count
    shared_count=$(sql "
        SELECT COUNT(DISTINCT ep.id)
        FROM error_patterns ep
        JOIN ai_analysis a ON a.error_pattern_id = ep.id
        LEFT JOIN build_failures bf ON bf.id = a.build_failure_id
        LEFT JOIN conforma_results cr ON cr.id = a.conforma_result_id
        GROUP BY ep.id
        HAVING COUNT(DISTINCT COALESCE(bf.application, cr.application)) >= 2;
    " 2>/dev/null | wc -l | tr -d ' ')
    if [ "${shared_count:-0}" -gt 0 ]; then
        printf "  Cross-app: ${CYAN}%s patterns${NC} shared across apps\n" "$shared_count"
    fi
    echo ""

    # --- Fix Outcomes ---
    echo -e "${BOLD}Fix Outcomes (last 30 days)${NC}"
    local fixes
    fixes=$(sql "
        SELECT
            COUNT(*) as total,
            COUNT(*) FILTER (WHERE was_successful = TRUE) as success,
            COUNT(*) FILTER (WHERE was_successful = FALSE) as failed,
            COUNT(*) FILTER (WHERE was_successful IS NULL AND status = 'pr_created') as pending
        FROM resolution_attempts
        WHERE attempted_at >= NOW() - INTERVAL '30 days';
    ")
    local ft fs ff fp
    IFS='|' read -r ft fs ff fp <<< "$fixes"
    local frate=0
    local resolved=$(( ${fs:-0} + ${ff:-0} ))
    if [ "$resolved" -gt 0 ]; then
        frate=$(( (${fs:-0} * 100) / resolved ))
    fi
    printf "  Total: %s  ${GREEN}Success: %s${NC}  ${RED}Failed: %s${NC}  Pending: %s\n" "${ft:-0}" "${fs:-0}" "${ff:-0}" "${fp:-0}"
    printf "  Success rate: ${CYAN}%s%%${NC}\n" "$frate"
    echo ""

    # --- API Costs ---
    echo -e "${BOLD}API Costs (last 30 days)${NC}"
    local costs
    costs=$(sql "
        SELECT
            COUNT(*) as analyses,
            COALESCE(SUM(tokens_used), 0) as tokens,
            ROUND(COALESCE(SUM(cost_usd), 0)::numeric, 2) as cost
        FROM ai_analysis
        WHERE analyzed_at >= NOW() - INTERVAL '30 days';
    ")
    local ca ct cc
    IFS='|' read -r ca ct cc <<< "$costs"
    printf "  Analyses: %s  Tokens: %s  Cost: ${CYAN}\$%s${NC}\n" "${ca:-0}" "${ct:-0}" "${cc:-0.00}"
    echo ""
}

