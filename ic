print()
can_fix = data.get('can_auto_fix', False)
print('Can Auto-Fix:   ' + ('YES' if can_fix else 'NO'))
review = data.get('requires_human_review', True)
print('Requires Review: ' + ('YES' if review else 'NO'))
" 2>/dev/null)

    if [ $? -ne 0 ]; then
