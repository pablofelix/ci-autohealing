# TRIAGE commands - focused on understanding failures

cmd_triage() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Triage Dashboard${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get current failing components (last build = failed)
    echo -e "${BOLD}Overview:${NC}"

    # Total records vs currently failing
    local total_records=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME';")
    local currently_failing=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name,
                status,
                is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds WHERE status = 'Failed' AND is_resolved = FALSE;
    ")
    local currently_working=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name,
                status
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds WHERE status = 'Succeeded';
    ")

    echo "  Total build records: $total_records"
    echo "  Currently failing: ${RED}$currently_failing${NC}"
    echo "  Currently working: ${GREEN}$currently_working${NC}"
    echo ""

    # Show only components that are CURRENTLY failing (last build = failed)
    echo -e "${BOLD}${RED}Currently Failing Components:${NC}"
    sql_table "
    WITH latest_builds AS (
        SELECT DISTINCT ON (component_name)
            component_name,
            pipelinerun_name,
            status,
            first_detected_at,
            build_logs IS NOT NULL as has_logs
        FROM build_failures
        WHERE application = '$APPLICATION_NAME'
        ORDER BY component_name, first_detected_at DESC
    )
    SELECT
        component_name as \"Component\",
        first_detected_at::date as \"Last Failure\",
        CASE WHEN has_logs THEN 'Yes' ELSE 'No' END as \"Has Logs\"
    FROM latest_builds
    WHERE status = 'Failed'
    ORDER BY first_detected_at DESC;
    "
    echo ""

    echo -e "${CYAN}Next Steps:${NC}"
    echo "  1. Pick a component from above"
    echo "  2. Run: ${BOLD}ic why <component>${NC} to see why it's failing"
    echo "  3. Run: ${BOLD}ic analyze <component>${NC} for deep analysis"
    echo "  4. Use: ${BOLD}ic working${NC} to see components that are currently working"
    echo ""
}

cmd_why() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic why <component-name>"
        echo ""
        echo "Example:"
        echo "  ic why odh-spark-operator-v3-4"
        exit 1
    fi

    # Check if component exists
    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        echo ""
        echo "Available components:"
        sql "SELECT DISTINCT component_name FROM build_failures ORDER BY component_name;" | head -10
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Why is $component failing?${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get latest PipelineRun
    local pr_data=$(sql "
        SELECT pipelinerun_name, repository_url, branch, first_detected_at
        FROM build_failures
        WHERE component_name = '$component'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [ -z "$pr_data" ]; then
        echo -e "${RED}No build failures found${NC}"
        exit 1
    fi

    IFS='|' read -r pr_name repo_url branch detected_at <<< "$pr_data"

    echo -e "${BOLD}Latest Failure:${NC}"
    echo "  PipelineRun: ${CYAN}$pr_name${NC}"
    echo "  Repository: $repo_url"
    echo "  Branch: $branch"
    echo "  Detected: $detected_at"
    echo ""

    # Get commit info and logs from DB
    local commit_data=$(sql "
        SELECT commit_sha, commit_url, konflux_logs_url, build_logs
        FROM build_failures
        WHERE pipelinerun_name = '$pr_name'
        LIMIT 1;
    ")

    if [ -n "$commit_data" ]; then
        IFS='|' read -r commit_sha commit_url log_url build_logs <<< "$commit_data"

        echo -e "${BOLD}========================================${NC}"
        echo -e "${BOLD}Commit Information${NC}"
        echo -e "${BOLD}========================================${NC}"
        echo ""
        if [ -n "$commit_sha" ] && [ "$commit_sha" != "" ]; then
            echo "  Commit SHA: ${CYAN}${commit_sha:0:8}${NC}"
        fi
        if [ -n "$commit_url" ] && [ "$commit_url" != "" ]; then
            echo "  Commit URL: ${CYAN}$commit_url${NC}"
        fi
        if [ -n "$log_url" ] && [ "$log_url" != "" ]; then
            echo "  Konflux UI: ${CYAN}$log_url${NC}"
        fi
        echo ""

        # Show log excerpt if available
        if [ -n "$build_logs" ] && [ ${#build_logs} -gt 500 ]; then
            echo -e "${BOLD}========================================${NC}"
            echo -e "${BOLD}Log Excerpt${NC}"
            echo -e "${BOLD}========================================${NC}"
            echo ""
            extract_error_context "$build_logs"
            echo ""
        else
            echo -e "${YELLOW}⚠ No logs available in database${NC}"
            echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
            echo ""
        fi
    fi

    echo -e "${CYAN}Next Steps:${NC}"
    echo "  • Use ${BOLD}ic describe component $component${NC} for full details"
    echo "  • Use ${BOLD}ic describe component $component --log${NC} for complete logs"
    echo ""
}

cmd_analyze() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic analyze <component-name>"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Deep Analysis: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Failure timeline
    echo -e "${BOLD}Failure Timeline (last 7 days):${NC}"
    sql_table "
    SELECT
        DATE(first_detected_at) as \"Date\",
        COUNT(*) as \"Failures\",
        COUNT(CASE WHEN build_logs IS NOT NULL THEN 1 END) as \"With Logs\"
    FROM build_failures
    WHERE component_name = '$component'
      AND first_detected_at > NOW() - INTERVAL '7 days'
    GROUP BY DATE(first_detected_at)
    ORDER BY DATE(first_detected_at) DESC;
    "
    echo ""

    # Repository info
    local repo_info=$(sql "
        SELECT DISTINCT repository_url, branch
        FROM build_failures
        WHERE component_name = '$component'
        LIMIT 1;
    " | head -1)

    if [ -n "$repo_info" ]; then
        IFS='|' read -r repo branch <<< "$repo_info"
        echo -e "${BOLD}Repository:${NC}"
        echo "  URL: $repo"
        echo "  Branch: $branch"
        echo ""
    fi

    # All recent failures
    echo -e "${BOLD}All Failures (recent):${NC}"
    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        first_detected_at::timestamp(0) as \"When\",
        CASE
            WHEN build_logs IS NOT NULL THEN 'Yes'
            ELSE 'No'
        END as \"Logs\"
    FROM build_failures
    WHERE component_name = '$component'
    ORDER BY first_detected_at DESC
    LIMIT 10;
    "
    echo ""

    # Pattern analysis
    local with_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")

    if [ "$with_logs" != "0" ]; then
        echo -e "${BOLD}Pattern Analysis:${NC}"

        # Count resource not found
        local resource_not_found=$(sql "
            SELECT COUNT(*)
            FROM build_failures
            WHERE component_name = '$component'
              AND build_logs LIKE '%resource not found%';
        ")

        if [ "$resource_not_found" != "0" ]; then
            echo "  - $resource_not_found failures show 'resource not found' (logs already archived)"
        fi

        # Sample error from latest
        local latest_error=$(sql "
            SELECT SUBSTRING(build_logs FROM 'ERROR[^\n]*')
            FROM build_failures
            WHERE component_name = '$component'
              AND build_logs IS NOT NULL
              AND build_logs LIKE '%ERROR%'
            ORDER BY first_detected_at DESC
            LIMIT 1;
        " | head -1)

        if [ -n "$latest_error" ] && [ "$latest_error" != "" ]; then
            echo "  - Sample error: $latest_error"
        fi
        echo ""
    fi

    echo -e "${CYAN}Recommendations:${NC}"
    if [ "$with_logs" = "0" ]; then
        echo "  1. ${BOLD}Fetch logs${NC} to understand failure reasons"
        echo "     python3 collectors/python/fetch_archived_logs.py"
    else
        echo "  1. ${BOLD}Review error patterns${NC} above"
        echo "  2. ${BOLD}Check latest failure${NC}: ic describe pr <pipelinerun>"
        echo "  3. ${BOLD}Compare with Konflux UI${NC} for full pipeline view"
    fi
    echo ""
}

cmd_errors() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic errors <component-name>"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Error Extraction: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get all logs for this component
    local logs=$(sql "
        SELECT build_logs
        FROM build_failures
        WHERE component_name = '$component'
          AND build_logs IS NOT NULL
        ORDER BY first_detected_at DESC;
    ")

    if [ -z "$logs" ]; then
        echo -e "${YELLOW}No logs available for this component${NC}"
        exit 0
    fi

    # Extract unique error patterns
    echo -e "${BOLD}Error Patterns:${NC}"
    echo "$logs" | grep -iE "error|fail|exception" | sort | uniq -c | sort -rn | head -10
    echo ""

    echo -e "${BOLD}Exit Codes:${NC}"
    echo "$logs" | grep -iE "exit code|exitcode" | head -5
    echo ""
}

# Main command router
case "${1:-}" in
    get)
        case "${2:-}" in
            components|component)
                if [ -n "$3" ]; then
                    cmd_get_component "$3"
                else
                    cmd_get_components
                fi
                ;;
            pipelineruns|pipelinerun|pr|failures)
                if [ -n "$3" ]; then
                    cmd_get_pipelinerun "$3"
                else
                    shift 2
                    cmd_get_pipelineruns "$@"
                fi
                ;;
            apps|applications|versions)
                cmd_get_apps
                ;;
            *) usage ;;
        esac
        ;;
    describe)
        case "${2:-}" in
            component) shift 2; cmd_describe_component "$@" ;;
            pipelinerun|pr) cmd_describe_pipelinerun "$3" ;;
            *) usage ;;
        esac
        ;;
    config)
        case "${2:-}" in
            set-app) cmd_config_set_app "$3" ;;
            "") cmd_config_show ;;
            *) usage ;;
        esac
        ;;
    apps|versions)
        cmd_get_apps
        ;;
    stats)
        case "${2:-}" in
            daily) cmd_stats_daily ;;
            resolved) cmd_stats_resolved ;;
            components) cmd_get_components ;;
            "") cmd_stats ;;
            *) usage ;;
        esac
        ;;
    triage)
        cmd_triage
        ;;
    why)
        cmd_why "$2"
        ;;
    analyze)
        cmd_analyze "$2"
        ;;
    errors)
        cmd_errors "$2"
        ;;
    resolved)
        cmd_resolved
        ;;
    working)
        cmd_working
        ;;
    history)
        cmd_history "$2"
        ;;
    db)
        case "${2:-}" in
            status) cmd_db_status ;;
            query) cmd_db_query "${@:3}" ;;
            *) usage ;;
        esac
        ;;
    # Backward compatibility
    build)
        case "${2:-}" in
            status) cmd_get_components ;;
            failures) shift 2; cmd_get_pipelineruns "$@" ;;
            get) cmd_get_pipelinerun "$3" ;;
            logs) cmd_describe_pipelinerun "$3" ;;
            *) usage ;;
        esac
        ;;
    component)
        case "${2:-}" in
            list) cmd_get_components ;;
            get) cmd_get_component "$3" ;;
            show) cmd_describe_component "$3" ;;
            *) usage ;;
        esac
        ;;
    help|--help|-h|"") usage ;;
    *)
        # Number shortcut
        if [[ "$1" =~ ^[0-9]+$ ]]; then
            cmd_describe_by_number "$@"
        else
            echo -e "${RED}Error: Unknown command: $1${NC}"
            echo ""
            usage
        fi
        ;;
esac
