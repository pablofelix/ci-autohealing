cmd_get_apps() {
    section_header "Available RHOAI Applications"
    echo ""

    local apps=$(oc get applications -n "$NAMESPACE" -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null | grep "${APPLICATION_NAME%%-v*}" | sort -V)

    if [ -z "$apps" ]; then
        echo -e "${YELLOW}⚠ Cluster unreachable — showing applications from database${NC}"
        echo ""
        apps=$(sql "SELECT DISTINCT application FROM build_failures ORDER BY application;" 2>/dev/null)
    fi

    if [ -z "$apps" ]; then
        echo -e "${YELLOW}No applications found${NC}"
        return 1
    fi

    local current="$APPLICATION_NAME"
    local count=0

    while IFS= read -r app; do
        [ -z "$app" ] && continue
        count=$((count + 1))
        local db_count=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$app';" 2>/dev/null)
        if [ "$app" = "$current" ]; then
            echo -e "  ${GREEN}✓ ${BOLD}$app${NC} ${CYAN}(current)${NC} — ${db_count:-0} records"
        else
            echo -e "    $app — ${db_count:-0} records"
        fi
    done <<< "$apps"

    echo ""
    echo "Total: $count applications"
    echo ""
    echo -e "${CYAN}Switch:${NC} ic config set-app <app-name>"
    echo ""
}

# DESCRIBE commands
cmd_describe_component() {
    local component="$1"
    local show_full_log=false
    local json_output=false

    # Parse options
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --log)
                show_full_log=true
                ;;
            --json)
                json_output=true
                ;;
        esac
        shift
    done

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic describe component <name> [--log]"
        return 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        if [ "$json_output" = true ]; then
            echo '{"error": "Component not found", "component": "'"$component"'"}'
        else
            echo -e "${RED}Error: Component not found: $component${NC}"
        fi
        return 1
    fi

    if [ "$json_output" = true ]; then
        sql_json "
            SELECT component_name AS component, pipelinerun_name, status,
                   repository_url, branch, failed_step_name AS failed_step,
                   error_type, LEFT(error_message, 500) AS error_message,
                   commit_sha, commit_author, LEFT(commit_message, 200) AS commit_message,
                   first_detected_at AS first_seen, last_updated_at AS last_seen,
                   CASE WHEN build_logs IS NOT NULL THEN true ELSE false END AS has_logs,
                   CASE WHEN ai_analysis_id IS NOT NULL THEN true ELSE false END AS has_analysis,
                   jira_key, output_image
            FROM build_failures
            WHERE component_name = '$component'
            ORDER BY first_detected_at DESC
            LIMIT 1
        "
        return
    fi

    section_header "Component: $component"
    echo ""

    # Summary
    local with_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")
    local first_failure=$(sql "SELECT MIN(first_detected_at) FROM build_failures WHERE component_name = '$component';")
    local latest_failure=$(sql "SELECT MAX(first_detected_at) FROM build_failures WHERE component_name = '$component';")

    subsection_header "Summary:"
    echo "  Total Failures: $total"
    echo "  Failures with Logs: $with_logs / $total"
    echo "  First Failure: $first_failure"
    echo "  Latest Failure: $latest_failure"
    echo ""

    # Get latest PipelineRun (including build_failure id for AI analysis matching)
    # Replace newlines in text fields to prevent IFS parsing issues
    local pr_data=$(sql "
        SELECT id, pipelinerun_name, pipelinerun_uid, status, repository_url, branch,
               CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END,
               COALESCE(konflux_logs_url, konflux_url),
               COALESCE(commit_sha, ''), COALESCE(commit_url, ''),
               COALESCE(commit_author, ''),
               COALESCE(REPLACE(REPLACE(LEFT(commit_message, 120), E'\n', ' '), E'\r', ''), ''),
               COALESCE(failed_step_name, ''), COALESCE(error_type, ''),
               COALESCE(REPLACE(REPLACE(LEFT(error_message, 200), E'\n', ' '), E'\r', ''), ''),
               COALESCE(build_duration_seconds::text, ''),
               COALESCE(jira_key, ''),
               COALESCE(output_image, ''),
               COALESCE(image_digest, ''),
               COALESCE(REPLACE(REPLACE(LEFT(task_summary, 120), E'\n', ' '), E'\r', ''), '')
        FROM build_failures
        WHERE component_name = '$component'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [ -n "$pr_data" ]; then
        IFS='|' read -r failure_id pr_name pr_uid status repo_url branch has_logs konflux_url \
            commit_sha commit_url commit_author commit_message \
            failed_step error_type error_message build_duration bf_jira_key \
            output_image image_digest task_summary_msg <<< "$pr_data"

        section_header "Latest PipelineRun"
        echo ""
        echo -e "${BOLD}PipelineRun:${NC} $pr_name"
        case "$status" in
            Cancelled) echo -e "${BOLD}Status:${NC} ${YELLOW}Cancelled${NC}" ;;
            Timeout)   echo -e "${BOLD}Status:${NC} ${YELLOW}Timeout${NC}" ;;
            *)         echo -e "${BOLD}Status:${NC} $status" ;;
        esac
        echo -e "${BOLD}Repository:${NC} $repo_url"
        echo -e "${BOLD}Branch:${NC} $branch"

        bf_jira_key=$(trim "$bf_jira_key")
        if [ -n "$bf_jira_key" ]; then
            echo -e "${BOLD}JIRA:${NC}        ${CYAN}${bf_jira_key}${NC} (${JIRA_URL}/browse/${bf_jira_key})"
        else
            echo -e "${BOLD}JIRA:${NC}        -"
        fi

        commit_sha=$(trim "$commit_sha")
        commit_url=$(trim "$commit_url")
        commit_author=$(trim "$commit_author")
        commit_message=$(trim "$commit_message")
        failed_step=$(trim "$failed_step")
        error_type=$(trim "$error_type")
        error_message=$(trim "$error_message")
        build_duration=$(trim "$build_duration")

        [ -n "$commit_sha" ] && echo -e "${BOLD}Commit:${NC}      ${commit_sha:0:8}"
        [ -n "$commit_author" ] && echo -e "${BOLD}Author:${NC}      $commit_author"
        [ -n "$commit_message" ] && echo -e "${BOLD}Message:${NC}     $commit_message"
        [ -n "$commit_url" ] && echo -e "${BOLD}Commit URL:${NC}  ${CYAN}$commit_url${NC}"

        output_image=$(trim "$output_image")
        image_digest=$(trim "$image_digest")
        task_summary_msg=$(trim "$task_summary_msg")

        if [ -n "$failed_step" ] || [ -n "$error_type" ]; then
            echo ""
            subsection_header "Failure Info:"
            [ -n "$failed_step" ] && echo -e "  Failed Step: ${RED}$failed_step${NC}"
            [ -n "$error_type" ] && echo -e "  Error Type:  $error_type"
            [ -n "$error_message" ] && echo -e "  Error:       $error_message"
            [ -n "$build_duration" ] && echo -e "  Duration:    ${build_duration}s"
            [ -n "$task_summary_msg" ] && echo -e "  Tasks:       $task_summary_msg"

            # If CONTEXT parameter error, extract Tekton config details
            if [[ "$error_message" =~ "CONTEXT parameter" ]]; then
                # Extract path-context using Python for proper YAML parsing
                local context_value=$(docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -tAc "
                    SELECT commit_context->'tekton_configs'->'${component}-push.yaml'
                    FROM build_failures
                    WHERE component_name = '$component' AND is_resolved = FALSE
                    ORDER BY first_detected_at DESC LIMIT 1
                " 2>/dev/null | python3 "$SCRIPT_DIR/parsers/parse_tekton_config.py" 2>/dev/null)

                if [ -n "$context_value" ]; then
                    echo ""
                    echo -e "  ${YELLOW}Tekton Config:${NC}"
                    echo -e "    path-context: ${RED}$context_value${NC}"
                    if [[ "$context_value" =~ ^\. ]]; then
                        echo -e "    ${YELLOW}⚠ Leading './' can cause buildah to reject the path${NC}"
                        echo -e "    ${CYAN}→ Fix: Remove './' prefix → ${context_value#./}${NC}"
                    fi
                fi
            fi
        fi

        if [ -n "$output_image" ]; then
            echo ""
            subsection_header "Build Output:"
            echo -e "  Image:  $output_image"
            [ -n "$image_digest" ] && echo -e "  Digest: ${image_digest:0:24}..."
        fi

        echo ""
        echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"

        # Quay image (derive from component naming convention)
        local quay_repo=$(echo "$repo_url" | sed 's|https://github.com/acme-org/||' | sed 's|\.git$||')
        if [ -n "$quay_repo" ]; then
            echo -e "${BOLD}Quay:${NC}       ${CYAN}https://quay.io/repository/${QUAY_ORG:-rhoai}/${component}${NC}"
        fi
        echo ""

        # Show logs if available
        if [ "$has_logs" = "Yes" ]; then
            local logs=$(sql "SELECT build_logs FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")
            local log_size=$(echo "$logs" | wc -c)

            if [ "$log_size" -gt 10 ]; then
                if [ "$show_full_log" = true ]; then
                    section_header "Build Logs (Full)"
                else
                    section_header "Build Logs"
                fi
                echo ""

                if [ "$show_full_log" = true ]; then
                    echo "$logs"
                else
                    # For short logs, show them directly
                    if [ "$log_size" -lt 1000 ]; then
                        echo "$logs"
                    else
                        # For long logs, extract context with error filtering
                        extract_error_context "$logs" "$failed_step"
                    fi

                    if [ "$log_size" -gt 1000 ]; then
                        echo ""
                        echo -e "${CYAN}💡 Tip: Add --log flag to see the complete build log${NC}"
                    fi
                fi
                echo ""
            else
                echo -e "${YELLOW}⚠ Logs available but empty${NC}"
                echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
                echo ""
            fi
        else
            echo -e "${CYAN}Fetching logs from cluster...${NC}"
            local fetch_result
            fetch_result=$(cd "$SCRIPT_DIR/src" && timeout 45 python3 fetch_logs.py "$pr_name" 2>/dev/null)
            if [ $? -eq 0 ] && [ -n "$fetch_result" ]; then
                local stored=$(echo "$fetch_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('stored',False))" 2>/dev/null)
                local log_len=$(echo "$fetch_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('logs_length',0))" 2>/dev/null)
                local log_src=$(echo "$fetch_result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('source',''))" 2>/dev/null)
                if [ "$stored" = "True" ]; then
                    echo -e "${CYAN}Fetched ${log_len} chars from ${log_src}${NC}"
                    # Re-read logs from DB
                    logs=$(sql "SELECT build_logs FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")
                    local log_size=$(echo "$logs" | wc -c)
                    if [ "$log_size" -gt 10 ]; then
                        section_header "Build Logs"
                        echo ""
                        if [ "$show_full_log" = true ]; then
                            echo "$logs"
                        elif [ "$log_size" -lt 1000 ]; then
                            echo "$logs"
                        else
                            extract_error_context "$logs" "$failed_step"
                            echo ""
                            echo -e "${CYAN}💡 Tip: Add --log flag to see the complete build log${NC}"
                        fi
                        echo ""
                    fi
                else
                    echo -e "${YELLOW}⚠ Logs fetched but not new (already stored)${NC}"
                fi
            else
                echo -e "${YELLOW}⚠ Could not fetch logs from cluster${NC}"
                echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
                echo ""
            fi
        fi

        # Build History from Tekton Results
        section_header "Build History (Tekton Results)"
        echo ""
        local history=$(cd "$SCRIPT_DIR/src" && $PYTHON get_build_history.py "$component" --limit 8 --type build 2>/dev/null)
        if [ -n "$history" ]; then
            while IFS='|' read -r h_ts h_status h_commit h_failed_task h_image h_pr_name; do
                h_ts=$(echo "$h_ts" | cut -c1-16 | tr 'T' ' ')
                case "$h_status" in
                    Succeeded) echo -e "  ${h_ts}  ${GREEN}✓ succeeded${NC}  (${h_commit})" ;;
                    Failed)    echo -e "  ${h_ts}  ${RED}✗ failed${NC}     (${h_failed_task:-unknown}, ${h_commit})" ;;
                    Cancelled) echo -e "  ${h_ts}  ${YELLOW}⊘ cancelled${NC}  (${h_commit})" ;;
                    Timeout)   echo -e "  ${h_ts}  ${YELLOW}⏱ timeout${NC}   (${h_commit})" ;;
                    *)         echo -e "  ${h_ts}  ? ${h_status}  (${h_commit})" ;;
                esac
            done <<< "$history"

            # Resolution status based on newest build
            local newest_status=$(echo "$history" | head -1 | cut -d'|' -f2)
            echo ""
            if [ "$newest_status" = "Succeeded" ]; then
                echo -e "  ${GREEN}Status: RESOLVED${NC} (latest build passed)"
            else
                echo -e "  ${RED}Status: FAILING${NC} (latest build: ${newest_status})"
            fi
        else
            echo -e "  ${YELLOW}No history available from Tekton Results${NC}"
        fi
        echo ""

        # Display AI analysis if available (matching this specific failure)
        display_ai_analysis "$component" "$failure_id" "build" "$commit_author"
    fi
}

