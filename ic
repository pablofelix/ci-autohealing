cmd_get_fixes() {
    local days="${1:-30}"
    [[ "$1" == "--all" ]] && days=3650

    section_header "Fix Resolution Attempts"
    echo -e "${BOLD}Application:${NC} ${CYAN}${APPLICATION_NAME}${NC}  |  Last ${days} day(s)"
    echo ""

    local count
    count=$(sql "
        SELECT COUNT(*)
        FROM resolution_attempts ra
        JOIN build_failures bf ON bf.id = ra.build_failure_id
        WHERE ra.attempted_at >= NOW() - INTERVAL '${days} days';
    " 2>/dev/null)

    if [ "${count:-0}" = "0" ]; then
        echo -e "${YELLOW}No fix attempts in the last ${days} days.${NC}"
        echo ""
        echo -e "${CYAN}Tip:${NC} Use 'ic fix <num>' to triage a failure and create a PR."
        return
    fi

    echo -e "${BOLD}Total:${NC} ${count} attempt(s)"
    echo ""

    sql_table "
    SELECT
        ra.id          AS \"ID\",
        bf.component_name AS \"Component\",
        CASE ra.status
            WHEN 'pr_created'  THEN 'PR open'
            WHEN 'success'     THEN '✓ Fixed'
            WHEN 'failed'      THEN '✗ Failed'
            WHEN 'abandoned'   THEN '~ Abandoned'
            ELSE ra.status
        END            AS \"Status\",
        CASE
            WHEN ra.was_successful = TRUE  THEN 'Yes'
            WHEN ra.was_successful = FALSE THEN 'No'
            ELSE '-'
        END            AS \"Build OK\",
        COALESCE('#' || ra.pr_number::text, '-') AS \"PR\",
        TO_CHAR(ra.attempted_at, 'DD Mon HH24:MI') AS \"Attempted\",
        COALESCE(TO_CHAR(ra.verified_at, 'DD Mon HH24:MI'), '-') AS \"Verified\"
    FROM resolution_attempts ra
    JOIN build_failures bf ON bf.id = ra.build_failure_id
    WHERE ra.attempted_at >= NOW() - INTERVAL '${days} days'
    ORDER BY ra.attempted_at DESC;
    "

    echo ""
    echo -e "${CYAN}Tip:${NC} PR links are stored in resolution_attempts.pr_url"
    echo -e "${CYAN}Tip:${NC} Use '--all' to see all time: ic get fixes --all"
    echo ""
}

cmd_fix() {
    local target="${1:-}"
    shift || true

    if [ -z "$target" ]; then
        echo -e "${RED}Usage: ic fix <num|component>${NC}"
        echo ""
        echo "Examples:"
        echo "  ic fix 1                     Triage failure #1 (interactive action menu)"
        echo "  ic fix odh-mlmd-grpc-server-v3-4"
        return 1
    fi

    require_db || return 1

    # Resolve target → component + failure_id + type (reuse export_jira pattern)
    local component="" export_type="" failure_id=""
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        local build_count
        build_count=$(sql "
            SELECT COUNT(*) FROM (
                SELECT DISTINCT ON (component_name) component_name
                FROM build_failures
                WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
                ORDER BY component_name, first_detected_at DESC
            ) sub;
        " 2>/dev/null)
        build_count=${build_count:-0}

        if [ "$target" -le "$build_count" ]; then
            export_type="build"
            local retriggered_json
            retriggered_json=$(sql_get_retriggered_json)
            component=$(sql_resolve_build_number "$target" "${retriggered_json:-[]}")
        else
            export_type="conforma"
            local conforma_offset=$((target - build_count - 1))
            component=$(sql_resolve_conforma_number "$conforma_offset")
        fi
    else
        component="$target"
        local has_build
        has_build=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)
        export_type=$( [ "${has_build:-0}" -gt 0 ] && echo "build" || echo "conforma" )
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component not found for: $target${NC}"
        return 1
    fi

    # Fetch failure_id and basic info
    local fix_data
    if [ "$export_type" = "build" ]; then
        fix_data=$(sql "
            SELECT b.id, b.error_type, b.failed_step_name,
                   TO_CHAR(b.first_detected_at, 'YYYY-MM-DD'),
                   EXTRACT(DAY FROM NOW() - b.first_detected_at)::int,
                   (SELECT COUNT(*) FROM build_failures WHERE component_name = b.component_name AND is_resolved = FALSE),
                   COALESCE(b.jira_key, '')
            FROM build_failures b
            WHERE b.component_name = '$component'
              AND b.application = '$APPLICATION_NAME'
              AND b.is_resolved = FALSE
            ORDER BY b.last_updated_at DESC
            LIMIT 1;
        " 2>/dev/null)
    else
        fix_data=$(sql "
            SELECT cr.id, cr.scenario, cr.violations_count::text,
                   TO_CHAR(cr.first_detected_at, 'YYYY-MM-DD'),
                   EXTRACT(DAY FROM NOW() - cr.first_detected_at)::int,
                   cr.violations_count,
                   COALESCE(cr.jira_key, '')
            FROM conforma_results cr
            WHERE cr.component_name = '$component'
              AND cr.application = '$APPLICATION_NAME'
              AND cr.is_resolved = FALSE
            ORDER BY cr.last_updated_at DESC
            LIMIT 1;
        " 2>/dev/null)
    fi

    local data_line
    data_line=$(echo "$fix_data" | tr '\n' ' ' | sed 's/  */ /g')
    IFS='|' read -r failure_id error_type failed_step first_seen days_failing occurrences linked_jira <<< "$data_line"
    failure_id=$(trim "$failure_id"); error_type=$(trim "$error_type")
    failed_step=$(trim "$failed_step"); days_failing=$(trim "$days_failing")
    occurrences=$(trim "$occurrences"); linked_jira=$(trim "$linked_jira")

    # Fetch AI analysis recommendation
    local ai_data
    if [ "$export_type" = "build" ]; then
        ai_data=$(sql "
            SELECT failure_category, ROUND(confidence_score * 100)::int,
                   can_auto_fix, requires_human_review, recommended_fix
            FROM ai_analysis
            WHERE build_failure_id = $failure_id
            ORDER BY created_at DESC
            LIMIT 1;
        " 2>/dev/null)
    else
        ai_data=$(sql "
            SELECT failure_category, ROUND(confidence_score * 100)::int,
                   can_auto_fix, requires_human_review, recommended_fix
            FROM ai_analysis
            WHERE conforma_result_id = $failure_id
            ORDER BY created_at DESC
            LIMIT 1;
        " 2>/dev/null)
    fi

    local ai_line
    ai_line=$(echo "$ai_data" | tr '\n' ' ' | sed 's/  */ /g')
    IFS='|' read -r ai_category ai_confidence ai_can_fix ai_human_review ai_rec_fix <<< "$ai_line"
    ai_category=$(trim "$ai_category"); ai_confidence=$(trim "$ai_confidence")
    ai_can_fix=$(trim "$ai_can_fix"); ai_rec_fix=$(trim "$ai_rec_fix")

    # Display header
    section_header "Fix Triage — ${component}"
    echo -e "${BOLD}Type:${NC}    ${export_type}"
    if [ "$export_type" = "build" ]; then
        echo -e "${BOLD}Error:${NC}   ${error_type:-unknown} at step ${failed_step:-unknown}"
    else
        echo -e "${BOLD}Error:${NC}   conforma violation in scenario '${error_type:-unknown}' (${failed_step:-0} violations)"
    fi
    echo -e "${BOLD}Age:${NC}     ${days_failing:-?} days (${occurrences:-?} occurrence(s))"
    echo ""

    if [ -n "$ai_category" ]; then
        echo -e "${BOLD}AI Analysis:${NC}"
        echo -e "  Category:   ${ai_category}"
        echo -e "  Confidence: ${ai_confidence}%"
        local can_fix_label="no"
        [ "$ai_can_fix" = "t" ] || [ "$ai_can_fix" = "true" ] && can_fix_label="yes"
        echo -e "  Can fix:    ${can_fix_label}"
        [ -n "$ai_rec_fix" ] && echo -e "  Fix hint:   $(echo "$ai_rec_fix" | head -c 120)"
        echo ""

        # Recommendation
        if [ "$ai_can_fix" = "t" ] || [ "$ai_can_fix" = "true" ]; then
            echo -e "${GREEN}Recommendation: [1] Generate PR fix  (confidence ${ai_confidence}%, auto-fixable)${NC}"
        else
            echo -e "${YELLOW}Recommendation: [2] Create Jira ticket  (needs human review)${NC}"
        fi
    else
        echo -e "${YELLOW}No AI analysis yet. Run: ic ai analyze ${target}${NC}"
        echo -e "${YELLOW}Recommendation: [2] Create Jira ticket${NC}"
    fi
    echo ""

    if [ "$export_type" = "conforma" ]; then
        # Conforma: Jira-first sequential flow
        echo -e "${BOLD}Action: Create Jira ticket${NC}"
        echo "(Conforma violations route to Jira for tracking. PR fix offered after.)"
        echo ""
        local jira_summary="Conforma violation: ${component} — ${error_type:-unknown} scenario (${failed_step:-0} violations)"
        export_jira "$component" "$export_type" | \
            $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                --mode jira \
                --component "$component" \
                --summary "$jira_summary"
        local jira_exit=$?

        # After Jira, offer automated PR fix when AI marks it auto-fixable
        if [ $jira_exit -eq 0 ] && ([ "$ai_can_fix" = "t" ] || [ "$ai_can_fix" = "true" ]); then
            echo ""
            printf "Also generate an automated PR fix? (category: ${ai_category:-unknown}) [y/N]: "
            read -r pr_choice
            if [ "$pr_choice" = "y" ] || [ "$pr_choice" = "Y" ]; then
                echo ""
                $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                    --mode pr \
                    --component "$component" \
                    --conforma-id "$failure_id" \
                    --application "$APPLICATION_NAME"
                local pr_exit=$?
                if [ $pr_exit -eq 0 ]; then
                    echo ""
                    printf "Push this PR to GitHub? [y/N]: "
                    read -r push_choice
                    if [ "$push_choice" = "y" ] || [ "$push_choice" = "Y" ]; then
                        $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                            --mode pr \
                            --component "$component" \
                            --conforma-id "$failure_id" \
                            --application "$APPLICATION_NAME" \
                            --execute
                    fi
                fi
            fi
        fi

        # Offer Slack after Jira
        echo ""
        printf "Send Slack notification? [y/N]: "
        read -r slack_choice
        if [ "$slack_choice" = "y" ] || [ "$slack_choice" = "Y" ]; then
            echo ""
            local slack_args=()
            [ -n "$linked_jira" ] && slack_args+=(--jira "$linked_jira")
            export_slack "$component" "$export_type" "${slack_args[@]}"
        fi
    else
        # Build failures: menu [1-4]
        echo -e "${BOLD}What do you want to do?${NC}"
        echo "  [1] Generate PR fix (dry-run — shows diff, no push)"
        echo "  [2] Create Jira ticket (review + edit before posting)"
        echo "  [3] Send Slack notification"
        echo "  [4] Skip"
        echo ""
        printf "Choice [1-4]: "
        read -r choice

        case "$choice" in
            1)
                echo ""
                $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                    --mode pr \
                    --component "$component" \
                    --failure-id "$failure_id" \
                    --application "$APPLICATION_NAME"
                local pr_exit=$?
                if [ $pr_exit -eq 0 ]; then
                    echo ""
                    printf "Create this PR on GitHub? [y/N]: "
                    read -r push_choice
                    if [ "$push_choice" = "y" ] || [ "$push_choice" = "Y" ]; then
                        $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                            --mode pr \
                            --component "$component" \
                            --failure-id "$failure_id" \
                            --application "$APPLICATION_NAME" \
                            --execute
                    fi
                fi
                ;;
            2)
                echo ""
                local jira_summary="Build failure: ${component} — ${error_type:-unknown} in ${failed_step:-unknown}"
                export_jira "$component" "$export_type" | \
                    $PYTHON "$SCRIPT_DIR/src/fixers/fix_generator.py" \
                        --mode jira \
                        --component "$component" \
                        --summary "$jira_summary"
                ;;
            3)
                echo ""
                local slack_args=()
                [ -n "$linked_jira" ] && slack_args+=(--jira "$linked_jira")
                export_slack "$component" "$export_type" "${slack_args[@]}"
                ;;
            4|"")
                echo "Skipped."
                ;;
            *)
                echo -e "${RED}Invalid choice.${NC}"
                return 1
                ;;
        esac
    fi
}

cmd_jira_link() {
    local component="${1:-}"
    local jira_key="${2:-}"

    if [ -z "$component" ] || [ -z "$jira_key" ]; then
        echo -e "${RED}Usage: ic jira link <component> <JIRA-KEY>${NC}"
        return 1
    fi

    # Check component exists in conforma_results or build_failures
    local conforma_count=$(sql "SELECT COUNT(*) FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE")
    local bf_count=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE")

    if [ "${conforma_count:-0}" = "0" ] && [ "${bf_count:-0}" = "0" ]; then
        echo -e "${RED}Error: No active violations or failures for '$component'${NC}"
        return 1
    fi

    # Verify ticket exists via Jira API (optional, graceful)
    local ticket_info
    ticket_info=$(jira_api GET "/rest/api/2/issue/$jira_key?fields=summary,status" 2>/dev/null)
    if echo "$ticket_info" | python3 "$SCRIPT_DIR/parsers/parse_jira_fields.py" summary 2>/dev/null; then
        local ticket_status
        ticket_status=$(echo "$ticket_info" | python3 "$SCRIPT_DIR/parsers/parse_jira_fields.py" status 2>/dev/null)
        echo -e "${GREEN}Ticket verified: $jira_key ($ticket_status)${NC}"
    else
        echo -e "${YELLOW}Warning: Could not verify ticket $jira_key (proceeding anyway)${NC}"
    fi

    # Update DB
    local updated=0
    if [ "${conforma_count:-0}" != "0" ]; then
        sql "UPDATE conforma_results SET jira_key = '$jira_key' WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE" >/dev/null
        updated=$((updated + conforma_count))
    fi
    if [ "${bf_count:-0}" != "0" ]; then
        sql "UPDATE build_failures SET jira_key = '$jira_key' WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE" >/dev/null
        updated=$((updated + bf_count))
    fi

    echo -e "${GREEN}Linked $jira_key → $component ($updated rows updated)${NC}"
}

cmd_get_jira() {
    local filter_key="${1:-}"

    local tickets=$(sql "
        SELECT DISTINCT jira_key, component_name, 'conforma' as source
        FROM conforma_results WHERE jira_key IS NOT NULL AND application = '$APPLICATION_NAME'
        UNION
        SELECT DISTINCT jira_key, component_name, 'build' as source
        FROM build_failures WHERE jira_key IS NOT NULL AND application = '$APPLICATION_NAME'
        ORDER BY 1
    ")

    if [ -z "$tickets" ]; then
        echo "No linked Jira tickets found."
        echo -e "${CYAN}→ Use 'ic jira link <component> <JIRA-KEY>' to link one${NC}"
        return
    fi

    printf "  ${BOLD}%-18s %-15s %-22s %-32s %-10s %-10s %s${NC}\n" "JIRA" "Status" "Assignee" "Component" "Source" "Updated" "Comments"
    printf "  %-18s %-15s %-22s %-32s %-10s %-10s %s\n" "----" "------" "--------" "---------" "------" "-------" "--------"

    echo "$tickets" | while IFS='|' read -r jira_key comp_name source; do
        jira_key=$(trim "$jira_key")
        comp_name=$(trim "$comp_name")
        source=$(trim "$source")

        [ -n "$filter_key" ] && [ "$jira_key" != "$filter_key" ] && continue

        local status="?" assignee="?" updated="?" comments="?"
        local info
        info=$(jira_api GET "/rest/api/2/issue/$jira_key?fields=status,assignee,updated,comment" 2>/dev/null)
        if [ -n "$info" ]; then
            local fields
            fields=$(echo "$info" | python3 "$SCRIPT_DIR/parsers/parse_jira_fields.py" status assignee updated comments 2>/dev/null)
            if [ -n "$fields" ]; then
                status=$(echo "$fields" | sed -n '1p')
                assignee=$(echo "$fields" | sed -n '2p')
                updated=$(echo "$fields" | sed -n '3p')
                comments=$(echo "$fields" | sed -n '4p')
            fi
        fi

        printf "  %-18s %-15s %-22s %-32s %-10s %-10s %s\n" "$jira_key" "$status" "$assignee" "$comp_name" "$source" "$updated" "$comments"
    done

    local inbox_count
    inbox_count=$(sql "SELECT COUNT(*) FROM jira_comment_drafts WHERE reviewed_at IS NULL" 2>/dev/null)
    inbox_count="${inbox_count:-0}"
    if [ "$inbox_count" -gt 0 ] 2>/dev/null; then
        echo ""
        echo -e "  ${BOLD}${inbox_count} unreviewed comment(s) in inbox${NC}  →  ${CYAN}ic jira inbox${NC}"
    fi
    echo ""
}

cmd_describe_jira() {
    local jira_key="${1:-}"
    local full_mode=false
    [ "${2:-}" = "--full" ] && full_mode=true

    if [ -z "$jira_key" ]; then
        echo -e "${RED}Usage: ic describe jira <JIRA-KEY> [--full]${NC}"
        return 1
    fi

    local info
    info=$(curl -s --max-time 30 -u "$JIRA_EMAIL:$JIRA_TOKEN" \
        "$JIRA_URL/rest/api/2/issue/$jira_key?fields=summary,description,status,assignee,priority,labels,components,comment,updated,created" 2>/dev/null)
    if [ -z "$info" ] || echo "$info" | grep -q '"errorMessages"'; then
        echo -e "${RED}Error: Could not fetch $jira_key${NC}"
        return 1
    fi

    local parsed
    parsed=$(echo "$info" | python3 "$SCRIPT_DIR/parsers/parse_jira.py" 2>/dev/null)

    if [ -z "$parsed" ]; then
        echo -e "${RED}Error: Failed to parse response for $jira_key${NC}"
        return 1
    fi

    local summary status priority assignee labels components created updated comment_count
    summary=$(echo "$parsed" | grep '^SUMMARY=' | cut -d= -f2-)
    status=$(echo "$parsed" | grep '^STATUS=' | cut -d= -f2-)
    priority=$(echo "$parsed" | grep '^PRIORITY=' | cut -d= -f2-)
    assignee=$(echo "$parsed" | grep '^ASSIGNEE=' | cut -d= -f2-)
    labels=$(echo "$parsed" | grep '^LABELS=' | cut -d= -f2-)
    components=$(echo "$parsed" | grep '^COMPONENTS=' | cut -d= -f2-)
    created=$(echo "$parsed" | grep '^CREATED=' | cut -d= -f2-)
    updated=$(echo "$parsed" | grep '^UPDATED=' | cut -d= -f2-)
    comment_count=$(echo "$parsed" | grep '^COMMENT_COUNT=' | cut -d= -f2-)
    local description_body
    description_body=$(echo "$parsed" | grep '^DESCRIPTION_BODY=' | cut -d= -f2-)

    section_header "$jira_key"
    echo ""
    echo -e "${BOLD}Summary:${NC}     $summary"
    echo -e "${BOLD}Status:${NC}      $status"
    echo -e "${BOLD}Priority:${NC}    $priority"
    echo -e "${BOLD}Assignee:${NC}    $assignee"
    echo -e "${BOLD}Labels:${NC}      $labels"
    echo -e "${BOLD}Components:${NC}  $components"
    echo -e "${BOLD}Created:${NC}     $created"
    echo -e "${BOLD}Updated:${NC}     $updated"
    echo -e "${BOLD}URL:${NC}         ${CYAN}${JIRA_URL}/browse/${jira_key}${NC}"

    if [ -n "$description_body" ]; then
        echo ""
        section_header "Description"
        echo ""
        if $full_mode; then
            echo "$description_body"
        else
            echo "${description_body:0:500}"
            [ ${#description_body} -gt 500 ] && echo -e "\n${CYAN}... (use --full to see complete description)${NC}"
        fi
    fi

    # Linked data from ic DB
    local db_data=$(sql "
        SELECT component_name, 'conforma' as source, violations_count, scenario
        FROM conforma_results
        WHERE jira_key = '$jira_key' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE
        UNION
        SELECT component_name, 'build' as source, 0, ''
        FROM build_failures
        WHERE jira_key = '$jira_key' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE
    " 2>/dev/null)

    if [ -n "$db_data" ]; then
        echo ""
        section_header "Linked in ic"
        echo ""
        echo "$db_data" | while IFS='|' read -r comp src vcount scen; do
            comp=$(trim "$comp")
            src=$(trim "$src")
            vcount=$(trim "$vcount")
            scen=$(trim "$scen")
            echo -e "${BOLD}Component:${NC}   $comp"
            echo -e "${BOLD}Source:${NC}       $src"
            [ "$src" = "conforma" ] && echo -e "${BOLD}Violations:${NC}  $vcount"
            [ -n "$scen" ] && echo -e "${BOLD}Scenario:${NC}    $scen"
        done
    fi

    # Comments
    if [ "${comment_count:-0}" != "0" ]; then
        echo ""
        section_header "Comments ($comment_count)"

        local in_comment=false
        local c_author="" c_date="" c_body=""
        echo "$parsed" | while IFS= read -r line; do
            case "$line" in
                COMMENT_AUTHOR=*)
                    c_author="${line#COMMENT_AUTHOR=}"
                    ;;
                COMMENT_DATE=*)
                    c_date="${line#COMMENT_DATE=}"
                    ;;
                COMMENT_BODY=*)
                    c_body="${line#COMMENT_BODY=}"
                    ;;
                COMMENT_END)
                    echo ""
                    echo -e "--- ${BOLD}$c_author${NC} ($c_date) ---"
                    if $full_mode; then
                        echo "$c_body"
                    else
                        echo "${c_body:0:300}"
                        [ ${#c_body} -gt 300 ] && echo -e "${CYAN}...${NC}"
                    fi
                    c_author="" c_date="" c_body=""
                    ;;
            esac
        done
    fi

    echo ""
}

cmd_jira_create() {
    local type="${1:-}"
    shift || true

    case "$type" in
        conforma) cmd_jira_create_conforma "$@" ;;
        *)
            echo -e "${RED}Usage: ic jira create conforma <component> [--execute]${NC}"
            return 1
            ;;
    esac
}

cmd_jira_create_conforma() {
    local component="${1:-}"
    local execute=false
    if [ "${2:-}" = "--execute" ]; then
        execute=true
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Usage: ic jira create conforma <component> [--execute]${NC}"
        return 1
    fi

    # Check for existing link
    local existing=$(sql "SELECT jira_key FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE AND jira_key IS NOT NULL LIMIT 1")
    if [ -n "$existing" ]; then
        echo -e "${YELLOW}Warning: $component already linked to $existing${NC}"
        echo -e "Use 'ic jira link $component <NEW-KEY>' to override"
        return 1
    fi

    # Fetch violation data (including is_future flag)
    # Order by violations_count DESC to prioritize the worst failure
    local data=$(sql "
        SELECT c.component_name, c.scenario,
               c.violations_count, c.warnings_count, c.successes_count,
               COALESCE(c.repository_url, ''), COALESCE(c.commit_sha, ''),
               c.pipelinerun_name, c.is_future
        FROM conforma_results c
        WHERE c.component_name = '$component'
          AND c.is_resolved = FALSE
          AND c.application = '$APPLICATION_NAME'
        ORDER BY c.violations_count DESC, c.last_updated_at DESC
        LIMIT 1;
    " 2>/dev/null)

    if [ -z "$data" ]; then
        echo -e "${RED}Error: No active Conforma violation for '$component'${NC}"
        return 1
    fi

    local data_oneline=$(echo "$data" | tr '\n' ' ' | sed 's/  */ /g')
    IFS='|' read -r comp_name scenario violations warnings successes repo_url commit_sha pr_name is_future <<< "$data_oneline"

    # Trim whitespace from parsed values
    is_future=$(echo "$is_future" | xargs)

    # Determine ticket prefix, priority, and labels based on is_future flag
    local ticket_prefix="BLOCKER"
    local jira_priority="Blocker"
    local jira_labels="conforma,conforma-blocker"

    if [ "$is_future" = "t" ] || [ "$is_future" = "true" ]; then
        ticket_prefix="FUTURE"
        jira_priority="Low"
        jira_labels="conforma,conforma-future"
    fi

    local summary="[Conforma/${ticket_prefix}] ${comp_name} - ${scenario} (${violations} violations)"

    # Generate description by reusing the export function output
    local description
    description=$(export_conforma_jira "$component" 2>/dev/null)

    if [ "$execute" = true ]; then
        echo -e "${BOLD}Creating Jira ticket...${NC}"

        # Build JSON payload (pass priority and labels via env vars)
        local payload
        payload=$(JIRA_PROJECT="$JIRA_PROJECT" JIRA_COMPONENT="$JIRA_COMPONENT" JIRA_SUMMARY="$summary" \
                  JIRA_PRIORITY="$jira_priority" JIRA_LABELS="$jira_labels" \
                  python3 "$SCRIPT_DIR/parsers/build_jira_payload.py" <<< "$description")

        local response
        response=$(jira_api POST "/rest/api/2/issue" "$payload")

        local new_key
        new_key=$(echo "$response" | python3 -c "import json,sys; print(json.load(sys.stdin)['key'])" 2>/dev/null)

        if [ -n "$new_key" ]; then
            sql "UPDATE conforma_results SET jira_key = '$new_key' WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE" >/dev/null
            echo -e "${GREEN}Created: $new_key${NC}"
            echo -e "URL: ${JIRA_URL}/browse/$new_key"
        else
            echo -e "${RED}Error creating ticket:${NC}"
            echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
            return 1
        fi
    else
        echo -e "${BOLD}[DRY RUN] Would create Jira ticket:${NC}"
        echo ""
        echo -e "  ${CYAN}Project:${NC}   $JIRA_PROJECT"
        echo -e "  ${CYAN}Type:${NC}      Bug"
        echo -e "  ${CYAN}Priority:${NC}  $jira_priority"
        echo -e "  ${CYAN}Labels:${NC}    $jira_labels"
        echo -e "  ${CYAN}Component:${NC} $JIRA_COMPONENT"
        echo -e "  ${CYAN}Summary:${NC}   $summary"
        echo ""
        if [ "$is_future" = "t" ] || [ "$is_future" = "true" ]; then
            echo -e "  ${YELLOW}Note: This is a FUTURE policy violation (informational, not blocking current releases)${NC}"
            echo ""
        fi
        echo -e "${BOLD}Description preview:${NC}"
        echo "$description" | head -30
        echo "..."
        echo ""
        echo -e "${YELLOW}→ Add --execute to actually create: ic jira create conforma $component --execute${NC}"
    fi
}

# Main command router
case "${1:-}" in
    get)
        case "${2:-}" in
            components|component)
                if [ -n "$3" ] && [[ "$3" != -* ]]; then
                    cmd_get_component "$3"
                else
                    cmd_get_components "${3:-}"
                fi
                ;;
            alerts)
                shift 2
                cmd_get_alerts "$@"
                ;;
            exceptions)
                cmd_get_exceptions
                ;;
            bindings)
                cmd_get_bindings
                ;;
            policy-gap|policygap|gap)
                cmd_get_policy_gap
                ;;
            conforma)
                cmd_get_conforma "${3:-}"
                ;;
            pipelineruns|pipelinerun|pr|failures)
                if [ -n "$3" ]; then
                    cmd_get_pipelinerun "$3"
                else
                    shift 2
                    cmd_get_pipelineruns "$@"
                fi
                ;;
            apps|applications|versions)
                cmd_get_apps
                ;;
            jira)
                cmd_get_jira "${3:-}"
                ;;
            fixes|fix-attempts)
                cmd_get_fixes "${3:-}"
                ;;
            releases|release)
                if [ -n "${3:-}" ] && [[ "${3:-}" != -* ]]; then
                    cmd_describe_release "$3" "${@:4}"
                else
                    shift 2
                    cmd_get_releases "$@"
                fi
                ;;
            vulnerabilities|cves|vuln)
                shift 2
                $PYTHON "$SCRIPT_DIR/src/cli/main.py" get vulnerabilities "$@"
                ;;
            *) usage ;;
        esac
        ;;
    describe)
        case "${2:-}" in
            component) shift 2; cmd_describe_component "$@" ;;
            conforma) shift 2; cmd_describe_conforma "$@" ;;
            pipelinerun|pr) cmd_describe_pipelinerun "$3" ;;
            jira) shift 2; cmd_describe_jira "$@" ;;
            release) shift 2; cmd_describe_release "$@" ;;
            *) usage ;;
        esac
        ;;
    config)
        case "${2:-}" in
            set-app) cmd_config_set_app "$3" "${4:-}" ;;
            "") cmd_config_show ;;
            *) usage ;;
        esac
        ;;
    apps|versions)
        cmd_get_apps
        ;;
    dashboard)
        cmd_dashboard
        ;;
    health)
        case "${2:-}" in
            warnings) cmd_health_warnings ;;
            "") cmd_health_overview ;;
            *) cmd_health_component "$2" ;;
        esac
        ;;
    stats)
        case "${2:-}" in
            daily) cmd_stats_daily ;;
            resolved) cmd_stats_resolved ;;
            components) cmd_get_components ;;
            "") cmd_stats ;;
            *) usage ;;
        esac
        ;;
    triage)
        cmd_triage
        ;;
    alerts)
        case "${2:-}" in
            check) cmd_alerts_check ;;
            *) cmd_alerts_check ;;
        esac
        ;;
    resolved)
        cmd_resolved
        ;;
    working)
        cmd_working
        ;;
    history)
        cmd_history "$2"
        ;;
    ai)
        shift
        cmd_ai "$@"
        ;;
    patterns)
        shift
        cmd_patterns "$@"
        ;;
    export)
        shift
        cmd_export "$@"
        ;;
    jira)
        shift
        case "${1:-}" in
            create) shift; cmd_jira_create "$@" ;;
            inbox)  shift; cmd_jira_inbox "$@" ;;
