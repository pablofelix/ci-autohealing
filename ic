#!/bin/bash

# IC (Infrastructure/CI) Command Line Tool
# kubectl-style interface for CI Auto-Healing system

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Delegate to Python CLI unless we're being called back from it
if [ "${IC_PYTHON_FALLBACK:-}" != "1" ]; then
    exec $PYTHON "$SCRIPT_DIR/ic.py" "$@"
fi

# Load configuration
if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    source "$SCRIPT_DIR/.env"
    set +a
fi

source "$SCRIPT_DIR/ic-config.sh"
source "$SCRIPT_DIR/ic-format.sh"
source "$SCRIPT_DIR/ic-queries.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Helper functions
_db_available=
_db_error_shown=
_check_db() {
    if [ -z "$_db_available" ]; then
        if docker exec "$DB_CONTAINER" pg_isready -q 2>/dev/null; then
            _db_available=1
        else
            _db_available=0
        fi
    fi
    if [ "$_db_available" = "0" ] && [ -z "$_db_error_shown" ]; then
        _db_error_shown=1
        echo "" >&2
        echo -e "${RED}Error: database is not running (${DB_CONTAINER})${NC}" >&2
        echo -e "${CYAN}Start it: docker start ${DB_CONTAINER}${NC}" >&2
        echo "" >&2
    fi
    [ "$_db_available" = "1" ]
}

sql() {
    _check_db || return 1
    docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -tAc "$1" 2>/dev/null
}

sql_table() {
    _check_db || return 1
    docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -c "$1" 2>/dev/null | grep -v "Emulate Docker"
}

sql_json() {
    _check_db || return 1
    local full_query="SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) FROM (${1}) t"
    docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -tAc "$full_query" 2>/dev/null
}

# Convert APPLICATION_NAME to conforma-reporter branch name
# product-v3-4 -> product-3.4, product-v3-4-ea-1 -> product-3.4-ea.1
app_to_reporter_branch() {
    local app="$1"
    local product="${app%%-v*}"
    local version="${app#*-v}"
    version=$(echo "$version" | sed 's/^\([0-9]\+\)-\([0-9]\+\)/\1.\2/')
    version=$(echo "$version" | sed 's/-ea-\([0-9]\+\)/-ea.\1/')
    echo "${product}-${version}"
}

# Convert scenario name to short label for display
conforma_scenario_label() {
    local scenario="$1"
    case "$scenario" in
        *-single-component) echo "single" ;;
        conforma-fbc-*)     echo "fbc" ;;
        conforma-custom-*)  echo "custom" ;;
        *-chart-*)          echo "chart" ;;
        csv-import)         echo "csv" ;;
        *)                  echo "-" ;;
    esac
}

# Jira API configuration
JIRA_URL="${JIRA_URL:-${JIRA_BASE_URL:-}}"
JIRA_EMAIL="${JIRA_EMAIL:-}"
JIRA_PROJECT="${JIRA_PROJECT:-}"
JIRA_COMPONENT="${JIRA_COMPONENT:-}"

jira_api() {
    local method="$1" endpoint="$2" data="${3:-}"
    if [ -z "${JIRA_TOKEN:-}" ]; then
        echo -e "${RED}Error: JIRA_TOKEN not set. Export it in ~/.bashrc or .env${NC}" >&2
        return 1
    fi
    if [ "$method" = "GET" ]; then
        curl -s --max-time 15 -u "$JIRA_EMAIL:$JIRA_TOKEN" "$JIRA_URL$endpoint"
    else
        curl -s --max-time 15 -X "$method" -u "$JIRA_EMAIL:$JIRA_TOKEN" \
            -H "Content-Type: application/json" -d "$data" "$JIRA_URL$endpoint"
    fi
}

# RHTAP (Konflux) component IDs on status.redhat.com
_RHTAP_COMPONENT_IDS="wblzm7qdp2f9 r3vl67rlz868 19kjb30pgzkn f8fdrnl3w06s nzsc9lfpy8ys 6hh38brjbpjj b94n21d6krbj 67cq73rt6pzz nyz5lznw8xhv yg906g8vzm3m"
_QUAY_COMPONENT_IDS="fvnvxz75h3m2 m65lxn2nf6l0 6fb8zflt4fbt"
_REGISTRY_COMPONENT_IDS="78htzl27599b trp61wc39x6l"

check_outages() {
    local cache_dir="/tmp/ic-outage-cache"
    mkdir -p "$cache_dir" 2>/dev/null
    local cache_file="${cache_dir}/incidents-$(date +%Y%m%d%H)"

    local incidents_json
    if [ -f "$cache_file" ]; then
        incidents_json=$(cat "$cache_file")
    else
        incidents_json=$(curl -sf --max-time 3 "https://status.redhat.com/api/v2/incidents/unresolved.json" 2>/dev/null) || return 1
        echo "$incidents_json" > "$cache_file" 2>/dev/null
    fi

    local all_ids="$_RHTAP_COMPONENT_IDS $_QUAY_COMPONENT_IDS $_REGISTRY_COMPONENT_IDS"
    echo "$incidents_json" | python3 -c "
import json, sys
ids = set('$all_ids'.split())
data = json.load(sys.stdin)
for inc in data.get('incidents', []):
    affected = {c['id'] for c in inc.get('components', [])}
    if affected & ids:
        impact = inc.get('impact', 'unknown')
        name = inc.get('name', 'Unknown incident')
        status = inc.get('status', 'unknown')
        updates = inc.get('incident_updates', [])
        latest = updates[0].get('body', '')[:120] if updates else ''
        comps = [c['name'] for c in inc.get('components', []) if c['id'] in ids]
        print(f\"{impact}|{name}|{status}|{', '.join(comps)}|{latest}\")
" 2>/dev/null
}

check_scheduled_maintenance() {
    local maint_json
    maint_json=$(curl -sf --max-time 3 "https://status.redhat.com/api/v2/scheduled-maintenances/upcoming.json" 2>/dev/null) || return 1
    local all_ids="$_RHTAP_COMPONENT_IDS $_QUAY_COMPONENT_IDS $_REGISTRY_COMPONENT_IDS"
    echo "$maint_json" | python3 -c "
import json, sys
ids = set('$all_ids'.split())
data = json.load(sys.stdin)
for m in data.get('scheduled_maintenances', []):
    affected = {c['id'] for c in m.get('components', [])}
    if affected & ids:
        name = m.get('name', '')
        start = m.get('scheduled_for', '')[:16]
        end = m.get('scheduled_until', '')[:16]
        print(f\"{name}|{start}|{end}\")
" 2>/dev/null
}

show_outage_banner() {
    local outages
    outages=$(check_outages 2>/dev/null)
    [ -z "$outages" ] && return

    while IFS='|' read -r impact name status comps latest; do
        [ -z "$name" ] && continue
        local icon="${YELLOW}⚠${NC}"
        [ "$impact" = "major" ] || [ "$impact" = "critical" ] && icon="${RED}⚠${NC}"
        echo -e "${icon} ${BOLD}Active Incident:${NC} ${name} [${status}]"
        [ -n "$comps" ] && echo -e "  Affected: ${comps}"
        [ -n "$latest" ] && echo -e "  ${DIM}${latest}${NC}"
    done <<< "$outages"

    local maint
    maint=$(check_scheduled_maintenance 2>/dev/null)
    if [ -n "$maint" ]; then
        while IFS='|' read -r mname mstart mend; do
            [ -z "$mname" ] && continue
            echo -e "${YELLOW}⚠ Scheduled Maintenance:${NC} ${mname} (${mstart} → ${mend})"
        done <<< "$maint"
    fi
    echo ""
}

show_freeze_banner() {
    local freeze
    freeze=$(sql_active_freeze 2>/dev/null)
    [ -z "$freeze" ] && return

    IFS='|' read -r reason start_date end_date <<< "$freeze"
    reason=$(trim "$reason"); start_date=$(trim "$start_date"); end_date=$(trim "$end_date")
    echo -e "${RED}❄ PIPELINE FROZEN${NC} until ${end_date} — ${reason}"

    local upcoming
    upcoming=$(sql_upcoming_freezes 7 2>/dev/null)
    if [ -n "$upcoming" ]; then
        while IFS='|' read -r ustart uend ureason; do
            ustart=$(trim "$ustart"); uend=$(trim "$uend"); ureason=$(trim "$ureason")
            [ -z "$ustart" ] && continue
            echo -e "  ${YELLOW}→ Upcoming:${NC} ${ustart} – ${uend} (${ureason})"
        done <<< "$upcoming"
    fi
    echo ""
}

# Fetch exception/exclusion rules from conforma-reporter GitHub repo (cached daily)
fetch_conforma_exceptions() {
    local app="$1"
    local branch=$(app_to_reporter_branch "$app")
    local cache_dir="/tmp/ic-conforma-cache"
    local cache_file="${cache_dir}/${branch}-exceptions-$(date +%Y%m%d)"

    mkdir -p "$cache_dir"

    if [ -f "$cache_file" ] && [ "${CONFORMA_NO_CACHE:-false}" != "true" ]; then
        cat "$cache_file"
        return
    fi

    local exceptions=""
    for yaml_file in conforma-exceptions-components.yaml conforma-exclusions-components.yaml; do
        local content
        content=$(gh api "repos/acme-org/conforma-reporter/contents/${yaml_file}?ref=${branch}" 2>/dev/null \
            | jq -r '.content // empty' 2>/dev/null | base64 -d 2>/dev/null)
        if [ -n "$content" ]; then
            local rules
            rules=$(echo "$content" | grep '^ *- "' | sed 's/^ *- "//;s/".*//')
            exceptions="${exceptions}${rules}"$'\n'
        fi
    done

    echo "$exceptions" | sort -u | grep -v '^$' | tee "$cache_file"
}

# Fetch raw YAML from all 4 GitLab EnterpriseContractPolicy files (cached daily)
# Shared by fetch_gitlab_exceptions and fetch_expiring_exceptions
fetch_gitlab_policy_yaml() {
    local cache_dir="/tmp/ic-conforma-cache"
    local cache_file="${cache_dir}/gitlab-yaml-$(date +%Y%m%d)"

    mkdir -p "$cache_dir"

    if [ -f "$cache_file" ] && [ "${CONFORMA_NO_CACHE:-false}" != "true" ]; then
        cat "$cache_file"
        return
    fi

    local gitlab_api="$GITLAB_API_BASE"
    local policy_files=("${GITLAB_POLICY_FILES[@]}")

    local all_yaml=""
    for pf in "${policy_files[@]}"; do
        local raw
        raw=$(curl -s --max-time 10 "${gitlab_api}/${pf}/raw?ref=main" 2>/dev/null)
        if [ -n "$raw" ]; then
            local fname
            fname=$(echo "$pf" | sed 's/.*%2F//')
            all_yaml="${all_yaml}"$'\n'"# __FILE__:${fname}"$'\n'"${raw}"
        fi
    done

    if [ -n "$all_yaml" ]; then
        echo "$all_yaml" | tee "$cache_file"
    fi
}

# Fetch active (non-expired) exception rule names (K8s API primary, GitLab fallback)
# Returns newline-separated rule names (value field before ":")
fetch_gitlab_exceptions() {
    local cache_dir="/tmp/ic-conforma-cache"
    local cache_file="${cache_dir}/gitlab-rules-$(date +%Y%m%d)"

    mkdir -p "$cache_dir"

    if [ -f "$cache_file" ] && [ "${CONFORMA_NO_CACHE:-false}" != "true" ]; then
        cat "$cache_file"
        return
    fi

    # Try K8s API first (faster, covers all 6 policies)
    local k8s_data
    k8s_data=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action exceptions --name-filter ${APPLICATION_NAME%%-v*} 2>/dev/null || true)
    if [ -n "$k8s_data" ] && echo "$k8s_data" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        echo "$k8s_data" | jq -r '.exceptions[].value' | cut -d: -f1 | sort -u | tee "$cache_file"
        return
    fi

    # Fallback to GitLab
    local all_yaml
    all_yaml=$(fetch_gitlab_policy_yaml)
    [ -z "$all_yaml" ] && return

    python3 "$SCRIPT_DIR/parsers/parse_gitlab_exceptions.py" <<< "$all_yaml" 2>/dev/null | tee "$cache_file"
}

# Check if a component's violations are covered by exceptions
# Args: violation_summary, github_exceptions, gitlab_exceptions
# Returns: YES, PARTIAL (github), PARTIAL (gitlab), NO, or UNKNOWN
check_exception_status() {
    local violation_summary="$1"
    local gh_exceptions="$2"
    local gl_exceptions="${3:-}"

    # Extract rule names only from violation lines (✕ [Violation] rule.name)
    local rules
    rules=$(echo "$violation_summary" | grep -oP '(?<=[✕✗] \[Violation\] )[a-z_]+\.[a-z_]+' 2>/dev/null | sort -u)

    [ -z "$rules" ] && echo "UNKNOWN" && return

    local total=0
    local gh_covered=0
    local gl_covered=0
    while IFS= read -r rule; do
        [ -z "$rule" ] && continue
        total=$((total + 1))
        if [ -n "$gh_exceptions" ] && echo "$gh_exceptions" | grep -q "^${rule}"; then
            gh_covered=$((gh_covered + 1))
        fi
        if [ -n "$gl_exceptions" ] && echo "$gl_exceptions" | grep -q "^${rule}"; then
            gl_covered=$((gl_covered + 1))
        fi
    done <<< "$rules"

    if [ "$total" -eq 0 ]; then echo "UNKNOWN"; return; fi

    local gh_full=false gl_full=false
    [ "$gh_covered" -eq "$total" ] && gh_full=true
    [ "$gl_covered" -eq "$total" ] && gl_full=true

    # Label shows where exceptions EXIST (not where the gap is)
    if [ "$gh_full" = true ] && [ "$gl_full" = true ]; then
        echo "YES"
    elif [ "$gh_full" = true ] && [ "$gl_full" = false ]; then
        echo "PARTIAL (github)"
    elif [ "$gl_full" = true ] && [ "$gh_full" = false ]; then
        echo "PARTIAL (gitlab)"
    elif [ "$gh_covered" -gt 0 ] || [ "$gl_covered" -gt 0 ]; then
        local sources=""
        [ "$gh_covered" -gt 0 ] && sources="github"
        [ "$gl_covered" -gt 0 ] && { [ -n "$sources" ] && sources="${sources}+gitlab" || sources="gitlab"; }
        echo "PARTIAL (${sources})"
    else
        echo "NO"
    fi
}

# Extract EC policy name from a conforma scenario
# conforma-registry-product-prod-v3-4-single-component → registry-product-prod
extract_policy_from_scenario() {
    local scenario="$1"
    local its_cache="/tmp/ic-its-cache/scenarios-${APPLICATION_NAME}"
    if [ -f "$its_cache" ]; then
        local policy
        policy=$(grep "^${scenario}|" "$its_cache" 2>/dev/null | cut -d'|' -f2)
        if [ -n "$policy" ]; then
            echo "$policy"
            return
        fi
    fi
    echo "$scenario" | sed 's/^conforma-//; s/-v[0-9].*$//'
}

refresh_its_cache() {
    local cache_dir="/tmp/ic-its-cache"
    local cache_file="${cache_dir}/scenarios-${APPLICATION_NAME}"
    mkdir -p "$cache_dir"
    local its_json
    its_json=$(cd "$SCRIPT_DIR/src" && $PYTHON its_scenario_data.py --action list --namespace "$NAMESPACE" --app-filter "$APPLICATION_NAME" 2>/dev/null || true)
    [ -z "$its_json" ] && return 1
    echo "$its_json" | jq -r '.scenarios[] | select(.policy_ref != "") | "\(.name)|\(.policy_ref | split("/") | last)|\(if .is_disabled then "disabled" else "active" end)"' > "$cache_file" 2>/dev/null
}

# Fetch full K8s exception data (cached daily)
# Returns pipe-delimited: value|source_policy|gitlab_link
fetch_k8s_exceptions_full() {
    local cache_dir="/tmp/ic-conforma-cache"
    local cache_file="${cache_dir}/k8s-exc-full-$(date +%Y%m%d)"

    mkdir -p "$cache_dir"

    if [ -f "$cache_file" ] && [ "${CONFORMA_NO_CACHE:-false}" != "true" ]; then
        cat "$cache_file"
        return
    fi

    local k8s_data
    k8s_data=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action exceptions --name-filter ${APPLICATION_NAME%%-v*} 2>/dev/null || true)
    if [ -n "$k8s_data" ] && echo "$k8s_data" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        echo "$k8s_data" | jq -r '.exceptions[] | "\(.value)|\(.source_policy)|\(.gitlab_link)|\(.reference // "")"' | tee "$cache_file"
        return
    fi

    echo ""
}

# Enhanced exception matching with policy-aware and cross-policy checks
# Args: violation_summary, gh_exceptions (newline list), k8s_full_exceptions (4-field pipe: value|policy|gl_link|reference)
# Optional: scenario (to filter to specific policy)
# Returns: status|jira_ref|gitlab_link (pipe-delimited)
exc_matches_rule() {
    local exc_list="$1"
    local rule="$2"
    [ -z "$exc_list" ] && return 1
    local category="${rule%%.*}"
    echo "$exc_list" | grep -q "^${rule}[:|]" && return 0
    echo "$exc_list" | grep -q "^${category}[|]" && return 0
    return 1
}

exc_find_match() {
    local exc_list="$1"
    local rule="$2"
    [ -z "$exc_list" ] && return
    local category="${rule%%.*}"
    echo "$exc_list" | grep -E "^${rule}[:|]|^${category}[|]" | head -1
}

map_rule_to_category() {
    case "${1%%.*}" in
        cve)                   echo "CVE" ;;
        base_image_registries) echo "Base Image" ;;
        trusted_task)          echo "Trusted Task" ;;
        sbom_spdx)             echo "SBOM" ;;
        rpm_repos)             echo "RPM" ;;
        not_useful)            echo "Deprecated" ;;
        slsa_provenance_available) echo "SLSA" ;;
        java)                  echo "Java" ;;
        labels)                echo "Labels" ;;
        *)                     echo "Other" ;;
    esac
}

categorize_violation_summary() {
    local vsummary="$1"
    [ -z "$vsummary" ] && return
    local rules
    rules=$(echo "$vsummary" | grep -oP '(?<=[✕✗] \[Violation\] )[a-z_]+\.[a-z_]+' 2>/dev/null | sort -u)
    [ -z "$rules" ] && return

    declare -A cat_counts
    while IFS= read -r rule; do
        [ -z "$rule" ] && continue
        local cat
        cat=$(map_rule_to_category "$rule")
        cat_counts[$cat]=$(( ${cat_counts[$cat]:-0} + 1 ))
    done <<< "$rules"

    local result=""
    for cat in $(echo "${!cat_counts[@]}" | tr ' ' '\n' | sort); do
        [ -n "$result" ] && result="${result}  "
        result="${result}${cat}:${cat_counts[$cat]}"
    done
    echo "$result"
}

check_exception_status_v2() {
    local violation_summary="$1"
    local gh_exceptions="$2"
    local k8s_full="${3:-}"
    local scenario="${4:-}"

    local _EXC_JIRA_REF=""
    local _EXC_GL_LINK=""

    local rules
    rules=$(echo "$violation_summary" | grep -oP '(?<=[✕✗] \[Violation\] )[a-z_]+\.[a-z_]+' 2>/dev/null | sort -u)
    [ -z "$rules" ] && echo "UNKNOWN||" && return

    local policy=""
    [ -n "$scenario" ] && policy=$(extract_policy_from_scenario "$scenario")

    local total=0
    local gh_covered=0
    local k8s_covered=0
    local k8s_other_covered=0
    local other_policies=""
    while IFS= read -r rule; do
        [ -z "$rule" ] && continue
        total=$((total + 1))

        if [ -n "$gh_exceptions" ] && echo "$gh_exceptions" | grep -q "^${rule}"; then
            gh_covered=$((gh_covered + 1))
        fi

        if [ -n "$k8s_full" ]; then
            local matched=false
            local filtered_exc="$k8s_full"
            [ -n "$policy" ] && filtered_exc=$(echo "$k8s_full" | grep "|${policy}|" || true)

            if exc_matches_rule "$filtered_exc" "$rule"; then
                matched=true
                if [ -z "$_EXC_JIRA_REF" ]; then
                    local m_line
                    m_line=$(exc_find_match "$filtered_exc" "$rule")
                    _EXC_JIRA_REF=$(echo "$m_line" | cut -d'|' -f4)
                    _EXC_GL_LINK=$(echo "$m_line" | cut -d'|' -f3)
                fi
            fi
            [ "$matched" = true ] && k8s_covered=$((k8s_covered + 1))

            if [ "$matched" = false ] && [ -n "$policy" ]; then
                local other_exc
                other_exc=$(echo "$k8s_full" | grep -v "|${policy}|" || true)
                if exc_matches_rule "$other_exc" "$rule"; then
                    k8s_other_covered=$((k8s_other_covered + 1))
                    local other_match
                    other_match=$(exc_find_match "$other_exc" "$rule")
                    local op
                    op=$(echo "$other_match" | cut -d'|' -f2 | sed 's/registry-[a-z]*-chart-/ch-/; s/registry-[a-z]*-/reg-/; s/fbc-[a-z]*-/fbc-/; s/stage/stg/')
                    if [ -n "$op" ] && [ -z "$other_policies" ]; then
                        other_policies="$op"
                    fi
                    if [ -z "$_EXC_JIRA_REF" ]; then
                        _EXC_JIRA_REF=$(echo "$other_match" | cut -d'|' -f4)
                        _EXC_GL_LINK=$(echo "$other_match" | cut -d'|' -f3)
                    fi
                fi
            fi
        fi
    done <<< "$rules"

    [ "$total" -eq 0 ] && echo "UNKNOWN||" && return

    local gh_full=false k8s_full_match=false
    [ "$gh_covered" -eq "$total" ] && gh_full=true
    [ "$k8s_covered" -eq "$total" ] && k8s_full_match=true

    local status=""
    if [ "$gh_full" = true ] && [ "$k8s_full_match" = true ]; then
        status="YES"
    elif [ "$gh_full" = true ] && [ "$k8s_full_match" = false ]; then
        status="PARTIAL (github)"
    elif [ "$k8s_full_match" = true ] && [ "$gh_full" = false ]; then
        status="YES (policy)"
    elif [ "$gh_covered" -gt 0 ] || [ "$k8s_covered" -gt 0 ]; then
        local sources=""
        [ "$gh_covered" -gt 0 ] && sources="github"
        [ "$k8s_covered" -gt 0 ] && { [ -n "$sources" ] && sources="${sources}+policy" || sources="policy"; }
        status="PARTIAL (${sources})"
    elif [ "$k8s_other_covered" -gt 0 ]; then
        status="NO (in ${other_policies})"
    else
        status="NO"
    fi
    echo "${status}|${_EXC_JIRA_REF}|${_EXC_GL_LINK}"
}

# Fetch expiring Conforma exceptions (K8s API primary, GitLab fallback)
# Returns deduplicated lines: days_left|effectiveUntil|value|imageUrl|reference|source|gitlab_link
fetch_expiring_exceptions() {
    local days_window="${1:-21}"
    local cache_dir="/tmp/ic-conforma-cache"
    local cache_file="${cache_dir}/gitlab-expiring-$(date +%Y%m%d)"

    mkdir -p "$cache_dir"

    if [ -f "$cache_file" ] && [ "${CONFORMA_NO_CACHE:-false}" != "true" ]; then
        cat "$cache_file"
        return
    fi

    # Try K8s API first (faster, covers all 6 policies)
    local k8s_data
    k8s_data=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action expiring --name-filter ${APPLICATION_NAME%%-v*} --days "$days_window" 2>/dev/null || true)
    if [ -n "$k8s_data" ] && echo "$k8s_data" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        echo "$k8s_data" | jq -r '.exceptions[] | "\(.days_left)|\(.effectiveUntil[:10])|\(.value)|\(.imageUrl // "")|\(.reference // "")|\(.source_policy)|\(.gitlab_link)"' | tee "$cache_file"
        return
    fi

    # Fallback to GitLab
    local all_yaml
    all_yaml=$(fetch_gitlab_policy_yaml)
    [ -z "$all_yaml" ] && return

    python3 "$SCRIPT_DIR/parsers/parse_expiring_exceptions.py" <<< "$all_yaml" 2>/dev/null | tee "$cache_file"
}

# Find the earliest expiring exception date for a component
# Args: component_name, violation_summary, expiring_data (pipe-delimited lines from fetch_expiring_exceptions)
# Returns: "YYYY-MM-DD (Nd)" or "-"
find_component_expiry() {
    local comp_name="$1"
    local vsummary="$2"
    local exp_data="$3"

    [ -z "$exp_data" ] && echo "-" && return

    # Extract violation rule names from summary
    local rules
    rules=$(echo "$vsummary" | grep -oP '(?<=[✕✗] \[Violation\] )[a-z_]+\.[a-z_]+' 2>/dev/null | sort -u)
    [ -z "$rules" ] && echo "-" && return

    # Derive image pattern from component name: odh-spark-operator-v3-4 -> odh-spark-operator
    local image_stem
    image_stem=$(echo "$comp_name" | sed 's/-v[0-9]\+.*$//')

    local earliest_date=""
    local earliest_days=999999

    while IFS='|' read -r days_left eff_until value image_url reference source gl_link; do
        [ -z "$days_left" ] && continue
        [ "$days_left" -lt 0 ] && continue

        local exc_rule="${value%%:*}"

        local matched=false
        while IFS= read -r rule; do
            [ -z "$rule" ] && continue
            if [ "$rule" = "$exc_rule" ]; then
                if [ -z "$image_url" ]; then
                    matched=true
                    break
                elif echo "$image_url" | grep -q "$image_stem"; then
                    matched=true
                    break
                fi
            fi
        done <<< "$rules"

        if [ "$matched" = true ] && [ "$days_left" -lt "$earliest_days" ]; then
            earliest_days=$days_left
            earliest_date=$eff_until
        fi
    done <<< "$exp_data"

    if [ -n "$earliest_date" ]; then
        echo "${earliest_date} (${earliest_days}d)"
    else
        echo "-"
    fi
}

# Part 1: Display AI analysis in describe commands
display_ai_analysis() {
    local component="$1"
    local record_id="$2"
    local type="${3:-build}"
    local commit_author="${4:-}"

    local fk_column="build_failure_id"
    local type_label="component"
    [ "$type" = "conforma" ] && fk_column="conforma_result_id" && type_label="conforma"

    local query="
        SELECT a.failure_category, ROUND(a.confidence_score * 100),
               REPLACE(a.root_cause, '|', '¦'),
               REPLACE(a.recommended_fix, '|', '¦'),
               REPLACE(COALESCE(array_to_string(a.recommended_files, ', '), ''), '|', '¦'),
               a.can_auto_fix, a.requires_human_review,
               TO_CHAR(a.analyzed_at, 'YYYY-MM-DD HH24:MI:SS'),
               COALESCE(a.langfuse_trace_url, ''),
               COALESCE(EXTRACT(DAY FROM (NOW() - a.analyzed_at))::int::text, '0')
        FROM ai_analysis a
        WHERE a.${fk_column} = '$record_id'
        ORDER BY a.analyzed_at DESC
        LIMIT 1
    "

    local analysis=$(sql "$query" 2>/dev/null)

    if [ -n "$analysis" ]; then
        local analysis_temp=$(echo "$analysis" | awk 'BEGIN{RS=""; ORS="¶"} {gsub(/\n/," "); print}' | sed 's/¶$//')
        IFS='|' read -r category confidence root_cause recommended_fix recommended_files \
            can_auto_fix requires_review analyzed_at trace_url days_old <<< "$analysis_temp"
        root_cause=$(echo "$root_cause" | sed $'s/¶/\\\n\\\n/g')
        recommended_fix=$(echo "$recommended_fix" | sed $'s/¶/\\\n\\\n/g')

        category=$(trim "$category")
        confidence=$(trim "$confidence")
        can_auto_fix=$(trim "$can_auto_fix")
        requires_review=$(trim "$requires_review")
        days_old=$(trim "$days_old"); [ -z "$days_old" ] && days_old="0"

        section_header "AI Analysis"
        echo ""
        printf "Category:       %s\n" "$category"
        printf "Confidence:     %s%%\n" "$confidence"

        if [ -n "$commit_author" ] && [ "$commit_author" != "" ]; then
            printf "Commit Author:  %s\n" "$commit_author"
        fi

        echo ""
        subsection_header "Root Cause:"
        echo "$root_cause" | sed 's/^/  /'
        echo ""
        subsection_header "Recommended Fix:"
        echo "$recommended_fix" | sed 's/^/  /'

        if [ -n "$recommended_files" ] && [ "$recommended_files" != "" ]; then
            echo ""
            subsection_header "Files to modify:"
            echo "$recommended_files" | sed 's/^/  /'
        fi

        echo ""
        printf "Can Auto-Fix:   %s\n" "$([ "$can_auto_fix" = "t" ] && echo "YES" || echo "NO")"
        printf "Requires Review: %s\n" "$([ "$requires_review" = "t" ] && echo "YES" || echo "NO")"
        printf "Analyzed:       %s\n" "$analyzed_at"

        if [ "${confidence:-0}" -lt 60 ] 2>/dev/null && [ -n "$commit_author" ]; then
            echo ""
            echo -e "${YELLOW}⚠ Low confidence (${confidence}%) - consider asking ${commit_author} about their changes${NC}"
        fi

        if [ "${days_old:-0}" -gt 7 ] 2>/dev/null; then
            echo ""
            echo -e "${YELLOW}[!] Analysis is $days_old days old (may be outdated)${NC}"
            echo -e "${YELLOW}[!] Re-analyze: ic ai analyze $type_label $component${NC}"
        fi

        if [ -n "$trace_url" ] && [ "$trace_url" != "" ]; then
            echo ""
            echo -e "Trace: ${CYAN}$trace_url${NC}"
        fi

        echo ""
        echo -e "${CYAN}[!] Export to Jira: ic export $type_label $component jira${NC}"
        echo ""
    else
        echo -e "${YELLOW}[!] AI analysis not available${NC}"
        echo -e "${CYAN}[!] Run: ic ai analyze $type_label $component${NC}"
        echo ""
    fi
}

# Extract error context from logs
extract_error_context() {
    local logs="$1"
    local failed_step="${2:-}"
    local context_lines=5

    local tmp_file=$(mktemp)
    local out_file=$(mktemp)
    echo "$logs" > "$tmp_file"

    local total_lines=$(wc -l < "$tmp_file")

    # If we know the failed step, try to extract just that TaskRun section
    if [ -n "$failed_step" ]; then
        local section_file=$(mktemp)
        # Extract the TaskRun section matching the failed step
        awk -v step="$failed_step" '
            /^===== TaskRun:/ { in_section = (index($0, step) > 0) }
            in_section { print }
        ' "$tmp_file" > "$section_file"

        local section_size=$(wc -l < "$section_file")
        if [ "$section_size" -gt 10 ]; then
            echo -e "${YELLOW}━━━ Failed step: ${failed_step} (${section_size} lines from ${total_lines} total) ━━━${NC}"
            echo ""
            cat "$section_file" > "$tmp_file"
            total_lines=$section_size
        fi
        rm -f "$section_file"
    fi

    # Match lines that look like real error output (timestamps, STEP markers, runtime messages)
    # not bash source code (if/then/echo/exit stanzas from inlined scripts)
    local error_pattern='\[.*\].*([Ee]rror|[Ff]ailed|[Ff]atal|[Ww]arning|denied|timeout|killed)|^(Error|ERROR|ERRO|FATAL|WARNING|WARN|Traceback|Exception|panic|STEP [0-9])|(segmentation fault|segfault|sigsegv|sigkill|sigterm|core dump|out of memory|oom|exit code [0-9]|exited with|subprocess exited|Skipping step because|cannot find|not found|permission denied|command not found|no space|disk full|quota exceeded|import error|module.*not found)'

    # Find lines matching error patterns
    grep -niE "$error_pattern" "$tmp_file" | cut -d: -f1 | sort -un > "${out_file}.nums"

    local match_count=$(wc -l < "${out_file}.nums")

    if [ "$match_count" -gt 0 ] && [ "$total_lines" -gt 80 ]; then
        echo -e "${YELLOW}━━━ Filtered: ${match_count} error/warning lines + context (from ${total_lines} lines) ━━━${NC}"
        echo ""

        # Build ranges with context lines, merge overlapping
        local prev_end=0
        local first=true
        while IFS= read -r line_num; do
            local range_start=$((line_num - context_lines))
            local range_end=$((line_num + context_lines))
            [ $range_start -lt 1 ] && range_start=1
            [ $range_end -gt $total_lines ] && range_end=$total_lines

            if [ $range_start -gt $((prev_end + 1)) ]; then
                if [ "$first" != true ]; then
                    local gap=$((range_start - prev_end - 1))
                    echo -e "  ${YELLOW}... (${gap} lines filtered) ...${NC}"
                fi
            fi
            first=false

            if [ $range_start -gt $prev_end ]; then
                sed -n "${range_start},${range_end}p" "$tmp_file" | sed 's/^/  /'
                prev_end=$range_end
            elif [ $range_end -gt $prev_end ]; then
                sed -n "$((prev_end + 1)),${range_end}p" "$tmp_file" | sed 's/^/  /'
                prev_end=$range_end
            fi
        done < "${out_file}.nums"

        # Always show last 10 lines
        if [ $prev_end -lt $((total_lines - 10)) ]; then
            echo -e "  ${YELLOW}... ($((total_lines - prev_end - 10)) lines filtered) ...${NC}"
            echo ""
            echo -e "  ${CYAN}[Last 10 lines]${NC}"
            tail -n 10 "$tmp_file" | sed 's/^/  /'
        fi
    else
        # Few matches or short log — show last 60 lines
        if [ "$total_lines" -gt 60 ]; then
            echo -e "${YELLOW}━━━ Last 60 of ${total_lines} lines ━━━${NC}"
            echo ""
            tail -n 60 "$tmp_file" | sed 's/^/  /'
        else
            sed 's/^/  /' "$tmp_file"
        fi
    fi

    rm -f "$tmp_file" "$out_file" "${out_file}.nums"
}

