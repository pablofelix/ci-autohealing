  ${CYAN}describe <resource> <name> [options]${NC}
    ic describe component <name> [--log]     Full component details + logs
                                             --log: Show complete logs (default: error context)
    ic describe pipelinerun <name>           Full PipelineRun details + logs
    ic describe pr <name>                    Alias for pipelinerun

  ${CYAN}Quick shortcuts:${NC}
    ic <1-N> [--log]                         Describe Nth failing component
