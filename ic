cmd_ai_analyze() {
    local target=""
    local force=false
    local component=""
    local analysis_type=""  # "build", "conforma", or "" (auto-detect)

    # Parse arguments - first arg is either number, "component", "conforma", or "--all"
    if [ $# -eq 0 ]; then
        echo -e "${RED}Error: Missing argument${NC}"
        echo "Usage: ic ai analyze <num|component> [--force]"
        echo "       ic ai analyze conforma <component> [--force]"
        echo "       ic ai analyze release <name> [--force]"
        echo "       ic ai analyze --all"
        return 1
    fi

    # Parse first argument
    if [ "$1" = "--all" ]; then
        target="all"
        shift
    elif [ "$1" = "release" ]; then
        analysis_type="release"
        shift
        local release_name="$1"
        shift
        # Parse remaining flags for release
        local release_force=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --force) release_force="--force"; shift ;;
                *) shift ;;
            esac
        done
        cmd_ai_analyze_release "$release_name" "$release_force"
        return $?
    elif [ "$1" = "scenarios" ] || [ "$1" = "its" ]; then
        shift
        cmd_ai_analyze_scenarios "$@"
        return $?
    elif [ "$1" = "conforma" ]; then
        analysis_type="conforma"
        shift
        component="$1"
        shift
    elif [ "$1" = "component" ]; then
        shift
        component="$1"
        shift
    elif [[ "$1" =~ ^[0-9]+$ ]]; then
        target="$1"
        shift
    else
        component="$1"
        shift
    fi

    # Parse remaining flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force)
                force=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    # Check if LLM is configured
    if [ -z "$LLM_PROVIDER" ] && [ -z "$ANTHROPIC_VERTEX_PROJECT_ID" ]; then
        echo -e "${RED}Error: LLM not configured${NC}"
        echo ""
        echo "Set LLM provider in .env or environment:"
        echo "  export LLM_PROVIDER=vertex_ai"
        echo "  export ANTHROPIC_VERTEX_PROJECT_ID=your-project-id"
        echo "  export CLOUD_ML_REGION=us-east5"
        echo ""
        echo "Or for direct Anthropic API:"
        echo "  export LLM_PROVIDER=anthropic"
        echo "  export ANTHROPIC_API_KEY=sk-ant-..."
        return 1
    fi

    cd "$SCRIPT_DIR/src" || return 1

    if [ "$target" = "all" ]; then
        echo -e "${CYAN}Analyzing all pending failures and violations...${NC}"
        echo ""

        # Analyze build failures
        echo -e "${BOLD}Build Failures:${NC}"
        $PYTHON analyze_failures.py
        local build_result=$?

        echo ""

        # Analyze Conforma violations
        echo -e "${BOLD}Conforma Violations:${NC}"
        $PYTHON analyze_conforma.py
        local conforma_result=$?

        # Return success if either succeeded
        if [ "$build_result" -eq 0 ] || [ "$conforma_result" -eq 0 ]; then
            return 0
        else
            return 1
        fi
    fi

    # Resolve component name and type from alert number if needed
    if [ -z "$component" ] && [ -n "$target" ]; then
        # Count build failures first
        local build_count=$(sql "
            SELECT COUNT(*) FROM (
                SELECT DISTINCT ON (component_name) component_name
                FROM build_failures
                WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
                ORDER BY component_name, first_detected_at DESC
            ) sub;
        " 2>/dev/null)
        build_count=${build_count:-0}

        # If number falls in build failures range
        if [ "$target" -le "$build_count" ]; then
            analysis_type="build"
            local retriggered_json=$(sql_get_retriggered_json)
            component=$(sql_resolve_build_number "$target" "${retriggered_json:-[]}")
        else
            # Falls in Conforma range
            analysis_type="conforma"
            local conforma_offset=$((target - build_count - 1))
            component=$(sql_resolve_conforma_number "$conforma_offset")
        fi
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component not found${NC}"
        return 1
    fi

    # Auto-detect type if not already set
    if [ -z "$analysis_type" ]; then
        local has_build=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)
        local has_conforma=$(sql "SELECT COUNT(*) FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)

        if [ "${has_build:-0}" -gt 0 ]; then
            analysis_type="build"
        elif [ "${has_conforma:-0}" -gt 0 ]; then
            analysis_type="conforma"
        else
            echo -e "${RED}Error: No unresolved failures found for component: $component${NC}"
            return 1
        fi
    fi

    # Check if already analyzed (based on type)
    if [ "$force" = false ]; then
        local exists=0
        if [ "$analysis_type" = "build" ]; then
            exists=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.component_name = '$component' AND b.is_resolved = FALSE AND b.application = '$APPLICATION_NAME';" 2>/dev/null)
        else
            exists=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.component_name = '$component' AND c.is_resolved = FALSE AND c.application = '$APPLICATION_NAME';" 2>/dev/null)
        fi

        if [ "${exists:-0}" -gt 0 ]; then
            echo -e "${YELLOW}Component $component already analyzed${NC}"
            echo ""
            echo "Use --force to re-analyze:"
            if [ "$analysis_type" = "build" ]; then
                echo "  ic ai analyze component $component --force"
            else
                echo "  ic ai analyze conforma $component --force"
            fi
            echo ""
            echo "Or view existing analysis:"
            if [ "$analysis_type" = "build" ]; then
                echo "  ic describe component $component"
            else
                echo "  ic describe conforma $component"
            fi
            return 0
        fi
    fi

    # Run appropriate analyzer
    if [ "$analysis_type" = "build" ]; then
        echo -e "${CYAN}Analyzing build failure: $component${NC}"
        echo ""
        $PYTHON analyze_failures.py --component "$component" $($force && echo "--force")
    else
        echo -e "${CYAN}Analyzing Conforma violation: $component${NC}"
        echo ""
        $PYTHON analyze_conforma.py --component "$component" $($force && echo "--force")
    fi
}

cmd_ai_analyze_release() {
    local release_name="$1"
    local force_flag="${2:-}"

    if [ -z "$release_name" ]; then
        echo -e "${RED}Error: Missing release name${NC}"
        echo "Usage: ic ai analyze release <release-name> [--force]"
        echo ""
        echo "Example: ic ai analyze release my-app-v3-4-prod-1234567890"
        return 1
    fi

    # Check if LLM is configured
    if [ -z "$LLM_PROVIDER" ] && [ -z "$ANTHROPIC_VERTEX_PROJECT_ID" ]; then
        echo -e "${RED}Error: LLM not configured${NC}"
        echo ""
        echo "Set LLM provider in .env or environment:"
        echo "  export LLM_PROVIDER=vertex_ai"
        echo "  export ANTHROPIC_VERTEX_PROJECT_ID=your-project-id"
        return 1
    fi

    echo -e "${CYAN}Analyzing release: $release_name${NC}"
    echo ""

    cd "$SCRIPT_DIR/src" || return 1

    # Capture stderr (logs) separately from stdout (JSON)
    local log_file
    log_file=$(mktemp)
    local output
    output=$($PYTHON analyze_release.py --release "$release_name" --namespace "$NAMESPACE" $force_flag 2>"$log_file")
    local exit_code=$?

    # Show log progress lines to user
    if [ -s "$log_file" ]; then
        grep -E "Collecting|Fetching|Got|Analyzing" "$log_file" | sed 's/^.*INFO - /  /' || true
        echo ""
    fi

    if [ $exit_code -ne 0 ]; then
        echo -e "${RED}Analysis failed${NC}"
        cat "$log_file" | tail -10
        rm -f "$log_file"
        return 1
    fi
    rm -f "$log_file"

    # Parse JSON output from Python
    local json_output
    json_output=$(printf '%s\n' "$output" | $PYTHON -c "
import sys, json
data = json.load(sys.stdin)

status = data.get('status', '')
if status == 'not_failed':
    print('NOT_FAILED')
    sys.exit(0)
if status == 'error':
    print('ERROR: ' + data.get('error', 'unknown'))
    sys.exit(1)

print('Category:       ' + data.get('failure_category', 'unknown'))
confidence = data.get('confidence_score', 0)
print('Confidence:     {}%'.format(int(float(confidence) * 100)))
owner = data.get('owner_team', '')
if owner:
