        return 0
    fi

    if [ "$json_output" = "NOT_FAILED" ]; then
        echo -e "${GREEN}Release has not failed — nothing to analyze${NC}"
        return 0
    fi

    if [[ "$json_output" == ERROR:* ]]; then
        echo -e "${RED}${json_output}${NC}"
