# Number shortcut — works across build failures AND conforma failures
cmd_describe_by_number() {
    local number="$1"
    shift
    local extra_args="$@"

    local retriggered_json=$(sql_get_retriggered_json)

    # Count build failures first
    local build_count=$(sql "
        SELECT COUNT(*) FROM (
            SELECT DISTINCT ON (component_name) component_name, status, is_resolved
            FROM build_failures WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        ) lb WHERE status = 'Failed' AND is_resolved = FALSE;
    ")
    build_count=${build_count:-0}

    local conforma_count=$(sql "
        SELECT COUNT(*) FROM (
            SELECT DISTINCT ON (component_name) component_name
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY component_name, last_updated_at DESC
        ) sub;
    " 2>/dev/null)
    conforma_count=${conforma_count:-0}

    local total=$((build_count + conforma_count))

    if [ "$number" -gt "$total" ] || [ "$number" -lt 1 ]; then
        echo -e "${RED}Error: Alert #$number does not exist${NC}"
        echo "There are $build_count build failures and $conforma_count Conforma failures ($total total)."
        return 1
    fi

    # If number falls in build failures range
    if [ "$number" -le "$build_count" ]; then
        local component=$(sql_resolve_build_number "$number" "${retriggered_json:-[]}")

        # Check if it's re-triggered
        local is_retriggered=""
        if echo "$retriggered_json" | jq -e --arg c "$component" 'index($c) != null' > /dev/null 2>&1; then
            is_retriggered=" (Re-triggered ✓)"
        fi

        echo -e "${CYAN}Build failure #$number of $total alerts${is_retriggered}${NC}"
        echo ""
        cmd_describe_component "$component" $extra_args
    else
        # Falls in conforma range
        local conforma_offset=$((number - build_count - 1))
        local component=$(sql_resolve_conforma_number "$conforma_offset")

        if [ -z "$component" ]; then
            echo -e "${RED}Error: Alert #$number does not exist${NC}"
            return 1
        fi

        echo -e "${CYAN}Conforma failure #$number of $total alerts${NC}"
        echo ""
        cmd_describe_conforma "$component"
    fi
}

