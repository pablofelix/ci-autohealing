# Component history command
cmd_history() {
    local component_name="$1"

    if [ -z "$component_name" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic history <component-name>"
        return 1
    fi

    section_header "History: $component_name"
    echo ""

    # Summary
    sql_table "
    SELECT
        COUNT(*) as \"Total Builds\",
        SUM(CASE WHEN status = 'Failed' THEN 1 ELSE 0 END) as \"Failures\",
        SUM(CASE WHEN status = 'Succeeded' THEN 1 ELSE 0 END) as \"Successes\",
        SUM(CASE WHEN is_resolved = TRUE THEN 1 ELSE 0 END) as \"Resolved\"
    FROM build_failures
    WHERE component_name = '$component_name'
      AND application = '$APPLICATION_NAME';
    "
    echo ""

    echo -e "${BOLD}Recent Builds (Last 20):${NC}"
    echo ""

    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        status as \"Status\",
        CASE WHEN is_resolved THEN '✓' ELSE '' END as \"Resolved\",
        LEFT(commit_short_sha, 8) as \"Commit\",
        first_detected_at as \"Date\"
    FROM build_failures
    WHERE component_name = '$component_name'
      AND application = '$APPLICATION_NAME'
    ORDER BY first_detected_at DESC
    LIMIT 20;
    "
    echo ""

    # Show current status (based on last build)
    local last_status=$(sql "
        SELECT status
        FROM build_failures
        WHERE component_name = '$component_name'
          AND application = '$APPLICATION_NAME'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [[ "$last_status" == "Failed" ]]; then
        echo -e "${RED}✗ Currently failing${NC} (last build: Failed)"
        echo -e "  Run: ${CYAN}ic why $component_name${NC} to investigate"
    elif [[ "$last_status" == "Succeeded" ]]; then
        echo -e "${GREEN}✓ Currently working${NC} (last build: Succeeded)"
    else
        echo -e "${YELLOW}? Status unknown${NC} (last build: $last_status)"
    fi
    echo ""
}

