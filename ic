SYNC_PID_FILE="$SCRIPT_DIR/.sync_status.pid"
SYNC_STALENESS_MINUTES=${SYNC_STALENESS_MINUTES:-10}

trigger_background_sync() {
    # Check if already running
    if [ -f "$SYNC_PID_FILE" ]; then
        local old_pid=$(cat "$SYNC_PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            return 1  # Already running
        fi
        rm -f "$SYNC_PID_FILE"
    fi

    (
        echo $$ > "$SYNC_PID_FILE"
        cd "$SCRIPT_DIR/collectors/python"
        python3 check_sync_status.py > /dev/null 2>&1
        python3 check_conforma_status.py > /dev/null 2>&1
        # If out of sync, also launch collector
        local is_sync=$(sql "SELECT in_sync FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null)
        if [ "$is_sync" = "f" ]; then
            "$SCRIPT_DIR/cron/collect-comprehensive.sh" > /dev/null 2>&1
        fi
        rm -f "$SYNC_PID_FILE"
    ) &
    return 0
}

# GET commands
cmd_get_components() {
    local refresh=false
    [[ "${1:-}" == "--refresh" || "${1:-}" == "-r" ]] && refresh=true

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Currently Failing Components${NC}"
    echo -e "${BOLD}Application: ${CYAN}${APPLICATION_NAME}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Read cached sync status from DB (instant)
    read_sync_cache() {
        sql "
            SELECT
                EXTRACT(EPOCH FROM (NOW() - last_checked_at))::int,
                in_sync,
                cluster_connected,
                COALESCE(missing_in_db::text, '[]'),
                COALESCE(extra_in_db::text, '[]'),
                COALESCE(error, ''),
                COALESCE(check_duration_seconds::text, '0'),
                TO_CHAR(last_checked_at, 'YYYY-MM-DD HH24:MI:SS'),
                COALESCE(retriggered_components::text, '[]')
            FROM sync_status WHERE application = '$APPLICATION_NAME';
        " 2>/dev/null
    }

    local sync_row=$(read_sync_cache)

    local age_seconds in_sync cluster_connected missing_json extra_json error duration sync_date retriggered_json
    IFS='|' read -r age_seconds in_sync cluster_connected missing_json extra_json error duration sync_date retriggered_json <<< "$sync_row"

    # Trim whitespace
    age_seconds=$(echo "$age_seconds" | tr -d ' ')
    in_sync=$(echo "$in_sync" | tr -d ' ')
    cluster_connected=$(echo "$cluster_connected" | tr -d ' ')
    error=$(echo "$error" | xargs 2>/dev/null || echo "")
    sync_date=$(echo "$sync_date" | xargs 2>/dev/null || echo "")

    # Force refresh if requested
    if [ "$refresh" = true ]; then
        echo -e "${CYAN}Refreshing sync status (querying KubeArchive)...${NC}"
        python3 "$SCRIPT_DIR/collectors/python/check_sync_status.py" > /dev/null 2>&1

        # If out of sync, also trigger comprehensive collection
        local refresh_sync=$(sql "SELECT in_sync FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null | tr -d ' ')
        if [ "$refresh_sync" = "f" ]; then
            echo -e "${CYAN}Out of sync — collecting missing component data...${NC}"
            "$SCRIPT_DIR/cron/collect-comprehensive.sh" > /dev/null 2>&1
            # Re-check sync after collection
            python3 "$SCRIPT_DIR/collectors/python/check_sync_status.py" > /dev/null 2>&1
        fi

        # Re-read cache
        sync_row=$(read_sync_cache)
        IFS='|' read -r age_seconds in_sync cluster_connected missing_json extra_json error duration sync_date retriggered_json <<< "$sync_row"
        age_seconds=$(echo "$age_seconds" | tr -d ' ')
        in_sync=$(echo "$in_sync" | tr -d ' ')
        cluster_connected=$(echo "$cluster_connected" | tr -d ' ')
        error=$(echo "$error" | xargs 2>/dev/null || echo "")
        sync_date=$(echo "$sync_date" | xargs 2>/dev/null || echo "")
    fi

    # Calculate staleness
    local age_minutes=0
    [ -n "$age_seconds" ] && age_minutes=$((age_seconds / 60))
    local staleness_seconds=$((SYNC_STALENESS_MINUTES * 60))
    local is_stale=false
    [ -z "$age_seconds" ] || [ "$age_seconds" -gt "$staleness_seconds" ] && is_stale=true

    # Show sync status from cache
    if [ -z "$age_seconds" ] || [ "$age_seconds" = "" ]; then
        echo -e "${YELLOW}⚠ Sync Status: NEVER CHECKED${NC}"
        echo -e "${CYAN}  → Checking in background...${NC}"
        trigger_background_sync
        echo ""
    elif [ "$cluster_connected" = "f" ]; then
        echo -e "${RED}⚠ Cluster: DISCONNECTED${NC} (last sync: ${sync_date:-unknown})"
        [ -n "$error" ] && echo -e "${YELLOW}  $error${NC}"
        echo -e "${CYAN}  → Login: oc login <cluster-url>${NC}"
        echo ""
    elif [ "$in_sync" = "t" ]; then
        echo -e "${GREEN}✓ Sync: IN SYNC${NC} (last sync: ${sync_date:-unknown}, ${age_minutes}m ago)"
        echo ""
    else
        echo -e "${YELLOW}⚠ Sync: OUT OF SYNC${NC} (last sync: ${sync_date:-unknown}, ${age_minutes}m ago)"

        [ -n "$error" ] && [ "$error" != "null" ] && echo -e "${YELLOW}  Issue: $error${NC}"

        # Show differences from cached JSON
        local missing_count=$(echo "$missing_json" | jq 'length' 2>/dev/null || echo "0")
        local extra_count=$(echo "$extra_json" | jq 'length' 2>/dev/null || echo "0")

        if [ "$missing_count" != "0" ]; then
            echo -e "${YELLOW}  Missing in DB: ${missing_count} component(s)${NC}"
            echo "$missing_json" | jq -r '.[]' 2>/dev/null | while IFS= read -r comp; do
                [ -n "$comp" ] && echo -e "${YELLOW}    - $comp${NC}"
            done
        fi
        if [ "$extra_count" != "0" ]; then
            echo -e "${YELLOW}  Extra in DB (resolved): ${extra_count} component(s)${NC}"
            echo "$extra_json" | jq -r '.[]' 2>/dev/null | while IFS= read -r comp; do
                [ -n "$comp" ] && echo -e "${YELLOW}    - $comp${NC}"
            done
        fi
        echo ""
    fi

    # If stale, trigger background refresh (non-blocking)
    if [ "$is_stale" = true ] && [ "$refresh" != true ]; then
        if trigger_background_sync; then
            echo -e "${CYAN}  ↻ Sync data is ${age_minutes}m old, refreshing in background...${NC}"
            echo ""
        fi
    fi

    # Get re-triggered component list from cache
    local retriggered_list=""
    if [ -n "$retriggered_json" ] && [ "$retriggered_json" != "[]" ]; then
        retriggered_list=$(echo "$retriggered_json" | jq -r '.[]' 2>/dev/null | paste -sd',' -)
    fi

    # Build the SQL for a unified table with status column
    # Push Failed components first (sorted by failures desc), then Re-triggered (sorted by date desc)
    local retriggered_filter="AND 1=0"  # no retriggered by default
    if [ -n "$retriggered_list" ]; then
        # Build SQL IN clause from comma-separated list
        local in_clause=$(echo "$retriggered_list" | sed "s/,/','/g" | sed "s/^/'/;s/$/'/")
        retriggered_filter="AND component_name IN ($in_clause)"
    fi

    # Count currently failing (push failed, not re-triggered)
    local push_failing=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds
        WHERE status = 'Failed' AND is_resolved = FALSE;
    ")

    local retriggered_count=0
    [ -n "$retriggered_json" ] && retriggered_count=$(echo "$retriggered_json" | jq 'length' 2>/dev/null || echo "0")

    local total_records=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME';")

    echo -e "${BOLD}Summary:${NC}"
    echo -e "  Push build failures: ${RED}${push_failing}${NC}"
    if [ "$retriggered_count" != "0" ]; then
        echo -e "  Re-triggered OK:     ${YELLOW}${retriggered_count}${NC}"
    fi
    echo -e "  Total build records: ${total_records}"
    echo ""

    # Unified table: Push Failed first, then Re-triggered
    sql_table "
    WITH push_failed AS (
        SELECT DISTINCT ON (component_name)
            component_name,
            status,
            is_resolved,
            first_detected_at,
            (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name) as total_failures,
            (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name AND bf.build_logs IS NOT NULL) as with_logs
        FROM build_failures
        WHERE application = '$APPLICATION_NAME'
        ORDER BY component_name, first_detected_at DESC
    ),
    failing AS (
        SELECT component_name, total_failures, with_logs,
            TO_CHAR(first_detected_at, 'DD Mon') as failed_date,
            1 as sort_group
        FROM push_failed
        WHERE status = 'Failed' AND is_resolved = FALSE
            AND component_name NOT IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
    ),
    retriggered AS (
        SELECT component_name, total_failures, with_logs,
            TO_CHAR(first_detected_at, 'DD Mon') as failed_date,
            2 as sort_group
        FROM push_failed
        WHERE status = 'Failed' AND is_resolved = FALSE
            AND component_name IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
    ),
    combined AS (
        SELECT * FROM failing
        UNION ALL
        SELECT * FROM retriggered
    )
    SELECT
        ROW_NUMBER() OVER (ORDER BY sort_group, total_failures DESC) as \"#\",
        component_name as \"Component\",
        CASE sort_group
            WHEN 1 THEN 'Push Failed'
            WHEN 2 THEN 'Re-triggered ✓'
        END as \"Status\",
        failed_date as \"Failed\",
        total_failures as \"Builds\",
        with_logs as \"Logs\"
    FROM combined
    ORDER BY sort_group, total_failures DESC;
    "
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic get components --refresh' to force a fresh sync check"
    echo -e "${CYAN}Tip:${NC} Use 'ic working' to see components that are currently working"
    echo ""
}

cmd_get_component() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic get component <name>"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}Component: ${CYAN}$component${NC}"
    echo ""
    echo -e "${BOLD}Summary:${NC}"
    echo "  Total failures: $total"
    echo "  With logs: $(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")"
    echo "  First seen: $(sql "SELECT MIN(first_detected_at) FROM build_failures WHERE component_name = '$component';")"
    echo "  Last seen: $(sql "SELECT MAX(first_detected_at) FROM build_failures WHERE component_name = '$component';")"
    echo ""
    echo -e "${CYAN}For full details with logs:${NC} ic describe component $component"
    echo ""
}

cmd_get_pipelineruns() {
    local limit="${1:-20}"

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Recent PipelineRun Failures${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        component_name as \"Component\",
        status as \"Status\",
        CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END as \"Logs\",
        first_detected_at as \"Detected\"
    FROM build_failures
    ORDER BY first_detected_at DESC
    LIMIT $limit;
    "
    echo ""
}

cmd_get_pipelinerun() {
    local pr_name="$1"
    if [ -z "$pr_name" ]; then
        echo -e "${RED}Error: PipelineRun name required${NC}"
        echo "Usage: ic get pipelinerun <name>"
        exit 1
    fi

    local data=$(sql "SELECT component_name, status, CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")

    if [ -z "$data" ]; then
        echo -e "${RED}Error: PipelineRun not found: $pr_name${NC}"
        exit 1
    fi

    IFS='|' read -r component status has_logs <<< "$data"

    echo -e "${BOLD}PipelineRun: ${CYAN}$pr_name${NC}"
    echo ""
    echo "  Component: $component"
    echo "  Status: $status"
    echo "  Has logs: $has_logs"
    echo ""
    echo -e "${CYAN}For full details with logs:${NC} ic describe pipelinerun $pr_name"
    echo ""
}

cmd_get_apps() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Available RHOAI Applications${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    local apps=$(oc get applications -n "$NAMESPACE" -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null | grep "rhoai" | sort -V)

    if [ -z "$apps" ]; then
        echo -e "${YELLOW}⚠ Cluster unreachable — showing applications from database${NC}"
        echo ""
        apps=$(sql "SELECT DISTINCT application FROM build_failures ORDER BY application;" 2>/dev/null)
    fi

    if [ -z "$apps" ]; then
        echo -e "${YELLOW}No applications found${NC}"
        exit 1
    fi

    local current="$APPLICATION_NAME"
    local count=0

    while IFS= read -r app; do
        [ -z "$app" ] && continue
        count=$((count + 1))
        local db_count=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$app';" 2>/dev/null)
        if [ "$app" = "$current" ]; then
            echo -e "  ${GREEN}✓ ${BOLD}$app${NC} ${CYAN}(current)${NC} — ${db_count:-0} records"
        else
            echo -e "    $app — ${db_count:-0} records"
        fi
    done <<< "$apps"

    echo ""
    echo "Total: $count applications"
    echo ""
    echo -e "${CYAN}Switch:${NC} ic config set-app <app-name>"
    echo ""
}

# DESCRIBE commands
cmd_describe_component() {
    local component="$1"
    local show_full_log=false

    # Parse options
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --log)
                show_full_log=true
                ;;
        esac
        shift
    done

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic describe component <name> [--log]"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Component: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Summary
    local with_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")
    local first_failure=$(sql "SELECT MIN(first_detected_at) FROM build_failures WHERE component_name = '$component';")
    local latest_failure=$(sql "SELECT MAX(first_detected_at) FROM build_failures WHERE component_name = '$component';")

    echo -e "${BOLD}Summary:${NC}"
    echo "  Total Failures: $total"
    echo "  Failures with Logs: $with_logs / $total"
    echo "  First Failure: $first_failure"
    echo "  Latest Failure: $latest_failure"
    echo ""

    # Get latest PipelineRun
    local pr_data=$(sql "
        SELECT pipelinerun_name, pipelinerun_uid, status, repository_url, branch,
               CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END,
               COALESCE(konflux_logs_url, konflux_url),
               COALESCE(commit_sha, ''), COALESCE(commit_url, ''),
               COALESCE(commit_author, ''), COALESCE(LEFT(commit_message, 120), ''),
               COALESCE(failed_step_name, ''), COALESCE(error_type, ''),
               COALESCE(LEFT(error_message, 200), ''),
               COALESCE(build_duration_seconds::text, '')
        FROM build_failures
        WHERE component_name = '$component'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [ -n "$pr_data" ]; then
        IFS='|' read -r pr_name pr_uid status repo_url branch has_logs konflux_url \
            commit_sha commit_url commit_author commit_message \
            failed_step error_type error_message build_duration <<< "$pr_data"

        echo -e "${BOLD}========================================${NC}"
        echo -e "${BOLD}Latest PipelineRun${NC}"
        echo -e "${BOLD}========================================${NC}"
        echo ""
        echo -e "${BOLD}PipelineRun:${NC} $pr_name"
        case "$status" in
            Cancelled) echo -e "${BOLD}Status:${NC} ${YELLOW}Cancelled${NC}" ;;
            Timeout)   echo -e "${BOLD}Status:${NC} ${YELLOW}Timeout${NC}" ;;
            *)         echo -e "${BOLD}Status:${NC} $status" ;;
        esac
        echo -e "${BOLD}Repository:${NC} $repo_url"
        echo -e "${BOLD}Branch:${NC} $branch"

        commit_sha=$(echo "$commit_sha" | xargs 2>/dev/null || echo "")
        commit_url=$(echo "$commit_url" | xargs 2>/dev/null || echo "")
        commit_author=$(echo "$commit_author" | xargs 2>/dev/null || echo "")
        commit_message=$(echo "$commit_message" | xargs 2>/dev/null || echo "")
        failed_step=$(echo "$failed_step" | xargs 2>/dev/null || echo "")
        error_type=$(echo "$error_type" | xargs 2>/dev/null || echo "")
        error_message=$(echo "$error_message" | xargs 2>/dev/null || echo "")
        build_duration=$(echo "$build_duration" | xargs 2>/dev/null || echo "")

        [ -n "$commit_sha" ] && echo -e "${BOLD}Commit:${NC}      ${commit_sha:0:8}"
        [ -n "$commit_author" ] && echo -e "${BOLD}Author:${NC}      $commit_author"
        [ -n "$commit_message" ] && echo -e "${BOLD}Message:${NC}     $commit_message"
        [ -n "$commit_url" ] && echo -e "${BOLD}Commit URL:${NC}  ${CYAN}$commit_url${NC}"

        if [ -n "$failed_step" ] || [ -n "$error_type" ]; then
            echo ""
            echo -e "${BOLD}Failure Info:${NC}"
            [ -n "$failed_step" ] && echo -e "  Failed Step: ${RED}$failed_step${NC}"
            [ -n "$error_type" ] && echo -e "  Error Type:  $error_type"
            [ -n "$error_message" ] && echo -e "  Error:       $error_message"
            [ -n "$build_duration" ] && echo -e "  Duration:    ${build_duration}s"
        fi

        echo ""
        echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"

        # Quay image (derive from component naming convention)
        local quay_repo=$(echo "$repo_url" | sed 's|https://github.com/acme-org/||' | sed 's|\.git$||')
        if [ -n "$quay_repo" ]; then
            echo -e "${BOLD}Quay:${NC}       ${CYAN}https://quay.io/repository/rhoai/${component}${NC}"
        fi
        echo ""

        # Show logs if available
        if [ "$has_logs" = "Yes" ]; then
            local logs=$(sql "SELECT build_logs FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")
            local log_size=$(echo "$logs" | wc -c)

            if [ "$log_size" -gt 10 ]; then
                echo -e "${BOLD}========================================${NC}"
                if [ "$show_full_log" = true ]; then
                    echo -e "${BOLD}Build Logs (Full)${NC}"
                else
                    echo -e "${BOLD}Build Logs${NC}"
                fi
                echo -e "${BOLD}========================================${NC}"
                echo ""

                if [ "$show_full_log" = true ]; then
                    echo "$logs"
                else
                    # For short logs, show them directly
                    if [ "$log_size" -lt 1000 ]; then
                        echo "$logs"
                    else
                        # For long logs, extract context
                        extract_error_context "$logs"
                    fi

                    if [ "$log_size" -gt 1000 ]; then
                        echo ""
                        echo -e "${CYAN}💡 Tip: Add --log flag to see the complete build log${NC}"
                    fi
                fi
                echo ""
            else
                echo -e "${YELLOW}⚠ Logs available but empty${NC}"
                echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
                echo ""
            fi
        else
            echo -e "${YELLOW}⚠ No logs stored in database${NC}"
            echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
            echo ""
        fi
    fi
}

