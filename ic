    while [[ $# -gt 0 ]]; do
        case "$1" in
            --estimate) flags="$flags --estimate"; is_estimate=true; shift ;;
            --limit)    flags="$flags --limit $2"; shift 2 ;;
            --all)      flags="$flags --all"; shift ;;
            *)          shift ;;
        esac
    done

    if [ -z "$flags" ]; then
        echo -e "${BOLD}IC AI Batch - Batch Analysis${NC}"
        echo ""
        echo "Usage: ic ai batch {--estimate|--limit N} [--all]"
        echo ""
        echo "Options:"
        echo "  --estimate     Show queue depth (no API calls)"
        echo "  --limit N      Analyze N failures (75% build, 25% conforma)"
        echo "  --all          Across all applications (default: current app)"
        echo ""
        echo "Examples:"
        echo "  ic ai batch --estimate           # Check queue depth"
        echo "  ic ai batch --limit 20           # Analyze 20 failures"
        echo "  ic ai batch --limit 50 --all     # 50 failures, all apps"
        echo ""
        echo -e "${YELLOW}Note: Uses Anthropic API - costs money per analysis${NC}"
        return 1
    fi

    if ! $is_estimate; then
