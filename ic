cmd_jira_inbox() {
    local subcmd="${1:-}"

    # Interactive refinement via LLM conversation
    if [ "$subcmd" = "refine" ]; then
        local idx="${2:-}"
        if [[ ! "$idx" =~ ^[0-9]+$ ]] || [ "$idx" -lt 1 ]; then
            echo -e "${RED}Usage: ic jira inbox refine <N>${NC}"
            return 1
        fi
        local target
        target=$(sql "SELECT jira_key, comment_id FROM jira_comment_drafts WHERE reviewed_at IS NULL ORDER BY created_at ASC LIMIT 1 OFFSET $((idx-1))")
        if [ -z "$target" ]; then
            echo -e "${RED}Error: No item #$idx in inbox${NC}"
            return 1
        fi
        local jira_key comment_id
        jira_key=$(echo "$target" | cut -d'|' -f1 | xargs)
        comment_id=$(echo "$target" | cut -d'|' -f2 | xargs)
        $PYTHON "$SCRIPT_DIR/src/jira_refine.py" "$jira_key" "$comment_id"
        return
    fi

    # Mark an item as reviewed by its 1-based index in the unreviewed list
    if [ "$subcmd" = "done" ] || [ "$subcmd" = "mark-reviewed" ]; then
        local idx="${2:-}"
        if [[ ! "$idx" =~ ^[0-9]+$ ]] || [ "$idx" -lt 1 ]; then
            echo -e "${RED}Usage: ic jira inbox done <N>${NC}"
            return 1
        fi
        local target
        target=$(sql "SELECT jira_key, comment_id FROM jira_comment_drafts WHERE reviewed_at IS NULL ORDER BY created_at ASC LIMIT 1 OFFSET $((idx-1))")
        if [ -z "$target" ]; then
            echo -e "${RED}Error: No item #$idx in inbox${NC}"
            return 1
        fi
        local jira_key comment_id
        jira_key=$(echo "$target" | cut -d'|' -f1 | xargs)
        comment_id=$(echo "$target" | cut -d'|' -f2 | xargs)
        sql "UPDATE jira_comment_drafts SET reviewed_at = NOW() WHERE jira_key = '$jira_key' AND comment_id = $comment_id" >/dev/null
        echo -e "${GREEN}✓ Marked reviewed: $jira_key comment #$comment_id${NC}"
        return
    fi

    local count
    count=$(sql "SELECT COUNT(*) FROM jira_comment_drafts WHERE reviewed_at IS NULL")
    count="${count:-0}"

    if [ "$count" = "0" ]; then
        echo -e "Jira inbox is empty — no unreviewed comments."
        return
    fi

    section_header "Jira Comment Inbox"
    echo -e "${BOLD}${count} unreviewed comment(s) pending your reply${NC}"
    echo ""

    local drafts_list
    drafts_list=$(sql "SELECT jira_key, comment_id, TO_CHAR(created_at, 'DD Mon HH24:MI') FROM jira_comment_drafts WHERE reviewed_at IS NULL ORDER BY created_at ASC")

    local idx=0
    while IFS='|' read -r jira_key comment_id received_at; do
        idx=$((idx+1))
        jira_key=$(echo "$jira_key" | xargs)
        comment_id=$(echo "$comment_id" | xargs)
        received_at=$(echo "$received_at" | xargs)
        [ -z "$jira_key" ] && continue

        local author="Unknown" body="[Comment not available]"
        local comment_info
        comment_info=$(jira_api GET "/rest/api/2/issue/$jira_key/comment/$comment_id" 2>/dev/null)
        if [ -n "$comment_info" ] && ! echo "$comment_info" | grep -q '"errorMessages"'; then
            author=$(echo "$comment_info" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('author', {}).get('displayName', 'Unknown'))
except Exception:
    print('Unknown')
" 2>/dev/null)
            body=$(echo "$comment_info" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    b = d.get('body', '').strip()
    print(b[:600] + ('...' if len(b) > 600 else ''))
except Exception:
    print('[unavailable]')
" 2>/dev/null)
        fi

        local draft
        draft=$(sql "SELECT draft_response FROM jira_comment_drafts WHERE jira_key = '$jira_key' AND comment_id = $comment_id")

        echo -e "  ${BOLD}[$idx]${NC} ${CYAN}${jira_key}${NC}  ·  ${received_at}  ·  from ${BOLD}${author}${NC}"
        echo ""
        echo -e "  ${BOLD}Comment:${NC}"
        echo "$body" | fold -s -w 72 | sed 's/^/    /'
        echo ""
        echo -e "  ${BOLD}Draft reply:${NC}"
        echo "$draft" | fold -s -w 72 | sed 's/^/    /'
        echo ""
        echo -e "  ${CYAN}→ ic jira inbox refine $idx${NC}  ·  ${CYAN}ic jira inbox done $idx${NC}  ·  ${CYAN}ic describe jira $jira_key${NC}"
        echo "  ────────────────────────────────────────────────────────────────"
        echo ""
    done <<< "$drafts_list"

    echo -e "${CYAN}Tip:${NC} Copy the draft, personalise it, post it on the ticket, then mark done."
    echo ""
}

