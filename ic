lookup_team_handle() {
    local component="$1"
    local default_handle="openshift-ai-devtestops-ic"
    local cache="$COMPONENT_DATA_CACHE"
    local ttl="$COMPONENT_DATA_TTL"

    if [ -f "$cache" ]; then
        local age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
        if [ "$age" -lt "$ttl" ]; then
            local handle
            handle=$(python3 "$SCRIPT_DIR/parsers/lookup_team.py" "$component" < "$cache" 2>/dev/null)
            echo "${handle:-$default_handle}"
            return
        fi
    fi

    local yaml_data
    yaml_data=$(curl -sL --max-time 10 "$COMPONENT_DATA_URL" 2>/dev/null)
    if [ -n "$yaml_data" ] && echo "$yaml_data" | head -1 | grep -q '^[a-z]'; then
        echo "$yaml_data" > "$cache"
        local handle
        handle=$(echo "$yaml_data" | python3 "$SCRIPT_DIR/parsers/lookup_team.py" "$component" 2>/dev/null)
        echo "${handle:-$default_handle}"
        return
    fi

    if [ -f "$cache" ]; then
        local handle
        handle=$(python3 "$SCRIPT_DIR/parsers/lookup_team.py" "$component" < "$cache" 2>/dev/null)
        echo "${handle:-$default_handle}"
        return
    fi

    echo "$default_handle"
}

export_slack() {
    local target="$1"
    local export_type="$2"
    local clipboard=false
    local jira_key=""

    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --clipboard) clipboard=true; shift ;;
            --jira)      jira_key="${2:-}"; shift 2 ;;
            *)           shift ;;
        esac
    done

    local component=""
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        local build_count=$(sql "
            SELECT COUNT(*) FROM (
                SELECT DISTINCT ON (component_name) component_name
                FROM build_failures
                WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
                ORDER BY component_name, first_detected_at DESC
            ) sub;
        " 2>/dev/null)
        build_count=${build_count:-0}

        if [ "$target" -le "$build_count" ]; then
            export_type="build"
            local retriggered_json=$(sql_get_retriggered_json)
            component=$(sql_resolve_build_number "$target" "${retriggered_json:-[]}")
        else
            export_type="conforma"
            local conforma_offset=$((target - build_count - 1))
            component=$(sql_resolve_conforma_number "$conforma_offset")
        fi
    else
        component="$target"
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component not found${NC}"
        return 1
    fi

    if [ -z "$export_type" ]; then
        local has_build=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)
        local has_conforma=$(sql "SELECT COUNT(*) FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)

        if [ "${has_build:-0}" -gt 0 ]; then
            export_type="build"
        elif [ "${has_conforma:-0}" -gt 0 ]; then
            export_type="conforma"
        else
            echo -e "${RED}Error: No unresolved failures found for component: $component${NC}"
            return 1
        fi
    fi

    local team_handle
    team_handle=$(lookup_team_handle "$component")

    local jira_line=""
    if [ -n "$jira_key" ]; then
        if [[ "$jira_key" =~ ^https?:// ]]; then
            jira_line=":jira2: <${jira_key}|${jira_key##*/}>"
        else
            jira_line=":jira2: <${JIRA_URL}/browse/${jira_key}|${jira_key}>"
        fi
    fi

    local output=""

    if [ "$export_type" = "conforma" ]; then
        local data=$(sql "
            SELECT c.component_name, c.scenario,
                   c.violations_count, c.warnings_count,
                   TO_CHAR(c.first_detected_at, 'DD Mon'),
                   c.pipelinerun_name
            FROM conforma_results c
            WHERE c.component_name = '$component'
              AND c.is_resolved = FALSE
              AND c.application = '$APPLICATION_NAME'
            ORDER BY c.last_updated_at DESC
            LIMIT 1;
        " 2>/dev/null)

        if [ -z "$data" ]; then
            echo -e "${RED}Error: No Conforma violation found for: $component${NC}"
            return 1
        fi

        local data_oneline=$(echo "$data" | tr '\n' ' ' | sed 's/  */ /g')
        IFS='|' read -r comp_name scenario violations warnings first_seen pr_name <<< "$data_oneline"
        comp_name=$(trim "$comp_name")
        scenario=$(trim "$scenario")
        violations=$(trim "$violations")
        warnings=$(trim "$warnings")
        first_seen=$(trim "$first_seen")
        pr_name=$(trim "$pr_name")

        local scenario_short="$scenario"
        [[ "$scenario" =~ single-component ]] && scenario_short="single-component"
        [[ "$scenario" =~ conforma-fbc ]] && scenario_short="fbc"
        [[ "$scenario" =~ conforma-custom ]] && scenario_short="custom"

        local konflux_url="${KONFLUX_UI_BASE}/ns/${NAMESPACE}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}/logs"

        output+=":warning: *Conforma policy violation on \`${comp_name}\`*\n"
        output+="\n"
        output+="Hi team, \`${comp_name}\` has ${violations} policy violation(s) in the \`${scenario_short}\` scenario that need attention.\n"
        output+="\n"
        output+="*Violations:* ${violations} | *Warnings:* ${warnings}\n"
        output+="*Failing since:* ${first_seen}\n"
        [ -n "$jira_line" ] && output+="\n${jira_line}\n"
        output+=":link: <${konflux_url}|View in Konflux>\n"
        output+="\n"
        output+="@${team_handle} — could you take a look at this when you have a moment? Let me know if you need any additional context. Thanks!\n"
    else
        local data=$(sql "
            SELECT b.component_name, b.error_type, b.failed_step_name,
                   COALESCE(REPLACE(REPLACE(LEFT(b.error_message, 120), E'\n', ' '), E'\r', ''), ''),
                   TO_CHAR(b.first_detected_at, 'DD Mon'),
                   (SELECT COUNT(*) FROM build_failures WHERE component_name = b.component_name AND is_resolved = FALSE),
                   COALESCE(b.commit_sha, ''), COALESCE(b.commit_author, ''),
                   COALESCE(b.commit_url, ''),
                   COALESCE(b.konflux_logs_url, b.konflux_url),
                   b.pipelinerun_name
            FROM build_failures b
            WHERE b.component_name = '$component'
              AND b.is_resolved = FALSE
              AND b.application = '$APPLICATION_NAME'
            ORDER BY b.last_updated_at DESC
            LIMIT 1;
        " 2>/dev/null)

        if [ -z "$data" ]; then
            echo -e "${RED}Error: No build failure found for: $component${NC}"
            return 1
        fi

        local data_oneline=$(echo "$data" | tr '\n' ' ' | sed 's/  */ /g')
        IFS='|' read -r comp_name error_type failed_step error_msg first_seen \
            occurrence_count commit_sha commit_author commit_url \
            konflux_url pr_name <<< "$data_oneline"
        comp_name=$(trim "$comp_name")
        error_type=$(trim "$error_type")
        failed_step=$(trim "$failed_step")
        error_msg=$(trim "$error_msg")
        first_seen=$(trim "$first_seen")
        occurrence_count=$(trim "$occurrence_count")
        commit_sha=$(trim "$commit_sha")
        commit_author=$(trim "$commit_author")
        commit_url=$(trim "$commit_url")
        konflux_url=$(trim "$konflux_url")

        output+=":red_circle: *Build failure on \`${comp_name}\`*\n"
        output+="\n"
        output+="Hi team, we have a build failure on \`${comp_name}\` that could use some attention.\n"
        output+="\n"
        [ -n "$error_type" ] && output+="*Error:* \`${error_type}\`"
        [ -n "$failed_step" ] && output+=" in step \`${failed_step}\`"
        [ -n "$error_type" ] && output+="\n"
        output+="*Failing since:* ${first_seen} (${occurrence_count} occurrence(s))\n"
        if [ -n "$commit_sha" ]; then
            if [ -n "$commit_url" ]; then
                output+="*Last commit:* <${commit_url}|\`${commit_sha:0:8}\`> by ${commit_author}\n"
            else
                output+="*Last commit:* \`${commit_sha:0:8}\` by ${commit_author}\n"
            fi
        fi
        [ -n "$jira_line" ] && output+="\n${jira_line}\n"
        [ -n "$konflux_url" ] && output+=":link: <${konflux_url}|View in Konflux>\n"
        output+="\n"
        output+="@${team_handle} — would you be able to take a look when you get a chance? Happy to provide more context if needed. Thanks!\n"
    fi

    clipboard_or_print "$output" "$clipboard"
}

# GET CONFORMA - Conforma test failures
cmd_get_conforma() {
    _check_db || return 1
    local refresh=false
    local filter_mode="current"  # current | future | all
    local json_output=false

    local show_grouped=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --refresh|-r) refresh=true; shift ;;
            --future) filter_mode="future"; shift ;;
            --all) filter_mode="all"; shift ;;
            --current) filter_mode="current"; shift ;;
            --group|-g) show_grouped=true; shift ;;
            --json) json_output=true; shift ;;
            *) shift ;;
        esac
    done

    if [ "$json_output" = true ]; then
        local fc=""
        case "$filter_mode" in
            current) fc="AND is_future = FALSE" ;;
            future) fc="AND is_future = TRUE" ;;
        esac
        sql_json "
            SELECT component_name AS component, scenario, status,
                   violations_count, warnings_count, successes_count,
                   first_detected_at AS first_seen, last_updated_at AS last_seen,
                   repository_url,
                   CASE WHEN ai_analysis_id IS NOT NULL THEN true ELSE false END AS has_analysis,
                   jira_key
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE $fc
            ORDER BY last_updated_at DESC
        "
        return
    fi

    local header_suffix=""
    local filter_clause=""

    case "$filter_mode" in
        current)
            header_suffix=" ${CYAN}(Blocking - Current Policy)${NC}"
            filter_clause="AND is_future = FALSE"
            ;;
        future)
            header_suffix=" ${YELLOW}(Informational - Future Policy)${NC}"
            filter_clause="AND is_future = TRUE"
            ;;
        all)
            header_suffix=" ${CYAN}(All: Current + Future)${NC}"
            filter_clause=""
            ;;
    esac

    section_header "Conforma Test Failures${header_suffix}"
    echo -e "${BOLD}Application: ${CYAN}${APPLICATION_NAME}${NC}"
    echo ""

    if [ "$refresh" = true ]; then
        echo -e "${CYAN}Refreshing Conforma status (querying KubeArchive)...${NC}"
        cd "$SCRIPT_DIR/src" && python3 check_conforma_status.py > /dev/null 2>&1
        python3 collect_conforma.py > /dev/null 2>&1
        cd "$SCRIPT_DIR"
    fi

    local count=$(sql "SELECT COUNT(*) FROM conforma_results WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE ${filter_clause};" 2>/dev/null)

    if [ "${count:-0}" = "0" ]; then
        echo -e "${GREEN}✓ No Conforma failures${NC}"
        echo ""
        if [ "$filter_mode" = "current" ]; then
            echo -e "${CYAN}Tip:${NC} Use 'ic conforma --future' to see future policy violations"
        fi
        echo -e "${CYAN}Tip:${NC} Use 'ic conforma --refresh' to check for new failures"
        return
    fi

    echo -e "${BOLD}Summary:${NC} ${RED}${count}${NC} components failing Conforma tests"
    echo ""

    if [ "$show_grouped" = true ]; then
        # Grouped by scenario
        local groups=$(sql "
            WITH latest AS (
                SELECT DISTINCT ON (component_name, scenario)
                    component_name, scenario, violations_count,
                    CASE WHEN is_future THEN 'future' ELSE 'current' END as policy
                FROM conforma_results
                WHERE application = '$APPLICATION_NAME'
                  AND is_resolved = FALSE
                  ${filter_clause}
                ORDER BY component_name, scenario, last_updated_at DESC
            )
            SELECT
                scenario,
                policy,
                COUNT(*) as cnt,
                SUM(violations_count) as total_violations,
                STRING_AGG(component_name || '(' || violations_count || ')', ', ' ORDER BY component_name) as components
            FROM latest
            GROUP BY scenario, policy
            ORDER BY cnt DESC;
        " 2>/dev/null)

        if [ -n "$groups" ]; then
            while IFS='|' read -r scenario policy cnt total_v components; do
                scenario=$(trim "$scenario")
                policy=$(trim "$policy")
                cnt=$(trim "$cnt")
                total_v=$(trim "$total_v")
                components=$(trim "$components")
                local policy_label=""
                [ "$policy" = "future" ] && policy_label=" ${YELLOW}[future]${NC}"
                echo -e "  ${RED}${scenario}${NC}${policy_label} (${cnt} components, ${total_v} total violations)"
                echo "$components" | fold -s -w 70 | while IFS= read -r line; do
                    echo -e "    ${CYAN}${line}${NC}"
                done
                echo ""
            done <<< "$groups"
        fi
    else
        sql_table "
        SELECT
            ROW_NUMBER() OVER (ORDER BY violations_count DESC) as \"#\",
            component_name as \"Component\",
            CASE WHEN scenario LIKE '%-single-component' THEN 'single'
                 WHEN scenario LIKE 'conforma-fbc-%' THEN 'fbc'
                 WHEN scenario LIKE 'conforma-custom-%' THEN 'custom'
                 WHEN scenario LIKE '%-chart-%' THEN 'chart'
                 ELSE '-' END as \"Type\",
            CASE WHEN is_future THEN 'future' ELSE 'current' END as \"Policy\",
            violations_count as \"Violations\",
            warnings_count as \"Warnings\",
            successes_count as \"OK\",
            TO_CHAR(first_detected_at, 'DD Mon') as \"Since\",
            COALESCE(jira_key, '-') as \"JIRA\"
        FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND is_resolved = FALSE
          ${filter_clause}
        ORDER BY violations_count DESC;
        "
    fi
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic describe conforma <component>' for violation details"
    echo -e "${CYAN}Tip:${NC} Use 'ic get conforma --group' to group by scenario"
    if [ "$filter_mode" = "current" ]; then
        echo -e "${CYAN}Tip:${NC} Use 'ic conforma --future' to see future policy violations"
        echo -e "${CYAN}Tip:${NC} Use 'ic conforma --all' to see both current and future"
    fi
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts' to see builds + Conforma in one view"
    echo ""
}

display_alerts_build_failures() {
    local retriggered_json="${1:-[]}"
    local build_count=$(sql_count_failing_builds)

    echo -e "${BOLD}Build Failures (${build_count:-0}):${NC}"

    if [ "${build_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No build failures${NC}"
    else
        sql_table "
        WITH push_failed AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, is_resolved, first_detected_at, jira_key,
                (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name) as total_failures
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        ),
        failing AS (
            SELECT component_name, total_failures, jira_key,
                TO_CHAR(first_detected_at, 'DD Mon') as failed_date,
                CASE WHEN component_name IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
                    THEN 'Re-triggered ✓'
                    ELSE 'Push Failed'
                END as status_label,
                CASE WHEN component_name IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
                    THEN 2 ELSE 1
                END as sort_group
            FROM push_failed
            WHERE status = 'Failed' AND is_resolved = FALSE
        )
        SELECT
            ROW_NUMBER() OVER (ORDER BY sort_group, total_failures DESC) as \"#\",
            component_name as \"Component\",
            status_label as \"Status\",
            failed_date as \"Failed\",
            total_failures as \"Builds\",
            COALESCE(jira_key, '-') as \"JIRA\"
        FROM failing
        ORDER BY sort_group, total_failures DESC;
        "
    fi
    echo ""
}

display_alerts_conforma_failures() {
    local offset="${1:-0}"
    local conforma_count=$(sql "
        SELECT COUNT(*) FROM (
            SELECT DISTINCT ON (component_name, scenario) component_name
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY component_name, scenario, last_updated_at DESC
        ) sub;
    " 2>/dev/null)

    echo -e "${BOLD}Conforma Failures (${conforma_count:-0}):${NC}"

    if [ "${conforma_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No Conforma failures${NC}"
    else
        local exceptions=""
        exceptions=$(fetch_conforma_exceptions "$APPLICATION_NAME" 2>/dev/null)
        local k8s_exc_full=""
        k8s_exc_full=$(fetch_k8s_exceptions_full 2>/dev/null)
        local expiring_data=""
        expiring_data=$(fetch_expiring_exceptions 21 2>/dev/null)

        local comp_rows
        comp_rows=$(sql "
        WITH latest_conforma AS (
            SELECT DISTINCT ON (component_name, scenario)
                component_name, scenario, violations_count, warnings_count, first_detected_at,
                COALESCE(jira_key, '') as jira_key
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND is_resolved = FALSE
            ORDER BY component_name, scenario, last_updated_at DESC
        )
        SELECT component_name, scenario, violations_count, warnings_count,
               TO_CHAR(first_detected_at, 'DD Mon'), jira_key
        FROM latest_conforma
        ORDER BY violations_count DESC;
        " 2>/dev/null)

        printf "  %-4s %-40s %-9s %6s %6s %-22s %-6s %s\n" "#" "Component" "Policy" "Viol" "Warn" "Exception" "Since" "JIRA"
        printf "  %-4s %-40s %-9s %6s %6s %-22s %-6s %s\n" "---" "$(printf '%0.s-' {1..40})" "---------" "------" "------" "----------------------" "------" "--------"

        local row_num=0
        echo "$comp_rows" | while IFS='|' read -r c_name c_scenario c_viol c_warn c_since c_jira; do
            c_name=$(trim "$c_name")
            c_scenario=$(trim "$c_scenario")
            c_viol=$(trim "$c_viol")
            c_warn=$(trim "$c_warn")
            c_since=$(trim "$c_since")
            c_jira=$(trim "$c_jira")
            [ -z "$c_name" ] && continue

            row_num=$((row_num + 1))
            local display_num=$((row_num + offset))

            local policy_name
            policy_name=$(extract_policy_from_scenario "$c_scenario")
            local policy_label
            policy_label=$(echo "$policy_name" | sed 's/registry-[a-z]*-/reg-/; s/fbc-[a-z]*-/fbc-/; s/stage/stg/')

            local exc_status="-"
            local exc_jira_ref=""
            local exc_gl_link=""
            local vsummary=""
            if [ -n "$exceptions" ] || [ -n "$k8s_exc_full" ]; then
                vsummary=$(sql "SELECT violation_summary FROM conforma_results WHERE component_name = '$c_name' AND scenario = '$c_scenario' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE ORDER BY last_updated_at DESC LIMIT 1;" 2>/dev/null)
                local exc_result
                exc_result=$(check_exception_status_v2 "$vsummary" "$exceptions" "$k8s_exc_full" "$c_scenario")
                exc_status=$(echo "$exc_result" | cut -d'|' -f1)
                exc_jira_ref=$(echo "$exc_result" | cut -d'|' -f2)
                exc_gl_link=$(echo "$exc_result" | cut -d'|' -f3)
            fi

            local exc_display="$exc_status"
            if [ -n "$expiring_data" ] && [[ "$exc_status" != NO* ]] && [ "$exc_status" != "-" ] && [ "$exc_status" != "UNKNOWN" ]; then
                local expiry_info
                expiry_info=$(find_component_expiry "$c_name" "$vsummary" "$expiring_data")
                if [ "$expiry_info" != "-" ]; then
                    exc_display="${exc_status} → ${expiry_info}"
                fi
            fi

            local exc_color="$NC"
            case "$exc_status" in
                YES*) exc_color="$GREEN" ;;
                NO\ \(in*) exc_color="$YELLOW" ;;
                NO) exc_color="$RED" ;;
                PARTIAL*) exc_color="$YELLOW" ;;
            esac

            local display_jira="${c_jira:--}"
            if [ -n "$exc_jira_ref" ] && [ "$exc_jira_ref" != "config.exclude (permanent)" ]; then
                local jira_key
                jira_key=$(echo "$exc_jira_ref" | grep -oP '[A-Z]+-\d+' | tail -1)
                [ -n "$jira_key" ] && [ "$display_jira" = "-" ] && display_jira="$jira_key"
            fi

            printf "  %-4s %-40s %-9s %6s %6s " "$display_num" "${c_name:0:40}" "$policy_label" "$c_viol" "$c_warn"
            echo -ne "${exc_color}$(printf '%-22s' "${exc_display:0:22}")${NC} "
            printf "%-6s " "$c_since"
            echo "$display_jira"

            # Show GitLab link for known EC policies (skip custom scenarios)
            local gl_link=""
            [[ "$exc_gl_link" == http* ]] && gl_link="$exc_gl_link"
            if [ -z "$gl_link" ] && [ -n "$policy_name" ] && [ -n "${GITLAB_EC_POLICY_URL:-}" ]; then
                gl_link="${GITLAB_EC_POLICY_URL}/${policy_name}.yaml"
            fi
            if [ -n "$gl_link" ]; then
                echo -e "       ${CYAN}↳ ${gl_link}${NC}"
            fi

            local categories=""
            [ -n "$vsummary" ] && categories=$(categorize_violation_summary "$vsummary")
            if [ -n "$categories" ]; then
                echo -e "       ${CYAN}↳ ${categories}${NC}"
            fi
        done
    fi
    echo ""
}

display_alerts_in_progress() {
    local running_builds_json running_conforma_json
    running_builds_json=$(sql "SELECT COALESCE(running_builds::text, '[]') FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null)
    running_conforma_json=$(sql "SELECT COALESCE(running_conforma::text, '[]') FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null)

    local running_count=0
    local running_items=""

    if [ -n "$running_builds_json" ] && [ "$running_builds_json" != "[]" ]; then
        local build_items=$(echo "$running_builds_json" | jq -r '.[] | "\(.component)|\(.timestamp)|\(.pipelinerun_name)|Build"' 2>/dev/null)
        [ -n "$build_items" ] && running_items="$build_items"
    fi

    if [ -n "$running_conforma_json" ] && [ "$running_conforma_json" != "[]" ]; then
        local conforma_items=$(echo "$running_conforma_json" | jq -r '.[] | "\(.component)|\(.timestamp)|\(.pipelinerun_name)|Conforma"' 2>/dev/null)
        if [ -n "$conforma_items" ]; then
            [ -n "$running_items" ] && running_items="$running_items"$'\n'"$conforma_items" || running_items="$conforma_items"
        fi
    fi

    if [ -n "$running_items" ]; then
        running_count=$(echo "$running_items" | wc -l)
        echo -e "${BOLD}In Progress (${running_count}):${NC}"
        printf "  %-40s %-10s %-18s %s\n" "Component" "Type" "Started" "Duration"
        printf "  %-40s %-10s %-18s %s\n" "$(printf '%0.s-' {1..40})" "$(printf '%0.s-' {1..10})" "$(printf '%0.s-' {1..18})" "$(printf '%0.s-' {1..10})"

        local now_epoch=$(date +%s)
        echo "$running_items" | while IFS='|' read -r r_comp r_ts r_pr r_type; do
            local start_epoch=$(date -d "$r_ts" +%s 2>/dev/null || echo "$now_epoch")
            local elapsed=$(( now_epoch - start_epoch ))
            local duration_str=""
            if [ "$elapsed" -ge 7200 ]; then
                duration_str="${YELLOW}⚠ $((elapsed / 3600))h $((elapsed % 3600 / 60))m (stuck?)${NC}"
            elif [ "$elapsed" -ge 3600 ]; then
                duration_str="$((elapsed / 3600))h $((elapsed % 3600 / 60))m"
            else
                duration_str="$((elapsed / 60))m"
            fi
            local started_fmt=$(date -d "$r_ts" '+%d %b %H:%M' 2>/dev/null || echo "$r_ts")
            printf "  %-40s %-10s %-18s " "${r_comp:0:40}" "$r_type" "$started_fmt"
            echo -e "$duration_str"
        done
        echo ""
    fi
}

display_alerts_release_failures() {
    local offset="${1:-0}"

    if ! oc whoami -t &>/dev/null; then
        echo -e "${BOLD}Release Failures:${NC}"
        echo -e "  ${YELLOW}(oc login required)${NC}"
        echo ""
        return
    fi

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$RELENG_NAMESPACE" -o json 2>/dev/null)

    if [ -z "$releases_json" ] || [ "$(echo "$releases_json" | jq '.items | length' 2>/dev/null)" = "0" ]; then
        return
    fi

    local app_version="${APPLICATION_NAME#*-v}"
    local now_epoch
    now_epoch=$(date +%s)

    # Filter to current app's releases. Group by release plan:
    # - Skip plans that have any successful release (superseded failures)
    # - Show only the latest failed/stuck release per plan (not all retries)
    local failed_releases
    failed_releases=$(echo "$releases_json" | jq -c --arg ver "$app_version" --argjson now "$now_epoch" '
        [.items[]
         | select(.spec.releasePlan | contains($ver))
         | {
             name: .metadata.name,
             plan: .spec.releasePlan,
             created: .metadata.creationTimestamp,
             released_status: ([.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"),
             released_reason: ([.status.conditions[]? | select(.type == "Released")] | .[0] | .reason // "Unknown"),
             error_msg: ([.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")] | .[0] | .message // ""),
             managed_reason: ([.status.conditions[]? | select(.type == "ManagedPipelineProcessed")] | .[0] | .reason // "Unknown"),
             age_hours: ((.metadata.creationTimestamp | sub("\\.[0-9]+"; "") | strptime("%Y-%m-%dT%H:%M:%S%Z") | mktime) as $ts | if $ts then ($now - $ts) / 3600 else 0 end)
           }
        ]
        | group_by(.plan)
        | [.[]
           | select(all(.released_status != "True"))
           | sort_by(.created) | reverse | .[0]
          ]
        | [.[] | select(
             (.released_status == "False") or
             (.released_status == "Unknown" and .age_hours > 24)
           )]
        | sort_by(.created) | reverse
    ' 2>/dev/null)

    local release_count
    release_count=$(echo "$failed_releases" | jq 'length' 2>/dev/null || echo "0")

    echo -e "${BOLD}Release Failures (${release_count}):${NC}"

    if [ "$release_count" = "0" ]; then
        echo -e "  ${GREEN}✓ No release failures${NC}"
    else
        printf "  %-4s %-44s %-14s %-6s  %s\n" "#" "Release" "Type" "Target" "Status"
        printf "  %-4s %-44s %-14s %-6s  %s\n" "---" "$(printf '%0.s-' {1..44})" "--------------" "------" "----------"

        while IFS= read -r rel; do
            offset=$((offset + 1))
            local name plan released_status error_msg age_hours managed_reason
            name=$(echo "$rel" | jq -r '.name')
            plan=$(echo "$rel" | jq -r '.plan')
            released_status=$(echo "$rel" | jq -r '.released_status')
            error_msg=$(echo "$rel" | jq -r '.error_msg')
            age_hours=$(echo "$rel" | jq -r '.age_hours | floor')
            managed_reason=$(echo "$rel" | jq -r '.managed_reason')

            local classification target type
            classification=$(_release_classify "$plan")
            target=$(echo "$classification" | cut -d'|' -f1)
            type=$(echo "$classification" | cut -d'|' -f2)
            local type_label
            type_label=$(_release_type_label "$type")
            local target_label
            target_label=$(echo "$target" | sed 's/stage/Stage/;s/prod/Prod/')

            local status_display
            if [ "$released_status" = "False" ]; then
                local short_err=""
                [ -n "$error_msg" ] && short_err=" ($(echo "$error_msg" | grep -oP 'task \K[^ :]+' | head -1))"
                [ -z "$short_err" ] && [ -n "$error_msg" ] && short_err=" (${error_msg:0:30})"
                status_display="${RED}✗ Failed${NC}${short_err}"
            else
                status_display="${YELLOW}◌ Stuck ${age_hours}h${NC}"
            fi

            printf "  %-4s %-44s %-14s %-6s  " "$offset" "${name:0:44}" "$type_label" "$target_label"
            echo -e "$status_display"
        done < <(echo "$failed_releases" | jq -c '.[]' 2>/dev/null)
    fi
    echo ""
}

display_alerts_exception_row() {
    local days_left="$1" eff_until="$2" value="$3" image_url="$4" reference="$5" source="$6" gl_link="$7"
    local max_value_len="${8:-45}" max_comp_len="${9:-30}"

    local src_label="${source:-?}"
    src_label=$(echo "$src_label" | sed 's/registry-[a-z]*-/reg-/; s/fbc-[a-z]*-/fbc-/; s/stage/stg/')

    local comp_name=""
    if [ -n "$image_url" ]; then
        comp_name=$(echo "$image_url" | grep -oP '[^/]+$' | sed 's/:.*//; s/@.*//' 2>/dev/null || true)
        local app_suffix="${APPLICATION_NAME#*-v}"
        comp_name="${comp_name}-${app_suffix}"
    else
        comp_name="(global rule)"
    fi

    local jira_key="-"
    if [ -n "$reference" ]; then
        jira_key=$(echo "$reference" | grep -oP '[A-Z]+-[0-9]+' 2>/dev/null | tail -1 || true)
        [ -z "$jira_key" ] && jira_key="$reference"
    fi

    local comp_short="${comp_name:0:$max_comp_len}"
    echo "${src_label}|${comp_short}|${jira_key}|${gl_link}"
}

display_alerts_expiring_exceptions() {
    local all_exceptions
    all_exceptions=$(fetch_expiring_exceptions 10 2>/dev/null || true)

    local expiring_soon
    expiring_soon=$(echo "$all_exceptions" | awk -F'|' '$1 >= -1 && $1 <= 10' || true)
    local expired_count
    expired_count=$(echo "$all_exceptions" | awk -F'|' '$1 < -1 && $1 != ""' | wc -l)

    # Batch query: violation counts per rule (for impact column)
    local impact_data=""
    impact_data=$(sql "
        WITH extracted AS (
            SELECT component_name,
                   (regexp_matches(violation_summary, '(?<=[✕✗] \[Violation\] )([a-z_]+\.[a-z_]+)', 'g'))[1] as rule
            FROM conforma_results
            WHERE application = '${APPLICATION_NAME}' AND is_resolved = FALSE
              AND violation_summary IS NOT NULL
        )
        SELECT rule, COUNT(DISTINCT component_name), COUNT(*)
        FROM extracted GROUP BY rule;
    " 2>/dev/null)

    if [ -n "$expiring_soon" ]; then
        local exp_count
        exp_count=$(echo "$expiring_soon" | wc -l)
        local expired_msg=""
        [ "$expired_count" -gt 0 ] && expired_msg=" ${RED}(${expired_count} already expired)${NC}"
        echo -e "${BOLD}${YELLOW}⚠ Expiring Exceptions — next 10 days (${exp_count}):${NC}${expired_msg}"
        printf "  %-6s %-12s %-8s %-38s %-22s %-12s %s\n" "Days" "Expires" "Source" "Rule" "Component" "JIRA" "Impact"
        printf "  %-6s %-12s %-8s %-38s %-22s %-12s %s\n" "------" "------------" "--------" "$(printf '%0.s-' {1..38})" "$(printf '%0.s-' {1..22})" "$(printf '%0.s-' {1..12})" "$(printf '%0.s-' {1..20})"
        echo "$expiring_soon" | while IFS='|' read -r days_left eff_until value image_url reference source gl_link; do
            [ -z "$days_left" ] && continue
            local day_color="$NC"
            local day_label="${days_left}d"
            if [ "$days_left" -lt 0 ]; then
                day_color="$RED"; day_label="TODAY"
            elif [ "$days_left" -le 3 ]; then
                day_color="$RED"
            elif [ "$days_left" -le 7 ]; then
                day_color="$YELLOW"
            fi
            local parsed
            parsed=$(display_alerts_exception_row "$days_left" "$eff_until" "$value" "$image_url" "$reference" "$source" "$gl_link" 22)
            IFS='|' read -r src_label comp_short jira_key row_gl_link <<< "$parsed"

            # Look up impact: match rule from exception value against violation data
            local impact_label="-"
            if [ -n "$impact_data" ]; then
                local exc_rule="${value%%:*}"
                local match_line
                match_line=$(echo "$impact_data" | grep "^ *${exc_rule} *|" | head -1)
                if [ -n "$match_line" ]; then
                    local ic_comps ic_viols
                    ic_comps=$(echo "$match_line" | cut -d'|' -f2 | tr -d ' ')
                    ic_viols=$(echo "$match_line" | cut -d'|' -f3 | tr -d ' ')
                    impact_label="${ic_comps}c/${ic_viols}v"
                fi
            fi

            echo -ne "  ${day_color}$(printf '%-6s' "$day_label")${NC} "
            printf "%-12s %-8s %-38s %-22s %-12s %s\n" "$eff_until" "$src_label" "${value:0:38}" "${comp_short:0:22}" "$jira_key" "$impact_label"
            [ -n "$row_gl_link" ] && echo -e "         ${CYAN}↳ ${row_gl_link}${NC}"
        done
        echo ""
    fi

    local already_expired
    already_expired=$(echo "$all_exceptions" | awk -F'|' '$1 < -1 && $1 != ""' || true)
    if [ -n "$already_expired" ]; then
        local ae_count
        ae_count=$(echo "$already_expired" | wc -l)
        echo -e "${BOLD}${RED}✕ Expired Exceptions (${ae_count}):${NC}"
        printf "  %-8s %-12s %-8s %-40s %-30s %s\n" "Expired" "Date" "Source" "Rule" "Component" "JIRA"
        printf "  %-8s %-12s %-8s %-40s %-30s %s\n" "--------" "------------" "--------" "$(printf '%0.s-' {1..40})" "$(printf '%0.s-' {1..30})" "$(printf '%0.s-' {1..16})"
        echo "$already_expired" | while IFS='|' read -r days_left eff_until value image_url reference source gl_link; do
            [ -z "$days_left" ] && continue
            local ago=$(( -1 * days_left ))
            local parsed
            parsed=$(display_alerts_exception_row "$days_left" "$eff_until" "$value" "$image_url" "$reference" "$source" "$gl_link" 40)
            IFS='|' read -r src_label comp_short jira_key row_gl_link <<< "$parsed"
            echo -ne "  ${RED}$(printf '%-8s' "${ago}d ago")${NC} "
            printf "%-12s %-8s %-40s %-30s %s\n" "$eff_until" "$src_label" "${value:0:40}" "$comp_short" "$jira_key"
            [ -n "$row_gl_link" ] && echo -e "            ${CYAN}↳ ${row_gl_link}${NC}"
        done
        echo ""
    fi
}

# GET ALERTS - unified view of build failures + conforma
cmd_get_alerts() {
    _check_db || return 1
    local refresh=false
    local target_date=""
    local from_date=""
    local to_date=""
    local show_all=false
    local show_grouped=false
    local json_output=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --refresh|-r) refresh=true; shift ;;
            --all) show_all=true; shift ;;
            --group|-g) show_grouped=true; shift ;;
            --json) json_output=true; shift ;;
            --date)
                shift
                target_date=$(date -d "${1:?--date requires a value}" '+%Y-%m-%d' 2>/dev/null)
                if [ -z "$target_date" ]; then
                    echo -e "${RED}Error: Invalid date: $1${NC}"
                    echo "Examples: --date 2026-04-20, --date yesterday, --date '3 days ago'"
                    return 1
                fi
                shift ;;
            --from)
                shift
                from_date=$(date -d "${1:?--from requires a value}" '+%Y-%m-%d' 2>/dev/null)
                [ -z "$from_date" ] && { echo -e "${RED}Error: Invalid date: $1${NC}"; return 1; }
                shift ;;
            --to)
                shift
                to_date=$(date -d "${1:?--to requires a value}" '+%Y-%m-%d' 2>/dev/null)
                [ -z "$to_date" ] && { echo -e "${RED}Error: Invalid date: $1${NC}"; return 1; }
                shift ;;
            *) shift ;;
        esac
    done

    if [ "$json_output" = true ]; then
        local builds_json conforma_json
        builds_json=$(sql_json "
            SELECT component_name AS component, 'Failed' AS status,
                   error_type, first_detected_at AS first_seen,
                   last_updated_at AS last_seen,
                   CASE WHEN build_logs IS NOT NULL AND build_logs != '' THEN true ELSE false END AS has_logs,
                   CASE WHEN ai_analysis_id IS NOT NULL THEN true ELSE false END AS has_analysis
            FROM build_failures
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY last_updated_at DESC
        ")
        conforma_json=$(sql_json "
            SELECT component_name AS component, 'Conforma Violation' AS status,
                   scenario AS error_type, first_detected_at AS first_seen,
                   last_updated_at AS last_seen,
                   CASE WHEN violation_details IS NOT NULL THEN true ELSE false END AS has_details,
                   CASE WHEN ai_analysis_id IS NOT NULL THEN true ELSE false END AS has_analysis
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY last_updated_at DESC
        ")
        local total_builds total_conforma
        total_builds=$(echo "$builds_json" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)
        total_conforma=$(echo "$conforma_json" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)
        python3 -c "
import json, sys
builds = json.loads(sys.argv[1]) if sys.argv[1] else []
conforma = json.loads(sys.argv[2]) if sys.argv[2] else []
result = {
    'application': sys.argv[3],
    'build_failures': builds,
    'conforma_violations': conforma,
    'total_count': len(builds) + len(conforma)
}
print(json.dumps(result, default=str, indent=2))
" "$builds_json" "$conforma_json" "$APPLICATION_NAME"
        return
    fi

    if [ -n "$target_date" ]; then
        cmd_get_alerts_on_date "$target_date"
        return
    fi
    if [ -n "$from_date" ]; then
        [ -z "$to_date" ] && to_date=$(date '+%Y-%m-%d')
        cmd_get_alerts_range "$from_date" "$to_date"
        return
    fi

    if [ "$show_grouped" = true ]; then
        cmd_get_alerts_grouped
        return
    fi

    if [ "$show_all" = true ]; then
        local _all_apps
        _all_apps=$(sql "
            SELECT application FROM (
                SELECT DISTINCT application FROM build_failures   WHERE is_resolved = FALSE
                UNION
                SELECT DISTINCT application FROM conforma_results WHERE is_resolved = FALSE
            ) combined ORDER BY application;
        " 2>/dev/null)
        if [ -z "$_all_apps" ]; then
            echo -e "${GREEN}No active alerts in any application.${NC}"
            return
        fi
        local _saved_app="$APPLICATION_NAME"
        while IFS= read -r _app; do
            [ -z "$_app" ] && continue
            APPLICATION_NAME="$_app"
            section_header "Alerts — ${_app}"
            echo ""
            local _bc
            _bc=$(sql_count_failing_builds)
            display_alerts_build_failures "[]"
            display_alerts_conforma_failures "${_bc:-0}"
        done <<< "$_all_apps"
        APPLICATION_NAME="$_saved_app"
        return
    fi

    section_header "Alerts — ${APPLICATION_NAME}"
    echo ""

    if [ "$refresh" = true ]; then
        echo -e "${CYAN}Refreshing builds and conforma (last 5 days)...${NC}"
        cd "$SCRIPT_DIR/src"

        local sync_out_file=$(mktemp)
        local conforma_log=$(mktemp)
        local t_start=$SECONDS

        # Run builds and conforma refresh in parallel (5-day window, 180s per script)
        # Note: collect_conforma.py is too slow for refresh — only sync status
        timeout 180 python3 check_sync_status.py --recent-days 5 > "$sync_out_file" 2>/dev/null &
        local pid_sync=$!
        timeout 180 python3 check_conforma_status.py --recent-days 5 > "$conforma_log" 2>/dev/null &
        local pid_conforma=$!

        # Wait for both
        local sync_ok=true conforma_ok=true
        wait $pid_sync 2>/dev/null || sync_ok=false
        wait $pid_conforma 2>/dev/null || conforma_ok=false
        local t_elapsed=$((SECONDS - t_start))

        if [ "$sync_ok" = true ] && [ -s "$sync_out_file" ]; then
            local missing_count
            missing_count=$(python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('missing_in_db',[])))" < "$sync_out_file" 2>/dev/null)
            if [ -n "$missing_count" ] && [ "$missing_count" -gt 0 ] 2>/dev/null; then
                echo -e "${CYAN}Collected ${missing_count} component(s) missing from DB${NC}"
            fi
        else
            echo -e "${YELLOW}Build sync timed out or failed (${t_elapsed}s)${NC}"
        fi

        [ "$conforma_ok" = true ] || echo -e "${YELLOW}Conforma refresh timed out or failed (${t_elapsed}s)${NC}"
        echo -e "${CYAN}Refresh completed in ${t_elapsed}s${NC}"

        rm -f "$sync_out_file" "$conforma_log"
        cd "$SCRIPT_DIR"
        echo ""
    fi

    local sync_row=$(sql "
        SELECT
            TO_CHAR(last_checked_at, 'YYYY-MM-DD HH24:MI:SS'),
            EXTRACT(EPOCH FROM (NOW() - last_checked_at))::int,
            COALESCE(retriggered_components::text, '[]')
        FROM sync_status WHERE application = '$APPLICATION_NAME';
    " 2>/dev/null)

    local sync_date age_seconds retriggered_json
    IFS='|' read -r sync_date age_seconds retriggered_json <<< "$sync_row"
    sync_date=$(trim "$sync_date")
    age_seconds=$(echo "$age_seconds" | tr -d ' ')
    local age_minutes=0
    [ -n "$age_seconds" ] && age_minutes=$((age_seconds / 60))
    [ -n "$sync_date" ] && echo -e "${CYAN}Last sync: ${sync_date}, ${age_minutes}m ago${NC}" && echo ""

    show_freeze_banner
    show_outage_banner

    # Release schedule countdown
    local sched_data
    sched_data=$(_release_get_schedule "$APPLICATION_NAME" 2>/dev/null)
    if [ -n "$sched_data" ]; then
        local s_pf s_ff s_cf s_rc s_rw s_ga s_nr
        IFS='|' read -r s_pf s_ff s_cf s_rc s_rw s_ga s_nr <<< "$sched_data"
        s_pf=$(trim "$s_pf"); s_ff=$(trim "$s_ff"); s_cf=$(trim "$s_cf")
        s_rc=$(trim "$s_rc"); s_rw=$(trim "$s_rw"); s_ga=$(trim "$s_ga")

        _alert_sched_fmt() {
            local label="$1" dt="$2"
            [ -z "$dt" ] && return
            local d; d=$(_release_days_until "$dt")
            local fmt; fmt=$(date -d "$dt" '+%b %d' 2>/dev/null || echo "$dt")
            if [ -n "$d" ] && [ "$d" -le 0 ]; then
                echo -e "${RED}${label}: ${fmt} (passed)${NC}"
            elif [ -n "$d" ] && [ "$d" -le 7 ]; then
                echo -e "${YELLOW}${label}: ${fmt} (${d}d)${NC}"
            elif [ -n "$d" ]; then
                echo "${label}: ${fmt} (${d}d)"
            fi
        }

        local parts=()
        local p
        p=$(_alert_sched_fmt "Code Freeze" "$s_cf") && [ -n "$p" ] && parts+=("$p")
        p=$(_alert_sched_fmt "RC" "$s_rc") && [ -n "$p" ] && parts+=("$p")
        p=$(_alert_sched_fmt "GA" "$s_ga") && [ -n "$p" ] && parts+=("$p")

        if [ "${#parts[@]}" -gt 0 ]; then
            local line="${parts[0]}"
            [ "${#parts[@]}" -ge 2 ] && line="${line}  │  ${parts[1]}"
            [ "${#parts[@]}" -ge 3 ] && line="${line}  │  ${parts[2]}"
            echo -e "${BOLD}Release:${NC}  ${line}"
            echo ""
        fi
    fi

    local build_count=$(sql_count_failing_builds)
    display_alerts_build_failures "$retriggered_json"

    local conforma_count=$(sql "
        SELECT COUNT(*) FROM (
            SELECT DISTINCT ON (component_name) component_name
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY component_name, last_updated_at DESC
        ) sub;
    " 2>/dev/null)
    display_alerts_conforma_failures "${build_count:-0}"

    local release_count=0
    display_alerts_release_failures "$((${build_count:-0} + ${conforma_count:-0}))"

    local running_count=0
    display_alerts_in_progress

    local total=$((${build_count:-0} + ${conforma_count:-0}))
    echo -e "${BOLD}Total alerts: ${RED}${total}${NC} (${build_count:-0} builds, ${conforma_count:-0} conforma)"
    [ "${running_count:-0}" -gt 0 ] && echo -e "${BOLD}In progress: ${YELLOW}${running_count}${NC}"
    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'ic <number>' to see details (works across both sections)"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --refresh' to force a fresh check"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --group' to group failures by root cause"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --date yesterday' to see past alerts"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --all' to show alerts across all applications"
    echo ""
}

# GET ALERTS GROUPED - group failures by root cause
cmd_get_alerts_grouped() {
    section_header "Alerts by Root Cause — ${APPLICATION_NAME}"
    echo ""

    # Build failures grouped by failed_task + error_type + error_message (truncated)
    local build_groups=$(sql "
        WITH latest AS (
            SELECT DISTINCT ON (component_name)
                component_name, failed_step_name, error_type,
                COALESCE(REPLACE(REPLACE(LEFT(error_message, 80), E'\n', ' '), E'\r', ''), '') as error_snippet
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND is_resolved = FALSE
              AND status = 'Failed'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT
            COALESCE(failed_step_name, 'unknown') as task,
            COALESCE(error_type, '-') as etype,
            error_snippet,
            COUNT(*) as cnt,
            STRING_AGG(component_name, ', ' ORDER BY component_name) as components
        FROM latest
        GROUP BY COALESCE(failed_step_name, 'unknown'), COALESCE(error_type, '-'), error_snippet
        ORDER BY cnt DESC;
    " 2>/dev/null)

    if [ -n "$build_groups" ]; then
        echo -e "${BOLD}Build Failures:${NC}"
        echo ""
        while IFS='|' read -r task etype error_snippet cnt components; do
            task=$(trim "$task")
            etype=$(trim "$etype")
            error_snippet=$(trim "$error_snippet")
            cnt=$(trim "$cnt")
            components=$(trim "$components")
            echo -e "  ${RED}${task}${NC} / ${etype} (${cnt} components)"
            [ -n "$error_snippet" ] && echo -e "    ${YELLOW}\"${error_snippet}\"${NC}"
            echo "$components" | fold -s -w 70 | while IFS= read -r line; do
                echo -e "    ${CYAN}${line}${NC}"
            done
            echo ""
        done <<< "$build_groups"
    else
        echo -e "  ${GREEN}✓ No build failures${NC}"
        echo ""
    fi

    # Conforma failures grouped by scenario
    local conforma_groups=$(sql "
        WITH latest AS (
            SELECT DISTINCT ON (component_name, scenario)
                component_name, scenario, violations_count
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND is_resolved = FALSE
            ORDER BY component_name, scenario, last_updated_at DESC
        )
        SELECT
            scenario,
            COUNT(*) as cnt,
            SUM(violations_count) as total_violations,
            STRING_AGG(component_name || '(' || violations_count || ')', ', ' ORDER BY component_name) as components
        FROM latest
        GROUP BY scenario
        ORDER BY cnt DESC;
    " 2>/dev/null)

    if [ -n "$conforma_groups" ]; then
        echo -e "${BOLD}Conforma Failures:${NC}"
        echo ""
        while IFS='|' read -r scenario cnt total_v components; do
            scenario=$(trim "$scenario")
            cnt=$(trim "$cnt")
            total_v=$(trim "$total_v")
            components=$(trim "$components")
            echo -e "  ${RED}${scenario}${NC} (${cnt} components, ${total_v} total violations)"
            echo "$components" | fold -s -w 70 | while IFS= read -r line; do
                echo -e "    ${CYAN}${line}${NC}"
            done
            echo ""
        done <<< "$conforma_groups"
    else
        echo -e "  ${GREEN}✓ No Conforma failures${NC}"
        echo ""
    fi

    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts' for the numbered list view"
    echo ""
}

