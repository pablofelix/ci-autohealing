cmd_ai_status() {
    section_header "AI Analysis Status"
    echo ""

    # Build failures state breakdown
    local build_pending=$(sql "SELECT COUNT(*) FROM build_failures WHERE ai_analyzed = FALSE AND is_resolved = FALSE AND build_logs IS NOT NULL AND ai_skip_reason IS NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local build_no_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE ai_analyzed = FALSE AND is_resolved = FALSE AND build_logs IS NULL AND ai_skip_reason IS NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local build_skipped=$(sql "SELECT COUNT(*) FROM build_failures WHERE ai_skip_reason IS NOT NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local build_analyzed=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.application = '$APPLICATION_NAME' AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local build_low_conf=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.application = '$APPLICATION_NAME' AND a.confidence_score < 0.7 AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local build_autofixable=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.application = '$APPLICATION_NAME' AND a.can_auto_fix = TRUE AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    # Conforma violations state breakdown
    local conforma_pending=$(sql "SELECT COUNT(*) FROM conforma_results WHERE ai_analyzed = FALSE AND is_resolved = FALSE AND violation_summary IS NOT NULL AND ai_skip_reason IS NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local conforma_skipped=$(sql "SELECT COUNT(*) FROM conforma_results WHERE ai_skip_reason IS NOT NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local conforma_analyzed=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.application = '$APPLICATION_NAME' AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local conforma_low_conf=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.application = '$APPLICATION_NAME' AND a.confidence_score < 0.7 AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local conforma_autofixable=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.application = '$APPLICATION_NAME' AND a.can_auto_fix = TRUE AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    # Total cost (both types)
    local total_cost=$(sql "
        SELECT COALESCE(SUM(a.cost_usd), 0)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    echo -e "${BOLD}Build Failures:${NC}"
    printf "  Pending:        %s awaiting analysis\n" "${build_pending:-0}"
    if [ "${build_no_logs:-0}" -gt 0 ]; then
        printf "  No logs yet:    %s (waiting for commit context collector)\n" "${build_no_logs:-0}"
    fi
    if [ "${build_skipped:-0}" -gt 0 ]; then
        printf "  Skipped:        %s (max retries or no-logs timeout)\n" "${build_skipped:-0}"
    fi
    printf "  Analyzed:       %s (last 30 days)\n" "${build_analyzed:-0}"
    if [ "${build_analyzed:-0}" -gt 0 ]; then
        local build_high=$((build_analyzed - build_low_conf))
        printf "    High conf (>=70%%): %s\n" "${build_high:-0}"
        if [ "${build_low_conf:-0}" -gt 0 ]; then
            printf "    Low conf  (<70%%):  %s  <- needs human review\n" "${build_low_conf:-0}"
        fi
        local build_pct=$((build_autofixable * 100 / build_analyzed))
        printf "  Auto-fixable:   %s (%s%%)\n" "${build_autofixable:-0}" "$build_pct"
    fi

    echo ""
    echo -e "${BOLD}Conforma Violations:${NC}"
    printf "  Pending:        %s awaiting analysis\n" "${conforma_pending:-0}"
    if [ "${conforma_skipped:-0}" -gt 0 ]; then
        printf "  Skipped:        %s (max retries)\n" "${conforma_skipped:-0}"
    fi
    printf "  Analyzed:       %s (last 30 days)\n" "${conforma_analyzed:-0}"
    if [ "${conforma_analyzed:-0}" -gt 0 ]; then
        local conforma_high=$((conforma_analyzed - conforma_low_conf))
        printf "    High conf (>=70%%): %s\n" "${conforma_high:-0}"
        if [ "${conforma_low_conf:-0}" -gt 0 ]; then
            printf "    Low conf  (<70%%):  %s  <- needs human review\n" "${conforma_low_conf:-0}"
        fi
        local conforma_pct=$((conforma_autofixable * 100 / conforma_analyzed))
        printf "  Auto-fixable:   %s (%s%%)\n" "${conforma_autofixable:-0}" "$conforma_pct"
    fi

    echo ""
    printf "${BOLD}Total cost:${NC}   \$%.2f (last 30 days)\n" "${total_cost:-0}"
    echo ""

    # Show recent analyses (both types)
    local recent_count=$(sql "
        SELECT COUNT(*)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '7 days';" 2>/dev/null)

    if [ "${recent_count:-0}" -gt 0 ]; then
        echo -e "${BOLD}Recent analyses (last 7 days):${NC}"
        sql_table "
            SELECT
                ROW_NUMBER() OVER (ORDER BY a.analyzed_at DESC) as \"#\",
                COALESCE(b.component_name, c.component_name) as \"Component\",
                CASE
                    WHEN a.build_failure_id IS NOT NULL THEN 'Build'
                    ELSE 'Conforma'
                END as \"Type\",
                a.failure_category as \"Category\",
                ROUND(a.confidence_score * 100) || '%' as \"Confidence\",
                CASE WHEN a.can_auto_fix THEN '✓' ELSE '✗' END as \"Fixable\"
            FROM ai_analysis a
            LEFT JOIN build_failures b ON a.build_failure_id = b.id
            LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
            WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
              AND a.analyzed_at > NOW() - INTERVAL '7 days'
            ORDER BY a.analyzed_at DESC
            LIMIT 10;
        "
        echo ""
    fi

    local total_pending=$((build_pending + conforma_pending))
    if [ "$total_pending" -gt 0 ]; then
        echo -e "${CYAN}Run 'ic ai analyze --all' to analyze pending failures and violations${NC}"
    else
        echo -e "${GREEN}✓ No pending failures or violations to analyze${NC}"
    fi
    echo ""
}

cmd_ai_stats() {
    section_header "AI Analysis Statistics"
    echo ""

    # By category and type
    echo -e "${BOLD}Analyses by Category (last 30 days):${NC}"
    sql_table "
        SELECT
            CASE
                WHEN a.build_failure_id IS NOT NULL THEN 'Build'
                ELSE 'Conforma'
            END as \"Type\",
            a.failure_category as \"Category\",
            COUNT(*) as \"Count\",
            ROUND(AVG(a.confidence_score * 100)) || '%' as \"Avg Confidence\",
            SUM(CASE WHEN a.can_auto_fix THEN 1 ELSE 0 END) as \"Auto-fixable\"
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days'
        GROUP BY
            CASE WHEN a.build_failure_id IS NOT NULL THEN 'Build' ELSE 'Conforma' END,
            a.failure_category
        ORDER BY COUNT(*) DESC;
    "
    echo ""

    # By date
    echo -e "${BOLD}Analyses by Date (last 7 days):${NC}"
    sql_table "
        SELECT
            DATE(a.analyzed_at) as \"Date\",
            COUNT(*) as \"Analyzed\",
            SUM(CASE WHEN a.can_auto_fix THEN 1 ELSE 0 END) as \"Auto-fixable\",
            COALESCE(SUM(a.cost_usd), 0)::numeric(10,2) as \"Cost USD\"
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '7 days'
        GROUP BY DATE(a.analyzed_at)
        ORDER BY DATE(a.analyzed_at) DESC;
    "
    echo ""

    # Token usage (both types)
    local total_tokens=$(sql "
        SELECT COALESCE(SUM(a.tokens_used), 0)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local avg_tokens=$(sql "
        SELECT COALESCE(AVG(a.tokens_used), 0)::int
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    echo -e "${BOLD}Token Usage (last 30 days):${NC}"
    printf "  Total tokens: %s\n" "${total_tokens:-0}"
    printf "  Avg per analysis: %s tokens\n" "${avg_tokens:-0}"
    echo ""
}

cmd_ai_stats_fixes() {
    section_header "Fix Quality Metrics (last 30 days)"
    echo ""

    local has_data
    has_data=$(docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -t -A -c "SELECT COUNT(*) FROM resolution_attempts WHERE attempted_at >= NOW() - INTERVAL '30 days'" 2>/dev/null | grep -v "Emulate Docker" | tr -d '[:space:]')
    if [ "$has_data" = "0" ] || [ -z "$has_data" ]; then
        echo "  No fix attempts in the last 30 days."
        echo "  Run 'ic fix <component>' to create fix PRs, then 'ic verify' to track outcomes."
        return 0
    fi

    echo -e "${BOLD}Fix Success Rate by Pattern:${NC}"
    sql_table "
        SELECT
            COALESCE(ep.pattern_name, '(no pattern)') as \"Pattern\",
            COUNT(*) as \"Fixes\",
            SUM(CASE WHEN ra.was_successful THEN 1 ELSE 0 END) as \"Success\",
            SUM(CASE WHEN ra.was_successful = FALSE THEN 1 ELSE 0 END) as \"Failed\",
            CASE WHEN SUM(CASE WHEN ra.was_successful IS NOT NULL THEN 1 ELSE 0 END) > 0
                THEN ROUND(SUM(CASE WHEN ra.was_successful THEN 1 ELSE 0 END)::numeric * 100 /
                     NULLIF(SUM(CASE WHEN ra.was_successful IS NOT NULL THEN 1 ELSE 0 END), 0)) || '%'
                ELSE '—'
            END as \"Rate\"
        FROM resolution_attempts ra
        LEFT JOIN ai_analysis a ON (a.build_failure_id = ra.build_failure_id OR a.conforma_result_id = ra.conforma_result_id)
        LEFT JOIN error_patterns ep ON ep.id = a.error_pattern_id
        WHERE ra.attempted_at >= NOW() - INTERVAL '30 days'
        GROUP BY ep.pattern_name
        ORDER BY COUNT(*) DESC;
    "
    echo ""

    echo -e "${BOLD}PR Merge Time:${NC}"
    sql_table "
        SELECT
            CASE WHEN ra.build_failure_id IS NOT NULL THEN 'Build' ELSE 'Conforma' END as \"Type\",
            COUNT(*) FILTER (WHERE ra.pr_merged) as \"Merged\",
            COUNT(*) FILTER (WHERE ra.was_successful) as \"Success\",
            COALESCE(
                ROUND(AVG(EXTRACT(EPOCH FROM (ra.pr_merged_at - ra.attempted_at)) / 3600)::numeric, 1),
                0
            ) || 'h' as \"Avg Merge Time\"
        FROM resolution_attempts ra
        WHERE ra.attempted_at >= NOW() - INTERVAL '30 days'
        GROUP BY CASE WHEN ra.build_failure_id IS NOT NULL THEN 'Build' ELSE 'Conforma' END;
    "
    echo ""

    echo -e "${BOLD}Hardest Categories (lowest success rate):${NC}"
    sql_table "
        SELECT
            a.failure_category as \"Category\",
            COUNT(ra.*) as \"Fix Attempts\",
            SUM(CASE WHEN ra.was_successful THEN 1 ELSE 0 END) as \"Successes\",
            CASE WHEN COUNT(ra.*) > 0
                THEN ROUND(SUM(CASE WHEN ra.was_successful THEN 1 ELSE 0 END)::numeric * 100 / COUNT(ra.*)) || '%'
                ELSE '—'
            END as \"Rate\"
        FROM ai_analysis a
        JOIN resolution_attempts ra ON (ra.build_failure_id = a.build_failure_id OR ra.conforma_result_id = a.conforma_result_id)
        WHERE ra.attempted_at >= NOW() - INTERVAL '30 days'
        GROUP BY a.failure_category
        ORDER BY
            CASE WHEN COUNT(ra.*) > 0 THEN SUM(CASE WHEN ra.was_successful THEN 1 ELSE 0 END)::numeric / COUNT(ra.*) ELSE 1 END ASC;
    "
    echo ""
}

cmd_patterns() {
    local subcmd="${1:-list}"
    shift || true
    case "$subcmd" in
        list) cmd_patterns_list "$@" ;;
        show) cmd_patterns_show "$@" ;;
        learn) cmd_patterns_learn ;;
