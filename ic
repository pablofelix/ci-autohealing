${CYAN}kubectl-style interface for Konflux CI/CD monitoring${NC}

${BOLD}USAGE:${NC}
    ic get <resource> [name] [options]
    ic describe <resource> <name>
    ic <number>                              Shortcut: describe Nth component

${BOLD}RESOURCES:${NC}

  ${CYAN}components${NC}           Components with build failures
  ${CYAN}pipelineruns, pr${NC}     PipelineRun failures
  ${CYAN}failures${NC}             Build failures (alias for pipelineruns)
  ${CYAN}apps${NC}                 Available applications (versions)

${BOLD}COMMANDS:${NC}

  ${CYAN}get <resource>${NC}
    ic get components                        List all failing components
    ic get component <name>                  Get component summary
    ic get pipelineruns [--limit N]          List all PipelineRun failures
    ic get pipelinerun <name>                Get PipelineRun details
