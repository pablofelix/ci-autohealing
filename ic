_release_blocker_advice() {
    local message="${1:-}" release_name="${2:-}"
    local advice=""
    case "$message" in
        *"ReleasePlan"*"not found"*)
            advice="ReleasePlan doesn't exist — verify the name in the Release CR matches an existing ReleasePlan in namespace ${NAMESPACE}" ;;
        *verify-access-to-resources*)
            advice="Permission issue — verify the service account has access to the target namespace and resources" ;;
        *apply-mapping*)
            advice="Image mapping failed — check ReleasePlanAdmission component mappings in konflux-release-data repo" ;;
        *publish-pyxis-repository*)
            advice="Pyxis publish failed — may be a transient issue, check advisory status and retry the release" ;;
        *verify-conforma*)
            advice="EC policy violations — run 'ic describe release ${release_name} --logs' to see specific violations" ;;
        *"Release validation"*)
            advice="Release failed pre-pipeline validation — check the Validated condition message for details" ;;
        *)
            [ -n "$release_name" ] && advice="Run 'ic describe release ${release_name} --logs' for error details" ;;
    esac
    [ -n "$advice" ] && echo -e "  → ${BOLD}Suggested action:${NC} ${advice}"
