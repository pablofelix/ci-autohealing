_release_days_until() {
    local target_date="$1"
    [ -z "$target_date" ] && return
    local today_epoch target_epoch
    today_epoch=$(date '+%s' 2>/dev/null)
    target_epoch=$(date -d "$target_date" '+%s' 2>/dev/null)
    [ -z "$target_epoch" ] && return
    local diff=$(( (target_epoch - today_epoch) / 86400 ))
    echo "$diff"
}

