        shift; cmd_freeze "$@"
        ;;
    report)
        case "${2:-}" in
            build)    shift 2; cmd_report_build "$@" ;;
            conforma) shift 2; cmd_conforma_report "$@" ;;
            *) echo -e "${RED}Usage: ic report <build|conforma> [options]${NC}" ;;
        esac
        ;;
    conforma)
        case "${2:-}" in
            report)     shift 2; cmd_conforma_report "$@" ;;
            categories) shift 2; cmd_conforma_categories "$@" ;;
            csv)        shift 2; cmd_conforma_csv "$@" ;;
            snapshot)   shift 2; cmd_conforma_snapshot "$@" ;;
            scenarios)  shift 2; cmd_scenarios "$@" ;;
            *) cmd_get_conforma "${2:-}" ;;
        esac
        ;;
    scenarios|its)
        shift; cmd_scenarios "$@"
        ;;
    db)
        case "${2:-}" in
            status) cmd_db_status ;;
            query) cmd_db_query "${@:3}" ;;
            *) usage ;;
        esac
        ;;
    # Backward compatibility
    build|builds)
        case "${2:-}" in
            health) cmd_components_health ;;
            status) cmd_get_components ;;
            failures) shift 2; cmd_get_pipelineruns "$@" ;;
            get) cmd_get_pipelinerun "$3" ;;
            logs) cmd_describe_pipelinerun "$3" ;;
            *) usage ;;
        esac
        ;;
    components)
        case "${2:-}" in
            health) cmd_components_health ;;
            list)   cmd_get_components ;;
            *)      cmd_get_components ;;
        esac
        ;;
    component)
        case "${2:-}" in
            list) cmd_get_components ;;
            get) cmd_get_component "$3" ;;
            show) cmd_describe_component "$3" ;;
            *) usage ;;
        esac
        ;;
    release)
        case "${2:-}" in
            status)    shift 2; cmd_release_status "$@" ;;
            diff)      shift 2; cmd_release_diff "$@" ;;
            verify)    shift 2; cmd_release_verify "$@" ;;
            readiness) shift 2; cmd_release_readiness "$@" ;;
            history)   shift 2; cmd_release_history "$@" ;;
            *) cmd_get_releases "${@:2}" ;;
        esac
        ;;
    help|--help|-h|"") usage ;;
    *)
        # Number shortcut
        if [[ "$1" =~ ^[0-9]+$ ]]; then
            cmd_describe_by_number "$@"
        else
            echo -e "${RED}Error: Unknown command: $1${NC}"
            echo ""
            usage
        fi
        ;;
esac
