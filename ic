cmd_get_bindings() {
    section_header "RPA → EC Policy Bindings (${APPLICATION_NAME%%-v*})"

    local bindings_json
    bindings_json=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action bindings --name-filter ${APPLICATION_NAME%%-v*} 2>/dev/null || true)

    if [ -z "$bindings_json" ] || ! echo "$bindings_json" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        echo -e "${RED}Error: Could not fetch RPA bindings (oc login required)${NC}"
        echo ""
        return 1
    fi

    local count
    count=$(echo "$bindings_json" | jq '.bindings | length')
    local policies_count
    policies_count=$(echo "$bindings_json" | jq '.policies_count')

    echo -e "${CYAN}${policies_count} EC policies, ${count} bound RPAs${NC}"
    echo ""
    printf "  %-55s %-30s %s\n" "RPA" "Policy" "Application(s)"
    printf "  %-55s %-30s %s\n" "$(printf '%0.s-' {1..55})" "$(printf '%0.s-' {1..30})" "$(printf '%0.s-' {1..30})"

    echo "$bindings_json" | jq -r '.bindings[] | "\(.rpa_name)\t\(.policy)\t\(.application)"' | while IFS=$'\t' read -r rpa policy app; do
        local rpa_short="${rpa:0:55}"
        if echo "$app" | grep -q ','; then
            local n
            n=$(echo "$app" | tr ',' '\n' | wc -l)
            app="${n} apps"
        fi
        printf "  %-55s %-30s %s\n" "$rpa_short" "$policy" "${app:0:30}"
    done

    echo ""
    echo -e "${CYAN}Tip:${NC} Data from K8s API (namespace: ${RELENG_NAMESPACE:-not set})"
    echo ""
}

cmd_get_policy_gap() {
    section_header "Stage → Prod EC Policy Gap"

    local gap_json
    local name_filter="${APPLICATION_NAME#*-v}"
    gap_json=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action policy-gap --name-filter "${name_filter}" --releng-namespace "${RELENG_NAMESPACE}" 2>/dev/null || true)

    if [ -z "$gap_json" ] || ! echo "$gap_json" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        echo -e "${RED}Error: Could not fetch policy gap (oc login required)${NC}"
        echo ""
        return 1
    fi

    local steps_count
    steps_count=$(echo "$gap_json" | jq '.steps | length')

    if [ "$steps_count" = "0" ]; then
        echo -e "  ${GREEN}✓ No policy differences found${NC}"
        echo ""
        return 0
    fi

    echo "$gap_json" | jq -r '.steps[] | @base64' | while read -r step_b64; do
        local step_json
        step_json=$(echo "$step_b64" | base64 -d)

        local step_name stage_pol prod_pol stage_exc prod_exc common gap_count prod_only
        step_name=$(echo "$step_json" | jq -r '.step')
        stage_pol=$(echo "$step_json" | jq -r '.stage_policy')
        prod_pol=$(echo "$step_json" | jq -r '.prod_policy')
        stage_exc=$(echo "$step_json" | jq -r '.stage_exceptions')
        prod_exc=$(echo "$step_json" | jq -r '.prod_exceptions')
        common=$(echo "$step_json" | jq -r '.common')
        gap_count=$(echo "$step_json" | jq -r '.stage_only_count')
        prod_only=$(echo "$step_json" | jq -r '.prod_only_count')
        local stage_temp prod_temp
        stage_temp=$(echo "$step_json" | jq -r '.stage_temporary')
        prod_temp=$(echo "$step_json" | jq -r '.prod_temporary')

        local step_label
        step_label=$(echo "$step_name" | sed 's/^./\U&/')

        local gap_indicator="${GREEN}✓${NC}"
        if [ "$gap_count" -gt 0 ]; then
            gap_indicator="${RED}${gap_count} at risk${NC}"
        fi

        echo -e "  ${BOLD}${step_label}${NC}  ${gap_indicator}"
        echo -e "    Stage policy: ${CYAN}${stage_pol}${NC} (${stage_exc} exceptions, ${stage_temp} temporary)"
        echo -e "    Prod policy:  ${CYAN}${prod_pol}${NC} (${prod_exc} exceptions, ${prod_temp} temporary)"
        echo -e "    Common: ${common}  |  Stage-only: ${gap_count}  |  Prod-only: ${prod_only}"

        if [ "$gap_count" -gt 0 ]; then
            echo ""
            echo -e "    ${YELLOW}Rules excepted in stage but NOT in prod:${NC}"
            echo "$step_json" | jq -r '.stage_only_rules[] | @base64' | while read -r rule_b64; do
                local rule_json rule_name rule_ref rule_perm rule_days
                rule_json=$(echo "$rule_b64" | base64 -d)
                rule_name=$(echo "$rule_json" | jq -r '.rule')
                rule_ref=$(echo "$rule_json" | jq -r '.reference')
                rule_perm=$(echo "$rule_json" | jq -r '.permanent')
                rule_days=$(echo "$rule_json" | jq -r '.days_left')

                local status_tag
                if [ "$rule_perm" = "true" ]; then
                    status_tag="${CYAN}permanent${NC}"
                elif [ "$rule_days" != "null" ]; then
                    if [ "$rule_days" -le 7 ]; then
                        status_tag="${RED}${rule_days}d left${NC}"
                    elif [ "$rule_days" -le 30 ]; then
                        status_tag="${YELLOW}${rule_days}d left${NC}"
                    else
                        status_tag="${GREEN}${rule_days}d left${NC}"
                    fi
                else
                    status_tag="active"
                fi

                local rule_short="${rule_name:0:65}"
                printf "      %-67s %s\n" "$rule_short" "$(echo -e "$status_tag")"
                if [ -n "$rule_ref" ] && [ "$rule_ref" != "config.exclude (permanent)" ]; then
                    echo -e "        ${DIM}${rule_ref}${NC}"
                fi
            done
        fi
        echo ""
    done

    echo -e "${CYAN}Tip:${NC} Stage-only rules = will fail in prod. Fix before promoting."
    echo -e "${CYAN}     ${NC}Temporary rules with days left = also expire from stage."
    echo ""
}

cmd_get_alerts_on_date() {
    local target_date="$1"
    local target_end="${target_date} 23:59:59"
    local display_date=$(date -d "$target_date" '+%a %d %b %Y')

    section_header "Alerts on ${display_date} — ${APPLICATION_NAME}"
    echo ""

    # Build failures that were active on that date
    local build_count=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$target_end'
          AND (resolved_at > '$target_date' OR is_resolved = FALSE);
    ")

    echo -e "${BOLD}Build Failures (${build_count:-0}):${NC}"

    if [ "${build_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No build failures on this date${NC}"
    else
        sql_table "
        WITH active_on_date AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, pipelinerun_name,
                first_detected_at, resolved_at, is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at <= '$target_end'
              AND (resolved_at > '$target_date' OR is_resolved = FALSE)
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT
            component_name as \"Component\",
            status as \"Status\",
            TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\",
            CASE WHEN resolved_at IS NOT NULL AND resolved_at <= '$target_end'
                THEN TO_CHAR(resolved_at, 'DD Mon HH24:MI')
                WHEN is_resolved THEN 'Later'
                ELSE 'Still open'
            END as \"Resolved\"
        FROM active_on_date
        ORDER BY first_detected_at DESC;
        "
    fi
    echo ""

    # Conforma failures that were active on that date
    local conforma_count=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$target_end'
          AND (resolved_at > '$target_date' OR is_resolved = FALSE);
    ")

    echo -e "${BOLD}Conforma Failures (${conforma_count:-0}):${NC}"

    if [ "${conforma_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No Conforma failures on this date${NC}"
    else
        sql_table "
        WITH active_on_date AS (
            SELECT DISTINCT ON (component_name)
                component_name, violations_count, warnings_count,
                first_detected_at, resolved_at, is_resolved
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at <= '$target_end'
              AND (resolved_at > '$target_date' OR is_resolved = FALSE)
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT
            component_name as \"Component\",
            violations_count as \"Violations\",
            warnings_count as \"Warnings\",
            TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\",
            CASE WHEN resolved_at IS NOT NULL AND resolved_at <= '$target_end'
                THEN TO_CHAR(resolved_at, 'DD Mon HH24:MI')
                WHEN is_resolved THEN 'Later'
                ELSE 'Still open'
            END as \"Resolved\"
        FROM active_on_date
        ORDER BY violations_count DESC;
        "
    fi
    echo ""

    local total=$((${build_count:-0} + ${conforma_count:-0}))
    echo -e "${BOLD}Total: ${total}${NC} (${build_count:-0} builds, ${conforma_count:-0} conforma)"
    echo ""
}

# GET ALERTS RANGE - changes between two dates
cmd_get_alerts_range() {
    local from_date="$1"
    local to_date="$2"
    local to_end="${to_date} 23:59:59"
    local display_from=$(date -d "$from_date" '+%a %d %b')
    local display_to=$(date -d "$to_date" '+%a %d %b %Y')

    section_header "Alerts ${display_from} → ${display_to} — ${APPLICATION_NAME}"
    echo ""

    # --- New failures in this range ---
    local new_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at >= '$from_date'
          AND first_detected_at <= '$to_end';
    ")
    local new_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at >= '$from_date'
          AND first_detected_at <= '$to_end';
    ")
    local new_total=$(( ${new_build:-0} + ${new_conforma:-0} ))

    echo -e "${BOLD}New Failures (${new_total}):${NC}"

    if [ "$new_total" = "0" ]; then
        echo -e "  ${GREEN}✓ No new failures in this period${NC}"
    else
        if [ "${new_build:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Build' as \"Type\",
                status as \"Status\",
                TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\"
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at >= '$from_date'
              AND first_detected_at <= '$to_end'
            ORDER BY component_name, first_detected_at DESC;
            "
        fi
        if [ "${new_conforma:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Conforma' as \"Type\",
                violations_count || ' violations' as \"Status\",
                TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\"
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at >= '$from_date'
              AND first_detected_at <= '$to_end'
            ORDER BY component_name, first_detected_at DESC;
            "
        fi
    fi
    echo ""

    # --- Resolved in this range ---
    local resolved_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND resolved_at >= '$from_date'
          AND resolved_at <= '$to_end';
    ")
    local resolved_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND resolved_at >= '$from_date'
          AND resolved_at <= '$to_end';
    ")
    local resolved_total=$(( ${resolved_build:-0} + ${resolved_conforma:-0} ))

    echo -e "${BOLD}Resolved (${resolved_total}):${NC}"

    if [ "$resolved_total" = "0" ]; then
        echo -e "  ${YELLOW}No failures resolved in this period${NC}"
    else
        if [ "${resolved_build:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Build' as \"Type\",
                TO_CHAR(first_detected_at, 'DD Mon') as \"Failed\",
                TO_CHAR(resolved_at, 'DD Mon HH24:MI') as \"Resolved\",
                EXTRACT(EPOCH FROM (resolved_at - first_detected_at))::int / 3600 || 'h' as \"Open For\"
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND resolved_at >= '$from_date'
              AND resolved_at <= '$to_end'
            ORDER BY component_name, resolved_at DESC;
            "
        fi
        if [ "${resolved_conforma:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Conforma' as \"Type\",
                TO_CHAR(first_detected_at, 'DD Mon') as \"Failed\",
                TO_CHAR(resolved_at, 'DD Mon HH24:MI') as \"Resolved\",
                EXTRACT(EPOCH FROM (resolved_at - first_detected_at))::int / 3600 || 'h' as \"Open For\"
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND resolved_at >= '$from_date'
              AND resolved_at <= '$to_end'
            ORDER BY component_name, resolved_at DESC;
            "
        fi
    fi
    echo ""

    # --- Still open at end of range ---
    local still_open_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$to_end'
          AND (resolved_at > '$to_end' OR is_resolved = FALSE);
    ")
    local still_open_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$to_end'
          AND (resolved_at > '$to_end' OR is_resolved = FALSE);
    ")
    local still_open=$(( ${still_open_build:-0} + ${still_open_conforma:-0} ))

    echo -e "${BOLD}Still Open at end of period (${still_open}):${NC}"
    if [ "$still_open" = "0" ]; then
        echo -e "  ${GREEN}✓ All clear${NC}"
    else
        echo -e "  ${still_open_build:-0} build failures, ${still_open_conforma:-0} conforma failures"
    fi
    echo ""
}

# CONFORMA CSV - fetch and compare with conforma-reporter CSV
cmd_conforma_csv() {
    local mode="summary"
    while [ $# -gt 0 ]; do
        case "$1" in
            --diff) mode="diff"; shift ;;
            --raw)  mode="raw"; shift ;;
            *)      shift ;;
        esac
    done

    local branch
    branch=$(app_to_reporter_branch "$APPLICATION_NAME")

    if [ -z "${GITHUB_TOKEN:-}" ]; then
        echo -e "${RED}Error: GITHUB_TOKEN not set. Export it in ~/.bashrc${NC}" >&2
        return 1
    fi

    local csv_data
    csv_data=$(curl -sH "Authorization: token $GITHUB_TOKEN" \
        "https://api.github.com/repos/acme-org/conforma-reporter/contents/latest/conforma-violations-report.csv?ref=${branch}" \
        | python3 -c "import json,sys,base64; d=json.load(sys.stdin); print(base64.b64decode(d['content']).decode())" 2>/dev/null)

    if [ -z "$csv_data" ]; then
        echo -e "${RED}Error: Could not fetch CSV from conforma-reporter (branch: $branch)${NC}"
        return 1
    fi

    if [ "$mode" = "raw" ]; then
        echo "$csv_data"
        return
    fi

    local csv_summary
    csv_summary=$(echo "$csv_data" | python3 "$SCRIPT_DIR/parsers/parse_csv_violations.py" 2>/dev/null)

    if [ "$mode" = "summary" ]; then
        echo -e "${BOLD}Conforma Reporter CSV (${branch})${NC}"
        echo -e "Source: https://github.com/acme-org/conforma-reporter/blob/${branch}/latest/conforma-violations-report.csv"
        echo ""
        printf "  ${BOLD}%-55s %-12s %s${NC}\n" "Component" "Violations" "Codes"
        printf "  %-55s %-12s %s\n" "---------" "----------" "-----"

        echo "$csv_summary" | while IFS='|' read -r comp count codes; do
            if [ "$comp" = "TOTAL" ]; then
                echo ""
                echo -e "  ${BOLD}Total: $count violations across $codes components${NC}"
            else
                printf "  %-55s %-12s %s\n" "$comp" "$count" "$codes"
            fi
        done
        echo ""
        return
    fi

    # --diff mode: compare CSV with DB
    echo -e "${BOLD}Comparing Reporter CSV vs ic DB (${APPLICATION_NAME})${NC}"
    echo ""

    local db_counts
    db_counts=$(sql "
        SELECT component_name, violations_count, scenario
        FROM conforma_results
        WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
        ORDER BY component_name
    " 2>/dev/null)

    printf "  ${BOLD}%-50s %-8s %-8s %-8s %-8s %s${NC}\n" "Component" "Type" "CSV" "DB" "Delta" "Status"
    printf "  %-50s %-8s %-8s %-8s %-8s %s\n" "---------" "----" "---" "--" "-----" "------"

    local diff_output
    diff_output=$(CSV_SUMMARY="$csv_summary" DB_COUNTS="$db_counts" python3 "$SCRIPT_DIR/parsers/diff_csv_violations.py" 2>/dev/null)

    echo "$diff_output" | while IFS='|' read -r comp label csv_n db_n delta status; do
        local color=""
        case "$status" in
            Match)        color="" ;;
            "NEW in CSV") color="${RED}" ;;
            RESOLVED)     color="${GREEN}" ;;
            "DB only")    color="${CYAN}" ;;
            *)            color="${YELLOW}" ;;
        esac
        printf "  %-50s %-8s %-8s %-8s %-8s ${color}%s${NC}\n" "$comp" "$label" "$csv_n" "$db_n" "$delta" "$status"
    done

    echo ""
}

fetch_csv_violations() {
    local branch
    branch=$(app_to_reporter_branch "$APPLICATION_NAME")

    if [ -z "${GITHUB_TOKEN:-}" ]; then
        return 1
    fi

    curl -sH "Authorization: token $GITHUB_TOKEN" \
        "https://api.github.com/repos/acme-org/conforma-reporter/contents/latest/conforma-violations-report.csv?ref=${branch}" \
        | python3 -c "import json,sys,base64; d=json.load(sys.stdin); print(base64.b64decode(d['content']).decode())" 2>/dev/null \
        | python3 "$SCRIPT_DIR/parsers/fetch_parse_csv.py" 2>/dev/null
}

cmd_conforma_snapshot() {
    local do_import=false
    local refresh_snap=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --import)   do_import=true; shift ;;
            --refresh)  refresh_snap=true; shift ;;
            *)          shift ;;
        esac
    done

    section_header "Snapshot Coverage — ${CYAN}${APPLICATION_NAME}"
    echo ""

    local cache_dir="/tmp/ic-conforma-cache"
    local snap_cache="${cache_dir}/snapshot-${APPLICATION_NAME}"
    mkdir -p "$cache_dir"

    local tmp_snap tmp_db tmp_csv
    tmp_snap=$(mktemp) tmp_db=$(mktemp) tmp_csv=$(mktemp)

    # Check snapshot cache (valid for 6 hours)
    local use_cache=false
    if [ "$refresh_snap" = false ] && [ -f "$snap_cache" ]; then
        local cache_age=$(( $(date +%s) - $(stat -c %Y "$snap_cache") ))
        if [ "$cache_age" -lt 21600 ]; then
            use_cache=true
        fi
    fi

    echo -e "${CYAN}Fetching data...${NC}"

    # CSV violations (fast, ~1s)
    fetch_csv_violations > "$tmp_csv" 2>/dev/null || true

    # DB — all components with any conforma data (synced via 'ic get conforma --refresh')
    local tmp_db_all
    tmp_db_all=$(mktemp)
    sql "SELECT DISTINCT component_name FROM conforma_results WHERE application = '$APPLICATION_NAME'" > "$tmp_db_all" 2>/dev/null || true

    # DB — components with unresolved violations (with source)
    sql "SELECT DISTINCT component_name || '|' || CASE WHEN scenario = 'csv-import' THEN 'csv-import' ELSE 'kubearchive' END FROM conforma_results WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE" > "$tmp_db" 2>/dev/null || true

    # Snapshot: from cache or live query
    local snap_name snap_count
    if [ "$use_cache" = true ]; then
        snap_name=$(head -1 "$snap_cache")
        tail -n +2 "$snap_cache" > "$tmp_snap"
        snap_count=$(grep -c . "$tmp_snap")
        local cache_age_min=$(( ($(date +%s) - $(stat -c %Y "$snap_cache")) / 60 ))
        echo -e "  Snapshot: ${BOLD}${snap_name}${NC} (${snap_count} components) ${CYAN}[cached ${cache_age_min}m ago]${NC}"
    else
        echo -e "  ${YELLOW}Querying snapshot (slow, ~2min — will cache for 6h)...${NC}"
        snap_name=$(oc get snapshots -n "$NAMESPACE" \
            -l "appstudio.openshift.io/application=$APPLICATION_NAME" \
            --sort-by=.metadata.creationTimestamp \
            -o name 2>/dev/null | tail -1 | sed 's|.*/||')

        if [ -z "$snap_name" ]; then
            echo -e "${RED}Error: Could not find snapshots for $APPLICATION_NAME${NC}"
            rm -f "$tmp_snap" "$tmp_db" "$tmp_csv" "$tmp_db_all"
            return 1
        fi

        oc get snapshot "$snap_name" -n "$NAMESPACE" \
            -o jsonpath='{range .spec.components[*]}{.name}{"\n"}{end}' 2>/dev/null > "$tmp_snap"
        snap_count=$(grep -c . "$tmp_snap")

        # Save to cache: line 1 = name, rest = components
        { echo "$snap_name"; cat "$tmp_snap"; } > "$snap_cache"

        echo -e "  Snapshot: ${BOLD}${snap_name}${NC} (${snap_count} components) ${GREEN}[cached]${NC}"
    fi
    echo -e "  ${GREEN}Data loaded${NC}"
    echo ""

    local tmp_py
    tmp_py=$(mktemp --suffix=.py)
    cat > "$tmp_py" << 'PYEOF'
import sys

def read_lines(path):
    with open(path) as f:
        return set(l.strip() for l in f if l.strip())

snap = read_lines(sys.argv[1])

# DB violations: "component_name|source" format
db_violations = {}
with open(sys.argv[2]) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        parts = line.split('|', 1)
        db_violations[parts[0]] = parts[1] if len(parts) > 1 else 'kubearchive'

csv_data = {}
with open(sys.argv[3]) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        parts = line.split('|', 3)
        if len(parts) >= 2:
            csv_data[parts[0]] = {'count': int(parts[1]), 'codes': parts[2] if len(parts) > 2 else ''}

db_all = read_lines(sys.argv[4]) if len(sys.argv) > 4 else set()

evaluated = db_all & snap
csv_only = set()
no_data = set()
for comp in snap:
    if comp not in evaluated:
        if comp in csv_data:
            csv_only.add(comp)
        else:
            no_data.add(comp)

eval_pct = len(evaluated) * 100 // len(snap) if snap else 0
print(f'COVERAGE|{len(evaluated)}|{len(csv_only)}|{len(no_data)}|{eval_pct}')

for comp in sorted(db_violations):
    if comp in snap:
        print(f'VIOLATION|{comp}|{db_violations[comp]}')

for comp in sorted(csv_only):
    if comp not in db_violations:
        d = csv_data[comp]
        print(f'CSV_ONLY|{comp}|{d["count"]}|{d["codes"]}')

for comp in sorted(no_data):
    print(f'NO_DATA|{comp}')
PYEOF

    local tmp_cov
    tmp_cov=$(mktemp)
    python3 "$tmp_py" "$tmp_snap" "$tmp_db" "$tmp_csv" "$tmp_db_all" > "$tmp_cov" 2>/dev/null

    rm -f "$tmp_db" "$tmp_db_all" "$tmp_py"

    echo ""

    local ka_n csv_n nodata_n ka_pct
    IFS='|' read -r _ ka_n csv_n nodata_n ka_pct <<< "$(grep '^COVERAGE' "$tmp_cov")"

    echo -e "  ${BOLD}Coverage:${NC}"
    echo -e "    Evaluated:    ${GREEN}${ka_n}${NC} components (${ka_pct}%)"
    if [ "${csv_n:-0}" -gt 0 ]; then
        echo -e "    CSV only:     ${YELLOW}${csv_n}${NC} components"
    fi
    if [ "${nodata_n:-0}" -gt 0 ]; then
        echo -e "    No data:      ${RED}${nodata_n}${NC} components"
    fi
    echo ""

    local violations
    violations=$(grep '^VIOLATION' "$tmp_cov" || true)
    if [ -n "$violations" ]; then
        echo -e "  ${BOLD}Components with violations in DB:${NC}"
        printf "    ${BOLD}%-55s %s${NC}\n" "Component" "Source"
        printf "    %-55s %s\n" "---------" "------"
        echo "$violations" | while IFS='|' read -r _ comp source; do
            printf "    %-55s %s\n" "$comp" "$source"
        done
        echo ""
    fi

    local csv_only_lines
    csv_only_lines=$(grep '^CSV_ONLY' "$tmp_cov" || true)
    if [ -n "$csv_only_lines" ]; then
        echo -e "  ${BOLD}${YELLOW}Components in CSV but NOT in KubeArchive:${NC}"
        printf "    ${BOLD}%-50s %-12s %s${NC}\n" "Component" "Violations" "Codes"
        printf "    %-50s %-12s %s\n" "---------" "----------" "-----"
        echo "$csv_only_lines" | while IFS='|' read -r _ comp count codes; do
            printf "    %-50s %-12s %s\n" "$comp" "$count" "$codes"
        done
        echo ""

        if [ "$do_import" = true ]; then
            echo -e "  ${CYAN}Importing CSV violations into DB...${NC}"
            local today
            today=$(date +%Y%m%d)
            local imported=0
            echo "$csv_only_lines" | while IFS='|' read -r _ comp count codes; do
                local pr_name="csv-import-${today}-${comp}"
                local safe_codes
                safe_codes=$(echo "$codes" | sed "s/'/''/g")
                sql "INSERT INTO conforma_results (
                        application, component_name, scenario,
                        pipelinerun_name, pipelinerun_uid,
                        status, violations_count, violation_summary
                    ) VALUES (
                        '${APPLICATION_NAME}', '${comp}', 'csv-import',
                        '${pr_name}', 'csv-import',
                        'Failed', ${count}, '${safe_codes}'
                    )
                    ON CONFLICT (pipelinerun_name) DO UPDATE SET
                        violations_count = ${count},
                        violation_summary = '${safe_codes}',
                        last_updated_at = NOW()
                    ;" > /dev/null 2>&1
                echo -e "    ${GREEN}+${NC} ${comp}: ${count} violations imported"
            done
            echo ""
        else
            echo -e "  ${CYAN}Tip:${NC} Use 'ic conforma snapshot --import' to import these into the DB"
            echo ""
        fi
    fi

    # Resolve stale DB entries when --import is used
    if [ "$do_import" = true ]; then
        # 1) Resolve csv-import entries for components no longer in current CSV
        local db_csv_components
        db_csv_components=$(sql "SELECT DISTINCT component_name FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND scenario = 'csv-import'
            AND is_resolved = FALSE" 2>/dev/null || true)

        if [ -n "$db_csv_components" ]; then
            local csv_resolved=0
            while IFS= read -r comp; do
                [ -z "$comp" ] && continue
                if ! grep -q "^${comp}|" "$tmp_csv" 2>/dev/null; then
                    sql "UPDATE conforma_results
                        SET is_resolved = TRUE, resolved_at = NOW(), last_updated_at = NOW()
                        WHERE component_name = '$comp' AND application = '$APPLICATION_NAME'
                        AND scenario = 'csv-import' AND is_resolved = FALSE" >/dev/null 2>&1
                    csv_resolved=$((csv_resolved + 1))
                fi
            done <<< "$db_csv_components"
            if [ "$csv_resolved" -gt 0 ]; then
                echo -e "  ${GREEN}✓${NC} Resolved ${csv_resolved} csv-import components no longer in CSV"
            fi
        fi

        # 2) Resolve kubearchive entries for snapshot components that passed clean in CSV
        local db_ka_components
        db_ka_components=$(sql "SELECT DISTINCT component_name FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND scenario != 'csv-import'
            AND is_resolved = FALSE" 2>/dev/null || true)

        if [ -n "$db_ka_components" ]; then
            local ka_resolved=0
            while IFS= read -r comp; do
                [ -z "$comp" ] && continue
                if grep -q "^${comp}$" "$tmp_snap" 2>/dev/null && \
                   ! grep -q "^${comp}|" "$tmp_csv" 2>/dev/null; then
                    sql "UPDATE conforma_results
                        SET is_resolved = TRUE, resolved_at = NOW(), last_updated_at = NOW()
                        WHERE component_name = '$comp' AND application = '$APPLICATION_NAME'
                        AND scenario != 'csv-import' AND is_resolved = FALSE" >/dev/null 2>&1
                    ka_resolved=$((ka_resolved + 1))
                fi
            done <<< "$db_ka_components"
            if [ "$ka_resolved" -gt 0 ]; then
                echo -e "  ${GREEN}✓${NC} Resolved ${ka_resolved} kubearchive components no longer in CSV"
            fi
        fi
    fi

    local nodata_lines
    nodata_lines=$(grep '^NO_DATA' "$tmp_cov" || true)
    if [ -n "$nodata_lines" ]; then
        echo -e "  ${BOLD}Components with no conforma data:${NC}"
        echo "$nodata_lines" | while IFS='|' read -r _ comp; do
            echo "    - $comp"
        done
        echo ""
    fi

    rm -f "$tmp_snap" "$tmp_csv" "$tmp_cov"
    return 0
}

# CONFORMA REPORT - daily tracking table for DLY standup
cmd_conforma_report() {
    local no_cache=false
    local show_detail=true
    local version_filters=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --no-cache) no_cache=true; shift ;;
            --detail) show_detail=true; shift ;;
            --summary) show_detail=false; shift ;;
            --*) shift ;;
            *)
                # Treat positional args as version filters
                # Accept: 3.4, 3.4-ea-1, v3-4, product-v3-4, 3.5-ea.1, etc.
                version_filters="${version_filters} $1"
                shift
                ;;
        esac
    done

    [ "$no_cache" = true ] && export CONFORMA_NO_CACHE=true

    section_header "Conforma Daily Report — $(date +%Y-%m-%d)"
    echo ""

    # Discover all active applications with conforma violations
    local apps
    apps=$(sql "SELECT DISTINCT application FROM conforma_results WHERE is_resolved = FALSE ORDER BY application;" 2>/dev/null)

    if [ -z "$apps" ]; then
        echo -e "${GREEN}No active Conforma violations in any application.${NC}"
        echo ""
        return
    fi

    # Known versions to always show (even if no data) — set in ic-config.sh or .env
    local known_versions="$KNOWN_APPLICATIONS"
    local all_versions
    all_versions=$(echo -e "${apps}\n${known_versions}" | tr ' ' '\n' | sort -u | grep -v '^$')

    # Apply version filters if provided
    if [ -n "$version_filters" ]; then
        local filtered=""
        for filter in $version_filters; do
            # Normalize filter to APPLICATION_NAME format
            # Accept: 3.4, 3.4-ea-1, v3-4, product-v3-4, 3.5-ea.1
            local normalized="$filter"
            normalized="${normalized#*-v}"
            normalized="${normalized#v}"
            # Convert dots to dashes for major.minor: 3.4 -> 3-4
            normalized=$(echo "$normalized" | sed 's/^\([0-9]\+\)\.\([0-9]\+\)/\1-\2/')
            # Convert -ea.N to -ea-N: -ea.1 -> -ea-1
            normalized=$(echo "$normalized" | sed 's/-ea\.\([0-9]\+\)/-ea-\1/')
            normalized="${APPLICATION_NAME%%-v*}-v${normalized}"

            # Find matching apps (substring match)
            local matches
            matches=$(echo "$all_versions" | grep "$normalized" 2>/dev/null || true)
            [ -n "$matches" ] && filtered="${filtered}${matches}"$'\n'
        done
        all_versions=$(echo "$filtered" | sort -u | grep -v '^$')

        if [ -z "$all_versions" ]; then
            echo -e "${RED}No matching versions found for: ${version_filters}${NC}"
            echo -e "${CYAN}Available:${NC} $(echo "$apps" | tr '\n' ' ')"
            echo ""
            return
        fi
    fi

    echo -e "${BOLD}DLY PROGRESS TABLE:${NC}"
    echo -e "${CYAN}(copy-paste ready for standup)${NC}"
    echo ""
    printf "%-32s %-40s %s\n" "ITEM" "CURRENT STATUS" "NEXT STEPS"
    printf "%-32s %-40s %s\n" "----" "--------------" "----------"

    # Fetch K8s EC policy exceptions once (shared across all versions)
    local k8s_exc_full
    k8s_exc_full=$(fetch_k8s_exceptions_full 2>/dev/null)

    # Track totals for summary
    local total_needs_jira=0

    while IFS= read -r app; do
        [ -z "$app" ] && continue

        local branch_label="${app#*-v}"
        branch_label=$(echo "$branch_label" | sed 's/^\([0-9]\+\)-\([0-9]\+\)/\1.\2/' | sed 's/-ea-\([0-9]\+\)/-ea.\1/')

        # Check if app has data in DB
        local has_data
        has_data=$(echo "$apps" | grep -c "^${app}$" 2>/dev/null || echo "0")

        if [ "$has_data" -eq 0 ]; then
            printf "%-32s %-40s %s\n" "Conforma ${branch_label}" "(no data)" "Not yet monitored"
            continue
        fi

        # Query DB for summary
        local summary
        summary=$(sql "SELECT COUNT(DISTINCT component_name), COALESCE(SUM(violations_count),0) FROM conforma_results WHERE application = '${app}' AND is_resolved = FALSE;" 2>/dev/null)
        local comp_count=$(echo "$summary" | cut -d'|' -f1)
        local viol_total=$(echo "$summary" | cut -d'|' -f2)

        # Fetch exceptions from GitHub
        local exceptions
        exceptions=$(fetch_conforma_exceptions "$app" 2>/dev/null)
        local exception_available=true
        [ -z "$exceptions" ] && [ -z "$k8s_exc_full" ] && exception_available=false

        # Count excepted vs not
        local excepted_count=0
        local needs_jira_count=0
        local partial_count=0

        if [ "$exception_available" = true ]; then
            local comp_list
            comp_list=$(sql "SELECT DISTINCT ON (component_name) component_name, scenario FROM conforma_results WHERE application = '${app}' AND is_resolved = FALSE ORDER BY component_name, last_updated_at DESC;" 2>/dev/null)
            while IFS='|' read -r comp_name comp_scenario; do
                comp_name=$(trim "$comp_name")
                comp_scenario=$(trim "$comp_scenario")
                [ -z "$comp_name" ] && continue
                local vsummary
                vsummary=$(sql "SELECT violation_summary FROM conforma_results WHERE component_name = '${comp_name}' AND application = '${app}' AND is_resolved = FALSE LIMIT 1;" 2>/dev/null)
                local status
                status=$(check_exception_status_v2 "$vsummary" "$exceptions" "$k8s_exc_full" "$comp_scenario" | cut -d'|' -f1)
                case "$status" in
                    YES*) excepted_count=$((excepted_count + 1)) ;;
                    PARTIAL*) partial_count=$((partial_count + 1)); needs_jira_count=$((needs_jira_count + 1)) ;;
                    NO*|UNKNOWN) needs_jira_count=$((needs_jira_count + 1)) ;;
                esac
            done <<< "$comp_list"
        fi

        total_needs_jira=$((total_needs_jira + needs_jira_count))

        local status_text="${comp_count} components, ${viol_total} violations"
        local next_text=""
        if [ "$exception_available" = true ]; then
            next_text="${needs_jira_count} need JIRA, ${excepted_count} excepted"
            [ "$partial_count" -gt 0 ] && next_text="${next_text}, ${partial_count} partial"
        else
            next_text="Exception data unavailable"
        fi

        printf "%-32s %-40s %s\n" "Conforma ${branch_label}" "$status_text" "$next_text"
    done <<< "$all_versions"

    # Expiring exceptions row — fetch from GitLab
    local expiring_data
    expiring_data=$(fetch_expiring_exceptions 21 2>/dev/null)
    local expiring_soon=""
    local expired=""
    if [ -n "$expiring_data" ]; then
        expiring_soon=$(echo "$expiring_data" | awk -F'|' '$1 >= 0 && $1 <= 21')
        expired=$(echo "$expiring_data" | awk -F'|' '$1 < 0')
    fi
    local exp_soon_count
    exp_soon_count=$(echo "$expiring_soon" | grep -c '[^[:space:]]' 2>/dev/null || true)
    exp_soon_count=${exp_soon_count:-0}
    local exp_expired_count
    exp_expired_count=$(echo "$expired" | grep -c '[^[:space:]]' 2>/dev/null || true)
    exp_expired_count=${exp_expired_count:-0}

    if [ -n "$expiring_data" ]; then
        local exp_status=""
        [ "$exp_expired_count" -gt 0 ] && exp_status="${exp_expired_count} expired, "
        exp_status="${exp_status}${exp_soon_count} expiring within 3 weeks"
        local exp_link="${GITLAB_EC_POLICY_URL:-release-data repo}"
        printf "%-32s %-40s %s\n" "Expiring Exceptions" "$exp_status" "$exp_link"
    else
        printf "%-32s %-40s %s\n" "Expiring Exceptions" "Source unreachable" "${GITLAB_EC_POLICY_URL:-release-data repo}"
    fi
    echo ""

    # Batch impact query for expiring exceptions
    local report_impact_data=""
    report_impact_data=$(sql "
        WITH extracted AS (
            SELECT component_name,
                   (regexp_matches(violation_summary, '(?<=[✕✗] \[Violation\] )([a-z_]+\.[a-z_]+)', 'g'))[1] as rule
            FROM conforma_results
            WHERE is_resolved = FALSE AND violation_summary IS NOT NULL
        )
        SELECT rule, COUNT(DISTINCT component_name), COUNT(*)
        FROM extracted GROUP BY rule;
    " 2>/dev/null)

    # Show expiring exceptions detail
    if [ -n "$expiring_soon" ] && [ "$exp_soon_count" -gt 0 ]; then
        echo -e "${BOLD}EXPIRING EXCEPTIONS (within 3 weeks):${NC}"
        echo ""
        local prev_date=""
        while IFS='|' read -r days_left eff_until value image_url reference source gl_link; do
            [ -z "$days_left" ] && continue
            local date_label=""
            if [ "$eff_until" != "$prev_date" ]; then
                local day_name
                day_name=$(date -d "$eff_until" +%A 2>/dev/null || echo "")
                if [ "$days_left" -le 7 ]; then
                    date_label="${RED}${day_name} ${eff_until} (${days_left}d) — expiring soon${NC}"
                elif [ "$days_left" -le 14 ]; then
                    date_label="${YELLOW}${day_name} ${eff_until} (${days_left}d)${NC}"
                else
                    date_label="${eff_until} (${days_left}d)"
                fi
                echo -e "  $date_label"
                prev_date="$eff_until"
            fi
            local display_value="$value"
            if [ ${#display_value} -gt 70 ]; then
                display_value="${display_value:0:67}..."
            fi

            local impact_info=""
            if [ -n "$report_impact_data" ]; then
                local exc_rule="${value%%:*}"
                local match_line
                match_line=$(echo "$report_impact_data" | grep "^ *${exc_rule} *|" | head -1)
                if [ -n "$match_line" ]; then
                    local ic_comps ic_viols
                    ic_comps=$(echo "$match_line" | cut -d'|' -f2 | tr -d ' ')
                    ic_viols=$(echo "$match_line" | cut -d'|' -f3 | tr -d ' ')
                    impact_info=" → ${ic_comps} components, ${ic_viols} violations"
                fi
            fi

            echo "    - ${display_value}${impact_info}"
            [ -n "$image_url" ] && echo "      image: $image_url"
            [ -n "$reference" ] && echo "      ref: $reference"
            [ -n "$gl_link" ] && echo -e "      ${CYAN}↳ ${gl_link}${NC}"
        done <<< "$expiring_soon"
        echo ""
    fi

    if [ -n "$expired" ] && [ "$exp_expired_count" -gt 0 ]; then
        echo -e "${BOLD}ALREADY EXPIRED:${NC}"
        echo ""
        while IFS='|' read -r days_left eff_until value image_url reference source gl_link; do
            [ -z "$days_left" ] && continue
            local display_value="$value"
            if [ ${#display_value} -gt 70 ]; then
                display_value="${display_value:0:67}..."
            fi
            echo -e "  ${RED}${eff_until} (${days_left#-}d ago)${NC}  $display_value"
            [ -n "$reference" ] && echo "      ref: $reference"
            [ -n "$gl_link" ] && echo -e "      ${CYAN}↳ ${gl_link}${NC}"
        done <<< "$expired"
        echo ""
    fi

    # Detailed breakdown per application
    if [ "$show_detail" = true ]; then
        while IFS= read -r app; do
            [ -z "$app" ] && continue

            local has_data
            has_data=$(echo "$apps" | grep -c "^${app}$" 2>/dev/null || echo "0")
            [ "$has_data" -eq 0 ] && continue

            local comp_count
            comp_count=$(sql "SELECT COUNT(DISTINCT component_name) FROM conforma_results WHERE application = '${app}' AND is_resolved = FALSE;" 2>/dev/null)

            echo -e "${BOLD}DETAILED BREAKDOWN — ${app} (${comp_count} components):${NC}"
            echo ""

            local exceptions
            exceptions=$(fetch_conforma_exceptions "$app" 2>/dev/null)

            printf " %2s  %-40s %-9s %6s  %-18s %-5s  %-17s  %s\n" "#" "Component" "Policy" "Viol" "Exception" "AI" "Expiry" "Action"
            printf " %2s  %-40s %-9s %6s  %-18s %-5s  %-17s  %s\n" "--" "$(printf '%0.s-' {1..40})" "---------" "------" "------------------" "-----" "-----------------" "------"

            local idx=0
            while IFS='|' read -r comp_name c_scenario viol_count warn_count ai_status; do
                [ -z "$comp_name" ] && continue
                idx=$((idx + 1))

                c_scenario=$(trim "$c_scenario")
                local policy_name
                policy_name=$(extract_policy_from_scenario "$c_scenario")
                local policy_label
                policy_label=$(echo "$policy_name" | sed 's/registry-[a-z]*-/reg-/; s/fbc-[a-z]*-/fbc-/; s/stage/stg/')

                # Get exception status via K8s API-aware matching
                local vsummary
                vsummary=$(sql "SELECT violation_summary FROM conforma_results WHERE component_name = '${comp_name}' AND scenario = '${c_scenario}' AND application = '${app}' AND is_resolved = FALSE LIMIT 1;" 2>/dev/null)
                local exc_status="?"
                local exc_jira_ref=""
                if [ -n "$exceptions" ] || [ -n "$k8s_exc_full" ]; then
                    local exc_result
                    exc_result=$(check_exception_status_v2 "$vsummary" "$exceptions" "$k8s_exc_full" "$c_scenario")
                    exc_status=$(echo "$exc_result" | cut -d'|' -f1)
                    exc_jira_ref=$(echo "$exc_result" | cut -d'|' -f2)
                fi

                # Find expiry date
                local expiry_info="-"
                if [ -n "$expiring_data" ]; then
                    expiry_info=$(find_component_expiry "$comp_name" "$vsummary" "$expiring_data")
                fi

                # Determine action — include exception JIRA if available
                local action=""
                local jira_key=""
                if [ -n "$exc_jira_ref" ] && [ "$exc_jira_ref" != "config.exclude (permanent)" ]; then
                    jira_key=$(echo "$exc_jira_ref" | grep -oP '[A-Z]+-\d+' | tail -1)
                fi
                case "$exc_status" in
                    YES*) action="Excepted${jira_key:+ ($jira_key)}" ;;
                    PARTIAL*) action="Partial${jira_key:+ ($jira_key)}" ;;
                    NO\ \(in*) action="In other${jira_key:+ ($jira_key)}" ;;
                    NO) action="Needs JIRA" ;;
                    *) action="Check manually" ;;
                esac

                # Truncate long component names
                local display_name="$comp_name"
                if [ ${#display_name} -gt 40 ]; then
                    display_name="${display_name:0:37}..."
                fi

                printf " %2d  %-40s %-9s %6s  %-18s %-5s  %-17s  %s\n" "$idx" "$display_name" "$policy_label" "$viol_count" "$exc_status" "${ai_status:--}" "$expiry_info" "$action"
            done < <(sql "
                SELECT c.component_name, c.scenario, c.violations_count, c.warnings_count,
                    COALESCE((SELECT ROUND(confidence_score * 100) || '%' FROM ai_analysis WHERE conforma_result_id = c.id ORDER BY analyzed_at DESC LIMIT 1), '-')
                FROM conforma_results c
                WHERE c.application = '${app}' AND c.is_resolved = FALSE
                ORDER BY c.violations_count DESC
                LIMIT 20;
            " 2>/dev/null)

            if [ "$comp_count" -gt 20 ]; then
                echo -e "  ${CYAN}... and $((comp_count - 20)) more components (use 'ic get conforma' for full list)${NC}"
            fi
            echo ""
        done <<< "$all_versions"
    fi

    # Sources
    echo -e "${BOLD}Sources:${NC}"
    echo "  Violations DB     local PostgreSQL (konflux_monitoring)"
    echo "  Exceptions (GH)   https://github.com/acme-org/conforma-reporter"
    echo "  EC Policies (K8s) EnterpriseContractPolicy CRDs (K8s API primary, GitLab fallback)"
    echo "  Policy files (GL) ${GITLAB_EC_POLICY_URL:-configure GITLAB_EC_POLICY_URL}"
    echo "  Reporter CSV      configure CONFORMA_REPORTER_URL"
    echo ""

    # Tips
    echo -e "${CYAN}Tips:${NC}"
    echo -e "  ic describe conforma <name>       Full violation details"
    echo -e "  ic export conforma <name> jira    Export for JIRA ticket"
    echo -e "  ic ai analyze conforma <name>     Run AI analysis"
    echo ""

    # Cleanup
    unset CONFORMA_NO_CACHE
}

cmd_conforma_categories() {
    local app="${1:-$APPLICATION_NAME}"

    section_header "Violation Categories — ${app}"
    echo ""

    local rule_data
    rule_data=$(sql "
        WITH extracted AS (
            SELECT component_name,
                   (regexp_matches(violation_summary, '(?<=[✕✗] \[Violation\] )([a-z_]+\.[a-z_]+)', 'g'))[1] as rule
            FROM conforma_results
            WHERE application = '${app}' AND is_resolved = FALSE
              AND violation_summary IS NOT NULL
        )
        SELECT rule, COUNT(DISTINCT component_name) as comp_count, COUNT(*) as viol_count
        FROM extracted
        GROUP BY rule
        ORDER BY viol_count DESC;
    " 2>/dev/null)

    if [ -z "$rule_data" ]; then
        echo -e "${GREEN}No active violations.${NC}"
        echo ""
        return
    fi

    declare -A cat_comps cat_viols cat_rules
    while IFS='|' read -r rule comp_count viol_count; do
        rule=$(echo "$rule" | tr -d ' ')
        comp_count=$(echo "$comp_count" | tr -d ' ')
        viol_count=$(echo "$viol_count" | tr -d ' ')
        [ -z "$rule" ] && continue
        local cat
        cat=$(map_rule_to_category "$rule")
        cat_comps[$cat]=$(( ${cat_comps[$cat]:-0} + comp_count ))
        cat_viols[$cat]=$(( ${cat_viols[$cat]:-0} + viol_count ))
        cat_rules[$cat]="${cat_rules[$cat]:+${cat_rules[$cat]}, }${rule}(${viol_count})"
    done <<< "$rule_data"

    printf "  %-16s %8s %10s  %s\n" "Category" "Comps" "Violations" "Rules"
    printf "  %-16s %8s %10s  %s\n" "$(printf '%0.s-' {1..16})" "--------" "----------" "$(printf '%0.s-' {1..50})"

    for cat in $(for c in "${!cat_viols[@]}"; do echo "${cat_viols[$c]}|$c"; done | sort -t'|' -k1 -rn | cut -d'|' -f2); do
        local color="$NC"
        case "$cat" in
            CVE) color="$RED" ;;
            "Trusted Task"|"Base Image") color="$YELLOW" ;;
        esac
        echo -ne "  ${color}$(printf '%-16s' "$cat")${NC} "
        printf "%8s %10s  %s\n" "${cat_comps[$cat]}" "${cat_viols[$cat]}" "${cat_rules[$cat]:0:60}"
    done
    echo ""

    local total_viols=0 total_rules=0
    for cat in "${!cat_viols[@]}"; do total_viols=$((total_viols + cat_viols[$cat])); done
    total_rules=$(echo "$rule_data" | grep -c '[^[:space:]]')
    echo -e "${BOLD}Total: ${total_viols} violations across ${total_rules} distinct rules${NC}"
    echo ""
}

# BUILD REPORT — daily standup table for build failures (symmetric to cmd_conforma_report)
cmd_report_build() {
    local show_detail=true
    local version_filters=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --summary) show_detail=false; shift ;;
            --detail)  show_detail=true;  shift ;;
            --*) shift ;;
            *) version_filters="${version_filters} $1"; shift ;;
        esac
    done

    section_header "Build Failures Daily Report — $(date +%Y-%m-%d)"
    echo ""

    local apps
    apps=$(sql "SELECT DISTINCT application FROM build_failures WHERE is_resolved = FALSE ORDER BY application;" 2>/dev/null)

    if [ -z "$apps" ]; then
        echo -e "${GREEN}No active build failures in any application.${NC}"
        echo ""
        return
    fi

    local known_versions="${KNOWN_APPLICATIONS:-}"
    local all_versions
    all_versions=$(echo -e "${apps}\n${known_versions}" | tr ' ' '\n' | sort -u | grep -v '^$')

    if [ -n "$version_filters" ]; then
        local filtered=""
        for filter in $version_filters; do
            local normalized="$filter"
            normalized="${normalized#*-v}"
            normalized="${normalized#v}"
            normalized=$(echo "$normalized" | sed 's/^\([0-9]\+\)\.\([0-9]\+\)/\1-\2/')
            normalized=$(echo "$normalized" | sed 's/-ea\.\([0-9]\+\)/-ea-\1/')
            normalized="${APPLICATION_NAME%%-v*}-v${normalized}"
            local matches
            matches=$(echo "$all_versions" | grep "$normalized" 2>/dev/null || true)
            [ -n "$matches" ] && filtered="${filtered}${matches}"$'\n'
        done
        all_versions=$(echo "$filtered" | sort -u | grep -v '^$')
        if [ -z "$all_versions" ]; then
            echo -e "${RED}No matching versions for: ${version_filters}${NC}"
            echo -e "${CYAN}Available:${NC} $(echo "$apps" | tr '\n' ' ')"
            echo ""; return
        fi
    fi

    echo -e "${BOLD}DLY PROGRESS TABLE:${NC}"
    echo -e "${CYAN}(copy-paste ready for standup)${NC}"
    echo ""
    printf "%-32s %-40s %s\n" "ITEM" "CURRENT STATUS" "NEXT STEPS"
    printf "%-32s %-40s %s\n" "----" "--------------" "----------"

    while IFS= read -r app; do
        [ -z "$app" ] && continue

        local branch_label="${app#*-v}"
        branch_label=$(echo "$branch_label" | sed 's/^\([0-9]\+\)-\([0-9]\+\)/\1.\2/' | sed 's/-ea-\([0-9]\+\)/-ea.\1/')

        local has_data
        has_data=$(echo "$apps" | grep -c "^${app}$" 2>/dev/null || echo "0")

        if [ "$has_data" -eq 0 ]; then
            printf "%-32s %-40s %s\n" "Build ${branch_label}" "(no data)" "Not yet monitored"
            continue
        fi

        local summary
        summary=$(sql "
            SELECT COUNT(*),
                   COUNT(*) FILTER (WHERE jira_key IS NOT NULL),
                   COUNT(*) FILTER (WHERE ai_analyzed AND EXISTS (
                       SELECT 1 FROM ai_analysis a WHERE a.id = b.ai_analysis_id AND a.can_auto_fix = TRUE
                   ))
            FROM build_failures b
            WHERE application = '${app}' AND is_resolved = FALSE;" 2>/dev/null)

        local comp_count=$(echo "$summary" | cut -d'|' -f1 | tr -d ' ')
        local jira_count=$(echo "$summary" | cut -d'|' -f2 | tr -d ' ')
        local autofix_count=$(echo "$summary" | cut -d'|' -f3 | tr -d ' ')
        local no_jira=$(( comp_count - jira_count ))

        local status_text="${comp_count} component(s) failing"
        local next_text="${no_jira} need Jira"
        [ "${autofix_count:-0}" -gt 0 ] && next_text="${next_text}, ${autofix_count} auto-fixable"
        [ "$jira_count" -gt 0 ]         && next_text="${next_text}, ${jira_count} have ticket"

        printf "%-32s %-40s %s\n" "Build ${branch_label}" "$status_text" "$next_text"
    done <<< "$all_versions"

    echo ""

    [ "$show_detail" = false ] && return

    # Detailed per-application breakdown
    while IFS= read -r app; do
        [ -z "$app" ] && continue

        local has_data
        has_data=$(echo "$apps" | grep -c "^${app}$" 2>/dev/null || echo "0")
        [ "$has_data" -eq 0 ] && continue

        local branch_label="${app#*-v}"
        branch_label=$(echo "$branch_label" | sed 's/^\([0-9]\+\)-\([0-9]\+\)/\1.\2/' | sed 's/-ea-\([0-9]\+\)/-ea.\1/')

        local comp_count
        comp_count=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '${app}' AND is_resolved = FALSE;" 2>/dev/null | tr -d ' ')

        echo -e "${BOLD}DETAILED BREAKDOWN — ${app} (${comp_count} components):${NC}"
        echo ""
        printf " %2s  %-42s %-14s %5s %4s  %-18s %-5s  %s\n" \
            "#" "Component" "Error Type" "Days" "Occ" "AI Category" "Fix?" "Jira"
        printf " %2s  %-42s %-14s %5s %4s  %-18s %-5s  %s\n" \
            "--" "$(printf '%0.s-' {1..42})" "--------------" "-----" "----" "------------------" "-----" "-------"

        local idx=0
        while IFS='|' read -r comp error_type days occurrences jira_key ai_analyzed category can_auto_fix confidence; do
            [ -z "$comp" ] && continue
            idx=$((idx + 1))

            comp=$(trim "$comp")
            error_type=$(trim "$error_type")
            days=$(trim "$days")
            occurrences=$(trim "$occurrences")
            jira_key=$(trim "$jira_key")
            category=$(trim "$category")
            can_auto_fix=$(trim "$can_auto_fix")
            confidence=$(trim "$confidence")

            # Color by age
            local day_color="$NC"
            [ "${days:-0}" -ge 7 ]  && day_color="$YELLOW"
            [ "${days:-0}" -ge 14 ] && day_color="$RED"

            # AI badge
            local ai_badge="     "
            if [ "$ai_analyzed" = "t" ] && [ -n "$category" ]; then
                ai_badge="${category:0:18}"
                [ "$can_auto_fix" = "t" ] && ai_badge="${ai_badge}"
            elif [ "$ai_analyzed" != "t" ]; then
                ai_badge="${YELLOW}pending${NC}"
            fi

            local fix_label="-"
            [ "$can_auto_fix" = "t" ] && fix_label="yes"
            [ "$can_auto_fix" = "f" ] && fix_label="no"

            local jira_label="${jira_key:--}"
            local comp_short="${comp:0:42}"

            printf " %2s  %-42s %-14s " "$idx" "$comp_short" "${error_type:0:14}"
            echo -ne "${day_color}$(printf '%5s' "${days:-?}")${NC} "
            printf "%4s  %-18s %-5s  %s\n" \
                "${occurrences:-?}" "${category:0:18}" "$fix_label" "$jira_label"
        done <<< "$(sql "
            SELECT b.component_name,
                   COALESCE(b.error_type, ''),
                   EXTRACT(DAY FROM (NOW() - b.first_detected_at))::int,
                   (SELECT COUNT(*) FROM build_failures
                    WHERE component_name = b.component_name AND is_resolved = FALSE),
                   COALESCE(b.jira_key, ''),
                   b.ai_analyzed,
                   COALESCE(a.failure_category, ''),
                   COALESCE(a.can_auto_fix::text, ''),
                   COALESCE(ROUND(a.confidence_score * 100)::text, '')
            FROM build_failures b
            LEFT JOIN ai_analysis a ON a.id = b.ai_analysis_id
            WHERE b.application = '${app}' AND b.is_resolved = FALSE
            ORDER BY EXTRACT(DAY FROM (NOW() - b.first_detected_at)) DESC, b.component_name;
        " 2>/dev/null)"

        echo ""
        echo -e "${CYAN}Tip:${NC} Use 'ic <number>' to describe a failure, 'ic ai analyze <component>' to run AI analysis"
        echo ""
    done <<< "$all_versions"
}

# DESCRIBE CONFORMA - violation details for a component
cmd_describe_conforma() {
    local component="" history=false json_output=false
    for arg in "$@"; do
        case "$arg" in
            --history|-H) history=true ;;
            --json) json_output=true ;;
            *) [ -z "$component" ] && component="$arg" ;;
        esac
    done

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic describe conforma <component> [--history]"
        return 1
    fi

    if [ "$json_output" = true ]; then
        sql_json "
            SELECT component_name AS component, scenario, pipelinerun_name, status,
                   violations_count, warnings_count, successes_count,
                   first_detected_at AS first_seen, last_updated_at AS last_seen,
                   repository_url, commit_sha, snapshot_name,
                   CASE WHEN violation_details IS NOT NULL THEN true ELSE false END AS has_details,
                   CASE WHEN ai_analysis_id IS NOT NULL THEN true ELSE false END AS has_analysis,
                   jira_key
            FROM conforma_results
            WHERE component_name = '$component'
              AND application = '$APPLICATION_NAME'
              AND is_resolved = FALSE
            ORDER BY first_detected_at DESC
            LIMIT 1
        "
        return
    fi

    # Get metadata (without violation_summary to avoid pipe conflicts)
    local data=$(sql "
        SELECT id, component_name, scenario, pipelinerun_name, status,
               violations_count, warnings_count, successes_count,
               TO_CHAR(first_detected_at, 'YYYY-MM-DD HH24:MI:SS'),
               COALESCE(repository_url, ''), COALESCE(commit_sha, ''),
               COALESCE(snapshot_name, ''), COALESCE(commit_url, ''),
               COALESCE(jira_key, '')
        FROM conforma_results
        WHERE component_name = '$component'
          AND application = '$APPLICATION_NAME'
          AND is_resolved = FALSE
        ORDER BY first_detected_at DESC
        LIMIT 1;
    " 2>/dev/null)

    if [ -z "$data" ]; then
        if [ "$history" = true ]; then
            echo -e "${GREEN}No active Conforma violations for: $component${NC}"
            echo ""
            cmd_conforma_history "$component"
            return
        fi
        echo -e "${RED}Error: No Conforma results found for: $component${NC}"
        echo -e "${CYAN}Tip:${NC} Use 'ic get conforma' to list components with failures"
        echo -e "${CYAN}Tip:${NC} Use '--history' to see PipelineRun timeline even for resolved components"
        return 1
    fi

    IFS='|' read -r conforma_id comp_name scenario pr_name status violations warnings successes \
        detected_at repo_url commit_sha snapshot commit_url jira_key <<< "$data"

    section_header "Conforma Results: $comp_name"
    echo ""
    echo -e "${BOLD}Scenario:${NC}    $scenario"
    echo -e "${BOLD}Result:${NC}      ${RED}FAILURE${NC} (${violations} violations, ${warnings} warnings, ${successes} successes)"
    echo -e "${BOLD}PipelineRun:${NC} $pr_name"
    echo -e "${BOLD}Detected:${NC}    $detected_at"

    repo_url=$(trim "$repo_url")
    commit_sha=$(trim "$commit_sha")
    snapshot=$(trim "$snapshot")
    commit_url=$(trim "$commit_url")

    [ -n "$repo_url" ] && echo -e "${BOLD}Repository:${NC}  $repo_url"
    [ -n "$commit_sha" ] && echo -e "${BOLD}Commit:${NC}      ${commit_sha:0:8}"
    [ -n "$commit_url" ] && echo -e "${BOLD}Commit URL:${NC}  ${CYAN}$commit_url${NC}"
    [ -n "$snapshot" ] && echo -e "${BOLD}Snapshot:${NC}    $snapshot"

    jira_key=$(trim "$jira_key")
    if [ -n "$jira_key" ]; then
        echo -e "${BOLD}JIRA:${NC}        ${CYAN}${jira_key}${NC} (${JIRA_URL}/browse/${jira_key})"
    else
        echo -e "${BOLD}JIRA:${NC}        -"
    fi

    # Container image from violation_details JSON
    local container_image=$(sql "
        SELECT violation_details->'components'->0->>'containerImage'
        FROM conforma_results
        WHERE pipelinerun_name = '$pr_name' LIMIT 1;
    " 2>/dev/null | xargs 2>/dev/null || echo "")
    if [ -n "$container_image" ]; then
        echo -e "${BOLD}Image:${NC}       $container_image"
        # Extract Quay repository URL from image reference
        local quay_path=$(echo "$container_image" | sed -n 's|quay\.io/\([^@]*\)@.*|quay.io/repository/\1|p')
        [ -n "$quay_path" ] && echo -e "${BOLD}Quay:${NC}        ${CYAN}https://${quay_path}${NC}"
    fi

    # Konflux UI link
    local konflux_url="${KONFLUX_UI_BASE}/ns/${NAMESPACE}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}/logs"
    echo ""
    echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"

    echo ""
    section_header "Violations"
    echo ""

    # Fetch violation_summary separately (contains pipes and newlines)
    local violation_summary=$(sql "
        SELECT violation_summary FROM conforma_results
        WHERE pipelinerun_name = '$pr_name' LIMIT 1;
    " 2>/dev/null)

    if [ -n "$violation_summary" ] && [ "$violation_summary" != "" ]; then
        echo "$violation_summary"
    else
        echo -e "${YELLOW}No detailed violation report available.${NC}"
        echo -e "${CYAN}→ Run 'ic get conforma --refresh' to fetch violation details${NC}"
    fi
    echo ""

    # Display AI analysis if available (matching this specific Conforma violation)
    display_ai_analysis "$component" "$conforma_id" "conforma"

    if [ "$history" = true ]; then
        echo ""
        cmd_conforma_history "$component"
    fi
}

# CONFORMA HISTORY - PipelineRun timeline from KubeArchive + Tekton Results
cmd_conforma_history() {
    local component="$1"
    local limit="${2:-10}"

    local token
    token=$(oc whoami -t 2>/dev/null)
    if [ -z "$token" ]; then
        echo -e "${RED}Error: Not logged into OpenShift (run 'oc login' first)${NC}"
        return 1
    fi

    section_header "PipelineRun History: ${CYAN}$component"
    echo ""

    local base="${KUBEARCHIVE_URL}/apis/tekton.dev/v1/namespaces/${NAMESPACE}/pipelineruns"
    local build_selector="appstudio.openshift.io/component=${component},pipelines.appstudio.openshift.io/type=build"
    local test_selector="appstudio.openshift.io/component=${component},pipelines.appstudio.openshift.io/type=test"

    local tmpdir
    tmpdir=$(mktemp -d)
    trap "rm -rf $tmpdir" RETURN

    curl -sk --max-time 60 -H "Authorization: Bearer $token" \
        "${base}?labelSelector=${build_selector}&limit=10" > "$tmpdir/build.json" 2>/dev/null &
    curl -sk --max-time 60 -H "Authorization: Bearer $token" \
        "${base}?labelSelector=${test_selector}&limit=20" > "$tmpdir/test.json" 2>/dev/null &
    wait

    python3 "$SCRIPT_DIR/parsers/parse_pipelinerun_history.py" "$limit" "$tmpdir/build.json" "$tmpdir/test.json"

    if [ $? -ne 0 ]; then
        echo -e "${RED}Error fetching PipelineRun history from KubeArchive${NC}"
    fi

    # Also show Tekton Results conforma history (longer retention)
    echo ""
    subsection_header "Conforma Test History (Tekton Results):"
    echo ""
    local conforma_hist=$(cd "$SCRIPT_DIR/src" && $PYTHON get_build_history.py "$component" --limit 8 --type conforma 2>/dev/null)
    if [ -n "$conforma_hist" ]; then
        while IFS='|' read -r h_ts h_status h_scenario h_pr_name; do
            h_ts=$(echo "$h_ts" | cut -c1-16 | tr 'T' ' ')
            local scenario_short="${h_scenario#conforma-}"
            case "$h_status" in
                Passed) echo -e "  ${h_ts}  ${GREEN}✓ passed${NC}  ${scenario_short}" ;;
                Failed) echo -e "  ${h_ts}  ${RED}✗ failed${NC}  ${scenario_short}" ;;
                *)      echo -e "  ${h_ts}  ? ${h_status}  ${scenario_short}" ;;
            esac
        done <<< "$conforma_hist"
    else
        echo -e "  ${YELLOW}No conforma history from Tekton Results${NC}"
    fi
}

