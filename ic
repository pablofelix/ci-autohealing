    ic build logs        → ic describe pipelinerun

EOF
    exit 0
}

# GET commands
cmd_get_components() {
    # Check synchronization status
    local sync_status=$(python3 "$SCRIPT_DIR/collectors/python/check_sync_status.py" 2>/dev/null)
    local cluster_connected=$(echo "$sync_status" | jq -r '.cluster_connected // false' 2>/dev/null)
    local in_sync=$(echo "$sync_status" | jq -r '.in_sync // false' 2>/dev/null)
    local error=$(echo "$sync_status" | jq -r '.error // ""' 2>/dev/null)
    local missing_count=$(echo "$sync_status" | jq -r '.missing_in_db | length' 2>/dev/null || echo "0")
    local extra_count=$(echo "$sync_status" | jq -r '.extra_in_db | length' 2>/dev/null || echo "0")

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Currently Failing Components${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Show sync status
    if [ "$cluster_connected" != "true" ]; then
        echo -e "${RED}⚠ Cluster Status: DISCONNECTED${NC}"
        echo -e "${YELLOW}  $error${NC}"
        echo -e "${YELLOW}  Database is OUT OF SYNC with Konflux${NC}"
        echo -e "${CYAN}  → Login to cluster: oc login <cluster-url>${NC}"
        echo ""
    elif [ "$in_sync" != "true" ]; then
        echo -e "${YELLOW}⚠ Sync Status: OUT OF SYNC${NC}"

        # Show error if present
        if [ -n "$error" ] && [ "$error" != "null" ]; then
            echo -e "${YELLOW}  Issue: $error${NC}"
        fi

        # Show differences
        if [ "$missing_count" != "0" ]; then
            echo -e "${YELLOW}  Missing in DB: ${missing_count} component(s)${NC}"
            local missing=$(echo "$sync_status" | jq -r '.missing_in_db[]' 2>/dev/null)
            while IFS= read -r comp; do
                [ -n "$comp" ] && echo -e "${YELLOW}    - $comp${NC}"
            done <<< "$missing"
        fi
        if [ "$extra_count" != "0" ]; then
            echo -e "${YELLOW}  Extra in DB (resolved): ${extra_count} component(s)${NC}"
            local extra=$(echo "$sync_status" | jq -r '.extra_in_db[]' 2>/dev/null)
            while IFS= read -r comp; do
                [ -n "$comp" ] && echo -e "${YELLOW}    - $comp${NC}"
            done <<< "$extra"
        fi

        # Show DB components when cluster query fails
        if [ "$missing_count" = "0" ] && [ "$extra_count" = "0" ] && [ -n "$error" ]; then
            local db_count=$(echo "$sync_status" | jq -r '.db_components | length' 2>/dev/null || echo "0")
            echo -e "${YELLOW}  Components in DB: ${db_count}${NC}"
            echo -e "${YELLOW}  Expected from UI: 8 (rhai-on-openshift-chart-v3-4, acme-fbc-fragment-v3-4, + 6 others)${NC}"
        fi

        echo -e "${CYAN}  → Auto-syncing in background...${NC}"
        echo ""

        # Launch sync in background
        nohup "$SCRIPT_DIR/cron/collect-comprehensive.sh" > /dev/null 2>&1 &
        local sync_pid=$!
        echo -e "${GREEN}  ✓ Sync started (PID: $sync_pid)${NC}"
        echo -e "${CYAN}  Run 'ic get components' again in ~2 minutes to see updated data${NC}"
        echo ""
    else
        echo -e "${GREEN}✓ Sync Status: IN SYNC${NC}"
        echo ""
    fi

    # Get currently failing components (last build = Failed AND not resolved)
    local currently_failing=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name,
                status,
                is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds WHERE status = 'Failed' AND is_resolved = FALSE;
    ")

    local total_records=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME';")

    echo -e "${BOLD}Summary:${NC}"
    echo -e "  Currently failing: ${RED}${currently_failing}${NC}"
    echo -e "  Total build records: ${total_records}"
    echo ""

    sql_table "
    WITH latest_builds AS (
        SELECT DISTINCT ON (component_name)
            component_name,
            pipelinerun_name,
            status,
            is_resolved,
            first_detected_at,
            build_logs IS NOT NULL as has_logs,
            (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name) as total_failures,
            (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name AND bf.build_logs IS NOT NULL) as with_logs
        FROM build_failures
        WHERE application = '$APPLICATION_NAME'
        ORDER BY component_name, first_detected_at DESC
    )
    SELECT
        ROW_NUMBER() OVER (ORDER BY total_failures DESC) as \"#\",
        component_name as \"Component\",
        total_failures as \"Failures\",
        with_logs as \"Logs\"
    FROM latest_builds
    WHERE status = 'Failed' AND is_resolved = FALSE
    ORDER BY total_failures DESC;
    "
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic working' to see components that are currently working"
    echo -e "${CYAN}Tip:${NC} Use 'ic history <component>' to see full build history"
    echo ""
}

cmd_get_component() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic get component <name>"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}Component: ${CYAN}$component${NC}"
    echo ""
    echo -e "${BOLD}Summary:${NC}"
    echo "  Total failures: $total"
    echo "  With logs: $(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")"
    echo "  First seen: $(sql "SELECT MIN(first_detected_at) FROM build_failures WHERE component_name = '$component';")"
    echo "  Last seen: $(sql "SELECT MAX(first_detected_at) FROM build_failures WHERE component_name = '$component';")"
    echo ""
    echo -e "${CYAN}For full details with logs:${NC} ic describe component $component"
    echo ""
}

cmd_get_pipelineruns() {
    local limit="${1:-20}"

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Recent PipelineRun Failures${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        component_name as \"Component\",
        status as \"Status\",
        CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END as \"Logs\",
        first_detected_at as \"Detected\"
    FROM build_failures
    ORDER BY first_detected_at DESC
    LIMIT $limit;
    "
    echo ""
}

cmd_get_pipelinerun() {
    local pr_name="$1"
    if [ -z "$pr_name" ]; then
        echo -e "${RED}Error: PipelineRun name required${NC}"
        echo "Usage: ic get pipelinerun <name>"
        exit 1
    fi

    local data=$(sql "SELECT component_name, status, CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")

    if [ -z "$data" ]; then
        echo -e "${RED}Error: PipelineRun not found: $pr_name${NC}"
        exit 1
    fi

    IFS='|' read -r component status has_logs <<< "$data"

    echo -e "${BOLD}PipelineRun: ${CYAN}$pr_name${NC}"
    echo ""
    echo "  Component: $component"
    echo "  Status: $status"
    echo "  Has logs: $has_logs"
    echo ""
    echo -e "${CYAN}For full details with logs:${NC} ic describe pipelinerun $pr_name"
    echo ""
}

cmd_get_apps() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Available RHOAI Applications${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    local apps=$(oc get applications -n "$NAMESPACE" -o custom-columns=NAME:.metadata.name --no-headers 2>/dev/null | grep "rhoai-v" | sort -V)

    if [ -z "$apps" ]; then
        echo -e "${YELLOW}No RHOAI applications found${NC}"
        exit 1
    fi

    local current="$APPLICATION_NAME"
    local count=0

    while IFS= read -r app; do
        count=$((count + 1))
        if [ "$app" = "$current" ]; then
            echo -e "  ${GREEN}✓ ${BOLD}$app${NC} ${CYAN}(current)${NC}"
        else
            echo -e "    $app"
        fi
    done <<< "$apps"

    echo ""
    echo "Total: $count applications"
    echo ""
    echo -e "${CYAN}Switch:${NC} ic config set-app <app-name>"
    echo ""
}

# DESCRIBE commands
cmd_describe_component() {
    local component="$1"
    local show_full_log=false

    # Parse options
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --log)
                show_full_log=true
                ;;
        esac
        shift
    done

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic describe component <name> [--log]"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Component: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Summary
    local with_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")
    local first_failure=$(sql "SELECT MIN(first_detected_at) FROM build_failures WHERE component_name = '$component';")
    local latest_failure=$(sql "SELECT MAX(first_detected_at) FROM build_failures WHERE component_name = '$component';")

    echo -e "${BOLD}Summary:${NC}"
    echo "  Total Failures: $total"
    echo "  Failures with Logs: $with_logs / $total"
    echo "  First Failure: $first_failure"
    echo "  Latest Failure: $latest_failure"
    echo ""

    # Get latest PipelineRun
    local pr_data=$(sql "
        SELECT pipelinerun_name, pipelinerun_uid, status, repository_url, branch,
               CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END,
               konflux_logs_url
        FROM build_failures
        WHERE component_name = '$component'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [ -n "$pr_data" ]; then
        IFS='|' read -r pr_name pr_uid status repo_url branch has_logs konflux_url <<< "$pr_data"

        echo -e "${BOLD}========================================${NC}"
        echo -e "${BOLD}Latest PipelineRun${NC}"
        echo -e "${BOLD}========================================${NC}"
        echo ""
        echo -e "${BOLD}PipelineRun:${NC} $pr_name"
        echo -e "${BOLD}UID:${NC} $pr_uid"
        echo -e "${BOLD}Status:${NC} $status"
        echo -e "${BOLD}Repository:${NC} $repo_url"
        echo -e "${BOLD}Branch:${NC} $branch"
        echo -e "${BOLD}Has Logs:${NC} $has_logs"
        echo ""
        echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"
        echo ""

        # Show logs if available
        if [ "$has_logs" = "Yes" ]; then
            local logs=$(sql "SELECT build_logs FROM build_failures WHERE pipelinerun_name = '$pr_name' LIMIT 1;")
            local log_size=$(echo "$logs" | wc -c)

            if [ "$log_size" -gt 10 ]; then
                echo -e "${BOLD}========================================${NC}"
                if [ "$show_full_log" = true ]; then
                    echo -e "${BOLD}Build Logs (Full)${NC}"
                else
                    echo -e "${BOLD}Build Logs${NC}"
                fi
                echo -e "${BOLD}========================================${NC}"
                echo ""

                if [ "$show_full_log" = true ]; then
                    echo "$logs"
                else
                    # For short logs, show them directly
                    if [ "$log_size" -lt 1000 ]; then
                        echo "$logs"
                    else
                        # For long logs, extract context
                        extract_error_context "$logs"
                    fi

                    if [ "$log_size" -gt 1000 ]; then
                        echo ""
                        echo -e "${CYAN}💡 Tip: Add --log flag to see the complete build log${NC}"
                    fi
                fi
                echo ""
            else
                echo -e "${YELLOW}⚠ Logs available but empty${NC}"
                echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
                echo ""
            fi
        else
            echo -e "${YELLOW}⚠ No logs stored in database${NC}"
            echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
            echo ""
        fi
    fi
}

cmd_describe_pipelinerun() {
    local pr_name="$1"
    if [ -z "$pr_name" ]; then
        echo -e "${RED}Error: PipelineRun name required${NC}"
        echo "Usage: ic describe pipelinerun <name>"
        exit 1
    fi

    local data=$(sql "
        SELECT component_name, pipelinerun_uid, status, repository_url, branch,
               CASE WHEN build_logs IS NOT NULL THEN 'Yes' ELSE 'No' END,
               konflux_logs_url, build_logs
        FROM build_failures
        WHERE pipelinerun_name = '$pr_name'
        LIMIT 1;
    ")

    if [ -z "$data" ]; then
        echo -e "${RED}Error: PipelineRun not found: $pr_name${NC}"
        exit 1
    fi

    IFS='|' read -r component uid status repo_url branch has_logs konflux_url logs <<< "$data"

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}PipelineRun: $pr_name${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""
    echo -e "${BOLD}Component:${NC} $component"
    echo -e "${BOLD}UID:${NC} $uid"
    echo -e "${BOLD}Status:${NC} $status"
    echo -e "${BOLD}Repository:${NC} $repo_url"
    echo -e "${BOLD}Branch:${NC} $branch"
    echo -e "${BOLD}Has Logs:${NC} $has_logs"
    echo ""
    echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"
    echo ""

    if [ "$has_logs" = "Yes" ]; then
        echo -e "${BOLD}========================================${NC}"
        echo -e "${BOLD}Build Logs${NC}"
        echo -e "${BOLD}========================================${NC}"
        echo ""
        echo "$logs"
        echo ""
    fi
}

# Number shortcut
cmd_describe_by_number() {
    local number="$1"
    shift
    local extra_args="$@"

    local total=$(sql "SELECT COUNT(DISTINCT component_name) FROM build_failures;")

    if [[ "$number" -gt "$total" ]]; then
        echo -e "${RED}Error: Component #$number does not exist${NC}"
        echo "Only $total components are failing."
        exit 1
    fi

    local component=$(sql "
        SELECT component_name
        FROM build_failures
        GROUP BY component_name
        ORDER BY COUNT(*) DESC
        OFFSET $((number - 1))
        LIMIT 1;
    ")

    echo -e "${CYAN}Component #$number of $total${NC}"
    echo ""
    cmd_describe_component "$component" $extra_args
}

# Config commands
cmd_config_show() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Current Configuration${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""
    echo -e "${BOLD}Environment:${NC}"
    echo "  Namespace: ${CYAN}${NAMESPACE}${NC}"
    echo "  Application: ${CYAN}${APPLICATION_NAME}${NC}"
    echo "  Config: $SCRIPT_DIR/.env"
    echo ""
    echo -e "${BOLD}Database:${NC}"
    echo "  Failures: $(sql 'SELECT COUNT(*) FROM build_failures;')"
    echo "  Components: $(sql 'SELECT COUNT(DISTINCT component_name) FROM build_failures;')"
    echo ""
    echo -e "${CYAN}Commands:${NC}"
    echo "  ic config set-app <app>  # Change application"
    echo "  ic get apps              # List applications"
    echo ""
}

cmd_config_set_app() {
    local new_app="$1"

    if [ -z "$new_app" ]; then
        echo -e "${RED}Error: Application name required${NC}"
        echo "Usage: ic config set-app <app-name>"
        echo ""
        cmd_get_apps
        exit 1
    fi

    if ! oc get application "$new_app" -n "$NAMESPACE" &>/dev/null; then
        echo -e "${RED}Error: Application '$new_app' not found${NC}"
        echo ""
        cmd_get_apps
        exit 1
    fi

    local env_file="$SCRIPT_DIR/.env"
    if grep -q "^APPLICATION_NAME=" "$env_file" 2>/dev/null; then
        sed -i "s/^APPLICATION_NAME=.*/APPLICATION_NAME=$new_app/" "$env_file"
    else
        echo "APPLICATION_NAME=$new_app" >> "$env_file"
    fi

    echo -e "${GREEN}✓ Application set to: ${CYAN}${new_app}${NC}"
    echo ""
    echo "Reload config with: source .env"
    echo ""
}

# Stats commands
cmd_stats() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Statistics${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT
        COUNT(*) as \"Total Failures\",
        COUNT(DISTINCT component_name) as \"Components\",
        COUNT(CASE WHEN build_logs IS NOT NULL THEN 1 END) as \"With Logs\"
    FROM build_failures;
    "
    echo ""
}

cmd_stats_daily() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Failures by Day${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT
        DATE(first_detected_at) as \"Date\",
        COUNT(*) as \"Failures\"
    FROM build_failures
    GROUP BY DATE(first_detected_at)
    ORDER BY DATE(first_detected_at) DESC
    LIMIT 7;
    "
    echo ""
}

cmd_stats_resolved() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Resolved Failures Statistics${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT
        COUNT(*) as \"Total Records\",
        SUM(CASE WHEN is_resolved = TRUE THEN 1 ELSE 0 END) as \"Resolved\",
        SUM(CASE WHEN is_resolved = FALSE THEN 1 ELSE 0 END) as \"Unresolved\",
        SUM(CASE WHEN status = 'Succeeded' THEN 1 ELSE 0 END) as \"Successes\"
    FROM build_failures
    WHERE application = '$APPLICATION_NAME';
    "
    echo ""
}

# Resolved components commands
cmd_resolved() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Resolved Components${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    sql_table "
    SELECT DISTINCT
        component_name as \"Component\",
        MAX(resolved_at) as \"Resolved At\",
        COUNT(*) as \"Failures Fixed\"
    FROM build_failures
    WHERE is_resolved = TRUE
      AND application = '$APPLICATION_NAME'
    GROUP BY component_name
    ORDER BY MAX(resolved_at) DESC;
    "
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic history <component>' to see full history"
    echo ""
}

# Component history command
cmd_history() {
    local component_name="$1"

    if [ -z "$component_name" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic history <component-name>"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}History: $component_name${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Summary
    sql_table "
    SELECT
        COUNT(*) as \"Total Builds\",
        SUM(CASE WHEN status = 'Failed' THEN 1 ELSE 0 END) as \"Failures\",
        SUM(CASE WHEN status = 'Succeeded' THEN 1 ELSE 0 END) as \"Successes\",
        SUM(CASE WHEN is_resolved = TRUE THEN 1 ELSE 0 END) as \"Resolved\"
    FROM build_failures
    WHERE component_name = '$component_name'
      AND application = '$APPLICATION_NAME';
    "
    echo ""

    echo -e "${BOLD}Recent Builds (Last 20):${NC}"
    echo ""

    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        status as \"Status\",
        CASE WHEN is_resolved THEN '✓' ELSE '' END as \"Resolved\",
        LEFT(commit_short_sha, 8) as \"Commit\",
        first_detected_at as \"Date\"
    FROM build_failures
    WHERE component_name = '$component_name'
      AND application = '$APPLICATION_NAME'
    ORDER BY first_detected_at DESC
    LIMIT 20;
    "
    echo ""

    # Show current status (based on last build)
    local last_status=$(sql "
        SELECT status
        FROM build_failures
        WHERE component_name = '$component_name'
          AND application = '$APPLICATION_NAME'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [[ "$last_status" == "Failed" ]]; then
        echo -e "${RED}✗ Currently failing${NC} (last build: Failed)"
        echo -e "  Run: ${CYAN}ic why $component_name${NC} to investigate"
    elif [[ "$last_status" == "Succeeded" ]]; then
        echo -e "${GREEN}✓ Currently working${NC} (last build: Succeeded)"
    else
        echo -e "${YELLOW}? Status unknown${NC} (last build: $last_status)"
    fi
    echo ""
}

# Currently working components
cmd_working() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Currently Working Components${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    echo -e "${BOLD}${GREEN}Components with last build = Succeeded:${NC}"
    sql_table "
    WITH latest_builds AS (
        SELECT DISTINCT ON (component_name)
            component_name,
            pipelinerun_name,
            status,
            commit_short_sha,
            commit_message,
            commit_url,
            konflux_url,
            first_detected_at
        FROM build_failures
        WHERE application = '$APPLICATION_NAME'
        ORDER BY component_name, first_detected_at DESC
    )
    SELECT
        component_name as \"Component\",
        LEFT(commit_short_sha, 8) as \"Commit\",
        LEFT(commit_message, 50) as \"Message\",
        first_detected_at::date as \"Last Build\"
    FROM latest_builds
    WHERE status = 'Succeeded'
    ORDER BY first_detected_at DESC;
    "
    echo ""

    echo -e "${CYAN}Links:${NC}"
    echo "  Use: ${BOLD}ic history <component>${NC} to see full build history"
    echo "  Use: ${BOLD}ic triage${NC} to see currently failing components"
    echo ""
}

