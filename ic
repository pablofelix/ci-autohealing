cmd_config_set_app() {
    local new_app="$1"
    local force=false
    [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]] && force=true

    if [ -z "$new_app" ]; then
        echo -e "${RED}Error: Application name required${NC}"
        echo "Usage: ic config set-app <app-name>"
        echo ""
        cmd_get_apps
        return 1
    fi

    # Validate against cluster if reachable
    if oc whoami &>/dev/null; then
        if ! oc get application "$new_app" -n "$NAMESPACE" &>/dev/null; then
            echo -e "${RED}Error: Application '$new_app' not found in namespace $NAMESPACE${NC}"
            echo ""
            cmd_get_apps
            return 1
        fi
    else
        # Cluster unreachable — validate against DB
        local in_db=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$new_app';" 2>/dev/null)
        if [ "${in_db:-0}" = "0" ] && [ "$force" != true ]; then
            echo -e "${YELLOW}⚠ Cluster unreachable${NC}"
            echo -e "${RED}Error: Application '$new_app' not found in database${NC}"
            echo ""
            cmd_get_apps
            echo -e "${CYAN}Use --force to set anyway:${NC} ic config set-app $new_app --force"
            echo ""
            return 1
        elif [ "${in_db:-0}" = "0" ]; then
            echo -e "${YELLOW}⚠ Cluster unreachable, application not in database — setting anyway${NC}"
        fi
    fi

    local env_file="$SCRIPT_DIR/.env"
    touch "$env_file"
    if grep -q "^APPLICATION_NAME=" "$env_file" 2>/dev/null; then
        sed -i "s/^APPLICATION_NAME=.*/APPLICATION_NAME=$new_app/" "$env_file"
    else
        echo "APPLICATION_NAME=$new_app" >> "$env_file"
    fi

    APPLICATION_NAME="$new_app"
    export APPLICATION_NAME

    echo -e "${GREEN}✓ Application set to: ${CYAN}${new_app}${NC}"
    # Check if we have cached data for this app
    local has_cache=$(sql "SELECT COUNT(*) FROM sync_status WHERE application = '$new_app';" 2>/dev/null)
    if [ "$has_cache" = "0" ] || [ -z "$has_cache" ]; then
        echo -e "  No cached data yet. Run ${CYAN}ic get components -r${NC} to sync."
    else
        echo -e "  Cached sync data available. Run ${CYAN}ic get components${NC} to view."
    fi
    echo ""
}

cmd_freeze() {
    local subcmd="${1:-list}"; shift 2>/dev/null
    case "$subcmd" in
        add)
            local start_date="$1" end_date="$2"
            shift 2 2>/dev/null
            local reason="$*"
            if [ -z "$start_date" ] || [ -z "$end_date" ] || [ -z "$reason" ]; then
                echo "Usage: ic freeze add <start-date> <end-date> <reason>"
                echo "Example: ic freeze add 2026-06-18 2026-06-19 Juneteenth"
                return 1
            fi
            start_date=$(date -d "$start_date" '+%Y-%m-%d' 2>/dev/null)
            end_date=$(date -d "$end_date" '+%Y-%m-%d' 2>/dev/null)
            if [ -z "$start_date" ] || [ -z "$end_date" ]; then
                echo -e "${RED}Error: Invalid date format${NC}"
                return 1
            fi
            local safe_reason="${reason//\'/\'\'}"
            sql "INSERT INTO release_freezes (start_date, end_date, reason) VALUES ('$start_date', '$end_date', '$safe_reason');" >/dev/null
            echo -e "${GREEN}✓${NC} Freeze added: ${start_date} → ${end_date} (${reason})"
            ;;
        list|ls)
            _check_db || return 1
            local data
            data=$(sql_list_freezes 2>/dev/null)
            if [ -z "$data" ]; then
                echo "No freezes configured."
                echo -e "${CYAN}Tip:${NC} ic freeze add 2026-06-18 2026-06-19 Juneteenth"
                return
            fi
            local today=$(date '+%Y-%m-%d')
            printf "  %-4s %-12s %-12s %-8s %s\n" "ID" "Start" "End" "Status" "Reason"
            printf "  %-4s %-12s %-12s %-8s %s\n" "---" "----------" "----------" "------" "------"
            while IFS='|' read -r fid fstart fend freason; do
                fid=$(trim "$fid"); fstart=$(trim "$fstart"); fend=$(trim "$fend"); freason=$(trim "$freason")
                [ -z "$fid" ] && continue
                local status_label="${DIM}past${NC}"
                [[ "$today" > "$fend" ]] || {
                    [[ "$today" < "$fstart" ]] && status_label="${YELLOW}upcoming${NC}" || status_label="${RED}ACTIVE${NC}"
                }
                printf "  %-4s %-12s %-12s " "$fid" "$fstart" "$fend"
                echo -e "$status_label $freason"
            done <<< "$data"
            ;;
        rm|remove|delete)
            local fid="$1"
            if [ -z "$fid" ]; then
                echo "Usage: ic freeze rm <id>"
                return 1
            fi
            if ! [[ "$fid" =~ ^[0-9]+$ ]]; then
                echo -e "${RED}Error: ID must be a number${NC}"
                return 1
            fi
            sql "DELETE FROM release_freezes WHERE id = $fid;" >/dev/null
            echo -e "${GREEN}✓${NC} Freeze ${fid} removed"
            ;;
        *)
            echo "Usage: ic freeze <add|list|rm>"
            ;;
    esac
}

