#!/bin/bash

# IC (Infrastructure/CI) Command Line Tool
# kubectl-style interface for CI Auto-Healing system

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load configuration
if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    source "$SCRIPT_DIR/.env"
    set +a
fi

NAMESPACE="${NAMESPACE:-NAMESPACE_PLACEHOLDER}"
APPLICATION_NAME="${APPLICATION_NAME:-acme-v2-0}"
export PGPASSWORD="admin"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Helper functions
sql() {
    docker exec ci-autohealing-db psql -U postgres -d konflux_monitoring -tAc "$1" 2>/dev/null
}

sql_table() {
    docker exec ci-autohealing-db psql -U postgres -d konflux_monitoring -c "$1" 2>/dev/null | grep -v "Emulate Docker"
}

# Extract error context from logs
extract_error_context() {
    local logs="$1"
    local max_sections=3
    local lines_per_section=40

    # Save logs to temp file for processing
    local tmp_file=$(mktemp)
    echo "$logs" > "$tmp_file"

    # Find TaskRun sections - these are the structure of our logs
    local taskrun_starts=$(grep -n "^===== TaskRun:" "$tmp_file" | cut -d: -f1)

    if [ -z "$taskrun_starts" ]; then
        # No TaskRun structure - show beginning and end
        echo -e "${YELLOW}━━━ Log excerpt (first and last sections) ━━━${NC}"
        echo ""
        echo -e "${CYAN}[Beginning]${NC}"
        head -n 40 "$tmp_file"
        echo ""
        echo -e "${YELLOW}... (middle section omitted) ...${NC}"
        echo ""
        echo -e "${CYAN}[End]${NC}"
        tail -n 40 "$tmp_file"
        rm -f "$tmp_file"
        return
    fi

    # Get last N TaskRun sections (most likely to contain errors)
    local taskrun_array=($taskrun_starts)
    local total_taskruns=${#taskrun_array[@]}
    local start_idx=$((total_taskruns > max_sections ? total_taskruns - max_sections : 0))

    echo -e "${YELLOW}━━━ Showing last ${max_sections} of ${total_taskruns} TaskRun section(s) ━━━${NC}"
    echo ""

    local shown=0
    for ((i=start_idx; i<total_taskruns && shown<max_sections; i++)); do
        shown=$((shown + 1))
        local start_line=${taskrun_array[$i]}
        local end_line

        # Calculate end: next TaskRun or end of file
        if [ $((i + 1)) -lt $total_taskruns ]; then
            end_line=$((${taskrun_array[$((i + 1))]} - 1))
        else
            end_line=$(wc -l < "$tmp_file")
        fi

        # Get TaskRun header
        local header=$(sed -n "${start_line}p" "$tmp_file")

        # Get section size
        local section_lines=$((end_line - start_line + 1))

        echo -e "${CYAN}━━━ Section #$shown: $(echo "$header" | sed 's/^===== //' | sed 's/ =====$//')${NC}"
        echo -e "${CYAN}━━━ Lines: $section_lines${NC}"
        echo ""

        if [ $section_lines -le $lines_per_section ]; then
            # Show entire section if small enough
            sed -n "${start_line},${end_line}p" "$tmp_file" | sed 's/^/  /'
        else
            # For large sections, show mostly the end (where errors usually are)
            local head_lines=5
            local tail_lines=$((lines_per_section - head_lines - 2))

            echo -e "${YELLOW}  [First $head_lines lines]${NC}"
            sed -n "${start_line},$((start_line + head_lines - 1))p" "$tmp_file" | sed 's/^/  /'
            echo ""
            echo -e "${YELLOW}  ... ($((section_lines - head_lines - tail_lines)) lines omitted) ...${NC}"
            echo ""
            echo -e "${YELLOW}  [Last $tail_lines lines - most likely error location]${NC}"
            sed -n "$((end_line - tail_lines + 1)),${end_line}p" "$tmp_file" | sed 's/^/  /'
        fi
        echo ""

    done

    rm -f "$tmp_file"
}

