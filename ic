# TRIAGE commands - focused on understanding failures

cmd_triage() {
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Triage Dashboard${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get current failing components (last build = failed)
    echo -e "${BOLD}Overview:${NC}"

    # Total records vs currently failing
    local total_records=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$APPLICATION_NAME';")
    local currently_failing=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name,
                status,
                is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds WHERE status = 'Failed' AND is_resolved = FALSE;
    ")
    local currently_working=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name,
                status
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds WHERE status = 'Succeeded';
    ")

    echo "  Total build records: $total_records"
    echo "  Currently failing: ${RED}$currently_failing${NC}"
    echo "  Currently working: ${GREEN}$currently_working${NC}"
    echo ""

    # Show only components that are CURRENTLY failing (last build = failed)
    echo -e "${BOLD}${RED}Currently Failing Components:${NC}"
    sql_table "
    WITH latest_builds AS (
        SELECT DISTINCT ON (component_name)
            component_name,
            pipelinerun_name,
            status,
            first_detected_at,
            build_logs IS NOT NULL as has_logs
        FROM build_failures
        WHERE application = '$APPLICATION_NAME'
        ORDER BY component_name, first_detected_at DESC
    )
    SELECT
        component_name as \"Component\",
        first_detected_at::date as \"Last Failure\",
        CASE WHEN has_logs THEN 'Yes' ELSE 'No' END as \"Has Logs\"
    FROM latest_builds
    WHERE status = 'Failed'
    ORDER BY first_detected_at DESC;
    "
    echo ""

    echo -e "${CYAN}Next Steps:${NC}"
    echo "  1. Pick a component from above"
    echo "  2. Run: ${BOLD}ic why <component>${NC} to see why it's failing"
    echo "  3. Run: ${BOLD}ic analyze <component>${NC} for deep analysis"
    echo "  4. Use: ${BOLD}ic working${NC} to see components that are currently working"
    echo ""
}

cmd_why() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic why <component-name>"
        echo ""
        echo "Example:"
        echo "  ic why odh-spark-operator-v3-4"
        exit 1
    fi

    # Check if component exists
    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        echo ""
        echo "Available components:"
        sql "SELECT DISTINCT component_name FROM build_failures ORDER BY component_name;" | head -10
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Why is $component failing?${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get latest PipelineRun
    local pr_data=$(sql "
        SELECT pipelinerun_name, repository_url, branch, first_detected_at
        FROM build_failures
        WHERE component_name = '$component'
        ORDER BY first_detected_at DESC
        LIMIT 1;
    ")

    if [ -z "$pr_data" ]; then
        echo -e "${RED}No build failures found${NC}"
        exit 1
    fi

    IFS='|' read -r pr_name repo_url branch detected_at <<< "$pr_data"

    echo -e "${BOLD}Latest Failure:${NC}"
    echo "  PipelineRun: ${CYAN}$pr_name${NC}"
    echo "  Repository: $repo_url"
    echo "  Branch: $branch"
    echo "  Detected: $detected_at"
    echo ""

    # Get commit info and logs from DB
    local commit_data=$(sql "
        SELECT commit_sha, commit_url, konflux_logs_url, build_logs
        FROM build_failures
        WHERE pipelinerun_name = '$pr_name'
        LIMIT 1;
    ")

    if [ -n "$commit_data" ]; then
        IFS='|' read -r commit_sha commit_url log_url build_logs <<< "$commit_data"

        echo -e "${BOLD}========================================${NC}"
        echo -e "${BOLD}Commit Information${NC}"
        echo -e "${BOLD}========================================${NC}"
        echo ""
        if [ -n "$commit_sha" ] && [ "$commit_sha" != "" ]; then
            echo "  Commit SHA: ${CYAN}${commit_sha:0:8}${NC}"
        fi
        if [ -n "$commit_url" ] && [ "$commit_url" != "" ]; then
            echo "  Commit URL: ${CYAN}$commit_url${NC}"
        fi
        if [ -n "$log_url" ] && [ "$log_url" != "" ]; then
            echo "  Konflux UI: ${CYAN}$log_url${NC}"
        fi
        echo ""

        # Show log excerpt if available
        if [ -n "$build_logs" ] && [ ${#build_logs} -gt 500 ]; then
            echo -e "${BOLD}========================================${NC}"
            echo -e "${BOLD}Log Excerpt${NC}"
            echo -e "${BOLD}========================================${NC}"
            echo ""
            extract_error_context "$build_logs"
            echo ""
        else
            echo -e "${YELLOW}⚠ No logs available in database${NC}"
            echo -e "${CYAN}→ View logs in Konflux UI (link above)${NC}"
            echo ""
        fi
    fi

    echo -e "${CYAN}Next Steps:${NC}"
    echo "  • Use ${BOLD}ic describe component $component${NC} for full details"
    echo "  • Use ${BOLD}ic describe component $component --log${NC} for complete logs"
    echo ""
}

cmd_analyze() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic analyze <component-name>"
        exit 1
    fi

    local total=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component';")
    if [ "$total" = "0" ]; then
        echo -e "${RED}Error: Component not found: $component${NC}"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Deep Analysis: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Failure timeline
    echo -e "${BOLD}Failure Timeline (last 7 days):${NC}"
    sql_table "
    SELECT
        DATE(first_detected_at) as \"Date\",
        COUNT(*) as \"Failures\",
        COUNT(CASE WHEN build_logs IS NOT NULL THEN 1 END) as \"With Logs\"
    FROM build_failures
    WHERE component_name = '$component'
      AND first_detected_at > NOW() - INTERVAL '7 days'
    GROUP BY DATE(first_detected_at)
    ORDER BY DATE(first_detected_at) DESC;
    "
    echo ""

    # Repository info
    local repo_info=$(sql "
        SELECT DISTINCT repository_url, branch
        FROM build_failures
        WHERE component_name = '$component'
        LIMIT 1;
    " | head -1)

    if [ -n "$repo_info" ]; then
        IFS='|' read -r repo branch <<< "$repo_info"
        echo -e "${BOLD}Repository:${NC}"
        echo "  URL: $repo"
        echo "  Branch: $branch"
        echo ""
    fi

    # All recent failures
    echo -e "${BOLD}All Failures (recent):${NC}"
    sql_table "
    SELECT
        pipelinerun_name as \"PipelineRun\",
        first_detected_at::timestamp(0) as \"When\",
        CASE
            WHEN build_logs IS NOT NULL THEN 'Yes'
            ELSE 'No'
        END as \"Logs\"
    FROM build_failures
    WHERE component_name = '$component'
    ORDER BY first_detected_at DESC
    LIMIT 10;
    "
    echo ""

    # Pattern analysis
    local with_logs=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND build_logs IS NOT NULL;")

    if [ "$with_logs" != "0" ]; then
        echo -e "${BOLD}Pattern Analysis:${NC}"

        # Count resource not found
        local resource_not_found=$(sql "
            SELECT COUNT(*)
            FROM build_failures
            WHERE component_name = '$component'
              AND build_logs LIKE '%resource not found%';
        ")

        if [ "$resource_not_found" != "0" ]; then
            echo "  - $resource_not_found failures show 'resource not found' (logs already archived)"
        fi

        # Sample error from latest
        local latest_error=$(sql "
            SELECT SUBSTRING(build_logs FROM 'ERROR[^\n]*')
            FROM build_failures
            WHERE component_name = '$component'
              AND build_logs IS NOT NULL
              AND build_logs LIKE '%ERROR%'
            ORDER BY first_detected_at DESC
            LIMIT 1;
        " | head -1)

        if [ -n "$latest_error" ] && [ "$latest_error" != "" ]; then
            echo "  - Sample error: $latest_error"
        fi
        echo ""
    fi

    echo -e "${CYAN}Recommendations:${NC}"
    if [ "$with_logs" = "0" ]; then
        echo "  1. ${BOLD}Fetch logs${NC} to understand failure reasons"
        echo "     python3 collectors/python/fetch_archived_logs.py"
    else
        echo "  1. ${BOLD}Review error patterns${NC} above"
        echo "  2. ${BOLD}Check latest failure${NC}: ic describe pr <pipelinerun>"
        echo "  3. ${BOLD}Compare with Konflux UI${NC} for full pipeline view"
    fi
    echo ""
}

cmd_errors() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic errors <component-name>"
        exit 1
    fi

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Error Extraction: $component${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Get all logs for this component
    local logs=$(sql "
        SELECT build_logs
        FROM build_failures
        WHERE component_name = '$component'
          AND build_logs IS NOT NULL
        ORDER BY first_detected_at DESC;
    ")

    if [ -z "$logs" ]; then
        echo -e "${YELLOW}No logs available for this component${NC}"
        exit 0
    fi

    # Extract unique error patterns
    echo -e "${BOLD}Error Patterns:${NC}"
    echo "$logs" | grep -iE "error|fail|exception" | sort | uniq -c | sort -rn | head -10
    echo ""

    echo -e "${BOLD}Exit Codes:${NC}"
    echo "$logs" | grep -iE "exit code|exitcode" | head -5
    echo ""
}

# GET CONFORMA - Conforma test failures
cmd_get_conforma() {
    local refresh=false
    [[ "${1:-}" == "--refresh" || "${1:-}" == "-r" ]] && refresh=true

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Conforma Test Failures${NC}"
    echo -e "${BOLD}Application: ${CYAN}${APPLICATION_NAME}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    if [ "$refresh" = true ]; then
        echo -e "${CYAN}Refreshing Conforma status (querying KubeArchive)...${NC}"
        cd "$SCRIPT_DIR/collectors/python" && python3 check_conforma_status.py > /dev/null 2>&1
        python3 collect_conforma.py > /dev/null 2>&1
        cd "$SCRIPT_DIR"
    fi

    local count=$(sql "SELECT COUNT(*) FROM conforma_results WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)

    if [ "${count:-0}" = "0" ]; then
        echo -e "${GREEN}✓ No Conforma failures${NC}"
        echo ""
        echo -e "${CYAN}Tip:${NC} Use 'ic get conforma --refresh' to check for new failures"
        return
    fi

    echo -e "${BOLD}Summary:${NC} ${RED}${count}${NC} components failing Conforma tests"
    echo ""

    sql_table "
    SELECT
        ROW_NUMBER() OVER (ORDER BY violations_count DESC) as \"#\",
        component_name as \"Component\",
        violations_count as \"Violations\",
        warnings_count as \"Warnings\",
        successes_count as \"OK\",
        TO_CHAR(first_detected_at, 'DD Mon') as \"Since\"
    FROM conforma_results
    WHERE application = '$APPLICATION_NAME'
      AND is_resolved = FALSE
    ORDER BY violations_count DESC;
    "
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic describe conforma <component>' for violation details"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts' to see builds + Conforma in one view"
    echo ""
}

# GET ALERTS - unified view of build failures + conforma
cmd_get_alerts() {
    local refresh=false
    local target_date=""
    local from_date=""
    local to_date=""

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --refresh|-r) refresh=true; shift ;;
            --date)
                shift
                target_date=$(date -d "${1:?--date requires a value}" '+%Y-%m-%d' 2>/dev/null)
                if [ -z "$target_date" ]; then
                    echo -e "${RED}Error: Invalid date: $1${NC}"
                    echo "Examples: --date 2026-04-20, --date yesterday, --date '3 days ago'"
                    exit 1
                fi
                shift ;;
            --from)
                shift
                from_date=$(date -d "${1:?--from requires a value}" '+%Y-%m-%d' 2>/dev/null)
                if [ -z "$from_date" ]; then
                    echo -e "${RED}Error: Invalid date: $1${NC}"
                    exit 1
                fi
                shift ;;
            --to)
                shift
                to_date=$(date -d "${1:?--to requires a value}" '+%Y-%m-%d' 2>/dev/null)
                if [ -z "$to_date" ]; then
                    echo -e "${RED}Error: Invalid date: $1${NC}"
                    exit 1
                fi
                shift ;;
            *) shift ;;
        esac
    done

    # Dispatch to historical view if date flags are used
    if [ -n "$target_date" ]; then
        cmd_get_alerts_on_date "$target_date"
        return
    fi

    if [ -n "$from_date" ]; then
        [ -z "$to_date" ] && to_date=$(date '+%Y-%m-%d')
        cmd_get_alerts_range "$from_date" "$to_date"
        return
    fi

    # --- Current alerts (original behavior) ---
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Alerts — ${APPLICATION_NAME}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    if [ "$refresh" = true ]; then
        echo -e "${CYAN}Refreshing (querying KubeArchive)...${NC}"
        cd "$SCRIPT_DIR/collectors/python"
        python3 check_sync_status.py > /dev/null 2>&1
        python3 check_conforma_status.py > /dev/null 2>&1
        python3 collect_conforma.py > /dev/null 2>&1
        cd "$SCRIPT_DIR"
        echo ""
    fi

    # Read sync cache for sync date and retriggered
    local sync_row=$(sql "
        SELECT
            TO_CHAR(last_checked_at, 'YYYY-MM-DD HH24:MI:SS'),
            EXTRACT(EPOCH FROM (NOW() - last_checked_at))::int,
            COALESCE(retriggered_components::text, '[]'),
            COALESCE(conforma_components::text, '[]')
        FROM sync_status WHERE application = '$APPLICATION_NAME';
    " 2>/dev/null)

    local sync_date age_seconds retriggered_json conforma_json
    IFS='|' read -r sync_date age_seconds retriggered_json conforma_json <<< "$sync_row"
    sync_date=$(echo "$sync_date" | xargs 2>/dev/null || echo "")
    age_seconds=$(echo "$age_seconds" | tr -d ' ')
    local age_minutes=0
    [ -n "$age_seconds" ] && age_minutes=$((age_seconds / 60))

    if [ -n "$sync_date" ]; then
        echo -e "${CYAN}Last sync: ${sync_date}, ${age_minutes}m ago${NC}"
        echo ""
    fi

    # --- Section 1: Build Failures ---
    local retriggered_list=""
    if [ -n "$retriggered_json" ] && [ "$retriggered_json" != "[]" ]; then
        retriggered_list=$(echo "$retriggered_json" | jq -r '.[]' 2>/dev/null | paste -sd',' -)
    fi

    local build_count=$(sql "
        WITH latest_builds AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT COUNT(*) FROM latest_builds
        WHERE status = 'Failed' AND is_resolved = FALSE;
    ")

    echo -e "${BOLD}Build Failures (${build_count:-0}):${NC}"

    if [ "${build_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No build failures${NC}"
    else
        sql_table "
        WITH push_failed AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, is_resolved, first_detected_at,
                (SELECT COUNT(*) FROM build_failures bf WHERE bf.component_name = build_failures.component_name) as total_failures
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
            ORDER BY component_name, first_detected_at DESC
        ),
        failing AS (
            SELECT component_name, total_failures,
                TO_CHAR(first_detected_at, 'DD Mon') as failed_date,
                CASE WHEN component_name IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
                    THEN 'Re-triggered ✓'
                    ELSE 'Push Failed'
                END as status_label,
                CASE WHEN component_name IN (SELECT value FROM json_array_elements_text('$(echo "${retriggered_json:-[]}" | sed "s/'/\\\\'/g")'))
                    THEN 2 ELSE 1
                END as sort_group
            FROM push_failed
            WHERE status = 'Failed' AND is_resolved = FALSE
        )
        SELECT
            ROW_NUMBER() OVER (ORDER BY sort_group, total_failures DESC) as \"#\",
            component_name as \"Component\",
            status_label as \"Status\",
            failed_date as \"Failed\",
            total_failures as \"Builds\"
        FROM failing
        ORDER BY sort_group, total_failures DESC;
        "
    fi
    echo ""

    # --- Section 2: Conforma Failures ---
    local conforma_count=$(sql "
        SELECT COUNT(*) FROM (
            SELECT DISTINCT ON (component_name) component_name
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
            ORDER BY component_name, last_updated_at DESC
        ) sub;
    " 2>/dev/null)

    echo -e "${BOLD}Conforma Failures (${conforma_count:-0}):${NC}"

    if [ "${conforma_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No Conforma failures${NC}"
    else
        # Offset numbering to continue from build failures
        local offset=${build_count:-0}
        sql_table "
        WITH latest_conforma AS (
            SELECT DISTINCT ON (component_name)
                component_name, violations_count, warnings_count, first_detected_at
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND is_resolved = FALSE
            ORDER BY component_name, last_updated_at DESC
        )
        SELECT
            (ROW_NUMBER() OVER (ORDER BY violations_count DESC) + $offset) as \"#\",
            component_name as \"Component\",
            violations_count as \"Violations\",
            warnings_count as \"Warnings\",
            TO_CHAR(first_detected_at, 'DD Mon') as \"Since\"
        FROM latest_conforma
        ORDER BY violations_count DESC;
        "
    fi
    echo ""

    # --- Section 3: In Progress ---
    local running_builds_json running_conforma_json
    running_builds_json=$(sql "SELECT COALESCE(running_builds::text, '[]') FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null)
    running_conforma_json=$(sql "SELECT COALESCE(running_conforma::text, '[]') FROM sync_status WHERE application = '$APPLICATION_NAME';" 2>/dev/null)

    # Combine both into a single list
    local running_count=0
    local running_items=""

    if [ -n "$running_builds_json" ] && [ "$running_builds_json" != "[]" ]; then
        local build_items=$(echo "$running_builds_json" | jq -r '.[] | "\(.component)|\(.timestamp)|\(.pipelinerun_name)|Build"' 2>/dev/null)
        if [ -n "$build_items" ]; then
            running_items="$build_items"
        fi
    fi

    if [ -n "$running_conforma_json" ] && [ "$running_conforma_json" != "[]" ]; then
        local conforma_items=$(echo "$running_conforma_json" | jq -r '.[] | "\(.component)|\(.timestamp)|\(.pipelinerun_name)|Conforma"' 2>/dev/null)
        if [ -n "$conforma_items" ]; then
            if [ -n "$running_items" ]; then
                running_items="$running_items"$'\n'"$conforma_items"
            else
                running_items="$conforma_items"
            fi
        fi
    fi

    if [ -n "$running_items" ]; then
        running_count=$(echo "$running_items" | wc -l)
        echo -e "${BOLD}In Progress (${running_count}):${NC}"
        printf "  %-40s %-10s %-18s %s\n" "Component" "Type" "Started" "Duration"
        printf "  %-40s %-10s %-18s %s\n" "$(printf '%0.s-' {1..40})" "$(printf '%0.s-' {1..10})" "$(printf '%0.s-' {1..18})" "$(printf '%0.s-' {1..10})"

        local now_epoch=$(date +%s)
        echo "$running_items" | while IFS='|' read -r r_comp r_ts r_pr r_type; do
            local start_epoch=$(date -d "$r_ts" +%s 2>/dev/null || echo "$now_epoch")
            local elapsed=$(( now_epoch - start_epoch ))
            local duration_str=""
            if [ "$elapsed" -ge 7200 ]; then
                duration_str="${YELLOW}⚠ $((elapsed / 3600))h $((elapsed % 3600 / 60))m (stuck?)${NC}"
            elif [ "$elapsed" -ge 3600 ]; then
                duration_str="$((elapsed / 3600))h $((elapsed % 3600 / 60))m"
            else
                duration_str="$((elapsed / 60))m"
            fi
            local started_fmt=$(date -d "$r_ts" '+%d %b %H:%M' 2>/dev/null || echo "$r_ts")
            printf "  %-40s %-10s %-18s " "${r_comp:0:40}" "$r_type" "$started_fmt"
            echo -e "$duration_str"
        done
        echo ""
    fi

    local total=$((${build_count:-0} + ${conforma_count:-0}))
    echo -e "${BOLD}Total alerts: ${RED}${total}${NC} (${build_count:-0} builds, ${conforma_count:-0} conforma)"
    if [ "$running_count" -gt 0 ]; then
        echo -e "${BOLD}In progress: ${YELLOW}${running_count}${NC}"
    fi
    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'ic <number>' to see details (works across both sections)"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --refresh' to force a fresh check"
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts --date yesterday' to see past alerts"
    echo ""
}

# GET ALERTS ON DATE - snapshot of alerts on a specific date
cmd_get_alerts_on_date() {
    local target_date="$1"
    local target_end="${target_date} 23:59:59"
    local display_date=$(date -d "$target_date" '+%a %d %b %Y')

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Alerts on ${display_date} — ${APPLICATION_NAME}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Build failures that were active on that date
    local build_count=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$target_end'
          AND (resolved_at > '$target_date' OR is_resolved = FALSE);
    ")

    echo -e "${BOLD}Build Failures (${build_count:-0}):${NC}"

    if [ "${build_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No build failures on this date${NC}"
    else
        sql_table "
        WITH active_on_date AS (
            SELECT DISTINCT ON (component_name)
                component_name, status, pipelinerun_name,
                first_detected_at, resolved_at, is_resolved
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at <= '$target_end'
              AND (resolved_at > '$target_date' OR is_resolved = FALSE)
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT
            component_name as \"Component\",
            status as \"Status\",
            TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\",
            CASE WHEN resolved_at IS NOT NULL AND resolved_at <= '$target_end'
                THEN TO_CHAR(resolved_at, 'DD Mon HH24:MI')
                WHEN is_resolved THEN 'Later'
                ELSE 'Still open'
            END as \"Resolved\"
        FROM active_on_date
        ORDER BY first_detected_at DESC;
        "
    fi
    echo ""

    # Conforma failures that were active on that date
    local conforma_count=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$target_end'
          AND (resolved_at > '$target_date' OR is_resolved = FALSE);
    ")

    echo -e "${BOLD}Conforma Failures (${conforma_count:-0}):${NC}"

    if [ "${conforma_count:-0}" = "0" ]; then
        echo -e "  ${GREEN}✓ No Conforma failures on this date${NC}"
    else
        sql_table "
        WITH active_on_date AS (
            SELECT DISTINCT ON (component_name)
                component_name, violations_count, warnings_count,
                first_detected_at, resolved_at, is_resolved
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at <= '$target_end'
              AND (resolved_at > '$target_date' OR is_resolved = FALSE)
            ORDER BY component_name, first_detected_at DESC
        )
        SELECT
            component_name as \"Component\",
            violations_count as \"Violations\",
            warnings_count as \"Warnings\",
            TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\",
            CASE WHEN resolved_at IS NOT NULL AND resolved_at <= '$target_end'
                THEN TO_CHAR(resolved_at, 'DD Mon HH24:MI')
                WHEN is_resolved THEN 'Later'
                ELSE 'Still open'
            END as \"Resolved\"
        FROM active_on_date
        ORDER BY violations_count DESC;
        "
    fi
    echo ""

    local total=$((${build_count:-0} + ${conforma_count:-0}))
    echo -e "${BOLD}Total: ${total}${NC} (${build_count:-0} builds, ${conforma_count:-0} conforma)"
    echo ""
}

# GET ALERTS RANGE - changes between two dates
cmd_get_alerts_range() {
    local from_date="$1"
    local to_date="$2"
    local to_end="${to_date} 23:59:59"
    local display_from=$(date -d "$from_date" '+%a %d %b')
    local display_to=$(date -d "$to_date" '+%a %d %b %Y')

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Alerts ${display_from} → ${display_to} — ${APPLICATION_NAME}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # --- New failures in this range ---
    local new_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at >= '$from_date'
          AND first_detected_at <= '$to_end';
    ")
    local new_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at >= '$from_date'
          AND first_detected_at <= '$to_end';
    ")
    local new_total=$(( ${new_build:-0} + ${new_conforma:-0} ))

    echo -e "${BOLD}New Failures (${new_total}):${NC}"

    if [ "$new_total" = "0" ]; then
        echo -e "  ${GREEN}✓ No new failures in this period${NC}"
    else
        if [ "${new_build:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Build' as \"Type\",
                status as \"Status\",
                TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\"
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at >= '$from_date'
              AND first_detected_at <= '$to_end'
            ORDER BY component_name, first_detected_at DESC;
            "
        fi
        if [ "${new_conforma:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Conforma' as \"Type\",
                violations_count || ' violations' as \"Status\",
                TO_CHAR(first_detected_at, 'DD Mon HH24:MI') as \"Detected\"
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND first_detected_at >= '$from_date'
              AND first_detected_at <= '$to_end'
            ORDER BY component_name, first_detected_at DESC;
            "
        fi
    fi
    echo ""

    # --- Resolved in this range ---
    local resolved_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND resolved_at >= '$from_date'
          AND resolved_at <= '$to_end';
    ")
    local resolved_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND resolved_at >= '$from_date'
          AND resolved_at <= '$to_end';
    ")
    local resolved_total=$(( ${resolved_build:-0} + ${resolved_conforma:-0} ))

    echo -e "${BOLD}Resolved (${resolved_total}):${NC}"

    if [ "$resolved_total" = "0" ]; then
        echo -e "  ${YELLOW}No failures resolved in this period${NC}"
    else
        if [ "${resolved_build:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Build' as \"Type\",
                TO_CHAR(first_detected_at, 'DD Mon') as \"Failed\",
                TO_CHAR(resolved_at, 'DD Mon HH24:MI') as \"Resolved\",
                EXTRACT(EPOCH FROM (resolved_at - first_detected_at))::int / 3600 || 'h' as \"Open For\"
            FROM build_failures
            WHERE application = '$APPLICATION_NAME'
              AND resolved_at >= '$from_date'
              AND resolved_at <= '$to_end'
            ORDER BY component_name, resolved_at DESC;
            "
        fi
        if [ "${resolved_conforma:-0}" != "0" ]; then
            sql_table "
            SELECT DISTINCT ON (component_name)
                component_name as \"Component\",
                'Conforma' as \"Type\",
                TO_CHAR(first_detected_at, 'DD Mon') as \"Failed\",
                TO_CHAR(resolved_at, 'DD Mon HH24:MI') as \"Resolved\",
                EXTRACT(EPOCH FROM (resolved_at - first_detected_at))::int / 3600 || 'h' as \"Open For\"
            FROM conforma_results
            WHERE application = '$APPLICATION_NAME'
              AND resolved_at >= '$from_date'
              AND resolved_at <= '$to_end'
            ORDER BY component_name, resolved_at DESC;
            "
        fi
    fi
    echo ""

    # --- Still open at end of range ---
    local still_open_build=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM build_failures
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$to_end'
          AND (resolved_at > '$to_end' OR is_resolved = FALSE);
    ")
    local still_open_conforma=$(sql "
        SELECT COUNT(DISTINCT component_name) FROM conforma_results
        WHERE application = '$APPLICATION_NAME'
          AND first_detected_at <= '$to_end'
          AND (resolved_at > '$to_end' OR is_resolved = FALSE);
    ")
    local still_open=$(( ${still_open_build:-0} + ${still_open_conforma:-0} ))

    echo -e "${BOLD}Still Open at end of period (${still_open}):${NC}"
    if [ "$still_open" = "0" ]; then
        echo -e "  ${GREEN}✓ All clear${NC}"
    else
        echo -e "  ${still_open_build:-0} build failures, ${still_open_conforma:-0} conforma failures"
    fi
    echo ""
}

# DESCRIBE CONFORMA - violation details for a component
cmd_describe_conforma() {
    local component="$1"
    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component name required${NC}"
        echo "Usage: ic describe conforma <component>"
        exit 1
    fi

    # Get metadata (without violation_summary to avoid pipe conflicts)
    local data=$(sql "
        SELECT component_name, scenario, pipelinerun_name, status,
               violations_count, warnings_count, successes_count,
               TO_CHAR(first_detected_at, 'YYYY-MM-DD HH24:MI:SS'),
               COALESCE(repository_url, ''), COALESCE(commit_sha, ''),
               COALESCE(snapshot_name, ''), COALESCE(commit_url, '')
        FROM conforma_results
        WHERE component_name = '$component'
          AND application = '$APPLICATION_NAME'
          AND is_resolved = FALSE
        ORDER BY first_detected_at DESC
        LIMIT 1;
    " 2>/dev/null)

    if [ -z "$data" ]; then
        echo -e "${RED}Error: No Conforma results found for: $component${NC}"
        echo -e "${CYAN}Tip:${NC} Use 'ic get conforma' to list components with failures"
        exit 1
    fi

    IFS='|' read -r comp_name scenario pr_name status violations warnings successes \
        detected_at repo_url commit_sha snapshot commit_url <<< "$data"

    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Conforma Results: $comp_name${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""
    echo -e "${BOLD}Scenario:${NC}    $scenario"
    echo -e "${BOLD}Result:${NC}      ${RED}FAILURE${NC} (${violations} violations, ${warnings} warnings, ${successes} successes)"
    echo -e "${BOLD}PipelineRun:${NC} $pr_name"
    echo -e "${BOLD}Detected:${NC}    $detected_at"

    repo_url=$(echo "$repo_url" | xargs 2>/dev/null || echo "")
    commit_sha=$(echo "$commit_sha" | xargs 2>/dev/null || echo "")
    snapshot=$(echo "$snapshot" | xargs 2>/dev/null || echo "")
    commit_url=$(echo "$commit_url" | xargs 2>/dev/null || echo "")

    [ -n "$repo_url" ] && echo -e "${BOLD}Repository:${NC}  $repo_url"
    [ -n "$commit_sha" ] && echo -e "${BOLD}Commit:${NC}      ${commit_sha:0:8}"
    [ -n "$commit_url" ] && echo -e "${BOLD}Commit URL:${NC}  ${CYAN}$commit_url${NC}"
    [ -n "$snapshot" ] && echo -e "${BOLD}Snapshot:${NC}    $snapshot"

    # Container image from violation_details JSON
    local container_image=$(sql "
        SELECT violation_details->'components'->0->>'containerImage'
        FROM conforma_results
        WHERE pipelinerun_name = '$pr_name' LIMIT 1;
    " 2>/dev/null | xargs 2>/dev/null || echo "")
    if [ -n "$container_image" ]; then
        echo -e "${BOLD}Image:${NC}       $container_image"
        # Extract Quay repository URL (e.g., quay.io/acme/component@sha256:... -> quay.io/repository/rhoai/component)
        local quay_path=$(echo "$container_image" | sed -n 's|quay\.io/\([^@]*\)@.*|quay.io/repository/\1|p')
        [ -n "$quay_path" ] && echo -e "${BOLD}Quay:${NC}        ${CYAN}https://${quay_path}${NC}"
    fi

    # Konflux UI link
    local konflux_url="https://konflux-ui.apps.CLUSTER_DOMAIN/ns/${NAMESPACE}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}/logs"
    echo ""
    echo -e "${BOLD}Konflux UI:${NC} ${CYAN}$konflux_url${NC}"

    echo ""
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Violations${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""

    # Fetch violation_summary separately (contains pipes and newlines)
    local violation_summary=$(sql "
        SELECT violation_summary FROM conforma_results
        WHERE pipelinerun_name = '$pr_name' LIMIT 1;
    " 2>/dev/null)

    if [ -n "$violation_summary" ] && [ "$violation_summary" != "" ]; then
        echo "$violation_summary"
    else
        echo -e "${YELLOW}No detailed violation report available.${NC}"
        echo -e "${CYAN}→ Run 'ic get conforma --refresh' to fetch violation details${NC}"
    fi
    echo ""
}

# Main command router
case "${1:-}" in
    get)
        case "${2:-}" in
            components|component)
                if [ -n "$3" ] && [[ "$3" != -* ]]; then
                    cmd_get_component "$3"
                else
                    cmd_get_components "${3:-}"
                fi
                ;;
            alerts)
                shift 2
                cmd_get_alerts "$@"
                ;;
            conforma)
                cmd_get_conforma "${3:-}"
                ;;
            pipelineruns|pipelinerun|pr|failures)
                if [ -n "$3" ]; then
                    cmd_get_pipelinerun "$3"
                else
                    shift 2
                    cmd_get_pipelineruns "$@"
                fi
                ;;
            apps|applications|versions)
                cmd_get_apps
                ;;
            *) usage ;;
        esac
        ;;
    describe)
        case "${2:-}" in
            component) shift 2; cmd_describe_component "$@" ;;
            conforma) cmd_describe_conforma "$3" ;;
            pipelinerun|pr) cmd_describe_pipelinerun "$3" ;;
            *) usage ;;
        esac
        ;;
    config)
        case "${2:-}" in
            set-app) cmd_config_set_app "$3" "${4:-}" ;;
            "") cmd_config_show ;;
            *) usage ;;
        esac
        ;;
    apps|versions)
        cmd_get_apps
        ;;
    stats)
        case "${2:-}" in
            daily) cmd_stats_daily ;;
            resolved) cmd_stats_resolved ;;
            components) cmd_get_components ;;
            "") cmd_stats ;;
            *) usage ;;
        esac
        ;;
    triage)
        cmd_triage
        ;;
    why)
        cmd_why "$2"
        ;;
    analyze)
        cmd_analyze "$2"
        ;;
    errors)
        cmd_errors "$2"
        ;;
    resolved)
        cmd_resolved
        ;;
    working)
        cmd_working
        ;;
    history)
        cmd_history "$2"
        ;;
    db)
        case "${2:-}" in
            status) cmd_db_status ;;
            query) cmd_db_query "${@:3}" ;;
            *) usage ;;
        esac
        ;;
    # Backward compatibility
    build)
        case "${2:-}" in
            status) cmd_get_components ;;
            failures) shift 2; cmd_get_pipelineruns "$@" ;;
            get) cmd_get_pipelinerun "$3" ;;
            logs) cmd_describe_pipelinerun "$3" ;;
            *) usage ;;
        esac
        ;;
    component)
        case "${2:-}" in
            list) cmd_get_components ;;
            get) cmd_get_component "$3" ;;
            show) cmd_describe_component "$3" ;;
            *) usage ;;
        esac
        ;;
    help|--help|-h|"") usage ;;
    *)
        # Number shortcut
        if [[ "$1" =~ ^[0-9]+$ ]]; then
            cmd_describe_by_number "$@"
        else
            echo -e "${RED}Error: Unknown command: $1${NC}"
            echo ""
            usage
        fi
        ;;
esac
