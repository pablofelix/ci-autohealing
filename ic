  ${CYAN}Component Status:${NC}
    ic working                               Components currently working (last build = success)
    ic resolved                              Components that were resolved
    ic history <component>                   Full build history (successes + failures)

  ${CYAN}Database:${NC}
    ic db status                             Check database connection
    ic db query "<sql>"                      Execute custom SQL query

${BOLD}EXAMPLES:${NC}

  ${CYAN}Basic workflow:${NC}
    ic get components                        # List all failing components
    ic 1                                     # Describe component #1
    ic describe component odh-spark-v3-4     # Full details for specific component

  ${CYAN}PipelineRun investigation:${NC}
    ic get pipelineruns --limit 10           # List 10 recent failures
    ic get pr odh-feature-server-v3-4-abc123 # Get PR summary
    ic describe pr odh-feature-server-v3-4-abc123  # Full details + logs

  ${CYAN}Version management:${NC}
    ic get apps                              # List RHOAI versions
    ic config set-app rhoai-v3-3             # Switch to v3.3
    ic get components                        # Now shows v3.3 data

  ${CYAN}Statistics:${NC}
    ic stats                                 # Overall stats
    ic stats daily                           # Failures by day
    ic db query "SELECT component_name, COUNT(*) FROM build_failures GROUP BY component_name"

