_release_fetch_pipeline_error() {
    local pipeline_ref="$1" fetch_logs="${2:-false}"
    [ -z "$pipeline_ref" ] && return

    local ns="${pipeline_ref%%/*}"
    local pr_name="${pipeline_ref##*/}"
    [ -z "$ns" ] && ns="$RELENG_NAMESPACE"

    local pr_json=""
    pr_json=$(oc get pipelinerun "$pr_name" -n "$ns" -o json 2>/dev/null || true)

    if [ -z "$pr_json" ] || echo "$pr_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        pr_json=$(curl -sk --max-time 30 \
            -H "Authorization: Bearer $OC_TOKEN" \
            "${KUBEARCHIVE_URL}/apis/tekton.dev/v1/namespaces/${ns}/pipelineruns/${pr_name}" 2>/dev/null)
    fi

    [ -z "$pr_json" ] && echo -e "  ${YELLOW}Could not retrieve pipeline run data${NC}" && return

    local failed_task="${3:-}"
    local failed_taskrun=""

    if [ -z "$failed_task" ]; then
        local pr_message
        pr_message=$(echo "$pr_json" | jq -r '
            .status.conditions[]? | select(.type == "Succeeded" and .status == "False") | .message // empty
        ' 2>/dev/null | head -1)
        [ -n "$pr_message" ] && failed_task=$(echo "$pr_message" | grep -oP 'task \K[^ :]+' | head -1)
    fi

    if [ -n "$failed_task" ]; then
        failed_taskrun=$(echo "$pr_json" | jq -r --arg task "$failed_task" '
            .status.childReferences[]? | select(.pipelineTaskName == $task) | .name
        ' 2>/dev/null | head -1)
    fi
    failed_taskrun="${failed_taskrun:-${pr_name}-${failed_task}}"

    echo -e "  ${BOLD}Failed task:${NC} ${failed_task:-unknown}"

    local tr_json=""
    tr_json=$(oc get taskrun "$failed_taskrun" -n "$ns" -o json 2>/dev/null || true)
    if [ -z "$tr_json" ] || echo "$tr_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        tr_json=$(curl -sk --max-time 30 \
            -H "Authorization: Bearer $OC_TOKEN" \
            "${KUBEARCHIVE_URL}/apis/tekton.dev/v1/namespaces/${ns}/taskruns/${failed_taskrun}" 2>/dev/null)
    fi

    if [ -n "$tr_json" ]; then
        local tr_message
        tr_message=$(echo "$tr_json" | jq -r '
            .status.conditions[]? | select(.type == "Succeeded" and .status == "False") | .message // empty
        ' 2>/dev/null | head -1)
        [ -n "$tr_message" ] && echo -e "  ${BOLD}Message:${NC}     ${tr_message:0:120}"

        local test_output
        test_output=$(echo "$tr_json" | jq -r '
            .metadata.annotations["test.appstudio.openshift.io/status"] // empty
        ' 2>/dev/null)
        if [ -z "$test_output" ]; then
            test_output=$(echo "$tr_json" | jq -r '
                .status.results[]? | select(.name == "TEST_OUTPUT") | .value // empty
            ' 2>/dev/null | head -1)
        fi
        if [ -n "$test_output" ]; then
            local result failures
            result=$(echo "$test_output" | jq -r '.result // empty' 2>/dev/null)
            failures=$(echo "$test_output" | jq -r '.failures // empty' 2>/dev/null)
            [ -n "$result" ] && echo -e "  ${BOLD}Result:${NC}      ${result} (${failures:-0} failures)"
        fi

        local failed_step
        failed_step=$(echo "$tr_json" | jq -r '
            [.status.steps[]? | select(.terminated.exitCode != 0)] | .[0] | .name // empty
        ' 2>/dev/null)
        [ -n "$failed_step" ] && echo -e "  ${BOLD}Failed step:${NC} ${failed_step}"

        if [ "$fetch_logs" = true ] && [ -n "$failed_step" ]; then
            local pod_name
            pod_name=$(echo "$tr_json" | jq -r '.status.podName // empty' 2>/dev/null)
            if [ -n "$pod_name" ]; then
                echo ""
                echo -e "  ${BOLD}Log excerpt (${failed_step}):${NC}"
                local logs
                logs=$(curl -sk --max-time 30 \
                    -H "Authorization: Bearer $OC_TOKEN" \
                    "${KUBEARCHIVE_URL}/api/v1/namespaces/${ns}/pods/${pod_name}/log?container=${failed_step}" 2>/dev/null)
                if [ -n "$logs" ]; then
                    echo "$logs" | grep -iE 'error|fail|violation|unauthorized|denied' | tail -20 | sed 's/^/    /'
                else
                    echo -e "    ${YELLOW}Logs not available (may have expired from Loki)${NC}"
                fi
            fi
        fi
    fi
}

_release_step_task_list() {
    local pipeline_ref="$1"
    [ -z "$pipeline_ref" ] && return

    local ns="${pipeline_ref%%/*}"
    local pr_name="${pipeline_ref##*/}"
    [ -z "$ns" ] && ns="$RELENG_NAMESPACE"

    local pr_json=""
    pr_json=$(oc get pipelinerun "$pr_name" -n "$ns" -o json 2>/dev/null || true)
    if [ -z "$pr_json" ] || echo "$pr_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        pr_json=$(curl -sk --max-time 30 \
            -H "Authorization: Bearer $OC_TOKEN" \
            "${KUBEARCHIVE_URL}/apis/tekton.dev/v1/namespaces/${ns}/pipelineruns/${pr_name}" 2>/dev/null)
    fi

    [ -z "$pr_json" ] && return

    echo "$pr_json" | jq -r '
        [.status.childReferences[]? | {
            name: .pipelineTaskName,
            taskrun: .name
        }] | .[] | .name + "|" + .taskrun
    ' 2>/dev/null | while IFS='|' read -r task_name taskrun_name; do
        [ -z "$task_name" ] && continue
        local tr_json
        tr_json=$(oc get taskrun "$taskrun_name" -n "$ns" -o json 2>/dev/null || true)
        if [ -z "$tr_json" ] || echo "$tr_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
            tr_json=$(curl -sk --max-time 15 \
                -H "Authorization: Bearer $OC_TOKEN" \
                "${KUBEARCHIVE_URL}/apis/tekton.dev/v1/namespaces/${ns}/taskruns/${taskrun_name}" 2>/dev/null)
        fi

        local tr_status="unknown"
        if [ -n "$tr_json" ]; then
            local succeeded
            succeeded=$(echo "$tr_json" | jq -r '
                [.status.conditions[]? | select(.type == "Succeeded")] | .[0] | .status // "Unknown"
            ' 2>/dev/null)
            local reason
            reason=$(echo "$tr_json" | jq -r '
                [.status.conditions[]? | select(.type == "Succeeded")] | .[0] | .reason // ""
            ' 2>/dev/null)
            if [ "$succeeded" = "True" ]; then
                tr_status="succeeded"
            elif [ "$succeeded" = "False" ]; then
                tr_status="failed"
            elif [ "$reason" = "Running" ]; then
                tr_status="running"
            else
                tr_status="pending"
            fi
        fi

        case "$tr_status" in
            succeeded) printf "       ${GREEN}✓${NC} %s\n" "$task_name" ;;
            failed)    printf "       ${RED}✗${NC} %s\n" "$task_name" ;;
            running)   printf "       ${YELLOW}◌${NC} %s\n" "$task_name" ;;
            *)         printf "       ${YELLOW}○${NC} %s\n" "$task_name" ;;
        esac
    done
}

# Compact pipeline summary for an epoch — outputs pipe-delimited counters.
# Usage: summary=$(_release_epoch_pipeline_summary "$all_releases_json" "$epoch" ["stage"|"prod"])
# Output: stage_done|stage_total|stage_retries|prod_done|prod_total|prod_retries|blocker_step|blocker_msg|next_step
_release_epoch_pipeline_summary() {
    local all_releases="$1" epoch="$2" filter_target="${3:-}"

    local steps
    steps=$(_release_discover_steps)

    local sd=0 st=0 sr=0 pd=0 pt=0 pr_r=0
    local blocker="" blocker_msg="" next_step=""

    while IFS='|' read -r step_target step_type; do
        [ -z "$step_target" ] && continue
        [ -n "$filter_target" ] && [ "$step_target" != "$filter_target" ] && continue

        local prefix
        prefix=$(_release_name_prefix "$step_target" "$step_type")
        local type_label
        type_label=$(_release_type_label "$step_type")

        local all_for_step
        all_for_step=$(echo "$all_releases" | jq -c --arg prefix "$prefix" '
            [.[] | select(.metadata.name | startswith($prefix + "-"))]
            | sort_by(.metadata.creationTimestamp)
        ' 2>/dev/null)
        [ -z "$all_for_step" ] || [ "$all_for_step" = "null" ] && all_for_step="[]"

        # Find the latest epoch for this specific step, then get all releases for that epoch
        local step_epoch
        step_epoch=$(echo "$all_for_step" | jq -r '[.[].metadata.name] | map(capture("(?<ep>[0-9]{10})").ep) | sort | reverse | .[0] // empty' 2>/dev/null)

        local matching="[]"
        if [ -n "$step_epoch" ]; then
            matching=$(echo "$all_for_step" | jq -c --arg ep "$step_epoch" '
                [.[] | select(.metadata.name | contains($ep))]
            ' 2>/dev/null)
        fi
        [ -z "$matching" ] || [ "$matching" = "null" ] && matching="[]"

        local match_count
        match_count=$(echo "$matching" | jq 'length' 2>/dev/null)

        [ "$step_target" = "stage" ] && st=$((st + 1)) || pt=$((pt + 1))

        if [ "${match_count:-0}" -eq 0 ]; then
            [ -z "$next_step" ] && [ -z "$blocker" ] && next_step="${step_target} ${type_label}"
            continue
        fi

        local last_status
        last_status=$(echo "$matching" | jq -r '
            .[-1] | [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
        ' 2>/dev/null)

        if [ "$last_status" = "True" ]; then
            [ "$step_target" = "stage" ] && sd=$((sd + 1)) || pd=$((pd + 1))
            local retries
            retries=$(echo "$matching" | jq 'length - 1' 2>/dev/null)
            if [ "${retries:-0}" -gt 0 ]; then
                [ "$step_target" = "stage" ] && sr=$((sr + retries)) || pr_r=$((pr_r + retries))
            fi
        elif [ "$last_status" = "False" ]; then
            if [ -z "$blocker" ]; then
                blocker="${step_target} ${type_label}"
                blocker_msg=$(echo "$matching" | jq -r '
                    .[-1] | [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")]
                    | .[0] | .message // empty
                ' 2>/dev/null | head -1)
            fi
        else
            [ -z "$next_step" ] && [ -z "$blocker" ] && next_step="${step_target} ${type_label}"
        fi
    done <<< "$steps"

    echo "${sd}|${st}|${sr}|${pd}|${pt}|${pr_r}|${blocker}|${blocker_msg}|${next_step}"
}

# Returns per-step pipeline status as multi-line output:
# target|label|status|retries|fail_task
_release_epoch_pipeline_steps() {
    local all_releases="$1" epoch="$2" filter_target="${3:-}"

    local steps
    steps=$(_release_discover_steps)

    while IFS='|' read -r step_target step_type; do
        [ -z "$step_target" ] && continue
        [ -n "$filter_target" ] && [ "$step_target" != "$filter_target" ] && continue

        local prefix type_label
        prefix=$(_release_name_prefix "$step_target" "$step_type")
        type_label=$(_release_type_label "$step_type")

        local all_for_step
        all_for_step=$(echo "$all_releases" | jq -c --arg prefix "$prefix" '
            [.[] | select(.metadata.name | startswith($prefix + "-"))]
            | sort_by(.metadata.creationTimestamp)
        ' 2>/dev/null)
        [ -z "$all_for_step" ] || [ "$all_for_step" = "null" ] && all_for_step="[]"

        local step_epoch
        step_epoch=$(echo "$all_for_step" | jq -r '[.[].metadata.name] | map(capture("(?<ep>[0-9]{10})").ep) | sort | reverse | .[0] // empty' 2>/dev/null)

        local matching="[]"
        if [ -n "$step_epoch" ]; then
            matching=$(echo "$all_for_step" | jq -c --arg ep "$step_epoch" '
                [.[] | select(.metadata.name | contains($ep))]
            ' 2>/dev/null)
        fi
        [ -z "$matching" ] || [ "$matching" = "null" ] && matching="[]"

        local match_count
        match_count=$(echo "$matching" | jq 'length' 2>/dev/null)

        if [ "${match_count:-0}" -eq 0 ]; then
            echo "${step_target}|${type_label}|not_started|0|"
            continue
        fi

        local last_status
        last_status=$(echo "$matching" | jq -r '
            .[-1] | [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
        ' 2>/dev/null)

        local retries
        retries=$(echo "$matching" | jq 'length - 1' 2>/dev/null)

        if [ "$last_status" = "True" ]; then
            echo "${step_target}|${type_label}|succeeded|${retries:-0}|"
        elif [ "$last_status" = "False" ]; then
            local fail_task
            fail_task=$(echo "$matching" | jq -r '
                .[-1] | [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")]
                | .[0] | .message // empty
            ' 2>/dev/null | grep -oP 'task \K[^ :]+' | head -1)
            echo "${step_target}|${type_label}|failed|${retries:-0}|${fail_task}"
        else
            echo "${step_target}|${type_label}|running|${retries:-0}|"
        fi
    done <<< "$steps"
}

# GET RELEASES — list recent Release CRs grouped by epoch
cmd_get_releases() {
    local filter_target="" limit=5

    while [ $# -gt 0 ]; do
        case "$1" in
            --stage) filter_target="stage"; shift ;;
            --prod)  filter_target="prod";  shift ;;
            --limit) shift; limit="${1:-5}"; shift ;;
            --all)   limit=999; shift ;;
            *) shift ;;
        esac
    done

    _release_require_oc || return 1

    section_header "Release CRs — ${APPLICATION_NAME}"
    echo ""

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)

    if [ -z "$releases_json" ] || [ "$(echo "$releases_json" | jq '.items | length' 2>/dev/null)" = "0" ]; then
        echo -e "${YELLOW}No Release CRs found in namespace ${NAMESPACE}${NC}"
        return
    fi

    local app_version="${APPLICATION_NAME#*-v}"
    local filtered
    filtered=$(echo "$releases_json" | jq -c --arg ver "$app_version" '
        [.items[] | select(.spec.releasePlan | contains($ver))]
    ' 2>/dev/null)

    local epochs
    epochs=$(echo "$filtered" | jq -r '.[].metadata.name' 2>/dev/null \
        | grep -oP '\d{10}' | sort -rn | uniq | head -"$limit")

    if [ -z "$epochs" ]; then
        echo -e "${YELLOW}No releases found for ${APPLICATION_NAME}${NC}"
        return
    fi

    local epoch_count
    epoch_count=$(echo "$epochs" | wc -l)
    echo -e "${CYAN}Showing ${epoch_count} most recent release group(s)${NC}"
    [ -n "$filter_target" ] && echo -e "${CYAN}Filter: ${filter_target} only${NC}"
    echo ""

    while IFS= read -r epoch; do
        [ -z "$epoch" ] && continue

        local epoch_releases
        epoch_releases=$(echo "$filtered" | jq -c --arg epoch "$epoch" '
            [.[] | select(.metadata.name | contains($epoch))]
            | sort_by(.metadata.creationTimestamp)
        ' 2>/dev/null)

        local snapshot
        snapshot=$(echo "$epoch_releases" | jq -r '.[0].spec.snapshot // "unknown"' 2>/dev/null)
        local created
        created=$(echo "$epoch_releases" | jq -r '.[0].metadata.creationTimestamp // ""' 2>/dev/null)
        local date_label
        date_label=$(date -d "$created" '+%Y-%m-%d' 2>/dev/null || echo "${created:0:10}")

        echo -e "${BOLD}Epoch ${epoch}${NC}  (${date_label})  Snapshot: ${CYAN}${snapshot}${NC}"
        printf "  %-48s %-14s %-6s  %s\n" "Release" "Type" "Target" "Status"
        printf "  %-48s %-14s %-6s  %s\n" "$(printf '%0.s-' {1..48})" "--------------" "------" "----------"

        echo "$epoch_releases" | jq -c '.[]' 2>/dev/null | while IFS= read -r rel; do
            local name plan status_reason released_status
            name=$(echo "$rel" | jq -r '.metadata.name')
            plan=$(echo "$rel" | jq -r '.spec.releasePlan')
            released_status=$(echo "$rel" | jq -r '
                [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
            ')
            status_reason=$(echo "$rel" | jq -r '
                [.status.conditions[]? | select(.type == "Released")] | .[0] | .reason // "Pending"
            ')

            local classification target type
            classification=$(_release_classify "$plan")
            target=$(echo "$classification" | cut -d'|' -f1)
            type=$(echo "$classification" | cut -d'|' -f2)

            [ -n "$filter_target" ] && [ "$target" != "$filter_target" ] && continue

            local type_label
            type_label=$(_release_type_label "$type")
            local target_label
            target_label=$(echo "$target" | sed 's/stage/Stage/;s/prod/Prod/')

            local status_display
            if [ "$released_status" = "True" ]; then
                status_display="${GREEN}✓ Succeeded${NC}"
            elif [ "$released_status" = "False" ]; then
                local msg
                msg=$(echo "$rel" | jq -r '
                    [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")] | .[0] | .message // empty
                ' 2>/dev/null | head -1)
                local short_msg=""
                [ -n "$msg" ] && short_msg=" ($(echo "$msg" | grep -oP 'task \K[^ :]+' | head -1))"
                status_display="${RED}✗ Failed${NC}${short_msg}"
            else
                local managed_status
                managed_status=$(echo "$rel" | jq -r '
                    [.status.conditions[]? | select(.type == "ManagedPipelineProcessed")] | .[0] | .reason // "Pending"
                ')
                if [ "$managed_status" = "Running" ] || [ "$managed_status" = "Pending" ]; then
                    status_display="${YELLOW}◌ Running${NC}"
                else
                    status_display="${YELLOW}○ Pending${NC}"
                fi
            fi

            local name_short="${name:0:48}"
            printf "  %-48s %-14s %-6s  " "$name_short" "$type_label" "$target_label"
            echo -e "$status_display"
        done
        echo ""
    done <<< "$epochs"

    echo -e "${CYAN}Tip:${NC} Use 'ic describe release <name>' for details"
    echo -e "${CYAN}Tip:${NC} Use 'ic release status [epoch]' for process checklist"
    [ -z "$filter_target" ] && echo -e "${CYAN}Tip:${NC} Use '--stage' or '--prod' to filter"
    echo ""
}

# DESCRIBE RELEASE — detail view of a single Release CR
cmd_describe_release() {
    local name="" fetch_logs=false

    for arg in "$@"; do
        case "$arg" in
            --logs) fetch_logs=true ;;
            -*) ;;
            *) [ -z "$name" ] && name="$arg" ;;
        esac
    done

    if [ -z "$name" ]; then
        echo -e "${RED}Usage: ic describe release <name> [--logs]${NC}"
        return 1
    fi

    _release_require_oc || return 1

    local rel_json
    rel_json=$(oc get release.appstudio.redhat.com "$name" -n "$NAMESPACE" -o json 2>/dev/null)

    if [ -z "$rel_json" ] || echo "$rel_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        echo -e "${RED}Error: Release not found: ${name}${NC}"
        return 1
    fi

    local snapshot plan created
    snapshot=$(echo "$rel_json" | jq -r '.spec.snapshot // "unknown"')
    plan=$(echo "$rel_json" | jq -r '.spec.releasePlan // "unknown"')
    created=$(echo "$rel_json" | jq -r '.metadata.creationTimestamp // ""')

    local classification target type
    classification=$(_release_classify "$plan")
    target=$(echo "$classification" | cut -d'|' -f1)
    type=$(echo "$classification" | cut -d'|' -f2)
    local type_label
    type_label=$(_release_type_label "$type")
    local target_label
    target_label=$(echo "$target" | sed 's/stage/Stage/;s/prod/Prod/')

    section_header "Release: ${name}"
    echo ""
    echo -e "${BOLD}Snapshot:${NC}     ${CYAN}${snapshot}${NC}"
    local snap_json
    snap_json=$(oc get snapshot "$snapshot" -n "$NAMESPACE" -o json 2>/dev/null || true)
    if [ -n "$snap_json" ] && ! echo "$snap_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        local comp_count
        comp_count=$(echo "$snap_json" | jq '.spec.components | length' 2>/dev/null)
        [ -n "$comp_count" ] && [ "$comp_count" != "null" ] && \
            echo -e "${BOLD}Components:${NC}   ${comp_count}"
    fi
    echo -e "${BOLD}ReleasePlan:${NC}  ${plan}"
    echo -e "${BOLD}Type:${NC}         ${type_label} → ${target_label}"
    echo -e "${BOLD}Created:${NC}      ${created}"

    local advisory_type
    advisory_type=$(echo "$rel_json" | jq -r '.spec.data.releaseNotes.type // empty' 2>/dev/null)
    if [ -n "$advisory_type" ]; then
        echo -e "${BOLD}Advisory:${NC}     ${advisory_type}"
        local issues_list
        issues_list=$(echo "$rel_json" | jq -r '
            [.spec.data.releaseNotes.issues.fixed[]?.id // empty] | join(", ")
        ' 2>/dev/null)
        local issues_count
        issues_count=$(echo "$rel_json" | jq '.spec.data.releaseNotes.issues.fixed | length // 0' 2>/dev/null)
        if [ "${issues_count:-0}" -gt 0 ]; then
            local issues_display="$issues_list"
            [ ${#issues_display} -gt 80 ] && issues_display="${issues_display:0:77}..."
            echo -e "${BOLD}Issues:${NC}       ${issues_count} fixed (${issues_display})"
        fi
        local cves_list
        cves_list=$(echo "$rel_json" | jq -r '
            [.spec.data.releaseNotes.cves[]? | .key + " (" + (.component // "?") + ")"] | join(", ")
        ' 2>/dev/null)
        local cves_count
        cves_count=$(echo "$rel_json" | jq '.spec.data.releaseNotes.cves | length // 0' 2>/dev/null)
        if [ "${cves_count:-0}" -gt 0 ]; then
            local cves_display="$cves_list"
            [ ${#cves_display} -gt 80 ] && cves_display="${cves_display:0:77}..."
            echo -e "${BOLD}CVEs:${NC}         ${cves_count} (${cves_display})"
        fi
    fi
    echo ""

    echo -e "${BOLD}Conditions:${NC}"
    printf "  %-36s %-8s %-12s %s\n" "Type" "Status" "Reason" "Message"
    printf "  %-36s %-8s %-12s %s\n" "$(printf '%0.s-' {1..36})" "--------" "------------" "-------"

    echo "$rel_json" | jq -c '.status.conditions[]?' 2>/dev/null | while IFS= read -r cond; do
        local ctype cstatus creason cmessage
        ctype=$(echo "$cond" | jq -r '.type')
        cstatus=$(echo "$cond" | jq -r '.status')
        creason=$(echo "$cond" | jq -r '.reason // "-"')
        cmessage=$(echo "$cond" | jq -r '.message // "-"')

        local status_color="$NC"
        [ "$cstatus" = "True" ] && [ "$creason" != "Skipped" ] && status_color="$GREEN"
        [ "$cstatus" = "False" ] && status_color="$RED"

        local indicator=""
        [ "$cstatus" = "False" ] && [ "$creason" = "Failed" ] && indicator=" ←"

        local msg_display
        if [ "$cmessage" = "-" ] || [ "$cmessage" = "" ]; then
            msg_display="-"
        elif [ "$cstatus" = "False" ]; then
            msg_display="$cmessage"
        else
            msg_display="${cmessage:0:60}"
        fi

        printf "  %-36s " "$ctype"
        echo -ne "${status_color}$(printf '%-8s' "$cstatus")${NC} "
        printf "%-12s %s" "$creason" "$msg_display"
        echo -e "${RED}${indicator}${NC}"
    done
    echo ""

    local pipeline_ref start_time end_time
    pipeline_ref=$(echo "$rel_json" | jq -r '.status.managedProcessing.pipelineRun // empty')
    start_time=$(echo "$rel_json" | jq -r '.status.managedProcessing.startTime // empty')
    end_time=$(echo "$rel_json" | jq -r '.status.managedProcessing.completionTime // empty')

    if [ -z "$pipeline_ref" ]; then
        local released_status
        released_status=$(echo "$rel_json" | jq -r '
            [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
        ')
        if [ "$released_status" = "False" ]; then
            echo -e "${BOLD}${RED}Error Details:${NC}"
            echo "$rel_json" | jq -r '
                [.status.conditions[]? | select(.status == "False")] | .[] |
                "  \(.type): \(.message // .reason // "unknown")"
            ' 2>/dev/null
            echo ""
            echo -e "  ${YELLOW}No managed pipeline was started — the release failed at validation.${NC}"
            echo ""
        fi
    fi

    if [ -n "$pipeline_ref" ]; then
        echo -e "${BOLD}Pipeline:${NC}"
        echo -e "  Run:      ${CYAN}${pipeline_ref}${NC}"
        [ -n "$start_time" ] && echo -e "  Started:  ${start_time}"
        [ -n "$end_time" ] && echo -e "  Ended:    ${end_time}"

        if [ -n "$start_time" ] && [ -n "$end_time" ]; then
            local start_epoch end_epoch duration_secs
            start_epoch=$(date -d "$start_time" '+%s' 2>/dev/null)
            end_epoch=$(date -d "$end_time" '+%s' 2>/dev/null)
            if [ -n "$start_epoch" ] && [ -n "$end_epoch" ]; then
                duration_secs=$((end_epoch - start_epoch))
                echo -e "  Duration: ${duration_secs}s ($((duration_secs / 60))m $((duration_secs % 60))s)"
            fi
        fi

        local ui_url
        ui_url=$(_release_pipeline_ui_url "$pipeline_ref")
        echo -e "  UI:       ${CYAN}${ui_url}${NC}"
        echo ""

        local released_status
        released_status=$(echo "$rel_json" | jq -r '
            [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
        ')

        if [ "$released_status" = "False" ]; then
            local managed_msg
            managed_msg=$(echo "$rel_json" | jq -r '
                [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")]
                | .[0] | .message // empty
            ' 2>/dev/null | head -1)
            local hint_task
            hint_task=$(echo "$managed_msg" | grep -oP 'task \K[^ :]+' | head -1)

            echo -e "${BOLD}${RED}Error Details:${NC}"
            _release_fetch_pipeline_error "$pipeline_ref" "$fetch_logs" "$hint_task"
            echo ""
        fi

        echo -e "${BOLD}Pipeline Steps:${NC}"
        _release_step_task_list "$pipeline_ref"
        echo ""
    fi

    echo -e "${CYAN}Tip:${NC} Use 'ic release status $(_release_epoch_from_name "$name")' for process checklist"
    echo -e "${CYAN}Tip:${NC} Use 'ic release verify ${name}' to check image availability in Pyxis"
    echo -e "${CYAN}Tip:${NC} oc get release ${name} -n ${NAMESPACE} -o yaml"
    [ "$fetch_logs" = false ] && echo -e "${CYAN}Tip:${NC} Use '--logs' to fetch pipeline failure logs from KubeArchive"
    echo ""
}

# RELEASE STATUS — process checklist showing done/pending/failed
cmd_release_status() {
    local epoch="" verbose=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose|-v) verbose=true; shift ;;
            -*) shift ;;
            *) [ -z "$epoch" ] && epoch="$1"; shift ;;
        esac
    done

    _release_require_oc || return 1

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)

    if [ -z "$releases_json" ]; then
        echo -e "${RED}Error: Could not fetch Release CRs${NC}"
        return 1
    fi

    local app_version="${APPLICATION_NAME#*-v}"
    local all_releases
    all_releases=$(echo "$releases_json" | jq -c --arg ver "$app_version" '
        [.items[] | select(.spec.releasePlan | contains($ver))]
    ' 2>/dev/null)

    if [ -z "$epoch" ]; then
        epoch=$(echo "$all_releases" | jq -r '.[].metadata.name' 2>/dev/null \
            | grep -oP '\d{10}' | sort -rn | uniq | head -1)
        if [ -z "$epoch" ]; then
            echo -e "${YELLOW}No releases found for ${APPLICATION_NAME}${NC}"
            return
        fi
    fi

    local seed_releases
    seed_releases=$(echo "$all_releases" | jq -c --arg epoch "$epoch" '
        [.[] | select(.metadata.name | contains($epoch))]
    ' 2>/dev/null)

    local snapshot
    snapshot=$(echo "$seed_releases" | jq -r '
        [.[] | select(.spec.releasePlan | (endswith("-components-stage") or endswith("-components-prod")))]
        | .[0].spec.snapshot // "unknown"
    ' 2>/dev/null)
    [ "$snapshot" = "unknown" ] || [ "$snapshot" = "null" ] && \
        snapshot=$(echo "$seed_releases" | jq -r '.[0].spec.snapshot // "unknown"' 2>/dev/null)

    local first_created
    first_created=$(echo "$seed_releases" | jq -r '
        [.[].metadata.creationTimestamp] | sort | .[0] // ""
    ' 2>/dev/null)

    section_header "Release Status — ${APPLICATION_NAME}"
    echo ""
    echo -e "${BOLD}Epoch:${NC}    ${CYAN}${epoch}${NC}"
    echo -e "${BOLD}Snapshot:${NC} ${CYAN}${snapshot}${NC}"
    [ -n "$first_created" ] && echo -e "${BOLD}Started:${NC}  ${first_created}"
    echo ""

    local steps
    steps=$(_release_discover_steps)

    local current_section=""
    local stage_total=0 stage_done=0 stage_retries=0
    local prod_total=0 prod_done=0 prod_retries=0
    local blocker="" blocker_release="" next_step=""
    local latest_end_time=""

    while IFS='|' read -r step_target step_type; do
        [ -z "$step_target" ] && continue

        if [ "$step_target" != "$current_section" ]; then
            current_section="$step_target"
            local section_label
            section_label=$(echo "$step_target" | sed 's/stage/Stage/;s/prod/Prod/')
            echo -e "── ${BOLD}${section_label}${NC} ──────────────────────────────────────────────────"
        fi

        local type_label
        type_label=$(_release_type_label "$step_type")

        local prefix
        prefix=$(_release_name_prefix "$step_target" "$step_type")

        local matching
        matching=$(echo "$all_releases" | jq -c --arg prefix "$prefix" --arg epoch "$epoch" '
            [.[] | select(.metadata.name | startswith($prefix + "-"))]
            | [.[] | select(.metadata.name | capture("(?<ep>[0-9]{10})").ep >= $epoch)]
            | sort_by(.metadata.creationTimestamp)
        ' 2>/dev/null)
        if [ -n "$matching" ] && [ "$matching" != "[]" ] && [ "$matching" != "null" ]; then
            local best_epoch_in_step
            best_epoch_in_step=$(echo "$matching" | jq -r '.[0].metadata.name' 2>/dev/null \
                | grep -oP '\d{10}' | head -1)
            if [ -n "$best_epoch_in_step" ]; then
                matching=$(echo "$matching" | jq -c --arg ep "$best_epoch_in_step" '
                    [.[] | select(.metadata.name | contains($ep))]
                ' 2>/dev/null)
            fi
        fi
        [ -z "$matching" ] || [ "$matching" = "null" ] && matching="[]"

        local match_count
        match_count=$(echo "$matching" | jq 'length' 2>/dev/null)

        if [ "$step_target" = "stage" ]; then
            stage_total=$((stage_total + 1))
        else
            prod_total=$((prod_total + 1))
        fi

        if [ "${match_count:-0}" -eq 0 ]; then
            printf "  ${YELLOW}○${NC}  %-18s ${YELLOW}Not started${NC}\n" "$type_label"
            if [ -z "$next_step" ] && [ -z "$blocker" ]; then
                next_step="$step_target $type_label"
            fi
            continue
        fi

        echo "$matching" | jq -c '.[]' 2>/dev/null | while IFS= read -r rel; do
            local rel_name released_status
            rel_name=$(echo "$rel" | jq -r '.metadata.name')
            released_status=$(echo "$rel" | jq -r '
                [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
            ')

            local retry=$(_release_retry_count "$rel_name")
            local retry_label=""
            [ "$retry" -gt 0 ] && retry_label=" (retry -${retry})"

            local duration_label="" time_label=""
            local s_time e_time
            s_time=$(echo "$rel" | jq -r '.status.managedProcessing.startTime // empty')
            e_time=$(echo "$rel" | jq -r '.status.managedProcessing.completionTime // empty')
            if [ -n "$s_time" ]; then
                time_label=$(date -d "$s_time" '+%m-%d %H:%M' 2>/dev/null)
            fi
            if [ -n "$s_time" ] && [ -n "$e_time" ]; then
                local s_ep e_ep
                s_ep=$(date -d "$s_time" '+%s' 2>/dev/null)
                e_ep=$(date -d "$e_time" '+%s' 2>/dev/null)
                if [ -n "$s_ep" ] && [ -n "$e_ep" ]; then
                    local dur_secs=$(( e_ep - s_ep ))
                    duration_label="(${dur_secs}s / $((dur_secs / 60))m)"
                fi
            fi

            local display_name="$rel_name"
            [ ${#display_name} -gt 46 ] && display_name="${display_name:0:43}..."

            local pipeline_ref_inline
            pipeline_ref_inline=$(echo "$rel" | jq -r '.status.managedProcessing.pipelineRun // empty')

            if [ "$released_status" = "True" ]; then
                printf "  ${GREEN}✓${NC}  %-18s ${GREEN}Succeeded${NC}   %-46s  %-12s %s\n" \
                    "${type_label}${retry_label}" "$display_name" "${time_label:-}" "$duration_label"
                if [ "$verbose" = true ] && [ -n "$pipeline_ref_inline" ]; then
                    echo -e "     UI: ${CYAN}$(_release_pipeline_ui_url "$pipeline_ref_inline")${NC}"
                fi
            elif [ "$released_status" = "False" ]; then
                printf "  ${RED}✗${NC}  %-18s ${RED}Failed${NC}      %-46s  %-12s %s\n" \
                    "${type_label}${retry_label}" "$display_name" "${time_label:-}" "$duration_label"
                local fail_msg
                fail_msg=$(echo "$rel" | jq -r '
                    [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")]
                    | .[0] | .message // empty
                ' 2>/dev/null | head -1)
                if [ -n "$fail_msg" ]; then
                    local short_msg="${fail_msg:0:100}"
                    echo -e "     ${RED}↳${NC} ${short_msg}"
                fi
                if [ -n "$pipeline_ref_inline" ]; then
                    echo -e "     UI: ${CYAN}$(_release_pipeline_ui_url "$pipeline_ref_inline")${NC}"
                fi
            else
                local managed_reason
                managed_reason=$(echo "$rel" | jq -r '
                    [.status.conditions[]? | select(.type == "ManagedPipelineProcessed")]
                    | .[0] | .reason // "Pending"
                ')
                if [ "$managed_reason" = "Running" ]; then
                    printf "  ${YELLOW}◌${NC}  %-18s ${YELLOW}Running${NC}     %-46s  %-12s\n" \
                        "${type_label}${retry_label}" "$display_name" "${time_label:-}"
                else
                    printf "  ${YELLOW}○${NC}  %-18s ${YELLOW}Pending${NC}     %-46s  %-12s\n" \
                        "${type_label}${retry_label}" "$display_name" "${time_label:-}"
                fi
                if [ -n "$pipeline_ref_inline" ]; then
                    echo -e "     UI: ${CYAN}$(_release_pipeline_ui_url "$pipeline_ref_inline")${NC}"
                fi
            fi
        done

        local last_status
        last_status=$(echo "$matching" | jq -r '
            .[-1] | [.status.conditions[]? | select(.type == "Released")] | .[0] | .status // "Unknown"
        ' 2>/dev/null)

        local step_end
        step_end=$(echo "$matching" | jq -r '
            [.[].status.managedProcessing.completionTime // empty] | map(select(. != "")) | sort | .[-1] // empty
        ' 2>/dev/null)
        if [ -n "$step_end" ] && [[ "$step_end" > "${latest_end_time:-}" ]]; then
            latest_end_time="$step_end"
        fi

        if [ "$last_status" = "True" ]; then
            if [ "$step_target" = "stage" ]; then
                stage_done=$((stage_done + 1))
            else
                prod_done=$((prod_done + 1))
            fi
            local total_retries
            total_retries=$(echo "$matching" | jq 'length - 1' 2>/dev/null)
            if [ "${total_retries:-0}" -gt 0 ]; then
                if [ "$step_target" = "stage" ]; then
                    stage_retries=$((stage_retries + total_retries))
                else
                    prod_retries=$((prod_retries + total_retries))
                fi
            fi
        elif [ "$last_status" = "False" ]; then
            if [ -z "$blocker" ]; then
                blocker="${step_target} ${type_label}"
                blocker_release=$(echo "$matching" | jq -r '.[-1].metadata.name' 2>/dev/null)
            fi
        else
            if [ -z "$next_step" ] && [ -z "$blocker" ]; then
                next_step="$step_target $type_label"
            fi
        fi

    done <<< "$steps"

    echo ""
    echo -e "── ${BOLD}Summary${NC} ────────────────────────────────────────────────────"

    local stage_status="" prod_status=""
    if [ "$stage_done" -eq "$stage_total" ]; then
        stage_status="${GREEN}${stage_done}/${stage_total} complete${NC}"
    else
        stage_status="${YELLOW}${stage_done}/${stage_total} complete${NC}"
    fi
    [ "$stage_retries" -gt 0 ] && stage_status="${stage_status} (${stage_retries} retries)"

    if [ "$prod_done" -eq "$prod_total" ]; then
        prod_status="${GREEN}${prod_done}/${prod_total} complete${NC}"
    elif [ -n "$blocker" ]; then
        prod_status="${RED}${prod_done}/${prod_total} complete — BLOCKED${NC}"
    else
        prod_status="${YELLOW}${prod_done}/${prod_total} complete${NC}"
    fi
    [ "$prod_retries" -gt 0 ] && prod_status="${prod_status} (${prod_retries} retries)"

    echo -ne "  Stage: "; echo -e "$stage_status"
    echo -ne "  Prod:  "; echo -e "$prod_status"

    if [ -n "$first_created" ]; then
        local start_epoch_ts end_epoch_ts elapsed_label
        start_epoch_ts=$(date -d "$first_created" '+%s' 2>/dev/null)
        if [ -n "$start_epoch_ts" ]; then
            local is_complete=false
            if [ "$stage_done" -eq "$stage_total" ] && [ "$prod_done" -eq "$prod_total" ]; then
                is_complete=true
            fi
            if [ "$is_complete" = true ] && [ -n "$latest_end_time" ]; then
                end_epoch_ts=$(date -d "$latest_end_time" '+%s' 2>/dev/null)
            else
                end_epoch_ts=$(date '+%s')
            fi
            if [ -n "$end_epoch_ts" ]; then
                local elapsed=$(( end_epoch_ts - start_epoch_ts ))
                local days=$((elapsed / 86400))
                local hours=$(( (elapsed % 86400) / 3600 ))
                local mins=$(( (elapsed % 3600) / 60 ))
                elapsed_label=""
                [ "$days" -gt 0 ] && elapsed_label="${days}d "
                [ "$hours" -gt 0 ] || [ "$days" -gt 0 ] && elapsed_label="${elapsed_label}${hours}h "
                elapsed_label="${elapsed_label}${mins}m"
                local suffix="(complete)"
                [ "$is_complete" != true ] && suffix="(in progress)"
                echo -ne "  ${BOLD}Elapsed:${NC} ${elapsed_label} ${suffix}"
                echo ""
            fi
        fi
    fi
    echo ""

    if [ -n "$blocker" ]; then
        echo -e "  ${RED}✗ Blocker:${NC} ${blocker} failed"
        if [ -n "$blocker_release" ]; then
            local fail_reason
            fail_reason=$(echo "$all_releases" | jq -r --arg name "$blocker_release" '
                [.[] | select(.metadata.name == $name)] | .[0]
                | [.status.conditions[]? | select(.type == "ManagedPipelineProcessed" and .status == "False")]
                | .[0] | .message // empty
            ' 2>/dev/null | head -1)
            if [ -z "$fail_reason" ]; then
                fail_reason=$(echo "$all_releases" | jq -r --arg name "$blocker_release" '
                    [.[] | select(.metadata.name == $name)] | .[0]
                    | [.status.conditions[]? | select(.type == "Validated" and .status == "False")]
                    | .[0] | .message // empty
                ' 2>/dev/null | head -1)
            fi
            local short_reason
            short_reason=$(echo "$fail_reason" | grep -oP 'task \K[^ :]+' | head -1)
            [ -n "$short_reason" ] && echo -e "  → Failed at: ${short_reason}"
            _release_blocker_advice "$fail_reason" "$blocker_release"
        fi
    elif [ -n "$next_step" ]; then
        echo -e "  → ${BOLD}Next step:${NC} ${next_step}"
    elif [ "$stage_done" -eq "$stage_total" ] && [ "$prod_done" -eq "$prod_total" ]; then
        echo -e "  ${GREEN}✓ Release complete!${NC}"
    fi

    # Advisory status from Pyxis (only for completed releases, skip if no valid ticket)
    if [ "$stage_done" -eq "$stage_total" ] && [ "$prod_done" -eq "$prod_total" ] && \
       klist -s 2>/dev/null; then
        local advisory_output
        advisory_output=$(cd "$SCRIPT_DIR/src" && $PYTHON advisory_status.py --target prod --page-size 5 2>/dev/null)
        if [ -n "$advisory_output" ]; then
            local adv_count
            adv_count=$(printf '%s\n' "$advisory_output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d.get('count',0))" 2>/dev/null)
            if [ "${adv_count:-0}" -gt 0 ]; then
                echo ""
                echo -e "  ${BOLD}Advisories:${NC}"
                printf '%s\n' "$advisory_output" | $PYTHON -c "
import sys, json
d = json.load(sys.stdin)
for adv in d.get('advisories', [])[:5]:
    eid = adv.get('errata_id', adv.get('_id', '?'))
    status = adv.get('status', '?')
    synopsis = adv.get('synopsis', '')[:60]
    print('    {} [{}] {}'.format(eid, status, synopsis))
" 2>/dev/null
            fi
        fi
    fi
    echo ""

    echo -e "${CYAN}Tip:${NC} Use 'ic describe release <name> --logs' for error details"
    echo -e "${CYAN}Tip:${NC} Use 'ic get releases' to list all Release CRs"
    echo -e "${CYAN}Tip:${NC} Use '--verbose' to show Konflux UI links for each step"
    echo ""
}

# RELEASE DIFF — compare snapshots between two release epochs
cmd_release_diff() {
    local epoch_a="${1:-}" epoch_b="${2:-}"
    if [ -z "$epoch_a" ] || [ -z "$epoch_b" ]; then
        echo -e "${RED}Usage: ic release diff <epoch1> <epoch2>${NC}"
        echo -e "${CYAN}Example: ic release diff 1778062796 1778099025${NC}"
        return 1
    fi

    _release_require_oc || return 1

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)
    local app_version="${APPLICATION_NAME#*-v}"

    _release_diff_snapshot() {
        local ep="$1"
        echo "$releases_json" | jq -r --arg ep "$ep" --arg ver "$app_version" '
            [.items[] | select(.spec.releasePlan | contains($ver))
                      | select(.metadata.name | contains($ep))
                      | select(.spec.releasePlan | (endswith("-components-stage") or endswith("-components-prod")))]
            | .[0].spec.snapshot // empty
        ' 2>/dev/null
    }

    local snap_a snap_b
    snap_a=$(_release_diff_snapshot "$epoch_a")
    snap_b=$(_release_diff_snapshot "$epoch_b")

    if [ -z "$snap_a" ]; then
        echo -e "${RED}Error: No component release found for epoch ${epoch_a}${NC}"
        return 1
    fi
    if [ -z "$snap_b" ]; then
        echo -e "${RED}Error: No component release found for epoch ${epoch_b}${NC}"
        return 1
    fi

    local snap_a_json snap_b_json
    snap_a_json=$(oc get snapshot "$snap_a" -n "$NAMESPACE" -o json 2>/dev/null || true)
    snap_b_json=$(oc get snapshot "$snap_b" -n "$NAMESPACE" -o json 2>/dev/null || true)

    if [ -z "$snap_a_json" ] || echo "$snap_a_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        echo -e "${RED}Error: Snapshot ${snap_a} not found (may have been garbage-collected)${NC}"
        return 1
    fi
    if [ -z "$snap_b_json" ] || echo "$snap_b_json" | jq -e '.kind == "Status"' >/dev/null 2>&1; then
        echo -e "${RED}Error: Snapshot ${snap_b} not found (may have been garbage-collected)${NC}"
        return 1
    fi

    local comps_a comps_b
    comps_a=$(echo "$snap_a_json" | jq -r '[.spec.components[]? | {name: .name, image: .containerImage}] | sort_by(.name)' 2>/dev/null)
    comps_b=$(echo "$snap_b_json" | jq -r '[.spec.components[]? | {name: .name, image: .containerImage}] | sort_by(.name)' 2>/dev/null)

    section_header "Release Diff — ${APPLICATION_NAME}"
    echo ""
    echo -e "${BOLD}Epoch A:${NC}  ${CYAN}${epoch_a}${NC}  Snapshot: ${CYAN}${snap_a}${NC}"
    echo -e "${BOLD}Epoch B:${NC}  ${CYAN}${epoch_b}${NC}  Snapshot: ${CYAN}${snap_b}${NC}"
    echo ""

    if [ "$snap_a" = "$snap_b" ]; then
        echo -e "${YELLOW}Both epochs use the same snapshot — no differences.${NC}"
        echo ""
        return
    fi

    local changed=() added=() removed=() same_count=0

    local names_a names_b
    names_a=$(echo "$comps_a" | jq -r '.[].name' 2>/dev/null)
    names_b=$(echo "$comps_b" | jq -r '.[].name' 2>/dev/null)

    local all_names
    all_names=$(echo -e "${names_a}\n${names_b}" | sort -u)

    while IFS= read -r comp_name; do
        [ -z "$comp_name" ] && continue
        local img_a img_b
        img_a=$(echo "$comps_a" | jq -r --arg n "$comp_name" '[.[] | select(.name == $n)] | .[0].image // empty' 2>/dev/null)
        img_b=$(echo "$comps_b" | jq -r --arg n "$comp_name" '[.[] | select(.name == $n)] | .[0].image // empty' 2>/dev/null)

        if [ -z "$img_a" ]; then
            added+=("$comp_name|$img_b")
        elif [ -z "$img_b" ]; then
            removed+=("$comp_name|$img_a")
        elif [ "$img_a" != "$img_b" ]; then
            local digest_a="${img_a##*@}" digest_b="${img_b##*@}"
            changed+=("$comp_name|${digest_a:0:19}|${digest_b:0:19}")
        else
            same_count=$((same_count + 1))
        fi
    done <<< "$all_names"

    printf "  ${BOLD}Changed:${NC} %-6d ${BOLD}Added:${NC} %-6d ${BOLD}Removed:${NC} %-6d ${BOLD}Same:${NC} %d\n" \
        "${#changed[@]}" "${#added[@]}" "${#removed[@]}" "$same_count"
    echo ""

    if [ "${#changed[@]}" -gt 0 ]; then
        echo -e "${BOLD}Changed:${NC}"
        for entry in "${changed[@]}"; do
            IFS='|' read -r name dig_a dig_b <<< "$entry"
            printf "  %-44s ${RED}%s${NC} → ${GREEN}%s${NC}\n" "$name" "$dig_a" "$dig_b"
        done
        echo ""
    fi

    if [ "${#added[@]}" -gt 0 ]; then
        echo -e "${BOLD}${GREEN}Added:${NC}"
        for entry in "${added[@]}"; do
            IFS='|' read -r name img <<< "$entry"
            local digest="${img##*@}"
            printf "  ${GREEN}+${NC} %-44s %s\n" "$name" "${digest:0:19}"
        done
        echo ""
    fi

    if [ "${#removed[@]}" -gt 0 ]; then
        echo -e "${BOLD}${RED}Removed:${NC}"
        for entry in "${removed[@]}"; do
            IFS='|' read -r name img <<< "$entry"
            local digest="${img##*@}"
            printf "  ${RED}-${NC} %-44s %s\n" "$name" "${digest:0:19}"
        done
        echo ""
    fi

    if [ "${#changed[@]}" -eq 0 ] && [ "${#added[@]}" -eq 0 ] && [ "${#removed[@]}" -eq 0 ]; then
        echo -e "${GREEN}Snapshots have identical components.${NC}"
        echo ""
    fi
}

cmd_release_verify() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo -e "${RED}Usage: ic release verify <release-name>${NC}"
        echo -e "${CYAN}Example: ic release verify my-app-v3-4-prod-1234567890${NC}"
        return 1
    fi

    _release_require_oc || return 1
    _release_require_kinit || return 1

    local output
    output=$(cd "$SCRIPT_DIR/src" && $PYTHON verify_release.py --release "$name" --namespace "$NAMESPACE" 2>/dev/null)

    if [ -z "$output" ]; then
        echo -e "${RED}Error: Pyxis verification failed.${NC}"
        return 1
    fi

    local status_check
    status_check=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d.get('status','ok'))" 2>/dev/null)
    if [ "$status_check" = "error" ]; then
        local err_msg
        err_msg=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d.get('error','unknown'))" 2>/dev/null)
        echo -e "${RED}Error: ${err_msg}${NC}"
        return 1
    fi

    local target snapshot total found missing errors
    target=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['target'])" 2>/dev/null)
    snapshot=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['snapshot'])" 2>/dev/null)
    total=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['total'])" 2>/dev/null)
    found=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['found'])" 2>/dev/null)
    missing=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['missing'])" 2>/dev/null)
    errors=$(printf '%s\n' "$output" | $PYTHON -c "import sys,json; d=json.load(sys.stdin); print(d['errors'])" 2>/dev/null)

    local target_label target_registry
    if [ "$target" = "prod" ]; then
        target_label="Prod"
        target_registry="registry.redhat.io"
    else
        target_label="Stage"
        target_registry="registry.stage.redhat.io"
    fi

    section_header "Release Verify: ${name}"
    echo ""
    echo -e "${BOLD}Target:${NC}    ${target_label} (${target_registry})"
    echo -e "${BOLD}Snapshot:${NC}  ${CYAN}${snapshot}${NC}"
    echo ""

    local found_color="$GREEN" missing_color="$NC"
    [ "${missing:-0}" -gt 0 ] 2>/dev/null && missing_color="$RED"
    printf "  ${BOLD}Found:${NC} ${found_color}%d/%d${NC}    ${BOLD}Missing:${NC} ${missing_color}%d${NC}    ${BOLD}Errors:${NC} %d\n" \
        "$found" "$total" "$missing" "$errors"
    echo ""

    if [ "${missing:-0}" -gt 0 ] || [ "${errors:-0}" -gt 0 ]; then
        echo -e "${BOLD}Missing/Error images:${NC}"
        printf '%s\n' "$output" | $PYTHON -c "
import sys, json
d = json.load(sys.stdin)
for img in d.get('images', []):
    if img['status'] in ('missing', 'error'):
        digest = img['digest'][:19] if len(img['digest']) > 19 else img['digest']
        print('  {:<44s} {:<40s} {}'.format(img['name'], img['repository'], digest))
" 2>/dev/null
        echo ""
        echo -e "${CYAN}Tip:${NC} Run 'ic ai analyze release ${name}' for root cause analysis"
    else
        echo -e "${GREEN}All images found in target registry.${NC}"
    fi
    echo ""
}

cmd_release_readiness() {
    local filter_target="" epoch=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --stage) filter_target="stage"; shift ;;
            --prod)  filter_target="prod"; shift ;;
            -*) shift ;;
            *) [ -z "$epoch" ] && epoch="$1"; shift ;;
        esac
    done

    _release_require_oc || return 1
    local db_ok=true
    _check_db 2>/dev/null || db_ok=false

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)
    if [ -z "$releases_json" ]; then
        echo -e "${RED}Error: Could not fetch Release CRs${NC}"
        return 1
    fi

    local app_version="${APPLICATION_NAME#*-v}"
    local all_releases
    all_releases=$(echo "$releases_json" | jq -c --arg ver "$app_version" '
        [.items[] | select(.spec.releasePlan | contains($ver))]
    ' 2>/dev/null)

    if [ -z "$epoch" ]; then
        epoch=$(echo "$all_releases" | jq -r '.[].metadata.name' 2>/dev/null \
            | grep -oP '\d{10}' | sort -rn | uniq | head -1)
        if [ -z "$epoch" ]; then
            echo -e "${YELLOW}No releases found for ${APPLICATION_NAME}${NC}"
            return
        fi
    fi

    local epoch_date
    epoch_date=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
        [.[] | select(.metadata.name | contains($epoch))] | .[0].metadata.creationTimestamp // ""
    ' 2>/dev/null)
    local date_label
    date_label=$(date -d "$epoch_date" '+%Y-%m-%d' 2>/dev/null || echo "${epoch_date:0:10}")

    section_header "Release Readiness — ${APPLICATION_NAME}"
    echo ""
    echo -e "${BOLD}Epoch:${NC}    ${CYAN}${epoch}${NC}  (${date_label})"

    # Schedule countdown from Smartsheet/DB cache
    local sched_data
    sched_data=$(_release_get_schedule "$APPLICATION_NAME" 2>/dev/null)
    if [ -n "$sched_data" ]; then
        local s_pf s_ff s_cf s_rc s_rw s_ga s_nr
        IFS='|' read -r s_pf s_ff s_cf s_rc s_rw s_ga s_nr <<< "$sched_data"
        s_pf=$(trim "$s_pf"); s_ff=$(trim "$s_ff"); s_cf=$(trim "$s_cf")
        s_rc=$(trim "$s_rc"); s_rw=$(trim "$s_rw"); s_ga=$(trim "$s_ga")
        s_nr=$(trim "$s_nr")

        _sched_fmt() {
            local label="$1" dt="$2"
            [ -z "$dt" ] && return
            local d; d=$(_release_days_until "$dt")
            local fmt; fmt=$(date -d "$dt" '+%b %d' 2>/dev/null || echo "$dt")
            if [ -n "$d" ] && [ "$d" -le 0 ]; then
                echo "${label}: ${fmt} (passed)"
            elif [ -n "$d" ]; then
                echo "${label}: ${fmt} (${d}d)"
            fi
        }

        local parts=()
        local p
        p=$(_sched_fmt "Release" "$s_ga") && [ -n "$p" ] && parts+=("$p")
        p=$(_sched_fmt "Rel Window" "$s_rw") && [ -n "$p" ] && parts+=("$p")
        p=$(_sched_fmt "RC" "$s_rc") && [ -n "$p" ] && parts+=("$p")
        p=$(_sched_fmt "Code Freeze" "$s_cf") && [ -n "$p" ] && parts+=("$p")
        p=$(_sched_fmt "Feature Freeze" "$s_ff") && [ -n "$p" ] && parts+=("$p")
        p=$(_sched_fmt "Planning Freeze" "$s_pf") && [ -n "$p" ] && parts+=("$p")

        if [ "${#parts[@]}" -gt 0 ]; then
            local line1="${parts[0]}"
            [ "${#parts[@]}" -ge 2 ] && line1="${line1}  │  ${parts[1]}"
            [ "${#parts[@]}" -ge 3 ] && line1="${line1}  │  ${parts[2]}"
            echo -e "${BOLD}Schedule:${NC} ${line1}"
            if [ "${#parts[@]}" -ge 4 ]; then
                local line2="          ${parts[3]}"
                [ "${#parts[@]}" -ge 5 ] && line2="${line2}  │  ${parts[4]}"
                [ "${#parts[@]}" -ge 6 ] && line2="${line2}  │  ${parts[5]}"
                echo -e "          ${line2}"
            fi
        fi

        if [ -n "$s_nr" ]; then
            echo -e "${BOLD}Next:${NC}     ${s_nr}"
        fi
    fi
    echo ""

    show_freeze_banner
    show_outage_banner

    # ── Section 1: Pipeline Status ──
    local summary
    summary=$(_release_epoch_pipeline_summary "$all_releases" "$epoch" "$filter_target")
    IFS='|' read -r sd st sr pd pt pr_r blocker blocker_msg next_step <<< "$summary"

    local step_lines
    step_lines=$(_release_epoch_pipeline_steps "$all_releases" "$epoch" "$filter_target")

    echo -e "── ${BOLD}Pipeline${NC} ────────────────────────────────────────────────────"

    if [ -z "$filter_target" ] || [ "$filter_target" = "stage" ]; then
        local stage_icon="${YELLOW}○${NC}"
        [ "$sd" -eq "$st" ] 2>/dev/null && stage_icon="${GREEN}✓${NC}"
        local stage_extra=""
        [ "${sr:-0}" -gt 0 ] && stage_extra="  (${sr} retries)"
        echo -e "  Stage: ${sd}/${st} ${stage_icon}${stage_extra}"
        # Per-step detail for stage
        local stage_done="" stage_pending=""
        while IFS='|' read -r s_tgt s_label s_status s_retries s_fail; do
            [ "$s_tgt" != "stage" ] && continue
            if [ "$s_status" = "succeeded" ]; then
                stage_done="${stage_done}${stage_done:+  }${GREEN}✓${NC} ${s_label}"
            elif [ "$s_status" = "failed" ]; then
                local fail_info=""
                [ -n "$s_fail" ] && fail_info=" — failed at ${s_fail}"
                stage_pending="${stage_pending}    ${RED}✗${NC} ${s_label}${fail_info}\n"
            elif [ "$s_status" = "running" ]; then
                stage_pending="${stage_pending}    ${YELLOW}◌${NC} ${s_label} (running)\n"
            else
                stage_pending="${stage_pending}    ${YELLOW}○${NC} ${s_label}\n"
            fi
        done <<< "$step_lines"
        [ -n "$stage_done" ] && echo -e "    ${stage_done}"
        [ -n "$stage_pending" ] && echo -en "$stage_pending"
    fi

    if [ -z "$filter_target" ] || [ "$filter_target" = "prod" ]; then
        local prod_icon="${YELLOW}○${NC}"
        [ "$pd" -eq "$pt" ] 2>/dev/null && prod_icon="${GREEN}✓${NC}"
        [ -n "$blocker" ] && [[ "$blocker" == prod* ]] && prod_icon="${RED}✗${NC}"
        local prod_extra=""
        [ "${pr_r:-0}" -gt 0 ] && prod_extra="  (${pr_r} retries)"
        local prod_note=""
        if [ "${pd:-0}" -eq 0 ] && [ "${sd:-0}" -lt "${st:-0}" ] 2>/dev/null; then
            prod_note=" (waiting on stage)"
        fi
        echo -e "  Prod:  ${pd}/${pt} ${prod_icon}${prod_extra}${prod_note}"
        # Per-step detail for prod (only when prod has activity or stage is done)
        if [ "${pd:-0}" -gt 0 ] || [ "${sd:-0}" -eq "${st:-0}" ] 2>/dev/null; then
            local prod_done="" prod_pending=""
            while IFS='|' read -r s_tgt s_label s_status s_retries s_fail; do
                [ "$s_tgt" != "prod" ] && continue
                if [ "$s_status" = "succeeded" ]; then
                    prod_done="${prod_done}${prod_done:+  }${GREEN}✓${NC} ${s_label}"
                elif [ "$s_status" = "failed" ]; then
                    local fail_info=""
                    [ -n "$s_fail" ] && fail_info=" — failed at ${s_fail}"
                    prod_pending="${prod_pending}    ${RED}✗${NC} ${s_label}${fail_info}\n"
                elif [ "$s_status" = "running" ]; then
                    prod_pending="${prod_pending}    ${YELLOW}◌${NC} ${s_label} (running)\n"
                else
                    prod_pending="${prod_pending}    ${YELLOW}○${NC} ${s_label}\n"
                fi
            done <<< "$step_lines"
            [ -n "$prod_done" ] && echo -e "    ${prod_done}"
            [ -n "$prod_pending" ] && echo -en "$prod_pending"
        fi
    fi
    echo ""

    # ── Section 2: Build Health ──
    local blockers=() risks=()
    local release_urgency=""
    if [ -n "$sched_data" ]; then
        local _ru_ga; _ru_ga=$(echo "$sched_data" | cut -d'|' -f6)
        _ru_ga=$(trim "$_ru_ga")
        if [ -n "$_ru_ga" ]; then
            local ga_days=$(_release_days_until "$_ru_ga")
            if [ -n "$ga_days" ] && [ "$ga_days" -gt 0 ]; then
                release_urgency=" — ${YELLOW}${ga_days}d to release${NC}"
            fi
        fi
    fi

    if [ "$db_ok" = true ]; then
        echo -e "── ${BOLD}Build Health${NC}${release_urgency} ────────────────────────────────────"

        local failing_data
        failing_data=$(sql_failing_builds_with_health "$APPLICATION_NAME" 2>/dev/null)
        local fail_count=0
        if [ -n "$failing_data" ]; then
            fail_count=$(echo "$failing_data" | grep -c '|' 2>/dev/null || echo 0)
        fi

        local resolved_data
        resolved_data=$(sql_recently_resolved_builds "$APPLICATION_NAME" 7 2>/dev/null)
        local resolved_count=0
        if [ -n "$resolved_data" ]; then
            resolved_count=$(echo "$resolved_data" | grep -c '|' 2>/dev/null || echo 0)
        fi

        echo -ne "  Failing: "
        if [ "$fail_count" -gt 0 ]; then
            echo -e "${RED}${fail_count}${NC}    Fixed (7d): ${GREEN}${resolved_count}${NC}"
            echo "$failing_data" | head -5 | while IFS='|' read -r fname fscore fconsec; do
                fname=$(trim "$fname"); fscore=$(trim "$fscore"); fconsec=$(trim "$fconsec")
                [ -z "$fname" ] && continue
                printf "    ${RED}✗${NC} %-40s (score: %s, %s consecutive)\n" "$fname" "$fscore" "$fconsec"
            done
            risks+=("${fail_count} component(s) have failing builds")
        else
            echo -e "${GREEN}0${NC}    Fixed (7d): ${GREEN}${resolved_count}${NC}"
        fi

        if [ "$resolved_count" -gt 0 ]; then
            echo "$resolved_data" | head -3 | while IFS='|' read -r rname rdate rcommit; do
                rname=$(trim "$rname"); rdate=$(trim "$rdate"); rcommit=$(trim "$rcommit")
                [ -z "$rname" ] && continue
                local commit_label=""
                [ -n "$rcommit" ] && commit_label=", ${rcommit}"
                printf "    ${GREEN}✓${NC} %-40s (fixed %s%s)\n" "$rname" "$rdate" "$commit_label"
            done
        fi
        echo ""

        # ── Section 3: Conforma Compliance ──
        echo -e "── ${BOLD}Conforma Compliance${NC}${release_urgency} ─────────────────────────────"

        local conforma_data
        conforma_data=$(sql_conforma_blocking "$APPLICATION_NAME" 2>/dev/null)

        if [ -z "$conforma_data" ]; then
            echo -e "  ${GREEN}✓ No current-policy violations${NC}"
        else
            local exceptions=""
            exceptions=$(fetch_conforma_exceptions "$APPLICATION_NAME" 2>/dev/null)
            local k8s_exc_full=""
            k8s_exc_full=$(fetch_k8s_exceptions_full 2>/dev/null)

            local blocking=0 excepted=0 partial=0
            local blocking_names=""
            echo "$conforma_data" | while IFS='|' read -r cname cviol cscenario; do
                cname=$(trim "$cname"); cviol=$(trim "$cviol"); cscenario=$(trim "$cscenario")
                [ -z "$cname" ] && continue

                local exc_status="-"
                if [ -n "$exceptions" ] || [ -n "$k8s_exc_full" ]; then
                    local cname_esc="${cname//\'/\'\'}" cscenario_esc="${cscenario//\'/\'\'}" app_esc="${APPLICATION_NAME//\'/\'\'}"
                    local vsummary
                    vsummary=$(sql "SELECT violation_summary FROM conforma_results WHERE component_name = '$cname_esc' AND scenario = '$cscenario_esc' AND application = '$app_esc' AND is_resolved = FALSE ORDER BY last_updated_at DESC LIMIT 1;" 2>/dev/null)
                    exc_status=$(check_exception_status_v2 "$vsummary" "$exceptions" "$k8s_exc_full" "$cscenario" | cut -d'|' -f1)
                fi

                case "$exc_status" in
                    YES|"YES (policy)") printf "    ${GREEN}✓${NC} %-40s (%s violations, excepted)\n" "$cname" "$cviol" ;;
                    PARTIAL*) printf "    ${YELLOW}△${NC} %-40s (%s violations, %s)\n" "$cname" "$cviol" "$exc_status" ;;
                    *) printf "    ${RED}✗${NC} %-40s (%s violations, NO exception)\n" "$cname" "$cviol" ;;
                esac
            done

            # Count blocking (re-run without subshell for variable access)
            local _blocking=0 _excepted=0 _partial=0 _blocking_names=""
            while IFS='|' read -r cname cviol cscenario; do
                cname=$(trim "$cname"); cscenario=$(trim "$cscenario")
                [ -z "$cname" ] && continue
                local exc_status="-"
                if [ -n "$exceptions" ] || [ -n "$k8s_exc_full" ]; then
                    local cname_esc="${cname//\'/\'\'}" cscenario_esc="${cscenario//\'/\'\'}" app_esc="${APPLICATION_NAME//\'/\'\'}"
                    local vsummary
                    vsummary=$(sql "SELECT violation_summary FROM conforma_results WHERE component_name = '$cname_esc' AND scenario = '$cscenario_esc' AND application = '$app_esc' AND is_resolved = FALSE ORDER BY last_updated_at DESC LIMIT 1;" 2>/dev/null)
                    exc_status=$(check_exception_status_v2 "$vsummary" "$exceptions" "$k8s_exc_full" "$cscenario" | cut -d'|' -f1)
                fi
                case "$exc_status" in
                    YES|"YES (policy)") _excepted=$((_excepted + 1)) ;;
                    PARTIAL*) _partial=$((_partial + 1)) ;;
                    *) _blocking=$((_blocking + 1)); _blocking_names="${_blocking_names} ${cname}" ;;
                esac
            done <<< "$conforma_data"

            echo ""
            echo -ne "  Summary: "
            [ "$_blocking" -gt 0 ] && echo -ne "${RED}${_blocking} blocking${NC}  "
            [ "$_excepted" -gt 0 ] && echo -ne "${GREEN}${_excepted} excepted${NC}  "
            [ "$_partial" -gt 0 ] && echo -ne "${YELLOW}${_partial} partial${NC}  "
            echo ""

            [ "$_blocking" -gt 0 ] && blockers+=("Conforma: ${_blocking} component(s) have unexcepted violations")
        fi
        echo ""
    else
        echo -e "${YELLOW}Database unavailable — build and conforma data not shown${NC}"
        echo ""
    fi

    # ── Section 4: Expiring Exceptions ──
    local name_filter="${APPLICATION_NAME#*-v}"
    local expiring_json
    expiring_json=$(cd "$SCRIPT_DIR/src" && $PYTHON ec_policy_data.py --action expiring --name-filter "$name_filter" --days 45 2>/dev/null || true)

    if [ -n "$expiring_json" ] && echo "$expiring_json" | jq -e '.source == "k8s-api"' >/dev/null 2>&1; then
        local exp_count
        exp_count=$(echo "$expiring_json" | jq '[.exceptions[] | select(.days_left >= 0)] | length')

        if [ "${exp_count:-0}" -gt 0 ]; then
            echo -e "── ${BOLD}Expiring Exceptions${NC}${release_urgency} ─────────────────────────────"

            local exp_summary
            exp_summary=$(echo "$expiring_json" | jq -r '
                [.exceptions[] | select(.days_left >= 0)] |
                group_by(.days_left) |
                map({
                    days: .[0].days_left,
                    count: length,
                    rules: ([.[].value | split(":")[0] | split(".")[0:2] | join(".")] | unique | sort)
                }) |
                sort_by(.days) |
                .[] | "\(.days)|\(.count)|\(.rules | join(", "))"
            ')

            while IFS='|' read -r exp_days exp_cnt exp_rules; do
                [ -z "$exp_days" ] && continue
                local urgency_icon="${GREEN}○${NC}"
                if [ "$exp_days" -le 0 ]; then
                    urgency_icon="${RED}✗${NC}"
                elif [ "$exp_days" -le 7 ]; then
                    urgency_icon="${RED}!${NC}"
                elif [ "$exp_days" -le 14 ]; then
                    urgency_icon="${YELLOW}△${NC}"
                fi
                printf "    %b %-6s %s exception(s): %s\n" "$urgency_icon" "${exp_days}d" "$exp_cnt" "$exp_rules"
            done <<< "$exp_summary"

            echo ""

            local expired_count
            expired_count=$(echo "$expiring_json" | jq '[.exceptions[] | select(.days_left < 0 and .days_left >= -7)] | length')
            if [ "${expired_count:-0}" -gt 0 ]; then
                echo -e "  ${RED}Warning:${NC} ${expired_count} exception(s) expired in the last 7 days"
            fi

            local urgent_count
            urgent_count=$(echo "$expiring_json" | jq '[.exceptions[] | select(.days_left >= 0 and .days_left <= 14)] | length')
            if [ "${urgent_count:-0}" -gt 0 ]; then
                risks+=("${urgent_count} EC exception(s) expire within 14 days")
            fi
            echo ""
        fi
    fi

    # ── Section 5: JIRA Linked Issues ──
    if [ "$db_ok" = true ] && [ -n "${JIRA_TOKEN:-}" ]; then
        local jira_keys
        jira_keys=$(sql_linked_jira_keys "$APPLICATION_NAME" 2>/dev/null)
        if [ -n "$jira_keys" ]; then
            echo -e "── ${BOLD}Linked JIRAs${NC} ──────────────────────────────────────────────"
            local jira_open=0 jira_closed=0
            while IFS= read -r jkey; do
                jkey=$(trim "$jkey")
                [ -z "$jkey" ] && continue
                local jinfo
                jinfo=$(jira_api GET "/rest/api/2/issue/$jkey?fields=status,summary,priority" 2>/dev/null)
                if [ -n "$jinfo" ]; then
                    local jstatus jsummary jpriority
                    jstatus=$(echo "$jinfo" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('status',{}).get('name','?'))" 2>/dev/null)
                    jsummary=$(echo "$jinfo" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('summary','')[:60])" 2>/dev/null)
                    jpriority=$(echo "$jinfo" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('priority',{}).get('name','?'))" 2>/dev/null)
                    case "$jstatus" in
                        Closed|Done|Resolved) jira_closed=$((jira_closed + 1))
                            printf "    ${GREEN}✓${NC} %-15s [%-8s] %s\n" "$jkey" "$jstatus" "$jsummary" ;;
                        *)  jira_open=$((jira_open + 1))
                            local jicon="${YELLOW}○${NC}"
                            [ "$jpriority" = "Blocker" ] && jicon="${RED}✗${NC}"
                            printf "    ${jicon} %-15s [%-8s] %s (%s)\n" "$jkey" "$jstatus" "$jsummary" "$jpriority" ;;
                    esac
                fi
            done <<< "$jira_keys"
            echo ""
            echo -ne "  Summary: "
            [ "$jira_open" -gt 0 ] && echo -ne "${YELLOW}${jira_open} open${NC}  "
            [ "$jira_closed" -gt 0 ] && echo -ne "${GREEN}${jira_closed} resolved${NC}  "
            echo ""
            echo ""
        fi
    fi

    # ── Section 6: Additional Risks ──
    # Retry warnings
    local total_retries=$(( ${sr:-0} + ${pr_r:-0} ))
    if [ "$total_retries" -gt 2 ]; then
        risks+=("High retry count: ${total_retries} retries in current epoch (possible flaky pipeline)")
    fi

    # Freeze check
    if [ "$db_ok" = true ]; then
        local active_freeze
        active_freeze=$(sql_active_freeze 2>/dev/null)
        if [ -n "$active_freeze" ]; then
            IFS='|' read -r freason fstart fend <<< "$active_freeze"
            blockers+=("Pipeline frozen until $(trim "$fend") ($(trim "$freason"))")
        fi
    fi

    # Outage check
    local active_outages
    active_outages=$(check_outages 2>/dev/null)
    if [ -n "$active_outages" ]; then
        local outage_name
        outage_name=$(echo "$active_outages" | head -1 | cut -d'|' -f2)
        risks+=("Active infrastructure incident: ${outage_name}")
    fi

    # ── Section 7: Verdict ──
    [ -n "$blocker" ] && blockers+=("Pipeline: ${blocker} failed")

    echo -e "── ${BOLD}Verdict${NC} ─────────────────────────────────────────────────────"
    echo ""

    if [ "${#blockers[@]}" -gt 0 ]; then
        echo -e "  ${RED}✗ NOT READY${NC}"
        echo ""
        echo -e "  ${BOLD}Blockers:${NC}"
        local i=1
        for b in "${blockers[@]}"; do
            echo -e "    ${i}. ${b}"
            i=$((i + 1))
        done
    elif [ "${#risks[@]}" -gt 0 ] || [ -n "$next_step" ]; then
        echo -e "  ${YELLOW}△ AT RISK${NC}"
        echo ""
        if [ -n "$next_step" ]; then
            echo -e "  Pipeline still in progress (next: ${next_step})"
        fi
        for r in "${risks[@]}"; do
            echo -e "  • ${r}"
        done
    else
        local all_done=false
        [ "$sd" -eq "$st" ] 2>/dev/null && [ "$pd" -eq "$pt" ] 2>/dev/null && all_done=true
        if [ "$all_done" = true ]; then
            echo -e "  ${GREEN}✓ READY — Release complete${NC}"
        else
            echo -e "  ${GREEN}✓ READY${NC}"
        fi
    fi

    # Production outlook when prod hasn't completed
    if [ "${pd:-0}" -lt "${pt:-0}" ] 2>/dev/null && [ "$db_ok" = true ]; then
        local outlook_parts=()
        [ "${fail_count:-0}" -gt 0 ] && outlook_parts+=("${fail_count} build failure(s)")
        [ "${_blocking:-0}" -gt 0 ] && outlook_parts+=("${_blocking} conforma violation(s)")
        if [ "${#outlook_parts[@]}" -gt 0 ]; then
            local outlook_str
            outlook_str=$(IFS='+'; echo "${outlook_parts[*]}" | sed 's/+/ + /g')
            echo ""
            echo -e "  ${BOLD}Production outlook:${NC} ${outlook_str} would also block prod"
        fi
    fi

    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'ic release status' for detailed pipeline checklist"
    echo -e "${CYAN}Tip:${NC} Use 'ic get policy-gap' for stage vs prod policy differences"
    echo -e "${CYAN}Tip:${NC} Use 'ic describe conforma <name>' for violation details"
    echo ""
}

cmd_release_history() {
    local last_n=3

    while [ $# -gt 0 ]; do
        case "$1" in
            --last) shift; last_n="${1:-3}"; shift ;;
            -*) shift ;;
            *) shift ;;
        esac
    done

    _release_require_oc || return 1
    local db_ok=true
    _check_db 2>/dev/null || db_ok=false

    local releases_json
    releases_json=$(oc get releases.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)
    if [ -z "$releases_json" ]; then
        echo -e "${RED}Error: Could not fetch Release CRs${NC}"
        return 1
    fi

    local app_version="${APPLICATION_NAME#*-v}"
    local all_releases
    all_releases=$(echo "$releases_json" | jq -c --arg ver "$app_version" '
        [.items[] | select(.spec.releasePlan | contains($ver))]
    ' 2>/dev/null)

    local epochs
    epochs=$(echo "$all_releases" | jq -r '.[].metadata.name' 2>/dev/null \
        | grep -oP '\d{10}' | sort -rn | uniq | head -"$last_n")

    if [ -z "$epochs" ]; then
        echo -e "${YELLOW}No release epochs found for ${APPLICATION_NAME}${NC}"
        return
    fi

    local epoch_count
    epoch_count=$(echo "$epochs" | wc -l)

    section_header "Release History — ${APPLICATION_NAME}"
    echo ""
    echo -e "${CYAN}Showing ${epoch_count} most recent epoch(s)${NC}"
    echo ""

    local prev_epoch_date=""
    local prev_epoch=""
    local epoch_num=0

    while IFS= read -r epoch; do
        [ -z "$epoch" ] && continue
        epoch_num=$((epoch_num + 1))

        local epoch_date
        epoch_date=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
            [.[] | select(.metadata.name | contains($epoch))]
            | sort_by(.metadata.creationTimestamp) | .[0].metadata.creationTimestamp // ""
        ' 2>/dev/null)
        local date_label
        date_label=$(date -d "$epoch_date" '+%b %d' 2>/dev/null || echo "${epoch_date:0:10}")

        local snapshot
        snapshot=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
            [.[] | select(.metadata.name | contains($epoch))]
            | [.[] | select(.spec.releasePlan | (endswith("-components-stage") or endswith("-components-prod")))]
            | .[0].spec.snapshot // "unknown"
        ' 2>/dev/null)
        [ "$snapshot" = "null" ] && snapshot="unknown"

        echo -e "${BOLD}═══ Epoch ${epoch} (${date_label}) ═══${NC}"
        echo -e "  Snapshot: ${CYAN}${snapshot}${NC}"

        # Pipeline summary
        local summary
        summary=$(_release_epoch_pipeline_summary "$all_releases" "$epoch")
        IFS='|' read -r sd st sr pd pt pr_r blocker blocker_msg next_step <<< "$summary"

        local stage_icon="${YELLOW}○${NC}"
        [ "$sd" -eq "$st" ] 2>/dev/null && stage_icon="${GREEN}✓${NC}"
        local prod_icon="${YELLOW}○${NC}"
        [ "$pd" -eq "$pt" ] 2>/dev/null && prod_icon="${GREEN}✓${NC}"
        [ -n "$blocker" ] && prod_icon="${RED}✗${NC}"

        local retries_label=""
        local total_retries=$(( ${sr:-0} + ${pr_r:-0} ))
        [ "$total_retries" -gt 0 ] && retries_label="  (${total_retries} retries)"

        # Duration
        local first_created last_completed duration_label=""
        first_created=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
            [.[] | select(.metadata.name | contains($epoch))]
            | [.[].metadata.creationTimestamp] | sort | .[0] // ""
        ' 2>/dev/null)
        last_completed=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
            [.[] | select(.metadata.name | contains($epoch))]
            | [.[].status.managedProcessing.completionTime // empty] | map(select(. != "")) | sort | .[-1] // ""
        ' 2>/dev/null)

        if [ -n "$first_created" ] && [ -n "$last_completed" ]; then
            local s_ep e_ep
            s_ep=$(date -d "$first_created" '+%s' 2>/dev/null)
            e_ep=$(date -d "$last_completed" '+%s' 2>/dev/null)
            if [ -n "$s_ep" ] && [ -n "$e_ep" ] && [ "$e_ep" -gt "$s_ep" ]; then
                local dur=$(( e_ep - s_ep ))
                local d=$((dur / 86400)) h=$(( (dur % 86400) / 3600 ))
                duration_label=""
                [ "$d" -gt 0 ] && duration_label="${d}d "
                duration_label="${duration_label}${h}h"
            fi
        fi

        echo -ne "  Pipeline: Stage ${sd}/${st} "
        echo -ne "$stage_icon"
        echo -ne "  Prod ${pd}/${pt} "
        echo -ne "$prod_icon"
        echo -ne "$retries_label"
        [ -n "$duration_label" ] && echo -ne "  (${duration_label})"
        echo ""

        if [ -n "$blocker" ]; then
            local short_task
            short_task=$(echo "$blocker_msg" | grep -oP 'task \K[^ :]+' | head -1)
            [ -n "$short_task" ] && echo -e "  ${RED}✗ Failed:${NC} ${blocker} at ${short_task}" \
                || echo -e "  ${RED}✗ Failed:${NC} ${blocker}"
        fi

        [ "$total_retries" -gt 2 ] && echo -e "  ${YELLOW}⚠ ${total_retries} retries — possible flaky pipeline or persistent blocker${NC}"

        # Snapshot diff vs previous epoch
        if [ -n "$prev_epoch" ]; then
            local snap_cur snap_prev
            snap_cur=$(echo "$all_releases" | jq -r --arg epoch "$epoch" '
                [.[] | select(.metadata.name | contains($epoch))]
                | [.[] | select(.spec.releasePlan | (endswith("-components-stage") or endswith("-components-prod")))]
                | .[0].spec.snapshot // ""
            ' 2>/dev/null)
            snap_prev=$(echo "$all_releases" | jq -r --arg epoch "$prev_epoch" '
                [.[] | select(.metadata.name | contains($epoch))]
                | [.[] | select(.spec.releasePlan | (endswith("-components-stage") or endswith("-components-prod")))]
                | .[0].spec.snapshot // ""
            ' 2>/dev/null)
            if [ -n "$snap_cur" ] && [ -n "$snap_prev" ] && [ "$snap_cur" != "$snap_prev" ]; then
                local snap_a_json snap_b_json
                snap_a_json=$(oc get snapshot "$snap_cur" -n "$NAMESPACE" -o json 2>/dev/null)
                snap_b_json=$(oc get snapshot "$snap_prev" -n "$NAMESPACE" -o json 2>/dev/null)
                if [ -n "$snap_a_json" ] && [ -n "$snap_b_json" ]; then
                    local diff_parts
                    diff_parts=$( {
                        echo "$snap_a_json"
                        echo "---SEPARATOR---"
                        echo "$snap_b_json"
                    } | python3 -c "
import json, sys
parts = sys.stdin.read().split('---SEPARATOR---')
a = json.loads(parts[0]).get('spec',{}).get('components',[])
b = json.loads(parts[1]).get('spec',{}).get('components',[])
ma = {c['name']: c.get('containerImage','') for c in a}
mb = {c['name']: c.get('containerImage','') for c in b}
changed = sum(1 for n in ma if n in mb and ma[n] != mb[n])
added = sum(1 for n in ma if n not in mb)
removed = sum(1 for n in mb if n not in ma)
if changed or added or removed:
    p = []
    if changed: p.append(f'{changed} updated')
    if added: p.append(f'{added} added')
    if removed: p.append(f'{removed} removed')
    print(', '.join(p))
" 2>/dev/null)
                    [ -n "$diff_parts" ] && echo -e "  Snapshot: ${CYAN}${diff_parts}${NC} (vs prev epoch)"
                fi
            elif [ "$snap_cur" = "$snap_prev" ] && [ -n "$snap_cur" ]; then
                echo -e "  Snapshot: ${DIM}same as previous epoch${NC}"
            fi
        fi

        # DB-sourced context: what changed between this epoch and the newer one
        # prev_epoch_date = the NEWER epoch (from previous iteration, since we iterate newest-first)
        # epoch_date = the CURRENT (older) epoch
        # We want: resolved BETWEEN current(older) AND prev(newer)
        if [ "$db_ok" = true ] && [ -n "$prev_epoch_date" ] && [ -n "$epoch_date" ]; then
            local fixed
            fixed=$(sql_builds_resolved_between "$APPLICATION_NAME" "$epoch_date" "$prev_epoch_date" 2>/dev/null)
            if [ -n "$fixed" ]; then
                echo -ne "  Builds fixed: "
                local fix_items=""
                while IFS='|' read -r fname fdate fcommit; do
                    fname=$(trim "$fname"); fcommit=$(trim "$fcommit")
                    [ -z "$fname" ] && continue
                    local item="$fname"
                    [ -n "$fcommit" ] && item="${fname} (${fcommit})"
                    [ -n "$fix_items" ] && fix_items="${fix_items}, ${item}" || fix_items="$item"
                done <<< "$fixed"
                echo -e "${GREEN}${fix_items}${NC}"
            fi

            local conf_resolved
            conf_resolved=$(sql_conforma_resolved_between "$APPLICATION_NAME" "$epoch_date" "$prev_epoch_date" 2>/dev/null)
            if [ -n "$conf_resolved" ]; then
                echo -ne "  Conforma resolved: "
                local conf_items=""
                while IFS='|' read -r cname cdate; do
                    cname=$(trim "$cname")
                    [ -z "$cname" ] && continue
                    [ -n "$conf_items" ] && conf_items="${conf_items}, ${cname}" || conf_items="$cname"
                done <<< "$conf_resolved"
                echo -e "${GREEN}${conf_items}${NC}"
            fi

            local conf_new
            conf_new=$(sql_conforma_appeared_between "$APPLICATION_NAME" "$epoch_date" "$prev_epoch_date" 2>/dev/null)
            if [ -n "$conf_new" ]; then
                echo -ne "  New violations: "
                local new_items=""
                while IFS='|' read -r cname cdate cviol; do
                    cname=$(trim "$cname"); cviol=$(trim "$cviol")
                    [ -z "$cname" ] && continue
                    local item="${cname} (${cviol} violations)"
                    [ -n "$new_items" ] && new_items="${new_items}, ${item}" || new_items="$item"
                done <<< "$conf_new"
                echo -e "${RED}${new_items}${NC}"
            fi
        elif [ "$db_ok" = true ] && [ -z "$prev_epoch_date" ]; then
            echo -e "  ${DIM}(oldest epoch — no previous to compare)${NC}"
        fi

        # AI release analyses for this epoch
        if [ "$db_ok" = true ]; then
            local ai_data
            ai_data=$(sql_release_ai_analyses "$epoch" 2>/dev/null)
            if [ -n "$ai_data" ]; then
                while IFS='|' read -r rname rcat rconf rdate; do
                    rname=$(trim "$rname"); rcat=$(trim "$rcat"); rconf=$(trim "$rconf")
                    [ -z "$rname" ] && continue
                    echo -e "  AI: ${CYAN}${rcat}${NC} (${rconf}% confidence)"
                done <<< "$ai_data"
            fi
        fi

        prev_epoch_date="$epoch_date"
        prev_epoch="$epoch"
        echo ""
    done < <(echo "$epochs")

    echo -e "${CYAN}Tip:${NC} Use 'ic release status <epoch>' for detailed pipeline checklist"
    echo -e "${CYAN}Tip:${NC} Use 'ic release diff <epoch1> <epoch2>' to compare snapshots"
    echo -e "${CYAN}Tip:${NC} Use '--last N' to show more epochs (default: 3)"
    echo ""
}

cmd_scenarios() {
    local show_all=false
    local show_gaps=false
    local filter_active=false
    local filter_disabled=false
    local filter_type=""
    local app_override=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)      show_all=true; shift ;;
            --gaps)     show_gaps=true; shift ;;
            --active)   filter_active=true; shift ;;
            --disabled) filter_disabled=true; shift ;;
            --type)     filter_type="$2"; shift 2 ;;
            --app)      app_override="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local app_filter="${app_override:-$APPLICATION_NAME}"
    local action="list"
    $show_gaps && action="gaps"

    local its_json
    if $show_all; then
        its_json=$(cd "$SCRIPT_DIR/src" && $PYTHON its_scenario_data.py --action "$action" --namespace "$NAMESPACE" 2>/dev/null || true)
    elif [ "$action" = "gaps" ]; then
        its_json=$(cd "$SCRIPT_DIR/src" && $PYTHON its_scenario_data.py --action gaps --namespace "$NAMESPACE" 2>/dev/null || true)
    else
        its_json=$(cd "$SCRIPT_DIR/src" && $PYTHON its_scenario_data.py --action list --namespace "$NAMESPACE" --app-filter "$app_filter" 2>/dev/null || true)
    fi

    if [ -z "$its_json" ] || [ "$(echo "$its_json" | jq -r '.source // empty' 2>/dev/null)" = "error" ]; then
        echo -e "${RED}Error: Could not query IntegrationTestScenarios${NC}"
        [ -n "$its_json" ] && echo -e "${YELLOW}$(echo "$its_json" | jq -r '.error // empty' 2>/dev/null)${NC}"
        return 1
    fi

    if $show_gaps; then
        _display_scenario_gaps "$its_json"
        return
    fi

    # Populate ITS cache for extract_policy_from_scenario
    if ! $show_all; then
        local cache_dir="/tmp/ic-its-cache"
        mkdir -p "$cache_dir"
        echo "$its_json" | jq -r '.scenarios[] | select(.policy_ref != "") | "\(.name)|\(.policy_ref | split("/") | last)|\(if .is_disabled then "disabled" else "active" end)"' > "${cache_dir}/scenarios-${app_filter}" 2>/dev/null
    fi

    local total active disabled conforma
    total=$(echo "$its_json" | jq '.total' 2>/dev/null)
    active=$(echo "$its_json" | jq '.active' 2>/dev/null)
    disabled=$(echo "$its_json" | jq '.disabled' 2>/dev/null)
    conforma=$(echo "$its_json" | jq '.conforma' 2>/dev/null)

    local label="$app_filter"
    $show_all && label="all apps"

    echo ""
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Scenarios — ${label}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""
    echo -e "${CYAN}${total} total, ${active} active, ${disabled} disabled, ${conforma} conforma${NC}"
    echo ""

    printf " ${BOLD}%3s  %-50s  %-9s  %-28s  %-10s${NC}\n" "#" "Scenario" "Status" "Policy" "Type"
    printf " %-3s  %-50s  %-9s  %-28s  %-10s\n" "---" "$(printf '%0.s-' {1..50})" "---------" "$(printf '%0.s-' {1..28})" "----------"

    local idx=0
    while IFS= read -r scenario; do
        local name status policy stype is_disabled is_conforma is_future app

        name=$(echo "$scenario" | jq -r '.name')
        is_disabled=$(echo "$scenario" | jq -r '.is_disabled')
        is_conforma=$(echo "$scenario" | jq -r '.is_conforma')
        is_future=$(echo "$scenario" | jq -r '.is_future')
        policy=$(echo "$scenario" | jq -r '.policy_ref // empty')
        app=$(echo "$scenario" | jq -r '.application')

        if [ "$is_disabled" = "true" ]; then
            $filter_active && continue
            status="${YELLOW}DISABLED${NC}"
        else
            $filter_disabled && continue
            status="${GREEN}active${NC}"
        fi

        if [ "$is_conforma" = "true" ]; then
            stype="conforma"
        else
            stype="other"
        fi
        [ "$is_future" = "true" ] && stype="${stype}+future"

        [ -n "$filter_type" ] && [[ "$stype" != *"$filter_type"* ]] && continue

        # Strip namespace prefix from policy for display
        local policy_short="${policy##*/}"

        idx=$((idx + 1))

        local name_display="$name"
        $show_all && name_display="${CYAN}${app}${NC}/${name}"

        printf " %3d  %-50b  %-18b  %-28s  %-10s\n" "$idx" "$name_display" "$status" "$policy_short" "$stype"
    done < <(echo "$its_json" | jq -c '.scenarios[]')

    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'ic scenarios --active' for active only"
    echo -e "${CYAN}Tip:${NC} Use 'ic scenarios --gaps' to detect missing scenarios"
    echo -e "${CYAN}Tip:${NC} Use 'ic scenarios --all' for all apps"
}

_display_scenario_gaps() {
    local gaps_json="$1"
    local apps_checked common_count gap_count

    apps_checked=$(echo "$gaps_json" | jq '.apps_checked' 2>/dev/null)
    gap_count=$(echo "$gaps_json" | jq '.gaps | length' 2>/dev/null)

    echo ""
    echo -e "${BOLD}========================================${NC}"
    echo -e "${BOLD}Scenario Gaps — ${NAMESPACE}${NC}"
    echo -e "${BOLD}========================================${NC}"
    echo ""
    echo -e "${CYAN}Checked ${apps_checked} applications${NC}"
    echo ""

    local common_types
    common_types=$(echo "$gaps_json" | jq -r '.common_types[]' 2>/dev/null)
    if [ -n "$common_types" ]; then
        echo -e "${BOLD}Common scenario types (present in ≥60% of apps):${NC}"
        while IFS= read -r ct; do
            echo "  • $ct"
        done <<< "$common_types"
        echo ""
    fi

    if [ "$gap_count" = "0" ]; then
        echo -e "${GREEN}No scenario gaps detected.${NC}"
        return
    fi

    echo -e "${BOLD}${gap_count} applications with missing scenarios:${NC}"
    echo ""
    printf " %-30s  %s\n" "Application" "Missing Scenarios"
    printf " %-30s  %s\n" "$(printf '%0.s-' {1..30})" "$(printf '%0.s-' {1..40})"

    while IFS= read -r gap; do
        local gapp missing_list
        gapp=$(echo "$gap" | jq -r '.application')
        missing_list=$(echo "$gap" | jq -r '.missing | join(", ")')
        printf " %-30s  ${YELLOW}%s${NC}\n" "$gapp" "$missing_list"
    done < <(echo "$gaps_json" | jq -c '.gaps[]')

    echo ""
}

cmd_components_health() {
    _release_require_oc || return 1

    section_header "Component Health — ${APPLICATION_NAME}"
    echo ""

    local comps_json
    comps_json=$(oc get components.appstudio.redhat.com -n "$NAMESPACE" -o json 2>/dev/null)

    if [ -z "$comps_json" ] || [ "$(echo "$comps_json" | jq '.items | length' 2>/dev/null)" = "0" ]; then
        echo -e "${YELLOW}No components found in namespace ${NAMESPACE}${NC}"
        return
    fi

    local app_comps
    app_comps=$(echo "$comps_json" | jq -c --arg app "$APPLICATION_NAME" '
        [.items[] | select(.spec.application == $app)]
        | sort_by(.metadata.name)
    ' 2>/dev/null)

    local total
    total=$(echo "$app_comps" | jq 'length' 2>/dev/null || echo "0")
    echo -e "${CYAN}${total} components in ${APPLICATION_NAME}${NC}"
    echo ""

    # Count by build status from DB
    local db_failing
    db_failing=$(sql "SELECT component_name FROM build_failures WHERE application = '${APPLICATION_NAME}' AND is_resolved = FALSE;" 2>/dev/null | tr -d ' ')
    local db_conforma
    db_conforma=$(sql "SELECT DISTINCT component_name FROM conforma_results WHERE application = '${APPLICATION_NAME}' AND is_resolved = FALSE;" 2>/dev/null | tr -d ' ')

    local healthy=0 build_fail=0 conforma_fail=0 both_fail=0

    printf "  %-50s %-12s %-12s %s\n" "Component" "Build" "Conforma" "Image"
    printf "  %-50s %-12s %-12s %s\n" "$(printf '%0.s-' {1..50})" "------------" "------------" "$(printf '%0.s-' {1..40})"

    echo "$app_comps" | jq -c '.[]' 2>/dev/null | while IFS= read -r comp; do
        local name image
        name=$(echo "$comp" | jq -r '.metadata.name')
        image=$(echo "$comp" | jq -r '.spec.containerImage // ""' | sed 's/@sha256:.*//')

        local b_status="✓ OK"
        local b_color="$GREEN"
        if echo "$db_failing" | grep -q "^${name}$"; then
            b_status="✗ Failed"
            b_color="$RED"
        fi

        local c_status="✓ OK"
        local c_color="$GREEN"
        if echo "$db_conforma" | grep -q "^${name}$"; then
            c_status="✗ Failing"
            c_color="$RED"
        fi

        local image_short="${image:0:40}"
        printf "  %-50s " "${name:0:50}"
        echo -ne "${b_color}$(printf '%-12s' "$b_status")${NC} "
        echo -ne "${c_color}$(printf '%-12s' "$c_status")${NC} "
        echo "$image_short"
    done

    echo ""

    # Summary counts — components can have both build AND conforma failures
    local fail_b fail_c
    fail_b=$(echo "$db_failing" | grep -c '[^[:space:]]' 2>/dev/null || echo "0")
    fail_c=$(echo "$db_conforma" | grep -c '[^[:space:]]' 2>/dev/null || echo "0")
    local any_failing
    any_failing=$(echo -e "${db_failing}\n${db_conforma}" | sort -u | grep -c '[^[:space:]]' 2>/dev/null || echo "0")
    local ok_count=$((total - any_failing))
    [ "$ok_count" -lt 0 ] && ok_count=0

    echo -e "${BOLD}Summary:${NC} ${GREEN}${ok_count} healthy${NC}, ${RED}${fail_b} build failures${NC}, ${RED}${fail_c} conforma failures${NC} (of ${total} total)"
    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'ic get alerts' for detailed failure information"
    echo ""
}

