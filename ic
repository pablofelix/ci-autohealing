RELENG_NAMESPACE="${RELENG_NAMESPACE:-}"
SMARTSHEET_API_TOKEN="${SMARTSHEET_API_TOKEN:-${SMARTSHEET_TOKEN:-}}"
SMARTSHEET_GA_SHEET_ID="${SMARTSHEET_GA_SHEET_ID:-}"

_release_app_to_shortname() {
    local app="${1:-$APPLICATION_NAME}"
    local ver="${app#*-v}"
    ver="${ver//-/.}"
    local major minor rest
    IFS='.' read -r major minor rest <<< "$ver"
    if [[ "$rest" == ea.* ]] || [[ "$rest" == ea* ]]; then
        local ea_num="${rest#ea.}"
        ea_num="${ea_num#ea}"
        echo "${APPLICATION_NAME%%-v*}-${major}.${minor}.EA${ea_num}"
    else
        echo "${APPLICATION_NAME%%-v*}-${major}.${minor}"
    fi
}

_release_fetch_smartsheet_dates() {
    local app="${1:-$APPLICATION_NAME}"
    [ -z "$SMARTSHEET_API_TOKEN" ] && return 1
    [ -z "$SMARTSHEET_GA_SHEET_ID" ] && return 1

    local shortname
    shortname=$(_release_app_to_shortname "$app")

    local sheet_data
    sheet_data=$(curl -s -H "Authorization: Bearer $SMARTSHEET_API_TOKEN" \
        "https://api.smartsheet.com/2.0/sheets/${SMARTSHEET_GA_SHEET_ID}" 2>/dev/null)
    [ -z "$sheet_data" ] && return 1

    local dates
    dates=$(echo "$sheet_data" | $PYTHON -c "
import json, sys, re
data = json.load(sys.stdin)
shortname = '${shortname}'
cols = {c['id']: c['title'] for c in data.get('columns', [])}
planning_freeze = feature_freeze = code_freeze = rc = release_window = ga = ''
next_release = ''
# Collect all shortnames to find the next release in sequence
all_shortnames = set()
for row in data.get('rows', []):
    for cell in row.get('cells', []):
        t = cols.get(cell.get('columnId',''), '')
        if t == 'shortname':
            v = cell.get('displayValue') or cell.get('value', '')
            if v: all_shortnames.add(v)
# Parse version for ordering
def parse_ver(sn):
    m = re.match(r'[a-z]+-(\d+)\.(\d+)(?:\.EA(\d+))?', sn)
    if not m: return (0, 0, 999)
    ea = int(m.group(3)) if m.group(3) else 999
    return (int(m.group(1)), int(m.group(2)), ea)
sorted_sns = sorted(all_shortnames, key=parse_ver)
try:
    idx = sorted_sns.index(shortname)
    if idx + 1 < len(sorted_sns):
        next_release = sorted_sns[idx + 1]
except ValueError:
    pass
for row in data.get('rows', []):
    vals = {}
    for cell in row.get('cells', []):
        t = cols.get(cell.get('columnId',''), '')
        v = cell.get('displayValue') or cell.get('value', '')
        if v: vals[t] = v
    sn = vals.get('shortname', '')
    name = vals.get('Task Name', '')
    flags = vals.get('Flags', '')
    if sn != shortname:
        continue
    start = vals.get('Start', '')[:10]
    nl = name.lower()
    if 'planning freeze' in nl:
        planning_freeze = start
    elif 'feature freeze' in nl:
        feature_freeze = start
    elif 'code freeze' in nl:
        code_freeze = start
    elif 'initial rc' in nl:
        rc = start
    elif 'release window' in nl:
        release_window = start
    elif 'GA' in flags and ('RELEASE' in name or 'RHOAI GA' in name):
        ga = start
print(f'{planning_freeze}|{feature_freeze}|{code_freeze}|{rc}|{release_window}|{ga}|{next_release}')
" 2>/dev/null)
    [ -z "$dates" ] && return 1

    local planning_freeze feature_freeze code_freeze rc release_window ga next_release
    IFS='|' read -r planning_freeze feature_freeze code_freeze rc release_window ga next_release <<< "$dates"

    if [ -n "$code_freeze" ] || [ -n "$rc" ] || [ -n "$ga" ]; then
        sql_upsert_release_schedule "$app" "$planning_freeze" "$feature_freeze" \
            "$code_freeze" "$rc" "$release_window" "$ga" "$next_release" \
            "$SMARTSHEET_GA_SHEET_ID" >/dev/null 2>&1
        echo "${planning_freeze}|${feature_freeze}|${code_freeze}|${rc}|${release_window}|${ga}|${next_release}"
    fi
}

_release_get_schedule() {
    local app="${1:-$APPLICATION_NAME}"

    local cached
    cached=$(sql_get_release_schedule "$app" 2>/dev/null)
    if [ -n "$cached" ]; then
        local pf ff cf rc rw rd nr updated
        IFS='|' read -r pf ff cf rc rw rd nr updated <<< "$cached"
        pf=$(trim "$pf"); ff=$(trim "$ff"); cf=$(trim "$cf")
        rc=$(trim "$rc"); rw=$(trim "$rw"); rd=$(trim "$rd")
        nr=$(trim "$nr")
        echo "${pf}|${ff}|${cf}|${rc}|${rw}|${rd}|${nr}"
