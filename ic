_release_classify() {
    local plan="$1"
    local target="unknown" type="unknown"

    case "$plan" in
        *-components-stage) target="stage"; type="components" ;;
        *-components-prod)  target="prod";  type="components" ;;
        *-charts-stage)     target="stage"; type="charts" ;;
        *-charts-prod)      target="prod";  type="charts" ;;
        *-addon-*-fbc-stage) target="stage"; type="fbc-addon" ;;
        *-addon-*-fbc-prod)  target="prod";  type="fbc-addon" ;;
        *-ocp-*-fbc-stage)
            target="stage"
            local ocp_ver
            ocp_ver=$(echo "$plan" | grep -oP 'ocp-\K\d+')
            type="fbc-${ocp_ver}"
            ;;
        *-ocp-*-fbc-prod)
            target="prod"
            local ocp_ver
            ocp_ver=$(echo "$plan" | grep -oP 'ocp-\K\d+')
            type="fbc-${ocp_ver}"
            ;;
    esac
    echo "${target}|${type}"
}

_release_type_label() {
    local type="$1"
    case "$type" in
        components) echo "Components" ;;
        charts)     echo "Charts" ;;
        fbc-addon)  echo "FBC Addon" ;;
        fbc-*)      local ver="${type#fbc-}"
                    local major="${ver:0:1}" minor="${ver:1}"
                    echo "FBC OCP ${major}.${minor}" ;;
        *)          echo "$type" ;;
    esac
}

_release_discover_steps() {
    local app="$APPLICATION_NAME"
    local plans
    local version_suffix="${app#*-}"
    plans=$(oc get releaseplans -n "$NAMESPACE" -o custom-columns='NAME:.metadata.name' --no-headers 2>/dev/null \
        | grep "^${APPLICATION_NAME%%-v*}-.*${version_suffix}" | sort)
    if [[ "$version_suffix" != *-ea-* ]]; then
        plans=$(echo "$plans" | grep -v '\-ea-')
    fi

    local has_stage_charts=false has_prod_charts=false
    local has_stage_addon=false has_prod_addon=false
    local stage_ocp_versions="" prod_ocp_versions=""

    while IFS= read -r plan; do
        [ -z "$plan" ] && continue
        case "$plan" in
            *-components-stage) ;;
            *-components-prod)  ;;
            *-charts-stage) has_stage_charts=true ;;
            *-charts-prod)  has_prod_charts=true ;;
            *-addon-*-fbc-stage) has_stage_addon=true ;;
            *-addon-*-fbc-prod)  has_prod_addon=true ;;
            *-ocp-*-fbc-stage)
                local ver
                ver=$(echo "$plan" | grep -oP 'ocp-\K\d+')
                stage_ocp_versions="${stage_ocp_versions} ${ver}"
                ;;
            *-ocp-*-fbc-prod)
                local ver
                ver=$(echo "$plan" | grep -oP 'ocp-\K\d+')
                prod_ocp_versions="${prod_ocp_versions} ${ver}"
                ;;
        esac
    done <<< "$plans"

    stage_ocp_versions=$(echo "$stage_ocp_versions" | tr ' ' '\n' | sort -n | uniq | tr '\n' ' ')
    prod_ocp_versions=$(echo "$prod_ocp_versions" | tr ' ' '\n' | sort -n | uniq | tr '\n' ' ')

    echo "stage|components"
    [ "$has_stage_charts" = true ] && echo "stage|charts"
    for ver in $stage_ocp_versions; do
        echo "stage|fbc-${ver}"
    done
    [ "$has_stage_addon" = true ] && echo "stage|fbc-addon"

    echo "prod|components"
    [ "$has_prod_charts" = true ] && echo "prod|charts"
    for ver in $prod_ocp_versions; do
        echo "prod|fbc-${ver}"
    done
    [ "$has_prod_addon" = true ] && echo "prod|fbc-addon"
    return 0
}

_release_name_prefix() {
    local app="$APPLICATION_NAME" target="$1" type="$2"
    case "$type" in
        components)
            echo "${app}-${target}" ;;
        charts)
            echo "${app}-charts-${target}" ;;
        fbc-addon)
            local ocp_ver
            ocp_ver=$(oc get releaseplans -n "$NAMESPACE" -o custom-columns='NAME:.metadata.name' --no-headers 2>/dev/null \
                | grep "addon.*${app#*-v}.*fbc-${target}" | grep -oP 'ocp-\K\d+' | head -1)
            echo "${APPLICATION_NAME%%-v*}-fbc-addon-ocp-${ocp_ver:-419}-${target}" ;;
        fbc-*)
            local ver="${type#fbc-}"
            echo "${APPLICATION_NAME%%-v*}-fbc-fragment-ocp-${ver}-${target}" ;;
    esac
}

_release_pipeline_ui_url() {
    local pipeline_ref="$1"
    local ns="${pipeline_ref%%/*}"
    local pr_name="${pipeline_ref##*/}"
    [ -z "$ns" ] && ns="$RELENG_NAMESPACE"
    echo "${KONFLUX_UI_BASE}/ns/${ns}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}"
