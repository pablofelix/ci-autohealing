cmd_config_set_app() {
    local new_app="$1"
    local force=false
    [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]] && force=true

    if [ -z "$new_app" ]; then
        echo -e "${RED}Error: Application name required${NC}"
        echo "Usage: ic config set-app <app-name>"
        echo ""
        cmd_get_apps
        return 1
    fi

    # Validate against cluster if reachable
    if oc whoami &>/dev/null; then
        if ! oc get application "$new_app" -n "$NAMESPACE" &>/dev/null; then
            echo -e "${RED}Error: Application '$new_app' not found in namespace $NAMESPACE${NC}"
            echo ""
            cmd_get_apps
            return 1
        fi
    else
        # Cluster unreachable — validate against DB
        local in_db=$(sql "SELECT COUNT(*) FROM build_failures WHERE application = '$new_app';" 2>/dev/null)
        if [ "${in_db:-0}" = "0" ] && [ "$force" != true ]; then
            echo -e "${YELLOW}⚠ Cluster unreachable${NC}"
            echo -e "${RED}Error: Application '$new_app' not found in database${NC}"
            echo ""
            cmd_get_apps
            echo -e "${CYAN}Use --force to set anyway:${NC} ic config set-app $new_app --force"
            echo ""
            return 1
        elif [ "${in_db:-0}" = "0" ]; then
            echo -e "${YELLOW}⚠ Cluster unreachable, application not in database — setting anyway${NC}"
        fi
    fi

    local env_file="$SCRIPT_DIR/.env"
    touch "$env_file"
    if grep -q "^APPLICATION_NAME=" "$env_file" 2>/dev/null; then
        sed -i "s/^APPLICATION_NAME=.*/APPLICATION_NAME=$new_app/" "$env_file"
    else
        echo "APPLICATION_NAME=$new_app" >> "$env_file"
    fi

    APPLICATION_NAME="$new_app"
    export APPLICATION_NAME

    echo -e "${GREEN}✓ Application set to: ${CYAN}${new_app}${NC}"
    # Check if we have cached data for this app
    local has_cache=$(sql "SELECT COUNT(*) FROM sync_status WHERE application = '$new_app';" 2>/dev/null)
    if [ "$has_cache" = "0" ] || [ -z "$has_cache" ]; then
        echo -e "  No cached data yet. Run ${CYAN}ic get components -r${NC} to sync."
    else
        echo -e "  Cached sync data available. Run ${CYAN}ic get components${NC} to view."
    fi
    echo ""
}

