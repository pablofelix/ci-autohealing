    fi

    section_header "AI Analysis"
    echo ""
    echo "$json_output"
}

cmd_ai_analyze_scenarios() {
    local app_arg=""
    local ns_arg="--namespace $NAMESPACE"
    local analyze_all=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)  analyze_all=true; shift ;;
            --app)  app_arg="--app $2"; shift 2 ;;
            *)
                # If arg looks like a scenario name, warn the user
                if [[ "$1" == conforma-* ]] || [[ "$1" == *-single-component ]] || [[ "$1" == *-enterprise-contract ]]; then
                    echo -e "${YELLOW}\"$1\" looks like a scenario name, not an application.${NC}"
                    echo -e "${CYAN}This command analyzes all scenarios for an application.${NC}"
                    echo ""
                    echo "Usage: ic ai analyze scenarios [--app <app-name>]"
                    echo "       ic ai analyze scenarios              # current app ($APPLICATION_NAME)"
                    echo "       ic ai analyze scenarios --app my-app-v3-4"
                    return 1
                fi
                app_arg="--app $1"; shift ;;
        esac
    done

    # Default to current application unless --all
    if [ -z "$app_arg" ] && ! $analyze_all; then
        app_arg="--app $APPLICATION_NAME"
    fi

    # Check if LLM is configured
    if [ -z "$LLM_PROVIDER" ] && [ -z "$ANTHROPIC_VERTEX_PROJECT_ID" ]; then
        echo -e "${RED}Error: LLM not configured${NC}"
        echo ""
        echo "Set LLM provider in .env or environment:"
        echo "  export LLM_PROVIDER=vertex_ai"
        echo "  export ANTHROPIC_VERTEX_PROJECT_ID=your-project-id"
        return 1
    fi

    echo -e "${CYAN}Analyzing ITS scenario configuration: ${app_arg#--app }${NC}"
    echo ""

    cd "$SCRIPT_DIR/src" || return 1

    local log_file
    log_file=$(mktemp)
    local output
    output=$($PYTHON analyze_scenarios.py $app_arg $ns_arg 2>"$log_file")
    local exit_code=$?

    if [ -s "$log_file" ]; then
        grep -E "Fetching|Found|Analysis complete|Severity" "$log_file" | sed 's/^.*INFO - /  /' || true
        echo ""
    fi

    if [ $exit_code -ne 0 ]; then
        echo -e "${RED}Analysis failed${NC}"
        tail -10 "$log_file"
        rm -f "$log_file"
        return 1
    fi
    rm -f "$log_file"

    local json_output
    json_output=$(printf '%s\n' "$output" | $PYTHON -c "
import sys, json
data = json.load(sys.stdin)

if not data.get('analyzed'):
    print('No scenarios found to analyze')
    sys.exit(0)

a = data.get('analysis', {})
severity = a.get('severity', 'info').upper()
issues = a.get('issues_count', 0)
conf = int(a.get('confidence_score', 0) * 100)
model = data.get('model', 'unknown')
cost = data.get('cost_usd', 0)
count = data.get('scenarios_count', 0)

print('Scenarios:      {}'.format(count))
print('Severity:       {}'.format(severity))
print('Issues Found:   {}'.format(issues))
print('Confidence:     {}%'.format(conf))
print('Model:          {}'.format(model))
print('Cost:           \${:.4f}'.format(cost))
print()
print('Findings:')
for line in a.get('findings', '').split('\n'):
    print('  ' + line)
print()
print('Recommendations:')
for line in a.get('recommendations', '').split('\n'):
    print('  ' + line)
" 2>/dev/null)

    if [ $? -ne 0 ]; then
        echo "$output"
        return 0
    fi

    section_header "AI Scenario Analysis"
    echo ""
    echo "$json_output"
    echo ""
}

cmd_ai_batch() {
    local flags=""
