cmd_patterns_list() {
    local type_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --type) type_filter="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local where="TRUE"
    if [ -n "$type_filter" ]; then
        where="failure_type = '$type_filter'"
    fi

    section_header "Error Pattern Library"
    echo ""
    sql_table "
        SELECT
            failure_type   AS \"Type\",
            failure_category AS \"Category\",
            occurrence_count AS \"Seen\",
            CASE
                WHEN avg_confidence IS NULL THEN '  —  '
                ELSE ROUND(avg_confidence * 100)::text || '%'
            END AS \"Avg Conf\",
            CASE
                WHEN doc_context IS NOT NULL THEN 'yes'
                ELSE 'no '
            END AS \"Doc\",
            CASE
                WHEN last_seen_at IS NULL THEN '—'
                ELSE TO_CHAR(last_seen_at, 'YYYY-MM-DD')
            END AS \"Last Seen\",
            LEFT(pattern_name, 40) AS \"Pattern\"
        FROM error_patterns
        WHERE $where
        ORDER BY occurrence_count DESC, failure_type, failure_category;
    "
    echo ""
    local total
    total=$(sql "SELECT COUNT(*) FROM error_patterns WHERE $where;" 2>/dev/null)
    printf "  %s patterns total. Run 'ic patterns show <pattern_name>' for details.\n" "${total:-0}"
    echo ""
}

cmd_patterns_show() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "Usage: ic patterns show <pattern_name>"
        return 1
    fi

    local row
    row=$(sql "SELECT id, failure_type, failure_category, pattern_name, description, typical_fix, doc_url, doc_context, doc_fetched_at, occurrence_count, avg_confidence, first_seen_at, last_seen_at, created_by FROM error_patterns WHERE pattern_name = '$name' OR failure_category = '$name' LIMIT 1;" 2>/dev/null)
    if [ -z "$row" ]; then
        echo "Pattern not found: $name"
        echo "Run 'ic patterns list' to see all patterns."
        return 1
    fi

    local id type category pname description typical_fix doc_url doc_context doc_fetched_at occurrences avg_conf first_seen last_seen created_by
    IFS='|' read -r id type category pname description typical_fix doc_url doc_context doc_fetched_at occurrences avg_conf first_seen last_seen created_by <<< "$row"

    section_header "Pattern: $pname"
    echo ""
    printf "  Type:          %s\n" "$type"
    printf "  Category:      %s\n" "$category"
    printf "  Created by:    %s\n" "$created_by"
    printf "  Occurrences:   %s\n" "${occurrences:-0}"
    if [ -n "$avg_conf" ]; then
        printf "  Avg confidence: %s%%\n" "$(echo "$avg_conf * 100" | bc -l 2>/dev/null | cut -d. -f1)"
    fi
    printf "  First seen:    %s\n" "${first_seen:-—}"
    printf "  Last seen:     %s\n" "${last_seen:-—}"
    echo ""

    if [ -n "$description" ]; then
        echo -e "${BOLD}Description:${NC}"
        echo "$description" | fold -s -w 80 | sed 's/^/  /'
        echo ""
    fi

    if [ -n "$typical_fix" ]; then
        echo -e "${BOLD}Typical Fix:${NC}"
        echo "$typical_fix" | fold -s -w 80 | sed 's/^/  /'
        echo ""
    fi

    if [ -n "$doc_url" ]; then
        printf "  Doc URL:       %s\n" "$doc_url"
        if [ -n "$doc_fetched_at" ]; then
            printf "  Doc fetched:   %s\n" "$doc_fetched_at"
        else
            echo "  Doc context:   not yet fetched (run collect_doc_context.py)"
        fi
    fi

    if [ -n "$doc_context" ]; then
        echo ""
        echo -e "${BOLD}Documentation Excerpt:${NC}"
        echo "$doc_context" | head -20 | fold -s -w 80 | sed 's/^/  /'
        local doc_lines
        doc_lines=$(echo "$doc_context" | wc -l)
        if [ "$doc_lines" -gt 20 ]; then
            echo "  ... (truncated, ${doc_lines} lines total)"
        fi
    fi
    echo ""
}

