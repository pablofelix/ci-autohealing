print()
print('Root Cause:')
for line in data.get('root_cause', '').split('\n'):
    print('  ' + line)
print()
print('Recommended Fix:')
for line in data.get('recommended_fix', '').split('\n'):
    print('  ' + line)

files = data.get('recommended_files', [])
if files:
