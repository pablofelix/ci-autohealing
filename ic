cmd_ai_analyze() {
    local target=""
    local force=false
    local component=""
    local analysis_type=""  # "build", "conforma", or "" (auto-detect)

    # Parse arguments - first arg is either number, "component", "conforma", or "--all"
    if [ $# -eq 0 ]; then
        echo -e "${RED}Error: Missing argument${NC}"
        echo "Usage: ic ai analyze <num|component> [--force]"
        echo "       ic ai analyze conforma <component> [--force]"
        echo "       ic ai analyze --all"
        return 1
    fi

    # Parse first argument
    if [ "$1" = "--all" ]; then
        target="all"
        shift
    elif [ "$1" = "conforma" ]; then
        analysis_type="conforma"
        shift
        component="$1"
        shift
    elif [ "$1" = "component" ]; then
        shift
        component="$1"
        shift
    elif [[ "$1" =~ ^[0-9]+$ ]]; then
        target="$1"
        shift
    else
        component="$1"
        shift
    fi

    # Parse remaining flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force)
                force=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    # Check if LLM is configured
    if [ -z "$LLM_PROVIDER" ] && [ -z "$ANTHROPIC_VERTEX_PROJECT_ID" ]; then
        echo -e "${RED}Error: LLM not configured${NC}"
        echo ""
        echo "Set LLM provider in .env or environment:"
        echo "  export LLM_PROVIDER=vertex_ai"
        echo "  export ANTHROPIC_VERTEX_PROJECT_ID=your-project-id"
        echo "  export CLOUD_ML_REGION=us-east5"
        echo ""
        echo "Or for direct Anthropic API:"
        echo "  export LLM_PROVIDER=anthropic"
        echo "  export ANTHROPIC_API_KEY=sk-ant-..."
        return 1
    fi

    cd "$SCRIPT_DIR/collectors/python" || return 1

    if [ "$target" = "all" ]; then
        echo -e "${CYAN}Analyzing all pending failures and violations...${NC}"
        echo ""

        # Analyze build failures
        echo -e "${BOLD}Build Failures:${NC}"
        python3.11 analyze_failures.py
        local build_result=$?

        echo ""

        # Analyze Conforma violations
        echo -e "${BOLD}Conforma Violations:${NC}"
        python3.11 analyze_conforma.py
        local conforma_result=$?

        # Return success if either succeeded
        if [ "$build_result" -eq 0 ] || [ "$conforma_result" -eq 0 ]; then
            return 0
        else
            return 1
        fi
    fi

    # Resolve component name and type from alert number if needed
    if [ -z "$component" ] && [ -n "$target" ]; then
        # Count build failures first
        local build_count=$(sql "
            SELECT COUNT(*) FROM (
                SELECT DISTINCT ON (component_name) component_name
                FROM build_failures
                WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
                ORDER BY component_name, first_detected_at DESC
            ) sub;
        " 2>/dev/null)
        build_count=${build_count:-0}

        # If number falls in build failures range
        if [ "$target" -le "$build_count" ]; then
            analysis_type="build"
            local retriggered_json=$(sql_get_retriggered_json)
            component=$(sql_resolve_build_number "$target" "${retriggered_json:-[]}")
        else
            # Falls in Conforma range
            analysis_type="conforma"
            local conforma_offset=$((target - build_count - 1))
            component=$(sql_resolve_conforma_number "$conforma_offset")
        fi
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component not found${NC}"
        return 1
    fi

    # Auto-detect type if not already set
    if [ -z "$analysis_type" ]; then
        local has_build=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)
        local has_conforma=$(sql "SELECT COUNT(*) FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)

        if [ "${has_build:-0}" -gt 0 ]; then
            analysis_type="build"
        elif [ "${has_conforma:-0}" -gt 0 ]; then
            analysis_type="conforma"
        else
            echo -e "${RED}Error: No unresolved failures found for component: $component${NC}"
            return 1
        fi
    fi

    # Check if already analyzed (based on type)
    if [ "$force" = false ]; then
        local exists=0
        if [ "$analysis_type" = "build" ]; then
            exists=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.component_name = '$component' AND b.is_resolved = FALSE AND b.application = '$APPLICATION_NAME';" 2>/dev/null)
        else
            exists=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.component_name = '$component' AND c.is_resolved = FALSE AND c.application = '$APPLICATION_NAME';" 2>/dev/null)
        fi

        if [ "${exists:-0}" -gt 0 ]; then
            echo -e "${YELLOW}Component $component already analyzed${NC}"
            echo ""
            echo "Use --force to re-analyze:"
            if [ "$analysis_type" = "build" ]; then
                echo "  ic ai analyze component $component --force"
            else
                echo "  ic ai analyze conforma $component --force"
            fi
            echo ""
            echo "Or view existing analysis:"
            if [ "$analysis_type" = "build" ]; then
                echo "  ic describe component $component"
            else
                echo "  ic describe conforma $component"
            fi
            return 0
        fi
    fi

    # Run appropriate analyzer
    if [ "$analysis_type" = "build" ]; then
        echo -e "${CYAN}Analyzing build failure: $component${NC}"
        echo ""
        python3.11 analyze_failures.py --component "$component"
    else
        echo -e "${CYAN}Analyzing Conforma violation: $component${NC}"
        echo ""
        python3.11 analyze_conforma.py --component "$component"
    fi
}

cmd_ai_status() {
    section_header "AI Analysis Status"
    echo ""

    # Build failures stats
    local build_pending=$(sql "SELECT COUNT(*) FROM build_failures WHERE ai_analyzed = FALSE AND is_resolved = FALSE AND build_logs IS NOT NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local build_analyzed=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.application = '$APPLICATION_NAME' AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local build_autofixable=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN build_failures b ON a.build_failure_id = b.id WHERE b.application = '$APPLICATION_NAME' AND a.can_auto_fix = TRUE AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    # Conforma violations stats
    local conforma_pending=$(sql "SELECT COUNT(*) FROM conforma_results WHERE ai_analyzed = FALSE AND is_resolved = FALSE AND violation_summary IS NOT NULL AND application = '$APPLICATION_NAME';" 2>/dev/null)
    local conforma_analyzed=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.application = '$APPLICATION_NAME' AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local conforma_autofixable=$(sql "SELECT COUNT(*) FROM ai_analysis a JOIN conforma_results c ON a.conforma_result_id = c.id WHERE c.application = '$APPLICATION_NAME' AND a.can_auto_fix = TRUE AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    # Total cost (both types)
    local total_cost=$(sql "
        SELECT COALESCE(SUM(a.cost_usd), 0)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    echo -e "${BOLD}Build Failures:${NC}"
    printf "  Pending:      %s failures awaiting analysis\n" "${build_pending:-0}"
    printf "  Analyzed:     %s failures (last 30 days)\n" "${build_analyzed:-0}"

    if [ "${build_analyzed:-0}" -gt 0 ]; then
        local build_pct=$((build_autofixable * 100 / build_analyzed))
        printf "  Auto-fixable: %s failures (%s%%)\n" "${build_autofixable:-0}" "$build_pct"
    else
        printf "  Auto-fixable: 0 failures\n"
    fi

    echo ""
    echo -e "${BOLD}Conforma Violations:${NC}"
    printf "  Pending:      %s violations awaiting analysis\n" "${conforma_pending:-0}"
    printf "  Analyzed:     %s violations (last 30 days)\n" "${conforma_analyzed:-0}"

    if [ "${conforma_analyzed:-0}" -gt 0 ]; then
        local conforma_pct=$((conforma_autofixable * 100 / conforma_analyzed))
        printf "  Auto-fixable: %s violations (%s%%)\n" "${conforma_autofixable:-0}" "$conforma_pct"
    else
        printf "  Auto-fixable: 0 violations\n"
    fi

    echo ""
    printf "${BOLD}Total cost:${NC}   \$%.2f (last 30 days)\n" "${total_cost:-0}"
    echo ""

    # Show recent analyses (both types)
    local recent_count=$(sql "
        SELECT COUNT(*)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '7 days';" 2>/dev/null)

    if [ "${recent_count:-0}" -gt 0 ]; then
        echo -e "${BOLD}Recent analyses (last 7 days):${NC}"
        sql_table "
            SELECT
                ROW_NUMBER() OVER (ORDER BY a.analyzed_at DESC) as \"#\",
                COALESCE(b.component_name, c.component_name) as \"Component\",
                CASE
                    WHEN a.build_failure_id IS NOT NULL THEN 'Build'
                    ELSE 'Conforma'
                END as \"Type\",
                a.failure_category as \"Category\",
                ROUND(a.confidence_score * 100) || '%' as \"Confidence\",
                CASE WHEN a.can_auto_fix THEN '✓' ELSE '✗' END as \"Fixable\"
            FROM ai_analysis a
            LEFT JOIN build_failures b ON a.build_failure_id = b.id
            LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
            WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
              AND a.analyzed_at > NOW() - INTERVAL '7 days'
            ORDER BY a.analyzed_at DESC
            LIMIT 10;
        "
        echo ""
    fi

    local total_pending=$((build_pending + conforma_pending))
    if [ "$total_pending" -gt 0 ]; then
        echo -e "${CYAN}Run 'ic ai analyze --all' to analyze pending failures and violations${NC}"
    else
        echo -e "${GREEN}✓ No pending failures or violations to analyze${NC}"
    fi
    echo ""
}

cmd_ai_stats() {
    section_header "AI Analysis Statistics"
    echo ""

    # By category and type
    echo -e "${BOLD}Analyses by Category (last 30 days):${NC}"
    sql_table "
        SELECT
            CASE
                WHEN a.build_failure_id IS NOT NULL THEN 'Build'
                ELSE 'Conforma'
            END as \"Type\",
            a.failure_category as \"Category\",
            COUNT(*) as \"Count\",
            ROUND(AVG(a.confidence_score * 100)) || '%' as \"Avg Confidence\",
            SUM(CASE WHEN a.can_auto_fix THEN 1 ELSE 0 END) as \"Auto-fixable\"
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days'
        GROUP BY
            CASE WHEN a.build_failure_id IS NOT NULL THEN 'Build' ELSE 'Conforma' END,
            a.failure_category
        ORDER BY COUNT(*) DESC;
    "
    echo ""

    # By date
    echo -e "${BOLD}Analyses by Date (last 7 days):${NC}"
    sql_table "
        SELECT
            DATE(a.analyzed_at) as \"Date\",
            COUNT(*) as \"Analyzed\",
            SUM(CASE WHEN a.can_auto_fix THEN 1 ELSE 0 END) as \"Auto-fixable\",
            COALESCE(SUM(a.cost_usd), 0)::numeric(10,2) as \"Cost USD\"
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '7 days'
        GROUP BY DATE(a.analyzed_at)
        ORDER BY DATE(a.analyzed_at) DESC;
    "
    echo ""

    # Token usage (both types)
    local total_tokens=$(sql "
        SELECT COALESCE(SUM(a.tokens_used), 0)
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)
    local avg_tokens=$(sql "
        SELECT COALESCE(AVG(a.tokens_used), 0)::int
        FROM ai_analysis a
        LEFT JOIN build_failures b ON a.build_failure_id = b.id
        LEFT JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE (b.application = '$APPLICATION_NAME' OR c.application = '$APPLICATION_NAME')
          AND a.analyzed_at > NOW() - INTERVAL '30 days';" 2>/dev/null)

    echo -e "${BOLD}Token Usage (last 30 days):${NC}"
    printf "  Total tokens: %s\n" "${total_tokens:-0}"
    printf "  Avg per analysis: %s tokens\n" "${avg_tokens:-0}"
    echo ""
}

# Part 3: Export commands
calculate_priority() {
    local occurrence_count=$1
    local days_failing=$2
    local confidence=$3
    local can_auto_fix=$4

    if [ "${occurrence_count:-0}" -gt 10 ] 2>/dev/null || [ "${days_failing:-0}" -gt 7 ] 2>/dev/null; then
        echo "P1"
    elif [ "$can_auto_fix" = "t" ] && [ "$(echo "$confidence >= 0.9" | bc -l 2>/dev/null || echo 0)" -eq 1 ]; then
        echo "P2"
    else
        echo "P3"
    fi
}

calculate_risk() {
    local requires_review=$1
    local can_auto_fix=$2
    local confidence=$3

    if [ "$requires_review" = "t" ]; then
        echo "HIGH"
    elif [ "$can_auto_fix" = "f" ]; then
        echo "MEDIUM"
    elif [ "$(echo "$confidence < 0.7" | bc -l 2>/dev/null || echo 0)" -eq 1 ]; then
        echo "MEDIUM"
    else
        echo "LOW"
    fi
}

estimate_fix_time() {
    local category=$1
    case "$category" in
        dependency_issue) echo "5-15 min" ;;
        config_error) echo "10-20 min" ;;
        build_error) echo "20-45 min" ;;
        test_failure) echo "30-60 min" ;;
        resource_limit) echo "15-30 min" ;;
        infrastructure) echo "1-2 hours" ;;
        *) echo "30-60 min" ;;
    esac
}

cmd_export() {
    local target="$1"
    local export_type=""  # "build", "conforma", or "" (auto-detect)

    # Handle "component <name>" and "conforma <name>" syntax
    if [ "$target" = "component" ]; then
        export_type="build"
        target="$2"
        shift
    elif [ "$target" = "conforma" ]; then
        export_type="conforma"
        target="$2"
        shift
    fi
    local format="$2"
    shift 2

    case "$format" in
        jira)
            export_jira "$target" "$export_type" "$@"
            ;;
        markdown)
            export_markdown "$target" "$export_type" "$@"
            ;;
        json)
            export_json "$target" "$export_type" "$@"
            ;;
        slack)
            export_slack "$target" "$export_type" "$@"
            ;;
        *)
            echo -e "${BOLD}IC Export - Export AI Analysis to Ticket Formats${NC}"
            echo ""
            echo "Usage: ic export <num|component> {jira|markdown|json|slack} [--clipboard]"
            echo "       ic export conforma <component> {jira|markdown|json|slack} [--clipboard]"
            echo ""
            echo "Formats:"
            echo "  jira       Jira markup format"
            echo "  markdown   GitHub Issues / Markdown"
            echo "  json       JSON for automation"
            echo "  slack      Slack message format"
            echo ""
            echo "Options:"
            echo "  --clipboard  Copy to clipboard (macOS: pbcopy, Linux: xclip)"
            echo ""
            echo "Examples:"
            echo "  ic export 1 jira                        # Print Jira ticket"
            echo "  ic export 1 jira --clipboard            # Copy to clipboard"
            echo "  ic export component acme-automl-v3-4 markdown"
            echo "  ic export conforma acme-autorag-v3-4 jira"
            return 1
            ;;
    esac
}

export_jira() {
    local target="$1"
    local export_type="$2"  # "build", "conforma", or "" (auto-detect)
    local clipboard=false

    # Check if second/third arg is --clipboard
    if [ "$2" = "--clipboard" ] || [ "$3" = "--clipboard" ]; then
        clipboard=true
    fi

    # Get component name and detect type
    local component=""
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        # Number - resolve to component and detect type (same logic as cmd_describe_by_number)
        local build_count=$(sql "
            SELECT COUNT(*) FROM (
                SELECT DISTINCT ON (component_name) component_name
                FROM build_failures
                WHERE application = '$APPLICATION_NAME' AND is_resolved = FALSE
                ORDER BY component_name, first_detected_at DESC
            ) sub;
        " 2>/dev/null)
        build_count=${build_count:-0}

        # If number falls in build failures range
        if [ "$target" -le "$build_count" ]; then
            export_type="build"
            local retriggered_json=$(sql_get_retriggered_json)
            component=$(sql_resolve_build_number "$target" "${retriggered_json:-[]}")
        else
            # Falls in Conforma range
            export_type="conforma"
            local conforma_offset=$((target - build_count - 1))
            component=$(sql_resolve_conforma_number "$conforma_offset")
        fi
    else
        component="$target"
    fi

    if [ -z "$component" ]; then
        echo -e "${RED}Error: Component not found${NC}"
        return 1
    fi

    # Auto-detect type if not already set
    if [ -z "$export_type" ]; then
        local has_build=$(sql "SELECT COUNT(*) FROM build_failures WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)
        local has_conforma=$(sql "SELECT COUNT(*) FROM conforma_results WHERE component_name = '$component' AND application = '$APPLICATION_NAME' AND is_resolved = FALSE;" 2>/dev/null)

        if [ "${has_build:-0}" -gt 0 ]; then
            export_type="build"
        elif [ "${has_conforma:-0}" -gt 0 ]; then
            export_type="conforma"
        else
            echo -e "${RED}Error: No unresolved failures found for component: $component${NC}"
            return 1
        fi
    fi

    # Delegate to appropriate export function
    if [ "$export_type" = "conforma" ]; then
        export_conforma_jira "$component" "$clipboard"
        return $?
    fi

    # Fetch build failure data (latest failure for component)
    local data=$(sql "
        SELECT b.component_name, b.pipelinerun_name, b.error_message,
               b.repository_url, b.branch, b.commit_sha, b.commit_message,
               b.commit_author, b.commit_url,
               TO_CHAR(b.first_detected_at, 'YYYY-MM-DD HH24:MI'),
               TO_CHAR(b.last_updated_at, 'YYYY-MM-DD HH24:MI'),
               EXTRACT(DAY FROM (NOW() - b.first_detected_at))::int as days_failing,
               (SELECT COUNT(*) FROM build_failures WHERE component_name = b.component_name AND is_resolved = FALSE) as occurrence_count,
               COALESCE(b.konflux_logs_url, b.konflux_url),
               b.failed_step_name, b.error_type
        FROM build_failures b
        WHERE b.component_name = '$component'
          AND b.is_resolved = FALSE
          AND b.application = '$APPLICATION_NAME'
        ORDER BY b.last_updated_at DESC
        LIMIT 1;
    " 2>/dev/null)

    if [ -z "$data" ]; then
        echo -e "${RED}Error: No failure data found for component: $component${NC}"
        return 1
    fi

    # Collapse newlines within fields (SQL returns multi-line text in commit messages, error messages)
    local data_oneline=$(echo "$data" | tr '\n' ' ' | sed 's/  */ /g')
    IFS='|' read -r comp_name pr_name error_msg repo_url branch commit_sha commit_msg \
        commit_author commit_url first_seen last_seen days_failing occurrence_count \
        konflux_url failed_step error_type <<< "$data_oneline"

    comp_name=$(trim "$comp_name"); pr_name=$(trim "$pr_name")
    error_msg=$(trim "$error_msg"); error_type=$(trim "$error_type")
    failed_step=$(trim "$failed_step"); commit_sha=$(trim "$commit_sha")
    commit_author=$(trim "$commit_author"); branch=$(trim "$branch")
    repo_url=$(trim "$repo_url"); commit_url=$(trim "$commit_url")
    commit_msg=$(trim "$commit_msg"); first_seen=$(trim "$first_seen")
    last_seen=$(trim "$last_seen"); days_failing=$(trim "$days_failing")
    occurrence_count=$(trim "$occurrence_count")

    # Fetch AI analysis separately (most recent for any failure of this component)
    local ai_data=$(sql "
        SELECT a.failure_category, ROUND(a.confidence_score * 100),
               a.root_cause, a.recommended_fix, a.recommended_files,
               a.can_auto_fix, a.requires_human_review,
               TO_CHAR(a.analyzed_at, 'YYYY-MM-DD HH24:MI:SS'),
               a.langfuse_trace_url, a.model_used
        FROM ai_analysis a
        JOIN build_failures b ON a.build_failure_id = b.id
        WHERE b.component_name = '$component'
        ORDER BY a.analyzed_at DESC
        LIMIT 1;
    " 2>/dev/null)

    local category="" confidence="" root_cause="" recommended_fix="" recommended_files=""
    local can_auto_fix="" requires_review="" analyzed_at="" trace_url="" model=""

    if [ -n "$ai_data" ]; then
        # Collapse newlines within fields (SQL returns multi-line text)
        local ai_oneline=$(echo "$ai_data" | tr '\n' ' ' | sed 's/  */ /g')
        IFS='|' read -r category confidence root_cause recommended_fix recommended_files \
            can_auto_fix requires_review analyzed_at trace_url model <<< "$ai_oneline"
    fi

    # Calculate priority and risk
    local priority=$(calculate_priority "$occurrence_count" "$days_failing" "${confidence:-0}" "$can_auto_fix")
    local risk=$(calculate_risk "$requires_review" "$can_auto_fix" "${confidence:-0}")
    local est_time=$(estimate_fix_time "$category")

    # Konflux UI URL — prefer DB-stored value, fall back to constructed
    konflux_url=$(trim "${konflux_url:-}")
    [ -z "$konflux_url" ] && konflux_url="${KONFLUX_UI_BASE}/ns/${NAMESPACE}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}/logs"

    # Generate Jira description (Red Hat bug template)
    local output=""

    # --- Description of problem ---
    output+="h3. Description of problem\n"
    output+="\n"
    output+="Build pipeline failure on component *${comp_name}* in application *${APPLICATION_NAME}*.\n"
    if [ -n "$error_type" ]; then
        output+="Error type: *${error_type}*"
        [ -n "$failed_step" ] && output+=" in pipeline step \`${failed_step}\`"
        output+=".\n"
    fi
    if [ -n "$error_msg" ]; then
        output+="{code}\n"
        output+="${error_msg}\n"
        output+="{code}\n"
    fi
    if [ -n "$category" ]; then
        output+="\n"
        output+="AI analysis (${confidence}% confidence) categorizes this as a *${category}* issue.\n"
        [ -n "$root_cause" ] && output+="${root_cause}\n"
    fi
    output+="\n"

    # --- Prerequisites ---
    output+="h3. Prerequisites\n"
    output+="\n"
    output+="* Component: \`${comp_name}\`\n"
    output+="* Application: \`${APPLICATION_NAME}\`\n"
    output+="* Repository: [${repo_url##*/}|${repo_url}] (branch: \`${branch}\`)\n"
    if [ -n "$commit_sha" ]; then
        output+="* Triggering commit: [${commit_sha:0:8}|${commit_url}] by ${commit_author}\n"
        [ -n "$commit_msg" ] && output+="* Commit message: ${commit_msg}\n"
    fi
    output+="\n"

    # --- Steps to Reproduce ---
    output+="h3. Steps to Reproduce\n"
    output+="\n"
    output+="# Push to branch \`${branch}\` in [${repo_url##*/}|${repo_url}]\n"
    output+="# Konflux triggers the \`${comp_name}\` build pipeline\n"
    [ -n "$failed_step" ] && output+="# Pipeline fails at step \`${failed_step}\`\n" || output+="# Pipeline fails during build\n"
    output+="\n"

    # --- Actual results ---
    output+="h3. Actual results\n"
    output+="\n"
    output+="Build pipeline fails with status *Failed*.\n"
    output+="PipelineRun: [${pr_name}|${konflux_url}]\n"
    output+="\n"

    # --- Expected results ---
    output+="h3. Expected results\n"
    output+="\n"
    output+="Build pipeline completes successfully.\n"
    output+="\n"

    # --- Reproducibility ---
    output+="h3. Reproducibility\n"
    output+="\n"
    if [ "${occurrence_count:-1}" -gt 1 ]; then
        output+="Always — ${occurrence_count} consecutive failures since ${first_seen}.\n"
    else
        output+="First occurrence — detected ${first_seen}.\n"
    fi
    output+="\n"

    # --- Found in what build ---
    output+="h3. Found in what build\n"
    output+="\n"
    output+="PipelineRun: [${pr_name}|${konflux_url}]\n"
    output+="First seen: ${first_seen}\n"
    [ "${first_seen}" != "${last_seen}" ] && output+="Last seen: ${last_seen}\n"
    output+="\n"

    # --- Workarounds ---
    output+="h3. Describe any workarounds\n"
    output+="\n"
    if [ -n "$category" ] && [ -n "$recommended_fix" ]; then
        output+="Suggested fix (${confidence}% confidence):\n"
        if [ -n "$recommended_files" ]; then
            output+="{code:language=diff}\n"
            output+="${recommended_fix}\n"
            output+="{code}\n"
        else
            output+="${recommended_fix}\n"
        fi
    else
        output+="No known workaround at this time.\n"
    fi
    output+="\n"

    # --- Additional information ---
    output+="h3. Additional information\n"
    output+="\n"
    output+="||Field||Value||\n"
    output+="|Suggested Priority|${priority}|\n"
    output+="|Risk Assessment|${risk}|\n"
    if [ -n "$category" ]; then
        output+="|AI Category|${category}|\n"
        output+="|Confidence|${confidence}%|\n"
        output+="|Auto-fixable|$([ "$can_auto_fix" = "t" ] && echo "Yes" || echo "No")|\n"
        output+="|Estimated effort|${est_time}|\n"
    fi
    output+="\n"
    output+="*Resources:*\n"
    output+="* [Full Build Logs|${konflux_url}]\n"
    output+="* [Repository|${repo_url}]\n"
    if [ -n "$trace_url" ]; then
        output+="* [AI Analysis Trace|${trace_url}]\n"
    fi
    output+="\n"

    # --- Priority guidance ---
    output+="h3. Priority guidance\n"
    output+="\n"
    output+="* Component tier: _please note the tier level of the component/feature_\n"
    output+="* Stable and EUS should be considered for .z releases\n"
    output+="* Fast release and Tech Preview can typically wait for the next normal release\n"
    output+="* If this is severe and a blocker, an exception could be granted\n"
    output+="* Consider release timeline differences if the decision is to wait for next release\n"
    output+="* Take customer impact into account when suggesting where it should be fixed\n"
    output+="* Tag PM and manager to confirm their agreement with the proposal\n"
    output+="\n"

    output+="---\n"
    if [ -n "$model" ]; then
        output+="_Automated analysis by ${model} (${analyzed_at})._\n"
    else
        output+="_No automated analysis available yet. Run: ic ai analyze component ${comp_name}_\n"
    fi

    clipboard_or_print "$output" "$clipboard"
}

export_conforma_jira() {
    local component="$1"
    local clipboard="$2"

    # Fetch Conforma violation data
    local data=$(sql "
        SELECT c.component_name, c.pipelinerun_name, c.scenario,
               c.violations_count, c.warnings_count, c.successes_count,
               TO_CHAR(c.first_detected_at, 'YYYY-MM-DD HH24:MI'),
               TO_CHAR(c.last_updated_at, 'YYYY-MM-DD HH24:MI'),
               EXTRACT(DAY FROM (NOW() - c.first_detected_at))::int as days_failing,
               (SELECT COUNT(*) FROM conforma_results WHERE component_name = c.component_name AND is_resolved = FALSE) as occurrence_count,
               COALESCE(c.repository_url, ''), COALESCE(c.commit_sha, ''),
               COALESCE(c.commit_url, ''), COALESCE(c.snapshot_name, '')
        FROM conforma_results c
        WHERE c.component_name = '$component'
          AND c.is_resolved = FALSE
          AND c.application = '$APPLICATION_NAME'
        ORDER BY c.last_updated_at DESC
        LIMIT 1;
    " 2>/dev/null)

    if [ -z "$data" ]; then
        echo -e "${RED}Error: No Conforma violation found for component: $component${NC}"
        return 1
    fi

    # Collapse newlines within fields
    local data_oneline=$(echo "$data" | tr '\n' ' ' | sed 's/  */ /g')
    IFS='|' read -r comp_name pr_name scenario violations warnings successes \
        first_seen last_seen days_failing occurrence_count \
        repo_url commit_sha commit_url snapshot <<< "$data_oneline"

    # Fetch AI analysis
    local ai_data=$(sql "
        SELECT a.failure_category, ROUND(a.confidence_score * 100),
               a.root_cause, a.recommended_fix, a.recommended_files,
               a.can_auto_fix, a.requires_human_review,
               TO_CHAR(a.analyzed_at, 'YYYY-MM-DD HH24:MI:SS'),
               a.langfuse_trace_url, a.model_used
        FROM ai_analysis a
        JOIN conforma_results c ON a.conforma_result_id = c.id
        WHERE c.component_name = '$component'
        ORDER BY a.analyzed_at DESC
        LIMIT 1;
    " 2>/dev/null)

    local category="" confidence="" root_cause="" recommended_fix="" recommended_files=""
    local can_auto_fix="" requires_review="" analyzed_at="" trace_url="" model=""

    if [ -n "$ai_data" ]; then
        local ai_oneline=$(echo "$ai_data" | tr '\n' ' ' | sed 's/  */ /g')
        IFS='|' read -r category confidence root_cause recommended_fix recommended_files \
            can_auto_fix requires_review analyzed_at trace_url model <<< "$ai_oneline"
    fi

    # Konflux UI URL
    local konflux_url="${KONFLUX_UI_BASE}/ns/${NAMESPACE}/applications/${APPLICATION_NAME}/pipelineruns/${pr_name}/logs"

    # Generate Jira template for Conforma
    local output=""
    output+="h2. Conforma Policy Violation: ${comp_name}\n"
    output+="\n"
    output+="||Field||Value||\n"
    output+="|Component|${comp_name}|\n"
    output+="|Status|Policy Violation|\n"
    output+="|Scenario|${scenario}|\n"
    output+="|Violations|${violations} violations, ${warnings} warnings, ${successes} successes|\n"
    output+="|PipelineRun|[${pr_name}|${konflux_url}]|\n"
    output+="|Snapshot|${snapshot}|\n"
    output+="|First Seen|${first_seen}|\n"
    output+="|Last Seen|${last_seen}|\n"
    output+="|Occurrences|${occurrence_count} times|\n"
    output+="\n"

    if [ -n "$category" ]; then
        output+="h3. AI Analysis (${confidence}% confidence)\n"
        output+="\n"
        output+="||Category||${category}||\n"
        output+="|Can Auto-Fix|$([ "$can_auto_fix" = "t" ] && echo "Yes" || echo "No")|\n"
        output+="|Requires Review|$([ "$requires_review" = "t" ] && echo "Yes" || echo "No")|\n"
        output+="\n"

        output+="h4. Root Cause\n"
        output+="\n"
        output+="${root_cause}\n"
        output+="\n"

        output+="h4. Recommended Fix\n"
        output+="\n"
        output+="${recommended_fix}\n"
        output+="\n"

        if [ -n "$recommended_files" ]; then
            output+="*Files/Configs to modify:*\n"
            output+="{code}\n"
            output+="${recommended_files}\n"
            output+="{code}\n"
            output+="\n"
        fi

        output+="h5. Policy Exception Process\n"
        output+="\n"
        output+="If the recommended fix isn't immediately feasible:\n"
        output+="# File JIRA at: [Create Issue|https://JIRA_CREATE_ISSUE_URL]\n"
        output+="# Explain business justification and timeline for proper fix\n"
        output+="# Create MR to exception file: {{konflux-release-data/.../fbc-acme-prod.yaml}}\n"
        output+="# Add exception terms (check AI analysis for specific package URLs)\n"
        output+="# Ping @owatkins (ProdSec) in #wg-3_0-openshift-ai-release for approval\n"
        output+="\n"
    fi

    output+="h3. Context & Resources\n"
    output+="\n"
    output+="*Repository:* ${repo_url}\n"
    if [ -n "$commit_sha" ]; then
        output+="*Commit:* [${commit_sha:0:8}|${commit_url}]\n"
    fi
    output+="\n"
    output+="*Useful Links:*\n"
    output+="* [Konflux PipelineRun|${konflux_url}]\n"
    output+="* [Quay Repository|https://quay.io/repository/rhoai/${comp_name}]\n"
    if [ -n "$trace_url" ]; then
        output+="* [AI Analysis Trace|${trace_url}]\n"
    fi
    output+="* [Enterprise Contract Docs|https://enterprisecontract.dev/]\n"
    output+="\n"

    output+="h3. Suggested Next Steps\n"
    output+="\n"
    output+="{panel:bgColor=#FFF4E6|title=Compliance Resolution}\n"

    if [ "$can_auto_fix" = "t" ]; then
        output+="The suggested fix appears straightforward:\n"
        output+="1. Review the recommended approach above\n"
        output+="2. Apply the fix (vendoring, config update, etc.)\n"
        output+="3. Rebuild and verify Conforma passes\n"
    else
        output+="This violation requires investigation:\n"
        output+="1. Review the violation details in Konflux UI\n"
        output+="2. Determine if fix or policy exception is appropriate\n"
        output+="3. If exception needed, follow policy exception process above\n"
    fi

    output+="{panel}\n"
    output+="\n"
    output+="---\n"
    if [ -n "$model" ]; then
        output+="_Automated analysis by ${model} (${analyzed_at})._\n"
    else
        output+="_No automated analysis available yet. Run: ic ai analyze conforma ${comp_name}_\n"
    fi
    if [ -n "$category" ]; then
        output+="_Confidence: ${confidence}% | Category: ${category}_\n"
    fi

    clipboard_or_print "$output" "$clipboard"
}

