#!/bin/bash
# Pre-commit hook: delegates to lefthook if installed, falls back to direct checks.
# Install: git config core.hooksPath .githooks

set -e

# Prefer lefthook — it runs checks in parallel
if command -v lefthook > /dev/null 2>&1; then
    exec lefthook run pre-commit
fi

# Fallback: run checks sequentially (same as lefthook.yml)
PYTHON="${PYTHON:-python3.11}"
ROOT=$(git rev-parse --show-toplevel)
COLLECTORS="$ROOT/src"
RH_PYTHON="${RH_PRE_COMMIT_PYTHON:-${HOME}/.local/share/rh-pre-commit/venv/bin/python3}"

echo "=== pre-commit: secrets (rh-gitleaks) ==="
if [ -x "$RH_PYTHON" ]; then
    "$RH_PYTHON" -m rh_pre_commit.multi
elif command -v rh-multi-pre-commit > /dev/null; then
    rh-multi-pre-commit
else
    echo "rh-multi-pre-commit not found, skipping secrets check" >&2
fi

echo "=== pre-commit: lint ==="
$PYTHON -m ruff check "$COLLECTORS/" --exclude='__pycache__'

echo "=== pre-commit: style (STYLE.md) ==="
cd "$ROOT"
bash scripts/check-style.sh

echo "=== pre-commit: security (bandit) ==="
if command -v bandit > /dev/null 2>&1; then
    bandit -r src/ -q --skip B101,B404 -x src/tests
elif $PYTHON -m bandit --version > /dev/null 2>&1; then
    $PYTHON -m bandit -r src/ -q --skip B101,B404 -x src/tests
else
    echo "bandit not installed, skipping security scan" >&2
fi

echo "=== pre-commit: tests ==="
cd "$ROOT"
$PYTHON -m pytest -q --tb=short 2>&1

echo "=== pre-commit: all checks passed ==="
